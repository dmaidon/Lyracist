                                                                CommandParameter="{Binding}"
                                                                Foreground="#E74C3C"
                                                                BorderBrush="#E74C3C"
                                                                Margin="2" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Settings" Width="50" Height="45" VerticalAlignment="Top" d:LayoutOverrides="Height">
