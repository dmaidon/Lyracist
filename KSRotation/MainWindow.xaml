                                        <TextBlock Text="• Banner Template: Type custom text in Settings. Use '{venue}' and '{dj}' in the text to automatically substitute the selected venue and DJ names." Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Topic 4: Settings & Venues -->
                            <StackPanel x:Name="SettingsHelpPanel">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedHelpTopic}" Value="⚙️ Settings &amp; Venues">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Settings &amp; Venues" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppHeaderBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="Configure app-wide parameters to suit your venue's style and setup."
                                           FontSize="14" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="20" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                <TextBlock Text="Venues List" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                                <TextBlock Text="Add all your regular venues to the list. Selecting a venue updates the active venue name instantly. Venue files are saved in 'Settings/venues.json'." Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

