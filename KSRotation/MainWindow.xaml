                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedHelpTopic}" Value="📺 Display Projection">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Display Projection" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppHeaderBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="The display window is designed to be dragged onto a second monitor or TV to show the audience who is singing and who is up next."
                                           FontSize="14" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="20" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                <TextBlock Text="Projection Views" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource AppHeaderBrush}" />
                                <Grid Margin="0,0,0,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Normal View" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Column="1" Text="Displays active singers in clean, high-contrast, self-wrapping columns. The active singer is highlighted in crimson." Margin="0,4" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                    <TextBlock Grid.Row="1" Text="Star Wars Crawl" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Animates the rotation queue in a 3D perspective scroll, moving up over a gorgeous twinkling starfield with distant galaxies. Ideal for breaks or dramatic rotation reveals!" Margin="0,4" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                    <TextBlock Grid.Row="2" Text="Vegas Marquee" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="A Vegas/Broadway theater marquee: the current singer's name in giant glowing letters inside a brass frame ringed by purple 'marching ants' light bulbs that chase around the border, with an Up Next strip below. The biggest crowd-pleaser." Margin="0,4" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                    <TextBlock Grid.Row="3" Text="Vinyl Turntable" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="A 'Now Spinning' turntable: a continuously spinning 45 single (big center hole) with the current singer's name and song title on the gold label, a tonearm resting on it, and a now-playing side panel listing who's On Deck." Margin="0,4" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                    <TextBlock Grid.Row="4" Text="Disco Ball" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="A mirror-ball dance club spectacle: rotating facets cast drifting light spots and sweeping colored stage beams across the venue floor with a bold neon hero performer card." Margin="0,4" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                    <TextBlock Grid.Row="5" Text="Synthwave Grid" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Retro 80s outrun aesthetic: animated perspective horizon grid bathed in neon cyan and magenta, featuring a glowing retro sun backdrop and synth-styled typography." Margin="0,4" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                    <TextBlock Grid.Row="6" Text="Concert Festival Lineup" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="Main-stage music festival poster vibe: towering stage trusses, drifting golden concert sparkles, and dynamic sweeping spotlights framing the headlining performer." Margin="0,4" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                    <TextBlock Grid.Row="7" Text="Casino Slot Reels" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="High-roller casino excitement: singer names spin rapidly on slot-machine reels that clunk to a stop on paylines, accompanied by a glittering jackpot coin flourish and golden glow." Margin="0,4" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                    <TextBlock Grid.Row="8" Text="Jukebox" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="Classic 1950s rock-and-roll diner cabinet: glowing chrome arches, animated rising bubble-tube light columns, and illuminated selector pushbuttons for upcoming song selections." Margin="0,4" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                    <TextBlock Grid.Row="9" Text="Stadium Jumbotron" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Row="9" Grid.Column="1" Text="Massive arena LED scoreboard: sweeping stadium floodlights crisscross the arena as the headlining singer is announced like a stadium superstar." Margin="0,4" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                    <TextBlock Grid.Row="10" Text="Movie Theater 'Now Showing'" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Row="10" Grid.Column="1" Text="Vintage Hollywood premiere aesthetic: vintage 35mm film leader countdown (3...2...1) sweep, flickering cinematic projector beam, and marquee coming-attraction lobby poster cards." Margin="0,4" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                    <TextBlock Grid.Row="11" Text="Purple Velvet Curtain" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Row="11" Grid.Column="1" Text="Opulent royal purple velvet stage with undulating drapery folds, overhead stage wash, and warm champagne-gold chasing marquee bulbs." Margin="0,4" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                </Grid>

                                <Border Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="⚙️ Customizing the Screen" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" Foreground="{DynamicResource AppHeaderBrush}" />
                                        <TextBlock Text="• Marquee Speed: Adjust the slider in the Appearance group in Settings to control how fast the ticker scrolls at the top of the display." Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        <TextBlock Text="• Banner Template: Type custom text in Settings. Use '{venue}' and '{dj}' in the text to automatically substitute the selected venue and DJ names." Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Topic 4: Settings & Venues -->
                            <StackPanel x:Name="SettingsHelpPanel">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedHelpTopic}" Value="⚙️ Settings &amp; Venues">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Settings &amp; Venues" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppHeaderBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="Configure app-wide parameters to suit your venue's style and setup."
                                           FontSize="14" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="20" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                <TextBlock Text="Venues List" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                                <TextBlock Text="Add all your regular venues to the list. Selecting a venue updates the active venue name instantly. Venue files are saved in 'Settings/venues.json'." Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                <TextBlock Text="DJs List" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                                <TextBlock Text="Add all your DJs to the list. Selecting a DJ updates the active DJ name instantly. Use '{dj}' in your banner and crawl text templates to automatically substitute the selected DJ's name. DJ files are saved in 'Settings/djs.json'." Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                <TextBlock Text="Theme Engine" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                                <TextBlock Text="Choose between Light, Dark, or System themes. Changing the theme instantly adjusts the main application visual styles dynamically using the Material Design in XAML Toolkit. With System selected, the app also follows live Windows light/dark switches automatically." Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                <TextBlock Text="Email and Reports" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                                <TextBlock Text="Configure the Report Email Recipient. Check the box to launch your mail client automatically when 'Save Rotation' is clicked." Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                <Border Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource PrimaryHueMidBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="💾 Automatic Debounced Saving" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                                        <TextBlock Text="You do not need to click 'Save Settings' manually after every minor adjustment! Settings auto-save in the background 500ms after you finish typing or dragging. Clicking the button forces an immediate sync." TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Topic: Display & DJ Banners -->
                            <StackPanel x:Name="DisplayHelpPanel">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedHelpTopic}" Value="📺 Display &amp; DJ Banners">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Display &amp; DJ Banners" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppHeaderBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="Configure wireless display streaming and projection for your singer rotation, along with custom branding screens."
                                           FontSize="14" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="20" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                <Border Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="📺 Wireless Casting Target Selection" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" Foreground="{DynamicResource AppHeaderBrush}" />
                                        <TextBlock Text="1. Navigate to the Display tab." Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        <TextBlock Text="2. Select a target from the 'Cast Rotation To' dropdown (Monitor, Miracast, Chromecast, Browser Cast, AirPlay, Wireless HDMI)." Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        <TextBlock Text="3. If Chromecast is selected, select the specific Chromecast device from the list. Use 'Rescan' to rediscover devices on your local network." Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        <TextBlock Text="4. Click 'Cast Rotation' to start streaming. The app uses an off-screen capture buffer to keep your host laptop desktop free of rotation windows." Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        <TextBlock Text="5. Click 'Stop Casting' to terminate the stream and release background buffers." Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="🌐 Browser Cast Server" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" Foreground="{DynamicResource AppHeaderBrush}" />
                                        <TextBlock Text="Selecting 'Browser Cast' starts a local HTTP web server. Anyone on your local Wi-Fi network can visit http://localhost:8080/rotation/ (or using your laptop's local IP address) to view the live audience rotation billboard in real-time." TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="🎏 DJ Banners &amp; Collision Priority" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" Foreground="{DynamicResource AppHeaderBrush}" />
                                        <TextBlock Text="• DJ Banner Window: Select a target screen for your DJ Banner under Settings and toggle it on to display full-screen borderless branding banners (supports PNG, JPG, JPEG, GIF, BMP, and looping MP4 video)." Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        <TextBlock Text="• Deconfliction Logic: If you select the same screen for both the DJ Banner and the main Rotation Display, the Rotation Display takes priority. The DJ Banner will automatically hide when the Rotation window is enabled or moved to that monitor, preventing any overlap collision." TextWrapping="Wrap" Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Topic: Connect & Wi-Fi Instructions -->
                            <StackPanel x:Name="ConnectHelpPanel">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedHelpTopic}" Value="📡 Connect &amp; Wi-Fi Instructions">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Connect &amp; Wi-Fi Instructions" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppHeaderBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="Project scan-to-connect Wi-Fi access and patron song request instructions directly onto your venue projection displays."
                                           FontSize="14" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="20" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                <Border Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="📱 Dual Scan-to-Connect QR Code Banner" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" Foreground="{DynamicResource AppHeaderBrush}" />
                                        <TextBlock Text="• Automatic Network Detection: Automatically scans the host machine's active Wi-Fi connection and resolves the connected SSID network name." Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        <TextBlock Text="• Dual QR Codes: Generates two distinct vector QR codes on the banner — a forest green (#064E3B) Wi-Fi Scan-to-Connect QR code (supporting WPA/WPA2/NoPass) and a pure black (#000000) Song Request Portal QR code." TextWrapping="Wrap" Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        <TextBlock Text="• Password Display: Displays the exact network password or indicates 'No Password Required' when password is omitted." Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="🔑 Persistent Wi-Fi Password Manager (wifi_passwords.json)" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" Foreground="{DynamicResource AppHeaderBrush}" />
                                        <TextBlock Text="• Automatic Password Saving: Passwords entered into the Wi-Fi password box are automatically saved per Wi-Fi SSID into 'wifi_passwords.json'." TextWrapping="Wrap" Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        <TextBlock Text="• Venue Auto-Recall: When you reconnect to a previously saved network (venue Wi-Fi, travel router, mobile hotspot), the application automatically recalls and populates the saved password." TextWrapping="Wrap" Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="🖥️ Dynamic 1:1 Pixel-Sharp Screen Resolution Detection" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" Foreground="{DynamicResource AppHeaderBrush}" />
                                        <TextBlock Text="• Auto Resolution Detection: Automatically detects physical target screen dimensions (1080p, 1440p, 4K 3840x2160, custom) and dynamically scales vector paths, card bounds, and QR module sizes (pixelsPerModule) for razor-sharp 1:1 pixel rendering." TextWrapping="Wrap" Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        <TextBlock Text="• Dedicated Display GroupBox: Located under Column 1 of the Display tab inside a dedicated Green GroupBox (GreenSettingsGroupBoxStyle). Select target display options: 'None', 'All Screens / Monitors', or specific connected monitors." TextWrapping="Wrap" Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Topic 6: Trivia Night Pro -->
                            <StackPanel x:Name="TriviaHelpPanel">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedHelpTopic}" Value="🎯 Trivia Night Pro">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="🎯 Trivia Night Pro" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppHeaderBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="Host interactive live pub and bar trivia games directly from KSRotation during intermissions or as a standalone entertainment module."
                                           FontSize="14" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="20" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                <Border Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="🎮 Trivia Quick Start &amp; Pre-Game Lobby" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" Foreground="{DynamicResource AppHeaderBrush}" />
                                        <TextBlock Text="1. Category Selection: Choose from 15 starter curated categories (150 questions each / 2,250 total questions) or add unlimited custom JSON packs into TriviaData/packs/." Margin="0,3" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                        <TextBlock Text="2. 1-Click Lobby Launch: Click 'Launch Pre-Game Lobby' to project the 70:30 widescreen lobby featuring 16:9 Category Announcement Banners, countdown clock, and stacked Wi-Fi &amp; Join QR codes." Margin="0,3" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                        <TextBlock Text="3. Zero-Install Mobile Buzzers: Patrons scan the Join QR code (http://&lt;LAN-IP&gt;:8085/trivia) to register their name/team and receive an instant 4-button color buzzer with randomized answer elimination." Margin="0,3" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                        <TextBlock Text="4. Authoritative Live Timers: The 'Question Answer Window' in Trivia Settings (default: 15s) is authoritative and instantly synchronizes with the live game engine and saves to storage on change." Margin="0,3" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                        <TextBlock Text="5. Tiered Scoring &amp; Penalties: Tiered option value scoring (100% / 70% / 40%), up to +500 speed bonus, +10% streak multiplier, and optional wrong answer point deductions (0 to -500 pts)." Margin="0,3" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                        <TextBlock Text="6. Automatic Pause: When DJ Banners or Rotation screens are cast, Trivia automatically freezes and resumes when closed." Margin="0,3" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                        <TextBlock Text="7. Custom JSON Packs: Place any custom JSON file in TriviaData/packs/ (with PackId, Title, Category, Description, and Questions array with Prompt, 4 Options, and CorrectAnswerIndex) to auto-discover and load new categories." Margin="0,3" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="⚡ Gameplay Modes: Manual vs. Automatic" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" Foreground="{DynamicResource AppHeaderBrush}" />
                                        <TextBlock Text="• 🎮 Manual DJ Mode (Auto-Run unchecked): Questions load in a 'standby/reading' state with the timer paused, allowing the DJ to read the prompt over the microphone. The DJ starts the countdown clock on demand (Spacebar or 'Start Question &amp; Timer' button), adjusts pacing using timer bumps, and manually triggers answer reveals and question progression (Next ⏭)." Margin="0,3" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                        <TextBlock Text="• ⚡ Automatic Mode (Auto-Run checked): The entire game runs unattended. Question timers start counting down immediately upon loading, wrong answers are eliminated automatically, correct answers are revealed after countdown, and the engine automatically advances to the next question after a 5-second reveal buffer." Margin="0,3" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Topic 8: Acknowledgements -->
                            <StackPanel x:Name="AcknowledgementsPanel">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedHelpTopic}" Value="🙏 Acknowledgements">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Acknowledgements" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppHeaderBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="KSRotation is built with the help of many open-source projects. Thank you to their authors and maintainers." Margin="0,3" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                <TextBlock Text="• 🎬 FFmpeg / FFprobe (GPLv3) - audio analysis and media probing." Margin="0,3" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                <TextBlock Text="• ▶️ VLC / LibVLC and LibVLCSharp (LGPL) - media playback." Margin="0,3" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                <TextBlock Text="• 🎨 MaterialDesignThemes, CommunityToolkit.Mvvm, QRCoder, SkiaSharp, PDFsharp, DocumentFormat.OpenXml, Dapper, SQLite and the .NET libraries (MIT / Apache-2.0 / public domain)." Margin="0,3" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                <TextBlock Text="KSRotation is free software licensed under the GNU General Public License v3.0 or later (see LICENSE in the installation folder)." Margin="0,8,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                <TextBlock Text="See THIRD-PARTY-NOTICES.txt in the installation folder for the complete list, licenses and source links." Margin="0,8,0,0" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Topic 7: FAQ & Shortcuts -->
                            <StackPanel x:Name="FAQPanel">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedHelpTopic}" Value="❓ FAQ &amp; Shortcuts">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="FAQ &amp; Keyboard Shortcuts" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppHeaderBrush}" Margin="0,0,0,8" />

                                <TextBlock Text="Keyboard Shortcuts" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource AppHeaderBrush}" />
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,16">
                                    <Grid Background="{DynamicResource MaterialDesignCardBackground}" Margin="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="8,6">
                                            <TextBlock Text="Shortcut" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                                        </Border>
                                        <Border Grid.Column="1" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="8,6">
                                            <TextBlock Text="Action" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                                        </Border>

                                        <Border Grid.Row="1" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="8,6">
                                            <TextBlock Text="Tab / Shift+Tab" Foreground="{DynamicResource MaterialDesignBody}" />
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="8,6">
                                            <TextBlock Text="Move focus between singer fields (Name, Song, Artist, Checkboxes)" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        </Border>

                                        <Border Grid.Row="2" Padding="8,6">
                                            <TextBlock Text="Spacebar" Foreground="{DynamicResource MaterialDesignBody}" />
                                        </Border>
                                        <Border Grid.Row="2" Grid.Column="1" Padding="8,6">
                                            <TextBlock Text="Toggle selected checkboxes or activate buttons" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Frequently Asked Questions" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource AppHeaderBrush}" />
                                <StackPanel>

                                    <TextBlock Text="Q: Why isn't the projection window opening?" FontWeight="SemiBold" Margin="0,4,0,2" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Text="A: Ensure 'Enable Display Window' is checked in the Rotation tab. The window is programmed to position itself on your second monitor automatically. If no second monitor is found, it will load on your primary monitor." Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                    <TextBlock Text="Q: Where are files saved on my computer?" FontWeight="SemiBold" Margin="0,4,0,2" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Text="A: All settings and reports are saved relative to the application's executable directory in folders labeled 'Settings' and 'Reports' respectively." Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                    <TextBlock Text="Q: What happens when I accept a request for a singer already in the rotation?" FontWeight="SemiBold" Margin="0,4,0,2" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Text="A: The application matches names case-insensitively. If the singer has no song listed, accepting the request automatically fills in their song and artist. If they already have a song, the request is added to their queued songs instead of creating a duplicate entry." Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="About" Width="50" Height="45">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Logo at 100% opacity -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource MaterialDesignCardBackground}"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16"
                            Margin="0,0,24,0"
                            VerticalAlignment="Top"
                            Width="282"
                            Height="282">
                        <Image Source="pack://application:,,,/Resources/KSRotation.png"
                               Stretch="Uniform"
                               Opacity="1.0" />
                    </Border>

                    <!-- Right: Info Details -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,16,0">
                            <!-- Title & Subtitle -->
                            <TextBlock Text="{Binding AppTitle}"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppHeaderBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}'}"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="A premium, state-of-the-art karaoke rotation manager designed for professional KJs and venue hosts. It combines local networking, offline accessibility, and classic visual boards to deliver a fair and engaging show."
                                       FontSize="15"
                                       TextWrapping="Wrap"
                                       LineHeight="22"
                                       Foreground="{DynamicResource MaterialDesignBody}"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="{Binding AppCopyright}"
                                       FontSize="12"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       Margin="0,0,0,24" />

                            <!-- Specifications Grid -->
                            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Author -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Author:" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppAuthor}" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />

                                    <!-- Company -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Company:" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AppCompany}" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />

                                    <!-- Support Email -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Support Email:" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="dmaidon@gmail.com" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />

                                    <!-- Architecture -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Architecture:" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="C# with MVVM Pattern (CommunityToolkit.Mvvm)" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />

                                    <!-- Frameworks & SDKs -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Framework:" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text=".NET 10.0 WPF Application" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />

                                    <!-- Main components -->
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Key Dependencies:" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Material Design in XAML Toolkit, PDFsharp, QRCoder" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                </Grid>
                            </Border>

                            <!-- Features bullet list -->
                            <TextBlock Text="Core Capabilities" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource AppHeaderBrush}" />

                            <BulletDecorator Margin="0,4">
                                <BulletDecorator.Bullet>
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource PrimaryHueMidBrush}" />
                                </BulletDecorator.Bullet>
                                <TextBlock Text="Patron Web Portal: Hosts a local server so singers scan a QR code to view the queue and submit song requests." Margin="10,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBody}" />
                            </BulletDecorator>

                            <BulletDecorator Margin="0,4">
                                <BulletDecorator.Bullet>
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource PrimaryHueMidBrush}" />
                                </BulletDecorator.Bullet>
                                <TextBlock Text="Retro Split-Flap Display: A stunning airport-style mechanical character board that flips tiles to show rotation changes." Margin="10,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBody}" />
                            </BulletDecorator>

                            <BulletDecorator Margin="0,4">
                                <BulletDecorator.Bullet>
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource PrimaryHueMidBrush}" />
                                </BulletDecorator.Bullet>
                                <TextBlock Text="Star Wars Crawl: A 3D perspective camera viewport rendering active singers crawling into space over a twinkling starfield." Margin="10,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBody}" />
                            </BulletDecorator>

                            <BulletDecorator Margin="0,4">
                                <BulletDecorator.Bullet>
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource PrimaryHueMidBrush}" />
                                </BulletDecorator.Bullet>
                                <TextBlock Text="Session Persistence &amp; PDF Reporting: Automatically saves active sessions and exports professional multi-page PDF performance reports." Margin="10,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBody}" />
                            </BulletDecorator>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>