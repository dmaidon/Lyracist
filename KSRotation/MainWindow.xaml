                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="8,6">
                                            <TextBlock Text="Shortcut" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                                        </Border>
                                        <Border Grid.Column="1" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="8,6">
                                            <TextBlock Text="Action" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                                        </Border>

                                        <Border Grid.Row="1" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="8,6">
                                            <TextBlock Text="Tab / Shift+Tab" Foreground="{DynamicResource MaterialDesignBody}" />
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="8,6">
                                            <TextBlock Text="Move focus between singer fields (Name, Song, Artist, Checkboxes)" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        </Border>

                                        <Border Grid.Row="2" Padding="8,6">
                                            <TextBlock Text="Spacebar" Foreground="{DynamicResource MaterialDesignBody}" />
                                        </Border>
                                        <Border Grid.Row="2" Grid.Column="1" Padding="8,6">
                                            <TextBlock Text="Toggle selected checkboxes or activate buttons" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Frequently Asked Questions" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource AppHeaderBrush}" />
                                <StackPanel>

                                    <TextBlock Text="Q: Why isn't the projection window opening?" FontWeight="SemiBold" Margin="0,4,0,2" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Text="A: Ensure 'Enable Display Window' is checked in the Rotation tab. The window is programmed to position itself on your second monitor automatically. If no second monitor is found, it will load on your primary monitor." Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                    <TextBlock Text="Q: Where are files saved on my computer?" FontWeight="SemiBold" Margin="0,4,0,2" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Text="A: All settings and reports are saved relative to the application's executable directory in folders labeled 'Settings' and 'Reports' respectively." Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                    <TextBlock Text="Q: What happens when I accept a request for a singer already in the rotation?" FontWeight="SemiBold" Margin="0,4,0,2" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Text="A: The application matches names case-insensitively. If the singer has no song listed, accepting the request automatically fills in their song and artist. If they already have a song, the request is added to their queued songs instead of creating a duplicate entry." Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="About" Width="50" Height="45">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Logo at 100% opacity -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource MaterialDesignCardBackground}"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16"
                            Margin="0,0,24,0"
                            VerticalAlignment="Top"
                            Width="282"
                            Height="282">
                        <Image Source="pack://application:,,,/Resources/KSRotation.png"
                               Stretch="Uniform"
                               Opacity="1.0" />
                    </Border>

                    <!-- Right: Info Details -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,16,0">
                            <!-- Title & Subtitle -->
                            <TextBlock Text="{Binding AppTitle}"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppHeaderBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}'}"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="A premium, state-of-the-art karaoke rotation manager designed for professional KJs and venue hosts. It combines local networking, offline accessibility, and classic visual boards to deliver a fair and engaging show."
                                       FontSize="15"
                                       TextWrapping="Wrap"
                                       LineHeight="22"
                                       Foreground="{DynamicResource MaterialDesignBody}"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="{Binding AppCopyright}"
                                       FontSize="12"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       Margin="0,0,0,24" />

                            <!-- Specifications Grid -->
                            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Author -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Author:" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppAuthor}" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />

                                    <!-- Company -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Company:" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AppCompany}" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />

                                    <!-- Support Email -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Support Email:" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="dmaidon@gmail.com" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />

                                    <!-- Architecture -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Architecture:" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="C# with MVVM Pattern (CommunityToolkit.Mvvm)" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />

                                    <!-- Frameworks & SDKs -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Framework:" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text=".NET 10.0 WPF Application" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />

                                    <!-- Main components -->
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Key Dependencies:" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Material Design in XAML Toolkit, PDFsharp, QRCoder" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                </Grid>
                            </Border>

                            <!-- Features bullet list -->
                            <TextBlock Text="Core Capabilities" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource AppHeaderBrush}" />

                            <BulletDecorator Margin="0,4">
                                <BulletDecorator.Bullet>
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource PrimaryHueMidBrush}" />
                                </BulletDecorator.Bullet>
                                <TextBlock Text="Patron Web Portal: Hosts a local server so singers scan a QR code to view the queue and submit song requests." Margin="10,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBody}" />
                            </BulletDecorator>

                            <BulletDecorator Margin="0,4">
                                <BulletDecorator.Bullet>
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource PrimaryHueMidBrush}" />
                                </BulletDecorator.Bullet>
                                <TextBlock Text="Retro Split-Flap Display: A stunning airport-style mechanical character board that flips tiles to show rotation changes." Margin="10,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBody}" />
                            </BulletDecorator>

                            <BulletDecorator Margin="0,4">
                                <BulletDecorator.Bullet>
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource PrimaryHueMidBrush}" />
                                </BulletDecorator.Bullet>
                                <TextBlock Text="Star Wars Crawl: A 3D perspective camera viewport rendering active singers crawling into space over a twinkling starfield." Margin="10,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBody}" />
                            </BulletDecorator>

                            <BulletDecorator Margin="0,4">
                                <BulletDecorator.Bullet>
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource PrimaryHueMidBrush}" />
                                </BulletDecorator.Bullet>
                                <TextBlock Text="Session Persistence &amp; PDF Reporting: Automatically saves active sessions and exports professional multi-page PDF performance reports." Margin="10,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBody}" />
                            </BulletDecorator>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>