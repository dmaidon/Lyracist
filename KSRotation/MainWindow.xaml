                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="A Vegas/Broadway theater marquee: the current singer's name in giant glowing letters inside a brass frame ringed by purple 'marching ants' light bulbs that chase around the border, with an Up Next strip below. The biggest crowd-pleaser." Margin="0,4" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                    <TextBlock Grid.Row="2" Text="Vinyl Turntable" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="A 'Now Spinning' turntable: a continuously spinning 45 single (big center hole) with the current singer's name and song title on the gold label, a tonearm resting on it, and a now-playing side panel listing who's On Deck." Margin="0,4" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                    <TextBlock Grid.Row="3" Text="Star Wars Crawl" FontWeight="SemiBold" Margin="0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Animates the rotation queue in a 3D perspective scroll, moving up over a gorgeous twinkling starfield with distant galaxies. Ideal for breaks or dramatic rotation reveals!" Margin="0,4" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                </Grid>

                                <Border Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel>
