<!-- Edited on Aug 26, 2026 @ 07:18:00 -> Add manual vs automatic trivia gameplay instructions to Help panel -->
<Window x:Name="FrmMain"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    x:Class="KSRotation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:KSRotation.Converters"
        xmlns:vm="clr-namespace:KSRotation.ViewModels"
        mc:Ignorable="d"
    Title="{Binding WindowTitle}"
    Width="1500"
    Height="800"
    d:DesignWidth="1500"
    d:DesignHeight="800"
    Background="{DynamicResource MaterialDesignPaper}"
    Foreground="{DynamicResource MaterialDesignBody}"
    Icon="/mic_64.png" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <!-- Drives the rotation list's "vertical mode" 3-row layout — true when the list is narrower
             than 700px (e.g. window resized tall and thin, or a portrait tablet). -->
        <converters:NarrowWidthToBooleanConverter x:Key="NarrowWidthConverter" />
        <!-- Custom text box style inside ListView rows to ensure perfect contrast and theme syncing -->
        <Style x:Key="GridTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
            <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center" Margin="2,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AppContrastTextBrush}" />
                    <Setter Property="BorderBrush" Value="#80FFFFFF" />
                    <Setter Property="Background" Value="#33FFFFFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNext}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AppContrastTextBrush}" />
                    <Setter Property="BorderBrush" Value="#80FFFFFF" />
                    <Setter Property="Background" Value="#33FFFFFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInactive}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Opacity" Value="0.6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Gold highlight for the currently-singing row and context menu -->
        <Style x:Key="CurrentSingerRowStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0,1,0,1" />
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="Toggle Active/Inactive"
                                  Command="{Binding Path=PlacementTarget.Tag.ToggleSingerInactiveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="Set as Current Singer"
                                  Command="{Binding Path=PlacementTarget.Tag.SetCurrentSingerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Command="{Binding Path=PlacementTarget.Tag.SetRotationStartSingerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="Set as 1st Singer (Round Start)" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=PlacementTarget.DataContext.IsRotationStart, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                            <Setter Property="Header" Value="Clear 1st Singer Badge" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <MenuItem Header="Finish Current Song"
                                  Command="{Binding Path=PlacementTarget.Tag.FinishSingerSongCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="Move Up"
                                  Command="{Binding Path=PlacementTarget.Tag.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Move Down"
                                  Command="{Binding Path=PlacementTarget.Tag.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="Remove Singer Permanently"
                                  Command="{Binding Path=PlacementTarget.Tag.RemoveSingerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Lowest priority: 1st Singer red tint, overridden below by Next (green) / Current (amber) -->
                <DataTrigger Binding="{Binding IsRotationStart}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppRotationStartBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AppContrastTextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNext}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppNextSingerBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AppContrastTextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppCurrentSingerBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AppContrastTextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInactive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MaterialDesignDivider}" />
                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
                    <Setter Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
        </Style>

        <Style x:Key="ModernButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ModernSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppSecondaryButtonBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryButtonForegroundBrush}" />
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Foreground" Value="{DynamicResource AppContrastTextBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AppContrastTextBrush}" />
        </Style>

        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
        </Style>

        <!-- Compact TextBox style with clean vertical centering for small inputs (28px height) -->
        <Style x:Key="ModernCompactTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center"
                                          Padding="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom button style inside ListView rows to ensure perfect sizing and selection contrast -->
        <Style x:Key="GridButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppSecondaryButtonBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryButtonForegroundBrush}" />
        </Style>

        <!-- Purple GroupBox theme (Rotation, DJ, Venues) -->
        <LinearGradientBrush x:Key="PurpleGroupBoxHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7B3FA8" Offset="0.0" />
            <GradientStop Color="#4A5AB8" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PurpleGroupBoxBodyBrush" Color="#127B3FA8" />
        <SolidColorBrush x:Key="PurpleGroupBoxBorderBrush" Color="#557B3FA8" />

        <Style x:Key="PurpleSettingsGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource PurpleGroupBoxBorderBrush}"
                                Background="{DynamicResource MaterialDesignCardBackground}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="{StaticResource PurpleGroupBoxHeaderBrush}"
                                        CornerRadius="7,7,0,0"
                                        Padding="14,9">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                </Border>
                                <Border Grid.Row="1"
                                        Background="{StaticResource PurpleGroupBoxBodyBrush}"
                                        Padding="14"
                                        CornerRadius="0,0,7,7">
                                    <ContentPresenter />
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Blue GroupBox theme (Theme, Displays, Projection, Banners) -->
        <LinearGradientBrush x:Key="BlueGroupBoxHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00A6E0" Offset="0.0" />
            <GradientStop Color="#0072ff" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BlueGroupBoxBodyBrush" Color="#1200c6ff" />
        <SolidColorBrush x:Key="BlueGroupBoxBorderBrush" Color="#550072ff" />

        <Style x:Key="BlueSettingsGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BlueGroupBoxBorderBrush}"
                                Background="{DynamicResource MaterialDesignCardBackground}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="{StaticResource BlueGroupBoxHeaderBrush}"
                                        CornerRadius="7,7,0,0"
                                        Padding="14,9">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                </Border>
                                <Border Grid.Row="1"
                                        Background="{StaticResource BlueGroupBoxBodyBrush}"
                                        Padding="14"
                                        CornerRadius="0,0,7,7">
                                    <ContentPresenter />
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Green GroupBox theme (Connect & Request Instructions) -->
        <LinearGradientBrush x:Key="GreenGroupBoxHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#059669" Offset="0.0" />
            <GradientStop Color="#047857" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="GreenGroupBoxBodyBrush" Color="#12059669" />
        <SolidColorBrush x:Key="GreenGroupBoxBorderBrush" Color="#5510B981" />

        <Style x:Key="GreenSettingsGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource GreenGroupBoxBorderBrush}"
                                Background="{DynamicResource MaterialDesignCardBackground}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="{StaticResource GreenGroupBoxHeaderBrush}"
                                        CornerRadius="7,7,0,0"
                                        Padding="14,9">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                </Border>
                                <Border Grid.Row="1"
                                        Background="{StaticResource GreenGroupBoxBodyBrush}"
                                        Padding="14"
                                        CornerRadius="0,0,7,7">
                                    <ContentPresenter />
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navy GroupBox theme (Network IP, Server/IP Setup) -->
        <LinearGradientBrush x:Key="NavyGroupBoxHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#3a7bd5" Offset="0.0" />
            <GradientStop Color="#3a6073" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="NavyGroupBoxBodyBrush" Color="#123a7bd5" />
        <SolidColorBrush x:Key="NavyGroupBoxBorderBrush" Color="#553a7bd5" />

        <Style x:Key="NavySettingsGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource NavyGroupBoxBorderBrush}"
                                Background="{DynamicResource MaterialDesignCardBackground}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="{StaticResource NavyGroupBoxHeaderBrush}"
                                        CornerRadius="7,7,0,0"
                                        Padding="14,9">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                </Border>
                                <Border Grid.Row="1"
                                        Background="{StaticResource NavyGroupBoxBodyBrush}"
                                        Padding="14"
                                        CornerRadius="0,0,7,7">
                                    <ContentPresenter />
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slate GroupBox theme (Email Settings, Security) -->
        <LinearGradientBrush x:Key="SlateGroupBoxHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#708090" Offset="0.0" />
            <GradientStop Color="#4f5d73" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="SlateGroupBoxBodyBrush" Color="#12708090" />
        <SolidColorBrush x:Key="SlateGroupBoxBorderBrush" Color="#55708090" />

        <Style x:Key="SlateSettingsGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource SlateGroupBoxBorderBrush}"
                                Background="{DynamicResource MaterialDesignCardBackground}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="{StaticResource SlateGroupBoxHeaderBrush}"
                                        CornerRadius="7,7,0,0"
                                        Padding="14,9">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                </Border>
                                <Border Grid.Row="1"
                                        Background="{StaticResource SlateGroupBoxBodyBrush}"
                                        Padding="14"
                                        CornerRadius="0,0,7,7">
                                    <ContentPresenter />
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom TabControl style to show borders/outlines around the content panel -->
        <Style x:Key="BorderedTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local"
                              ClipToBounds="true"
                              SnapsToDevicePixels="true">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ColumnDefinition0" />
                                <ColumnDefinition x:Name="ColumnDefinition1" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="RowDefinition0" Height="Auto" />
                                <RowDefinition x:Name="RowDefinition1" Height="*" />
                            </Grid.RowDefinitions>
                            <!-- Tab Headers panel -->
                            <TabPanel x:Name="HeaderPanel"
                                      Grid.Row="0"
                                      Grid.Column="0"
                                      IsItemsHost="true"
                                      Panel.ZIndex="1"
                                      KeyboardNavigation.TabNavigation="Once" />
                            <!-- Outlined/Bordered Content Area -->
                            <Border x:Name="ContentPanel"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="true">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="{TemplateBinding Padding}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <TabControl x:Name="Tc" Background="Transparent" BorderThickness="2" BorderBrush="{DynamicResource AppHeaderBrush}" Style="{StaticResource BorderedTabControlStyle}">
            <TabControl.Resources>
                <!-- Align the tab headers panel to the left so they sit next to each other without stretching -->
                <Style TargetType="TabPanel">
                    <Setter Property="HorizontalAlignment" Value="Left" />
                </Style>
            </TabControl.Resources>
            <TabItem Header="Rotation" Width="80" Height="45">
                <Grid Margin="12">
                    <!-- Row 1 only holds content in vertical/tablet mode, when the sidebar below stacks
                         under the rotation list instead of sitting beside it in Column 1. It's Auto-height
                         so it collapses to nothing when unused in the normal wide layout. -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Grid.IsSharedSizeScope="True" Margin="0,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,12" Orientation="Horizontal">
                            <CheckBox
                            Content="Enable Display Window"
                            IsChecked="{Binding IsDisplayEnabled}"
                            Style="{StaticResource ModernCheckBoxStyle}"
                            FontSize="16"
                            Margin="0,0,24,0" />
                            <CheckBox
                            Content="Float Current to Top"
                            IsChecked="{Binding FloatCurrentSingerToTop}"
                            Style="{StaticResource ModernCheckBoxStyle}"
                            FontSize="16"
                            Margin="0,0,24,0"
                            ToolTip="When checked, the current singer always floats to the top of the rotation list." />
                            <ComboBox
                            Width="180"
                            Margin="0,0,24,0"
                            materialDesign:HintAssist.Hint="Projection View"
                            Style="{StaticResource ModernComboBoxStyle}"
                            ItemsSource="{Binding ProjectionViews}"
                            SelectedItem="{Binding SelectedProjectionView}"
                            FontSize="14"
                            VerticalAlignment="Center" />
                            <TextBlock
                            Text="Singers in Rotation:"
                            FontSize="16"
                            VerticalAlignment="Center"
                            Margin="24,0,8,0"
                            Foreground="{DynamicResource MaterialDesignBody}" />
                            <TextBox
                            Text="{Binding SingersInRotationCount, Mode=OneWay}"
                            IsReadOnly="True"
                            Width="50"
                            FontSize="16"
                            TextAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource ModernTextBoxStyle}"
                            Focusable="False" />
                            <TextBlock
                            Text="Theme:"
                            FontSize="16"
                            VerticalAlignment="Center"
                            Margin="24,0,8,0"
                            Foreground="{DynamicResource MaterialDesignBody}" />
                            <ComboBox
                            Width="110"
                            ItemsSource="{Binding Themes}"
                            SelectedItem="{Binding SelectedTheme, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource ModernComboBoxStyle}"
                            FontSize="14"
                            VerticalAlignment="Center" />
                        </WrapPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="col0" MinWidth="34" />
                                <ColumnDefinition Width="2*" SharedSizeGroup="col1" MinWidth="110" />
                                <ColumnDefinition Width="1.8*" SharedSizeGroup="colDuet" MinWidth="95" />
                                <ColumnDefinition Width="2.5*" SharedSizeGroup="col2" MinWidth="140" />
                                <ColumnDefinition Width="2.5*" SharedSizeGroup="col3" MinWidth="140" />
                            </Grid.ColumnDefinitions>

                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AppHeaderBrush}" />
                                </Style>
                            </Grid.Resources>

                            <TextBlock Text="★" FontWeight="SemiBold" HorizontalAlignment="Center" ToolTip="Set current singer" />
                            <TextBlock Grid.Column="1" Text="Singer" FontWeight="SemiBold" Margin="4,0,0,0" />
                            <TextBlock Grid.Column="2" Text="Duet Partner" FontWeight="SemiBold" Margin="4,0,0,0" />
                            <TextBlock Grid.Column="3" Text="Song" FontWeight="SemiBold" Margin="4,0,0,0" />
                            <TextBlock Grid.Column="4" Text="Artist" FontWeight="SemiBold" Margin="4,0,0,0" />
                        </Grid>

                        <ListView
                        x:Name="SingersListView"
                        Grid.Row="2"
                        ItemsSource="{Binding Singers}"
                        ItemContainerStyle="{StaticResource CurrentSingerRowStyle}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        HorizontalContentAlignment="Stretch"
                        UseLayoutRounding="True"
                        SnapsToDevicePixels="True"
                        Margin="0,8,0,8">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="2,6,2,10" MinHeight="80">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Row 0: Identity & Song Inputs -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="col0" MinWidth="34" />
                                                    <ColumnDefinition Width="2*" SharedSizeGroup="col1" MinWidth="110" />
                                                    <ColumnDefinition Width="1.8*" SharedSizeGroup="colDuet" MinWidth="95" />
                                                    <ColumnDefinition Width="2.5*" SharedSizeGroup="col2" MinWidth="140" />
                                                    <ColumnDefinition Width="2.5*" SharedSizeGroup="col3" MinWidth="140" />
                                                </Grid.ColumnDefinitions>

                                                <Button
                                                Command="{Binding DataContext.SetCurrentSingerCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"
                                                Grid.Column="0"
                                                Margin="2"
                                                ToolTip="Set as current singer">
                                                    <!-- In vertical mode this reads as a small badge next to the Name field rather than a
                                                         full-size column button, even though it stays structurally in its own column. -->
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource GridButtonStyle}">
                                                            <Setter Property="Content" Value="☆" />
                                                            <Setter Property="Foreground" Value="#888888" />
                                                            <Setter Property="FontSize" Value="14" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Content" Value="★" />
                                                                    <Setter Property="Foreground" Value="#F5D042" />
                                                                    <Setter Property="BorderBrush" Value="#F5D042" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NarrowWidthConverter}}" Value="True">
                                                                    <Setter Property="Width" Value="26" />
                                                                    <Setter Property="Height" Value="26" />
                                                                    <Setter Property="Padding" Value="0" />
                                                                    <Setter Property="FontSize" Value="13" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Grid Grid.Column="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Background="#DC2626"
                                                            CornerRadius="4"
                                                            Padding="4,2"
                                                            Margin="0,0,4,0"
                                                            VerticalAlignment="Center"
                                                            ToolTip="1st Singer in Rotation (Round Start)"
                                                            Visibility="{Binding IsRotationStart, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="🚩 1st" FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBox
                                                    Grid.Column="1"
                                                    x:Name="SingerNameInput"
                                                    Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                    GotKeyboardFocus="SingerNameTextBox_GotKeyboardFocus"
                                                    PreviewMouseLeftButtonDown="SingerNameTextBox_PreviewMouseLeftButtonDown"
                                                    TextChanged="SingerNameTextBox_TextChanged"
                                                    PreviewKeyDown="SingerNameTextBox_PreviewKeyDown"
                                                    LostFocus="SingerNameTextBox_LostFocus">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox" BasedOn="{StaticResource GridTextBoxStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMusic}" Value="True">
                                                                        <Setter Property="Foreground" Value="#2ECC71" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                    <Popup
                                                     x:Name="SuggestionsPopup"
                                                     IsOpen="False"
                                                     Placement="Bottom"
                                                     PlacementTarget="{Binding ElementName=SingerNameInput}"
                                                     StaysOpen="False"
                                                     AllowsTransparency="False"
                                                     Focusable="False"
                                                     Width="220"
                                                     PopupAnimation="None">
                                                        <Border Background="{DynamicResource MaterialDesignPaper}"
                                                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                MaxHeight="200">
                                                            <ListBox
                                                            x:Name="SuggestionsList"
                                                            ItemsSource="{Binding DataContext.FilteredSingers, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            SelectionChanged="SuggestionsList_SelectionChanged"
                                                            PreviewKeyDown="SuggestionsList_PreviewKeyDown"
                                                            PreviewMouseLeftButtonDown="SuggestionsList_PreviewMouseLeftButtonDown"
                                                            Focusable="True"
                                                            BorderThickness="0">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding}" Padding="8,4" />
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                        </Border>
                                                    </Popup>
                                                </Grid>

                                                <TextBox Text="{Binding DuetPartnerName, UpdateSourceTrigger=LostFocus}" Grid.Column="2">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource GridTextBoxStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMusic}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                    <Setter Property="Opacity" Value="0.3" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>

                                                <TextBox Text="{Binding Song, UpdateSourceTrigger=LostFocus}" Grid.Column="3">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource GridTextBoxStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMusic}" Value="True">
                                                                    <Setter Property="Foreground" Value="#2ECC71" />
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <TextBox Text="{Binding Artist, UpdateSourceTrigger=LostFocus}" Grid.Column="4">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource GridTextBoxStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMusic}" Value="True">
                                                                    <Setter Property="Foreground" Value="#2ECC71" />
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Grid>

                                            <!-- Row 1: Round Checkboxes & Row Actions.
                                                 Wide layout: checkboxes (left) and action buttons (right) share this one row.
                                                 Vertical mode (list narrower than 700px): checkboxes take the full row, and action
                                                 buttons drop to their own row below — giving the 3-row layout (Name+badge / checkboxes / buttons). -->
                                            <Grid Grid.Row="1" Margin="38,6,4,2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Round Checkboxes Row -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Grid.Row" Value="0" />
                                                            <Setter Property="Grid.Column" Value="0" />
                                                            <Setter Property="Grid.ColumnSpan" Value="1" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NarrowWidthConverter}}" Value="True">
                                                                    <Setter Property="Grid.ColumnSpan" Value="2" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="Rounds:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <CheckBox IsChecked="{Binding Song1Completed}" Foreground="#E74C3C" ToolTip="Round 1 Completed" Margin="0,0,6,0" />
                                                    <CheckBox IsChecked="{Binding Song2Completed}" Foreground="#E67E22" ToolTip="Round 2 Completed" Margin="0,0,6,0" />
                                                    <CheckBox IsChecked="{Binding Song3Completed}" Foreground="#F1C40F" ToolTip="Round 3 Completed" Margin="0,0,6,0" />
                                                    <CheckBox IsChecked="{Binding Song4Completed}" Foreground="#2ECC71" ToolTip="Round 4 Completed" Margin="0,0,6,0" />
                                                    <CheckBox IsChecked="{Binding Song5Completed}" Foreground="#1ABC9C" ToolTip="Round 5 Completed" Margin="0,0,6,0" />
                                                    <CheckBox IsChecked="{Binding Song6Completed}" Foreground="#3498DB" ToolTip="Round 6 Completed" Margin="0,0,6,0" />
                                                    <CheckBox IsChecked="{Binding Song7Completed}" Foreground="#9B59B6" ToolTip="Round 7 Completed" Margin="0,0,6,0" />
                                                    <CheckBox IsChecked="{Binding Song8Completed}" Foreground="#FF1493" ToolTip="Round 8 Completed" Margin="0,0,6,0" />
                                                    <CheckBox IsChecked="{Binding Song9Completed}" Foreground="#00E5FF" ToolTip="Round 9 Completed" Margin="0,0,6,0" />
                                                    <CheckBox IsChecked="{Binding Song10Completed}" Foreground="#E040FB" ToolTip="Round 10 Completed" Margin="0,0,6,0" />

                                                    <!-- Background Music Overlay to hide CheckBoxes -->
                                                    <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMusic}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="♪ Background Music Track" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#2ECC71" FontStyle="Italic" FontWeight="Bold" FontSize="11" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- Action Buttons Row -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Grid.Row" Value="0" />
                                                            <Setter Property="Grid.Column" Value="1" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NarrowWidthConverter}}" Value="True">
                                                                    <Setter Property="Grid.Row" Value="1" />
                                                                    <Setter Property="Grid.Column" Value="0" />
                                                                    <Setter Property="Margin" Value="0,6,0,0" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Button Content="✓ Finish"
                                                            Command="{Binding DataContext.FinishSingerSongCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="0,0,6,0"
                                                            Padding="10,2"
                                                            ToolTip="Finish current song and advance rotation">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource GridButtonStyle}">
                                                                <Setter Property="MinWidth" Value="72" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsInactive}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <Button Content="▲"
                                                            Style="{StaticResource GridButtonStyle}"
                                                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}"
                                                            Width="32"
                                                            Margin="0,0,4,0"
                                                            ToolTip="Move Singer Up" />

                                                    <Button Content="▼"
                                                            Style="{StaticResource GridButtonStyle}"
                                                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}"
                                                            Width="32"
                                                            ToolTip="Move Singer Down" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button
                            Content="Add Singer"
                            Style="{StaticResource ModernButtonStyle}"
                            Command="{Binding AddSingerCommand}"
                            Click="AddSingerButton_Click"
                            Width="120"
                            Margin="0,0,12,0" />
                            <Button
                            Content="Save Rotation"
                            Style="{StaticResource ModernSecondaryButtonStyle}"
                            Command="{Binding SaveRotationCommand}"
                            Width="130"
                            ToolTip="Save the night's rotation report to file and optionally email it" />
                            <Button
                            Content="Clear Rotation"
                            Style="{StaticResource ModernSecondaryButtonStyle}"
                            Command="{Binding ClearRotationCommand}"
                            Width="130"
                            Margin="12,0,0,0"
                            ToolTip="Clear the entire rotation list" />
                        </StackPanel>
                    </Grid>

                    <!-- Right: Incoming Requests Sidebar.
                         Wide layout: sits beside the rotation list in Column 1, fixed 360px wide.
                         Vertical/tablet mode (window narrower than 1050px): drops below the rotation
                         list in Row 1, spanning the full width, with a fixed height since its own
                         Height="*" incoming-requests row needs a bounded parent to render into. -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.Column" Value="1" />
                                <Setter Property="Width" Value="360" />
                                <Setter Property="Margin" Value="8,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NarrowWidthConverter}}" Value="True">
                                        <Setter Property="Grid.Row" Value="1" />
                                        <Setter Property="Grid.Column" Value="0" />
                                        <Setter Property="Width" Value="NaN" />
                                        <Setter Property="Height" Value="320" />
                                        <Setter Property="Margin" Value="0,16,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header & Connection Info -->
                        <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock FontWeight="Bold"
                                                    FontSize="11"
                                                    Cursor="Hand"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Click to toggle DJ/Patron QR code mode"
                                                    PreviewMouseLeftButtonDown="OnPortalTitleClicked">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="PATRON WEB PORTAL" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AppHeaderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDjQrVisible}" Value="True">
                                                            <Setter Property="Text" Value="⚠️ DJ CONTROL PORTAL" />
                                                            <Setter Property="Foreground" Value="#EF4444" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button HorizontalAlignment="Right"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Padding="6,1"
                                                Height="20"
                                                BorderThickness="0.8"
                                                BorderBrush="#8B5CF6"
                                                Foreground="#8B5CF6"
                                                Click="OnKioskQrCodeButtonClicked"
                                                ToolTip="Open Tablet Kiosk QR Code and Link">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Tablet" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                <TextBlock Text="Kiosk" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock FontSize="11"
                                                Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                Margin="0,0,0,4">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Connect to local Wi-Fi, then visit:" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDjQrVisible}" Value="True">
                                                        <Setter Property="Text" Value="DJ ONLY: Remote dashboard login URL" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox FontWeight="SemiBold"
                                              FontSize="15"
                                              IsReadOnly="True"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              Padding="0"
                                              HorizontalAlignment="Left">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Setter Property="Text" Value="{Binding ConnectionUrl, Mode=OneWay}" />
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDjQrVisible}" Value="True">
                                                        <Setter Property="Text" Value="{Binding DjConnectionUrl, Mode=OneWay}" />
                                                        <Setter Property="Foreground" Value="#EF4444" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <TextBlock Margin="0,6,0,0"
                                                FontSize="11"
                                                Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDjQrVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                         <Run Text="DJ PIN (give to DJ only): " />
                                         <Run Text="{Binding DjPin, Mode=OneWay}"
                                              FontWeight="Bold"
                                              FontSize="14"
                                              Foreground="#EF4444" />
                                    </TextBlock>
                                </StackPanel>

                                <Border Grid.Column="1"
                                         Width="80"
                                         Height="80"
                                         Margin="12,0,0,0"
                                         Background="White"
                                         CornerRadius="4"
                                         Padding="2"
                                         VerticalAlignment="Center"
                                         PreviewMouseLeftButtonDown="OnQrCodeBorderClicked">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDjQrVisible}" Value="True">
                                                    <Setter Property="BorderThickness" Value="2.5" />
                                                    <Setter Property="BorderBrush" Value="#EF4444" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Setter Property="ToolTip" Value="Click to open enlarged DJ Remote Control QR Code &amp; PIN" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Image Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Source" Value="{Binding QrCodeImage}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDjQrVisible}" Value="True">
                                                        <Setter Property="Source" Value="{Binding DjQrCodeImage}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Incoming Requests List -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,4,0,8" HorizontalAlignment="Left" Width="328">
                                <TextBlock Text="Incoming Requests"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="{DynamicResource AppHeaderBrush}"
                                           VerticalAlignment="Center" Margin="0,0,37,0" />
                                <materialDesign:Badged Badge="{Binding IncomingRequests.Count}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                            </Grid>

                            <CheckBox Grid.Row="1"
                                      Content="Auto-accept incoming requests"
                                      IsChecked="{Binding AutoAcceptRequests, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource ModernCheckBoxStyle}"
                                      FontSize="12"
                                      Margin="0,0,0,8"
                                      ToolTip="When checked, patron requests are added straight to the rotation instead of waiting here for DJ approval." />

                            <Border Grid.Row="2"
                                    Background="{DynamicResource MaterialDesignCardBackground}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8">
                                <Grid>
                                    <!-- Empty State view -->
                                    <TextBlock Text="No requests pending."
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IncomingRequests.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- ListView of Requests -->
                                    <ListView ItemsSource="{Binding IncomingRequests}"
                                              HorizontalContentAlignment="Stretch"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.Style>
                                            <Style TargetType="ListView" BasedOn="{StaticResource {x:Type ListView}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IncomingRequests.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListView.Style>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding DuetPartnerName, StringFormat=' (with {0})'}" FontWeight="Normal" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DuetPartnerName}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding DuetPartnerName}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <!-- Music Badge -->
                                                            <Border CornerRadius="3" Background="#2ECC71" Margin="6,0,0,0" Padding="4,2" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RequestType}" Value="Music">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
