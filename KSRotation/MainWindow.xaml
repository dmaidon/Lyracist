                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <TextBox
                                     Grid.Row="2"
                                     Text="{Binding NewVenueName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8"
                                     ToolTip="Type a new venue name"
                                     Style="{StaticResource ModernTextBoxStyle}" />

                            <StackPanel Grid.Row="3" Orientation="Horizontal">
                                <Button
                                         Content="Add Venue"
                                         Command="{Binding AddVenueCommand}"
                                         Width="110"
                                         Margin="0,0,8,0"
                                         Style="{StaticResource ModernButtonStyle}" />
                                <Button
                                         Content="Remove"
                                         Command="{Binding RemoveVenueCommand}"
                                         Width="90"
                                         Style="{StaticResource ModernSecondaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- DJ Names in the 3rd column -->
                    <GroupBox Header="DJ Names"
                                  Style="{StaticResource PurpleSettingsGroupBoxStyle}"
                                  Grid.Column="2"
                                  Grid.Row="1"
                                  Grid.RowSpan="2"
                                  Margin="15,0,0,12" d:LayoutOverrides="LeftMargin, RightMargin, TopMargin, BottomMargin">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Active DJ Label -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,8">
                                <TextBlock Text="Active DJ: " FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="13" />
                                <TextBlock Text="{Binding DjName}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}" FontSize="13" />
                            </StackPanel>

                            <ListBox x:Name="LbDjs"
                                         Grid.Row="1"
                                         ItemsSource="{Binding Djs}"
                                         SelectedItem="{Binding SelectedDj, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,8"
                                         BorderThickness="1"
                                         BorderBrush="{DynamicResource MaterialDesignDivider}"
                                         Background="{DynamicResource MaterialDesignCardBackground}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         Padding="4" IsTabStop="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Path Data="M12,2A3,3 0 0,0 9,5V11A3,3 0 0,0 12,14A3,3 0 0,0 15,11V5A3,3 0 0,0 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z"
                                                       Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       Width="14" Height="14"
                                                       Stretch="Uniform"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1"
                                                            Text="{Binding}"
                                                            FontSize="14"
                                                            VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="Medium" />
                                                        <Setter Property="Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Path Grid.Column="2"
                                                       Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                                       Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       Width="14" Height="14"
                                                       Stretch="Uniform"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,4,0">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,6" />
                                        <Setter Property="Margin" Value="0,1" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd"
                                                                 Background="{TemplateBinding Background}"
                                                                 BorderThickness="0"
                                                                 CornerRadius="6"
                                                                 Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHueMidBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AppContrastTextBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaterialDesignDivider}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <TextBox
                                     Grid.Row="2"
                                     Text="{Binding NewDjName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8"
                                     ToolTip="Type a new DJ name"
                                     Style="{StaticResource ModernTextBoxStyle}" />

                            <StackPanel Grid.Row="3" Orientation="Horizontal">
                                <Button
                                         Content="Add DJ"
                                         Command="{Binding AddDjCommand}"
                                         Width="110"
                                         Margin="0,0,8,10"
                                         Style="{StaticResource ModernButtonStyle}" />
                                <Button
                                         Content="Remove"
                                         Command="{Binding RemoveDjCommand}"
                                         Width="90"
                                           Margin="0,0,8,10"
                                         Style="{StaticResource ModernSecondaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Network IP Setup"
                                  Style="{StaticResource NavySettingsGroupBoxStyle}"
                                  Grid.Column="3"
                                  Grid.Row="1"
                                  Margin="15,0,0,2" d:LayoutOverrides="LeftMargin, RightMargin, TopMargin, BottomMargin">
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Text="Manual Portal IPv4 (Optional)" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                            <TextBox
                                    Text="{Binding PreferredHostIp, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,0,0,8"
                                    ToolTip="Example: 192.168.50.20"
                                    Style="{StaticResource ModernTextBoxStyle}" />
                            <TextBlock Text="Leave blank to auto-detect the local IPv4 address. Use this field when you want a fixed travel-router IP in the displayed URL and QR code."
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}" />
                        </StackPanel>
                    </GroupBox>

                    <!-- Appearance Settings in the 2nd column -->
                    <GroupBox Header="Appearance"
                              Style="{StaticResource BlueSettingsGroupBoxStyle}"
                              Grid.Column="1"
                              Grid.Row="1"
                              Grid.RowSpan="3"
                              Margin="15,0,0,12">
                        <StackPanel Margin="0,4,0,0">
                            <!-- Theme -->
                            <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                            <ComboBox
                                    Width="120" HorizontalAlignment="Left"
                                    ItemsSource="{Binding Themes}"
                                    SelectedItem="{Binding SelectedTheme, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource ModernComboBoxStyle}"
                                    Margin="0,0,0,12" />

                            <!-- Banner Text -->
                            <TextBlock Text="Banner Text" FontWeight="SemiBold" Margin="0,4,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                            <TextBox
                                    Text="{Binding BannerText, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,0,0,12"
                                    Style="{StaticResource ModernTextBoxStyle}" />

                            <!-- Star Wars Crawl Text -->
                            <TextBlock Text="Star Wars Crawl Text" FontWeight="SemiBold" Margin="0,4,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                            <TextBox
                                    Text="{Binding CrawlBannerText, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap" Height="120"
                                    Margin="0,0,0,12"
                                    Style="{StaticResource ModernTextBoxStyle}" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" />

