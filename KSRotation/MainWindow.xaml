<!-- Edited on Oct 2, 2026 @ 12:56:00 -> Add Center Face button to Users avatar actions -->
<Window x:Name="FrmMain"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    x:Class="KSRotation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:KSRotation.Converters"
        xmlns:vm="clr-namespace:KSRotation.ViewModels"
        mc:Ignorable="d"
    Title="{Binding WindowTitle}"
    Width="1500"
    Height="800"
    d:DesignWidth="1500"
    d:DesignHeight="800"
    Background="{DynamicResource MaterialDesignPaper}"
    Foreground="{DynamicResource AppContrastTextBrush}"
    Icon="/mic_64.png" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <!-- Drives the rotation list's "vertical mode" 3-row layout — true when the list is narrower
             than 700px (e.g. window resized tall and thin, or a portrait tablet). -->
        <converters:NarrowWidthToBooleanConverter x:Key="NarrowWidthConverter" />
        <!-- Custom text box style inside ListView rows to ensure perfect contrast and theme syncing -->
        <Style x:Key="GridTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
            <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource AppContrastTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AppContrastTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center" Margin="2,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AppContrastTextBrush}" />
                    <Setter Property="BorderBrush" Value="#80FFFFFF" />
                    <Setter Property="Background" Value="#33FFFFFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNext}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AppContrastTextBrush}" />
                    <Setter Property="BorderBrush" Value="#80FFFFFF" />
                    <Setter Property="Background" Value="#33FFFFFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInactive}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Opacity" Value="0.6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Gold highlight for the currently-singing row and context menu -->
        <Style x:Key="CurrentSingerRowStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0,1,0,1" />
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="Toggle Active/Inactive"
                                  Command="{Binding Path=PlacementTarget.Tag.ToggleSingerInactiveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="Set as Current Singer"
                                  Command="{Binding Path=PlacementTarget.Tag.SetCurrentSingerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Command="{Binding Path=PlacementTarget.Tag.SetRotationStartSingerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="Set as Rotation Anchor" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=PlacementTarget.DataContext.IsRotationStart, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                            <Setter Property="Header" Value="Clear Rotation Anchor" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <MenuItem Header="Finish Current Song"
                                  Command="{Binding Path=PlacementTarget.Tag.FinishSingerSongCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Command="{Binding Path=PlacementTarget.Tag.ToggleSkipSingerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="⏭ Skip Singer (This Round)" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=PlacementTarget.DataContext.IsSkipped, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                            <Setter Property="Header" Value="▶ Unskip Singer" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <MenuItem Command="{Binding Path=PlacementTarget.Tag.ToggleSpecialSingerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="⭐ Mark as Special (One-Time)" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=PlacementTarget.DataContext.IsSpecial, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                            <Setter Property="Header" Value="⭐ Clear Special Status" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Move Up"
                                  Command="{Binding Path=PlacementTarget.Tag.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Move Down"
                                  Command="{Binding Path=PlacementTarget.Tag.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem ToolTip="Linked singers always stay adjacent in the rotation - no other singer can be inserted between them"
                                  Command="{Binding Path=PlacementTarget.Tag.ToggleLinkSingerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="🔗 Link With Another Singer" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=PlacementTarget.DataContext.IsLinked, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                            <Setter Property="Header" Value="🔗 Unlink Singer" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Remove Singer Permanently"
                                  Command="{Binding Path=PlacementTarget.Tag.RemoveSingerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="👤 Edit Performer Profile"
                                  Command="{Binding Path=PlacementTarget.Tag.EditSingerProfileFromRotationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Lowest priority: Rotation Anchor red tint, overridden below by Next (green) / Current (amber) -->
                <DataTrigger Binding="{Binding IsRotationStart}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppRotationStartBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AppContrastTextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNext}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppNextSingerBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AppContrastTextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppCurrentSingerBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AppContrastTextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInactive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MaterialDesignDivider}" />
                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
                    <Setter Property="FontStyle" Value="Italic" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                    <Setter Property="Opacity" Value="0.65" />
                    <Setter Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource AppContrastTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AppContrastTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Padding="{TemplateBinding Padding}"
                                              SnapsToDevicePixels="True" />
                                <TextBlock x:Name="PART_Placeholder"
                                           Text="{Binding Path=(materialDesign:HintAssist.Hint), RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           Opacity="0.55"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           Margin="{TemplateBinding Padding}"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value="" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="PART_Placeholder" Property="Visibility" Value="Visible" />
                            </MultiTrigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="PART_Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="AcceptsReturn" Value="True">
                                <Setter Property="VerticalContentAlignment" Value="Top" />
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ModernSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppSecondaryButtonBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryButtonForegroundBrush}" />
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Foreground" Value="{DynamicResource AppContrastTextBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AppContrastTextBrush}" />
        </Style>

        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource AppContrastTextBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AppContrastTextBrush}" />
        </Style>

        <!-- Compact TextBox style with clean vertical centering for small inputs (28px height) -->
        <Style x:Key="ModernCompactTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource AppContrastTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AppContrastTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center"
                                          Padding="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom button style inside ListView rows to ensure perfect sizing and selection contrast -->
        <Style x:Key="GridButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppSecondaryButtonBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryButtonForegroundBrush}" />
        </Style>

        <!-- Purple GroupBox theme (Rotation, DJ, Venues) -->
        <LinearGradientBrush x:Key="PurpleGroupBoxHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7B3FA8" Offset="0.0" />
            <GradientStop Color="#4A5AB8" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PurpleGroupBoxBodyBrush" Color="#127B3FA8" />
        <SolidColorBrush x:Key="PurpleGroupBoxBorderBrush" Color="#557B3FA8" />

        <Style x:Key="PurpleSettingsGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource PurpleGroupBoxBorderBrush}"
                                Background="{DynamicResource MaterialDesignCardBackground}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="{StaticResource PurpleGroupBoxHeaderBrush}"
                                        CornerRadius="7,7,0,0"
                                        Padding="14,9">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                </Border>
                                <Border Grid.Row="1"
                                        Background="{StaticResource PurpleGroupBoxBodyBrush}"
                                        Padding="{TemplateBinding Padding}"
                                        CornerRadius="0,0,7,7">
                                    <ContentPresenter />
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Blue GroupBox theme (Theme, Displays, Projection, Banners) -->
        <LinearGradientBrush x:Key="BlueGroupBoxHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00A6E0" Offset="0.0" />
            <GradientStop Color="#0072ff" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BlueGroupBoxBodyBrush" Color="#1200c6ff" />
        <SolidColorBrush x:Key="BlueGroupBoxBorderBrush" Color="#550072ff" />

        <Style x:Key="BlueSettingsGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BlueGroupBoxBorderBrush}"
                                Background="{DynamicResource MaterialDesignCardBackground}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="{StaticResource BlueGroupBoxHeaderBrush}"
                                        CornerRadius="7,7,0,0"
                                        Padding="14,9">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                </Border>
                                <Border Grid.Row="1"
                                        Background="{StaticResource BlueGroupBoxBodyBrush}"
                                        Padding="14"
                                        CornerRadius="0,0,7,7">
                                    <ContentPresenter />
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Green GroupBox theme (Connect & Request Instructions) -->
        <LinearGradientBrush x:Key="GreenGroupBoxHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#059669" Offset="0.0" />
            <GradientStop Color="#047857" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="GreenGroupBoxBodyBrush" Color="#12059669" />
        <SolidColorBrush x:Key="GreenGroupBoxBorderBrush" Color="#5510B981" />

        <Style x:Key="GreenSettingsGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource GreenGroupBoxBorderBrush}"
                                Background="{DynamicResource MaterialDesignCardBackground}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="{StaticResource GreenGroupBoxHeaderBrush}"
                                        CornerRadius="7,7,0,0"
                                        Padding="14,9">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                </Border>
                                <Border Grid.Row="1"
                                        Background="{StaticResource GreenGroupBoxBodyBrush}"
                                        Padding="14"
                                        CornerRadius="0,0,7,7">
                                    <ContentPresenter />
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navy GroupBox theme (Network IP, Server/IP Setup) -->
        <LinearGradientBrush x:Key="NavyGroupBoxHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#3a7bd5" Offset="0.0" />
            <GradientStop Color="#3a6073" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="NavyGroupBoxBodyBrush" Color="#123a7bd5" />
        <SolidColorBrush x:Key="NavyGroupBoxBorderBrush" Color="#553a7bd5" />

        <Style x:Key="NavySettingsGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="12,6,12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource NavyGroupBoxBorderBrush}"
                                Background="{DynamicResource MaterialDesignCardBackground}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="{StaticResource NavyGroupBoxHeaderBrush}"
                                        CornerRadius="7,7,0,0"
                                        Padding="12,6">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                </Border>
                                <Border Grid.Row="1"
                                        Background="{StaticResource NavyGroupBoxBodyBrush}"
                                        Padding="{TemplateBinding Padding}"
                                        CornerRadius="0,0,7,7">
                                    <ContentPresenter />
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slate GroupBox theme (Email Settings, Security) -->
        <LinearGradientBrush x:Key="SlateGroupBoxHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#708090" Offset="0.0" />
            <GradientStop Color="#4f5d73" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="SlateGroupBoxBodyBrush" Color="#12708090" />
        <SolidColorBrush x:Key="SlateGroupBoxBorderBrush" Color="#55708090" />

        <Style x:Key="SlateSettingsGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="12,6,12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource SlateGroupBoxBorderBrush}"
                                Background="{DynamicResource MaterialDesignCardBackground}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="{StaticResource SlateGroupBoxHeaderBrush}"
                                        CornerRadius="7,7,0,0"
                                        Padding="12,6">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                </Border>
                                <Border Grid.Row="1"
                                        Background="{StaticResource SlateGroupBoxBodyBrush}"
                                        Padding="{TemplateBinding Padding}"
                                        CornerRadius="0,0,7,7">
                                    <ContentPresenter />
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom TabControl style to show borders/outlines around the content panel -->
        <Style x:Key="BorderedTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local"
                              ClipToBounds="true"
                              SnapsToDevicePixels="true">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ColumnDefinition0" />
                                <ColumnDefinition x:Name="ColumnDefinition1" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="RowDefinition0" Height="Auto" />
                                <RowDefinition x:Name="RowDefinition1" Height="*" />
                            </Grid.RowDefinitions>
                            <!-- Tab Headers panel -->
                            <TabPanel x:Name="HeaderPanel"
                                      Grid.Row="0"
                                      Grid.Column="0"
                                      IsItemsHost="true"
                                      Panel.ZIndex="1"
                                      KeyboardNavigation.TabNavigation="Once" />
                            <!-- Outlined/Bordered Content Area -->
                            <Border x:Name="ContentPanel"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="true">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="{TemplateBinding Padding}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <TabControl x:Name="Tc" SelectedIndex="{Binding SelectedMainTabIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="2" BorderBrush="{DynamicResource AppHeaderBrush}" Style="{StaticResource BorderedTabControlStyle}">
            <TabControl.Resources>
                <!-- Align the tab headers panel to the left so they sit next to each other without stretching -->
                <Style TargetType="TabPanel">
                    <Setter Property="HorizontalAlignment" Value="Left" />
                </Style>
            </TabControl.Resources>
            <TabItem Header="Rotation" Width="80" Height="45">
                <Grid Margin="12">
                    <!-- Row 1 only holds content in vertical/tablet mode, when the sidebar below stacks
                         under the rotation list instead of sitting beside it in Column 1. It's Auto-height
                         so it collapses to nothing when unused in the normal wide layout. -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Grid.IsSharedSizeScope="True" Margin="0,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,12" Orientation="Horizontal">
                            <CheckBox
                            Content="Enable Display Window"
                            IsChecked="{Binding IsDisplayEnabled}"
                            Style="{StaticResource ModernCheckBoxStyle}"
                            FontSize="16"
                            Margin="0,0,24,0" />
                            <CheckBox
                            Content="Float Current to Top"
                            IsChecked="{Binding FloatCurrentSingerToTop}"
                            Style="{StaticResource ModernCheckBoxStyle}"
                            FontSize="16"
                            Margin="0,0,24,0"
                            ToolTip="When checked, the current singer always floats to the top of the rotation list." />
                            <ComboBox
                            Width="180"
                            Margin="0,0,24,0"
                            materialDesign:HintAssist.Hint="Projection View"
                            Style="{StaticResource ModernComboBoxStyle}"
                            ItemsSource="{Binding ProjectionViews}"
                            SelectedItem="{Binding SelectedProjectionView}"
                            FontSize="14"
                            VerticalAlignment="Center" />
                            <TextBlock
                            Text="Singers in Rotation:"
                            FontSize="16"
                            VerticalAlignment="Center"
                            Margin="24,0,8,0"
                            Foreground="{DynamicResource MaterialDesignBody}" />
                            <TextBox
                            Text="{Binding SingersInRotationCount, Mode=OneWay}"
                            IsReadOnly="True"
                            Width="50"
                            FontSize="16"
                            TextAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource ModernTextBoxStyle}"
                            Focusable="False" />
                            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                    BorderBrush="{DynamicResource AppHeaderBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    Margin="24,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Estimated time to complete current round, projected completion time, and full round duration">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⏱️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding RoundEstimateNoticeText}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBody}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <TextBlock
                            Text="Theme:"
                            FontSize="16"
                            VerticalAlignment="Center"
                            Margin="24,0,8,0"
                            Foreground="{DynamicResource MaterialDesignBody}" />
                            <ComboBox
                            Width="110"
                            ItemsSource="{Binding Themes}"
                            SelectedItem="{Binding SelectedTheme, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource ModernComboBoxStyle}"
                            FontSize="14"
                            VerticalAlignment="Center" />
                        </WrapPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="col0" MinWidth="34" />
                                <ColumnDefinition Width="2*" SharedSizeGroup="col1" MinWidth="110" />
                                <ColumnDefinition Width="1.8*" SharedSizeGroup="colDuet" MinWidth="95" />
                                <ColumnDefinition Width="2.5*" SharedSizeGroup="col2" MinWidth="140" />
                                <ColumnDefinition Width="2.5*" SharedSizeGroup="col3" MinWidth="140" />
                            </Grid.ColumnDefinitions>

                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AppHeaderBrush}" />
                                </Style>
                            </Grid.Resources>

                            <TextBlock Text="★" FontWeight="SemiBold" HorizontalAlignment="Center" ToolTip="Set current singer" />
                            <TextBlock Grid.Column="1" Text="Singer" FontWeight="SemiBold" Margin="4,0,0,0" />
                            <TextBlock Grid.Column="2" Text="Duet Partner" FontWeight="SemiBold" Margin="4,0,0,0" />
                            <TextBlock Grid.Column="3" Text="Song" FontWeight="SemiBold" Margin="4,0,0,0" />
                            <TextBlock Grid.Column="4" Text="Artist" FontWeight="SemiBold" Margin="4,0,0,0" />
                        </Grid>

                        <ListView
                        x:Name="SingersListView"
                        Grid.Row="2"
                        ItemsSource="{Binding Singers}"
                        ItemContainerStyle="{StaticResource CurrentSingerRowStyle}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        HorizontalContentAlignment="Stretch"
                        UseLayoutRounding="True"
                        SnapsToDevicePixels="True"
                        Margin="0,8,0,8">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="2,6,2,10" MinHeight="80">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Row 0: Identity & Song Inputs -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="col0" MinWidth="34" />
                                                    <ColumnDefinition Width="2*" SharedSizeGroup="col1" MinWidth="110" />
                                                    <ColumnDefinition Width="1.8*" SharedSizeGroup="colDuet" MinWidth="95" />
                                                    <ColumnDefinition Width="2.5*" SharedSizeGroup="col2" MinWidth="140" />
                                                    <ColumnDefinition Width="2.5*" SharedSizeGroup="col3" MinWidth="140" />
                                                </Grid.ColumnDefinitions>

                                                <Button
                                                Command="{Binding DataContext.SetCurrentSingerCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"
                                                Grid.Column="0"
                                                Margin="2"
                                                ToolTip="Set as current singer">
                                                    <!-- In vertical mode this reads as a small badge next to the Name field rather than a
                                                         full-size column button, even though it stays structurally in its own column. -->
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource GridButtonStyle}">
                                                            <Setter Property="Content" Value="☆" />
                                                            <Setter Property="Foreground" Value="#888888" />
                                                            <Setter Property="FontSize" Value="14" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Content" Value="★" />
                                                                    <Setter Property="Foreground" Value="#F5D042" />
                                                                    <Setter Property="BorderBrush" Value="#F5D042" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NarrowWidthConverter}}" Value="True">
                                                                    <Setter Property="Width" Value="26" />
                                                                    <Setter Property="Height" Value="26" />
                                                                    <Setter Property="Padding" Value="0" />
                                                                    <Setter Property="FontSize" Value="13" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Grid Grid.Column="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <Border Background="#DC2626"
                                                                CornerRadius="4"
                                                                Padding="4,2"
                                                                Margin="0,0,4,0"
                                                                VerticalAlignment="Center"
                                                                ToolTip="Rotation Anchor (marks where a round begins)"
                                                                Visibility="{Binding IsRotationStart, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="⚓ Anchor" FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Border Background="#5C1010"
                                                                CornerRadius="4"
                                                                Padding="4,2"
                                                                Margin="0,0,4,0"
                                                                VerticalAlignment="Center"
                                                                ToolTip="Singer has completed their song in the last round"
                                                                Visibility="{Binding HasSungInLastRound, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="DONE (LAST ROUND)" FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Border Background="#1E3A5F"
                                                                BorderBrush="#0EA5E9"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="4,2"
                                                                Margin="0,0,4,0"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding IsLinked, Converter={StaticResource BoolToVis}}"
                                                                ToolTip="{Binding LinkedPartnerName, StringFormat='Linked with {0} - always stays adjacent in the rotation'}">
                                                            <TextBlock Text="{Binding LinkedPartnerName, StringFormat='🔗 {0}'}" FontSize="10" FontWeight="Bold" Foreground="#0EA5E9" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Border Background="#D97706"
                                                                CornerRadius="4"
                                                                Padding="4,2"
                                                                Margin="0,0,4,0"
                                                                VerticalAlignment="Center"
                                                                ToolTip="Singer is skipped for this round"
                                                                Visibility="{Binding IsSkipped, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="⏭ SKIP" FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Border Background="#8B5CF6"
                                                                CornerRadius="4"
                                                                Padding="4,2"
                                                                Margin="0,0,4,0"
                                                                VerticalAlignment="Center"
                                                                ToolTip="Special one-time performer - will become inactive after singing"
                                                                Visibility="{Binding IsSpecial, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="⭐ SPECIAL" FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Border Background="#1E3A5F"
                                                                BorderBrush="#0EA5E9"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="4,2"
                                                                Margin="0,0,4,0"
                                                                VerticalAlignment="Center"
                                                                ToolTip="{Binding EstimatedWaitMinutes, StringFormat='Estimated wait: ~{0} min'}"
                                                                Visibility="{Binding HasEstimatedWait, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding EstimatedWaitMinutes, StringFormat='⏳ {0}m'}" FontSize="10" FontWeight="Bold" Foreground="#0EA5E9" VerticalAlignment="Center" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBox
                                                    Grid.Column="1"
                                                    x:Name="SingerNameInput"
                                                    Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                    GotKeyboardFocus="SingerNameTextBox_GotKeyboardFocus"
                                                    PreviewMouseLeftButtonDown="SingerNameTextBox_PreviewMouseLeftButtonDown"
                                                    TextChanged="SingerNameTextBox_TextChanged"
                                                    PreviewKeyDown="SingerNameTextBox_PreviewKeyDown"
                                                    LostFocus="SingerNameTextBox_LostFocus">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox" BasedOn="{StaticResource GridTextBoxStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMusic}" Value="True">
                                                                        <Setter Property="Foreground" Value="#2ECC71" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                    <Popup
                                                     x:Name="SuggestionsPopup"
                                                     IsOpen="False"
                                                     Placement="Bottom"
                                                     PlacementTarget="{Binding ElementName=SingerNameInput}"
                                                     StaysOpen="False"
                                                     AllowsTransparency="False"
                                                     Focusable="False"
                                                     Width="220"
                                                     PopupAnimation="None">
                                                        <Border Background="{DynamicResource MaterialDesignPaper}"
                                                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                MaxHeight="200">
                                                            <ListBox
                                                            x:Name="SuggestionsList"
                                                            ItemsSource="{Binding DataContext.FilteredSingers, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            SelectionChanged="SuggestionsList_SelectionChanged"
                                                            PreviewKeyDown="SuggestionsList_PreviewKeyDown"
                                                            PreviewMouseLeftButtonDown="SuggestionsList_PreviewMouseLeftButtonDown"
                                                            Focusable="True"
                                                            BorderThickness="0">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding}" Padding="8,4" />
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                        </Border>
                                                    </Popup>
                                                </Grid>

                                                <TextBox Text="{Binding DuetPartnerName, UpdateSourceTrigger=LostFocus}" Grid.Column="2">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource GridTextBoxStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMusic}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                    <Setter Property="Opacity" Value="0.3" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>

                                                <TextBox Text="{Binding Song, UpdateSourceTrigger=LostFocus}" Grid.Column="3">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource GridTextBoxStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMusic}" Value="True">
                                                                    <Setter Property="Foreground" Value="#2ECC71" />
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <TextBox Text="{Binding Artist, UpdateSourceTrigger=LostFocus}" Grid.Column="4">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource GridTextBoxStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMusic}" Value="True">
                                                                    <Setter Property="Foreground" Value="#2ECC71" />
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Grid>

                                            <!-- Row 1: Round Checkboxes & Row Actions.
                                                 Wide layout: checkboxes (left) and action buttons (right) share this one row.
                                                 Vertical mode (list narrower than 700px): checkboxes take the full row, and action
                                                 buttons drop to their own row below — giving the 3-row layout (Name+badge / checkboxes / buttons). -->
                                            <Grid Grid.Row="1" Margin="38,6,4,2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Round Checkboxes Row -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Grid.Row" Value="0" />
                                                            <Setter Property="Grid.Column" Value="0" />
                                                            <Setter Property="Grid.ColumnSpan" Value="1" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NarrowWidthConverter}}" Value="True">
                                                                    <Setter Property="Grid.ColumnSpan" Value="2" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="Rounds:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <CheckBox IsChecked="{Binding Song1Completed}" Foreground="#E74C3C" ToolTip="Round 1 Completed" Margin="0,0,6,0" />
                                                    <CheckBox IsChecked="{Binding Song2Completed}" Foreground="#E67E22" ToolTip="Round 2 Completed" Margin="0,0,6,0" />
                                                    <CheckBox IsChecked="{Binding Song3Completed}" Foreground="#F1C40F" ToolTip="Round 3 Completed" Margin="0,0,6,0" />
                                                    <CheckBox IsChecked="{Binding Song4Completed}" Foreground="#2ECC71" ToolTip="Round 4 Completed" Margin="0,0,6,0" />
                                                    <CheckBox IsChecked="{Binding Song5Completed}" Foreground="#1ABC9C" ToolTip="Round 5 Completed" Margin="0,0,6,0" />
                                                    <CheckBox IsChecked="{Binding Song6Completed}" Foreground="#3498DB" ToolTip="Round 6 Completed" Margin="0,0,6,0" />
                                                    <CheckBox IsChecked="{Binding Song7Completed}" Foreground="#9B59B6" ToolTip="Round 7 Completed" Margin="0,0,6,0" />
                                                    <CheckBox IsChecked="{Binding Song8Completed}" Foreground="#FF1493" ToolTip="Round 8 Completed" Margin="0,0,6,0" />
                                                    <CheckBox IsChecked="{Binding Song9Completed}" Foreground="#00E5FF" ToolTip="Round 9 Completed" Margin="0,0,6,0" />
                                                    <CheckBox IsChecked="{Binding Song10Completed}" Foreground="#E040FB" ToolTip="Round 10 Completed" Margin="0,0,6,0" />

                                                    <!-- Background Music Overlay to hide CheckBoxes -->
                                                    <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMusic}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="♪ Background Music Track" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#2ECC71" FontStyle="Italic" FontWeight="Bold" FontSize="11" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- Action Buttons Row -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Grid.Row" Value="0" />
                                                            <Setter Property="Grid.Column" Value="1" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NarrowWidthConverter}}" Value="True">
                                                                    <Setter Property="Grid.Row" Value="1" />
                                                                    <Setter Property="Grid.Column" Value="0" />
                                                                    <Setter Property="Margin" Value="0,6,0,0" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Button Content="✓ Finish"
                                                            Command="{Binding DataContext.FinishSingerSongCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="0,0,6,0"
                                                            Padding="10,2"
                                                            ToolTip="Finish current song and advance rotation">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource GridButtonStyle}">
                                                                <Setter Property="MinWidth" Value="72" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsInactive}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <Button Command="{Binding DataContext.ToggleSkipSingerCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="0,0,6,0"
                                                            Padding="8,2"
                                                            ToolTip="Skip or unskip singer for this round">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource GridButtonStyle}">
                                                                <Setter Property="Content" Value="⏭ Skip" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                                                        <Setter Property="Content" Value="▶ Unskip" />
                                                                        <Setter Property="Foreground" Value="#F59E0B" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsInactive}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <Button Content="▲"
                                                            Style="{StaticResource GridButtonStyle}"
                                                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}"
                                                            Width="32"
                                                            Margin="0,0,4,0"
                                                            ToolTip="Move Singer Up" />

                                                    <Button Content="▼"
                                                            Style="{StaticResource GridButtonStyle}"
                                                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}"
                                                            Width="32"
                                                            ToolTip="Move Singer Down" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button
                            Content="Add Singer"
                            Style="{StaticResource ModernButtonStyle}"
                            Command="{Binding AddSingerCommand}"
                            Click="AddSingerButton_Click"
                            Width="120"
                            Margin="0,0,12,0" />
                            <Button
                            Content="Add Special"
                            Style="{StaticResource ModernSecondaryButtonStyle}"
                            Command="{Binding AddSpecialSingerCommand}"
                            Click="AddSingerButton_Click"
                            Width="120"
                            Margin="0,0,12,0"
                            ToolTip="Add a special one-time singer who automatically becomes inactive after their performance" />
                            <Button
                            Content="Save Rotation"
                            Style="{StaticResource ModernSecondaryButtonStyle}"
                            Command="{Binding SaveRotationCommand}"
                            Width="130"
                            ToolTip="Save the night's rotation report to file and optionally email it" />
                            <Button
                            Content="Clear Rotation"
                            Style="{StaticResource ModernSecondaryButtonStyle}"
                            Command="{Binding ClearRotationCommand}"
                            Width="130"
                            Margin="12,0,0,0"
                            ToolTip="Clear the entire rotation list" />
                            <Button
                            Command="{Binding ToggleLastRoundCommand}"
                            Width="140"
                            Margin="12,0,0,0"
                            ToolTip="Toggle Last Round: announces that the last round of the night is underway and removes singers after they perform">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Setter Property="Margin" Value="0,4" />
                                        <Setter Property="FontSize" Value="14" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Content" Value="Last Round" />
                                        <Setter Property="Background" Value="#059669" />
                                        <Setter Property="BorderBrush" Value="#047857" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLastRound}" Value="True">
                                                <Setter Property="Content" Value="✓ Last Round" />
                                                <Setter Property="Background" Value="#2563EB" />
                                                <Setter Property="BorderBrush" Value="#1D4ED8" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.9" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Right: Incoming Requests Sidebar.
                         Wide layout: sits beside the rotation list in Column 1, fixed 360px wide.
                         Vertical/tablet mode (window narrower than 1050px): drops below the rotation
                         list in Row 1, spanning the full width, with a fixed height since its own
                         Height="*" incoming-requests row needs a bounded parent to render into. -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.Column" Value="1" />
                                <Setter Property="Width" Value="360" />
                                <Setter Property="Margin" Value="8,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NarrowWidthConverter}}" Value="True">
                                        <Setter Property="Grid.Row" Value="1" />
                                        <Setter Property="Grid.Column" Value="0" />
                                        <Setter Property="Width" Value="NaN" />
                                        <Setter Property="Height" Value="320" />
                                        <Setter Property="Margin" Value="0,16,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header & Connection Info -->
                        <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock FontWeight="Bold"
                                               FontSize="11"
                                               Cursor="Hand"
                                               VerticalAlignment="Center"
                                               ToolTip="Click to toggle DJ/Patron QR code mode"
                                               PreviewMouseLeftButtonDown="OnPortalTitleClicked"
                                               Margin="0,0,0,4">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="PATRON WEB PORTAL" />
                                                <Setter Property="Foreground" Value="{DynamicResource AppHeaderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDjQrVisible}" Value="True">
                                                        <Setter Property="Text" Value="⚠️ DJ CONTROL PORTAL" />
                                                        <Setter Property="Foreground" Value="#EF4444" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Padding="6,1"
                                                Height="20"
                                                BorderThickness="0.8"
                                                BorderBrush="#10B981"
                                                Foreground="#10B981"
                                                Click="OnDeviceHandoffButtonClicked"
                                                ToolTip="Switch Device / Transfer Session between Laptop and Tablet"
                                                Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="SwapHorizontalBold" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                <TextBlock Text="Switch Device" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Padding="6,1"
                                                Height="20"
                                                BorderThickness="0.8"
                                                BorderBrush="#8B5CF6"
                                                Foreground="#8B5CF6"
                                                Click="OnKioskQrCodeButtonClicked"
                                                ToolTip="Open Tablet Kiosk QR Code and Link">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Tablet" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                <TextBlock Text="Kiosk" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock FontSize="11"
                                                Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                Margin="0,0,0,4">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Connect to local Wi-Fi, then visit:" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDjQrVisible}" Value="True">
                                                        <Setter Property="Text" Value="DJ ONLY: Remote dashboard login URL" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox FontWeight="SemiBold"
                                              FontSize="15"
                                              IsReadOnly="True"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              Padding="0"
                                              HorizontalAlignment="Left">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Setter Property="Text" Value="{Binding ConnectionUrl, Mode=OneWay}" />
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDjQrVisible}" Value="True">
                                                        <Setter Property="Text" Value="{Binding DjConnectionUrl, Mode=OneWay}" />
                                                        <Setter Property="Foreground" Value="#EF4444" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <TextBlock Margin="0,6,0,0"
                                                FontSize="11"
                                                Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDjQrVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                         <Run Text="DJ PIN (give to DJ only): " />
                                         <Run Text="{Binding DjPin, Mode=OneWay}"
                                              FontWeight="Bold"
                                              FontSize="14"
                                              Foreground="#EF4444" />
                                    </TextBlock>
                                </StackPanel>

                                <Border Grid.Column="1"
                                         Width="80"
                                         Height="80"
                                         Margin="12,0,0,0"
                                         Background="White"
                                         CornerRadius="4"
                                         Padding="2"
                                         VerticalAlignment="Center"
                                         PreviewMouseLeftButtonDown="OnQrCodeBorderClicked">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDjQrVisible}" Value="True">
                                                    <Setter Property="BorderThickness" Value="2.5" />
                                                    <Setter Property="BorderBrush" Value="#EF4444" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Setter Property="ToolTip" Value="Click to open enlarged DJ Remote Control QR Code &amp; PIN" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Image Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Source" Value="{Binding QrCodeImage}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDjQrVisible}" Value="True">
                                                        <Setter Property="Source" Value="{Binding DjQrCodeImage}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Incoming Requests List -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,4,0,8" HorizontalAlignment="Left" Width="328">
                                <TextBlock Text="Incoming Requests"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="{DynamicResource AppHeaderBrush}"
                                           VerticalAlignment="Center" Margin="0,0,37,0" />
                                <materialDesign:Badged Badge="{Binding IncomingRequests.Count}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                            </Grid>

                            <CheckBox Grid.Row="1"
                                      Content="Auto-accept incoming requests"
                                      IsChecked="{Binding AutoAcceptRequests, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource ModernCheckBoxStyle}"
                                      FontSize="12"
                                      Margin="0,0,0,8"
                                      ToolTip="When checked, patron requests are added straight to the rotation instead of waiting here for DJ approval." />

                            <Border Grid.Row="2"
                                    Background="{DynamicResource MaterialDesignCardBackground}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8">
                                <Grid>
                                    <!-- Empty State view -->
                                    <TextBlock Text="No requests pending."
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IncomingRequests.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- ListView of Requests -->
                                    <ListView ItemsSource="{Binding IncomingRequests}"
                                              HorizontalContentAlignment="Stretch"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.Style>
                                            <Style TargetType="ListView" BasedOn="{StaticResource {x:Type ListView}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IncomingRequests.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListView.Style>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding DuetPartnerName, StringFormat=' (with {0})'}" FontWeight="Normal" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DuetPartnerName}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding DuetPartnerName}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <!-- Music Badge -->
                                                            <Border CornerRadius="3" Background="#2ECC71" Margin="6,0,0,0" Padding="4,2" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RequestType}" Value="Music">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="MUSIC" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                            </Border>
                                                            <!-- Karaoke Badge -->
                                                            <Border CornerRadius="3" Background="#9B59B6" Margin="6,0,0,0" Padding="4,2" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RequestType}" Value="Music">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="KARAOKE" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                            </Border>
                                                        </StackPanel>
                                                        <ItemsControl ItemsSource="{Binding Songs}" Margin="4,2,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" TextTrimming="CharacterEllipsis">
                                                                        <Run Text="•" />
                                                                        <Run Text="{Binding Song}" />
                                                                        <Run Text=" - " />
                                                                        <Run Text="{Binding Artist}" FontStyle="Italic" />
                                                                    </TextBlock>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <Button Content="✓"
                                                                ToolTip="Accept request and add to rotation"
                                                                Style="{StaticResource GridButtonStyle}"
                                                                Command="{Binding DataContext.AcceptRequestCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                CommandParameter="{Binding}"
                                                                Foreground="#2ECC71"
                                                                BorderBrush="#2ECC71"
                                                                Margin="2" />
                                                        <Button Content="X"
                                                                ToolTip="Decline and remove request"
                                                                Style="{StaticResource GridButtonStyle}"
                                                                Command="{Binding DataContext.DeclineRequestCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                CommandParameter="{Binding}"
                                                                Foreground="#E74C3C"
                                                                BorderBrush="#E74C3C"
                                                                Margin="2" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Settings" Width="50" Height="45" VerticalAlignment="Top" d:LayoutOverrides="Height">
                <Grid Margin="12" TextElement.Foreground="{DynamicResource AppContrastTextBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="222" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Venue Names in the 1st column -->
                    <GroupBox Header="Venue Names"
                                  Style="{StaticResource PurpleSettingsGroupBoxStyle}"
                                  Grid.Row="1"
                                  Grid.RowSpan="2"
                                  Margin="0,0,0,12">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Active Venue Label -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,8">
                                <TextBlock Text="Active Venue: " FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="13" />
                                <TextBlock Text="{Binding VenueName}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource AppHeaderBrush}" FontSize="13" />
                            </StackPanel>

                            <ListBox x:Name="LbVenues"
                                         Grid.Row="1"
                                         ItemsSource="{Binding Venues}"
                                         SelectedItem="{Binding SelectedVenue, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,8"
                                         BorderThickness="1"
                                         BorderBrush="{DynamicResource MaterialDesignDivider}"
                                         Background="{DynamicResource MaterialDesignCardBackground}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         Padding="4" IsTabStop="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Path Data="M12,2A7,7 0 0,0 5,9C5,14.25 12,22 12,22C12,22 19,14.25 19,9A7,7 0 0,0 12,2M12,6A3,3 0 0,1 15,9A3,3 0 0,1 12,12A3,3 0 0,1 9,9A3,3 0 0,1 12,6Z"
                                                       Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       Width="14" Height="14"
                                                       Stretch="Uniform"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1"
                                                            Text="{Binding}"
                                                            FontSize="14"
                                                            VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="Medium" />
                                                        <Setter Property="Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Path Grid.Column="2"
                                                       Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                                       Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       Width="14" Height="14"
                                                       Stretch="Uniform"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,4,0">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,6" />
                                        <Setter Property="Margin" Value="0,1" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd"
                                                                 Background="{TemplateBinding Background}"
                                                                 BorderThickness="0"
                                                                 CornerRadius="6"
                                                                 Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHueMidBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AppContrastTextBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaterialDesignDivider}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <TextBox
                                     Grid.Row="2"
                                     Text="{Binding NewVenueName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8"
                                     ToolTip="Type a new venue name"
                                     Style="{StaticResource ModernTextBoxStyle}" />

                            <StackPanel Grid.Row="3" Orientation="Horizontal">
                                <Button
                                         Content="Add Venue"
                                         Command="{Binding AddVenueCommand}"
                                         Width="100"
                                         Margin="0,0,6,0"
                                         Style="{StaticResource ModernButtonStyle}" />
                                <Button
                                         Content="Remove"
                                         Command="{Binding RemoveVenueCommand}"
                                         Width="85"
                                         Margin="0,0,6,0"
                                         Style="{StaticResource ModernSecondaryButtonStyle}" />
                                <Button
                                         Content="📍 Tag GPS"
                                         Command="{Binding TagCurrentLocationCommand}"
                                         Width="105"
                                         ToolTip="Tag current GPS coordinates to active venue for auto-retrieval"
                                         Style="{StaticResource ModernSecondaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- DJ Names in the 3rd column -->
                    <GroupBox Header="DJ Names"
                                  Style="{StaticResource PurpleSettingsGroupBoxStyle}"
                                  Grid.Column="2"
                                  Grid.Row="1"
                                  Grid.RowSpan="2"
                                  Margin="15,0,0,12">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Active DJ Label -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,8">
                                <TextBlock Text="Active DJ: " FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="13" />
                                <TextBlock Text="{Binding DjName}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource AppHeaderBrush}" FontSize="13" />
                            </StackPanel>

                            <ListBox x:Name="LbDjs"
                                         Grid.Row="1"
                                         ItemsSource="{Binding Djs}"
                                         SelectedItem="{Binding SelectedDj, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,8"
                                         BorderThickness="1"
                                         BorderBrush="{DynamicResource MaterialDesignDivider}"
                                         Background="{DynamicResource MaterialDesignCardBackground}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         Padding="4" IsTabStop="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Path Data="M12,2A3,3 0 0,0 9,5V11A3,3 0 0,0 12,14A3,3 0 0,0 15,11V5A3,3 0 0,0 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z"
                                                       Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       Width="14" Height="14"
                                                       Stretch="Uniform"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1"
                                                            Text="{Binding}"
                                                            FontSize="14"
                                                            VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="Medium" />
                                                        <Setter Property="Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Path Grid.Column="2"
                                                       Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                                       Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       Width="14" Height="14"
                                                       Stretch="Uniform"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,4,0">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,6" />
                                        <Setter Property="Margin" Value="0,1" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd"
                                                                 Background="{TemplateBinding Background}"
                                                                 BorderThickness="0"
                                                                 CornerRadius="6"
                                                                 Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHueMidBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AppContrastTextBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaterialDesignDivider}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <TextBox
                                     Grid.Row="2"
                                     Text="{Binding NewDjName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8"
                                     ToolTip="Type a new DJ name"
                                     Style="{StaticResource ModernTextBoxStyle}" />

                            <StackPanel Grid.Row="3" Orientation="Horizontal">
                                <Button
                                         Content="Add DJ"
                                         Command="{Binding AddDjCommand}"
                                         Width="110"
                                         Margin="0,0,8,10"
                                         Style="{StaticResource ModernButtonStyle}" />
                                <Button
                                         Content="Remove"
                                         Command="{Binding RemoveDjCommand}"
                                         Width="90"
                                           Margin="0,0,8,10"
                                         Style="{StaticResource ModernSecondaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Column 3: Network IP Setup & Rotation Settings -->
                    <StackPanel Grid.Column="3" Grid.Row="1" Grid.RowSpan="3" VerticalAlignment="Top" Margin="15,0,0,0">
                        <GroupBox Header="Network IP Setup"
                                  Style="{StaticResource NavySettingsGroupBoxStyle}"
                                  Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Manual Portal IPv4 (Optional)" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                                <TextBox
                                        Text="{Binding PreferredHostIp, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,6"
                                        ToolTip="Example: 192.168.50.20"
                                        Style="{StaticResource ModernTextBoxStyle}" />
                                <TextBlock Text="Leave blank to auto-detect. Set for travel routers or fixed portal IP."
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Rotation Settings"
                                  Style="{StaticResource PurpleSettingsGroupBoxStyle}"
                                  Padding="14,10,14,12"
                                  Margin="0,0,0,12">
                            <StackPanel Margin="0,4,0,0">
                                <CheckBox
                                         Content="Test Mode (loads sample singers on next startup)"
                                         IsChecked="{Binding IsTestMode}"
                                         Style="{StaticResource ModernCheckBoxStyle}"
                                         Margin="0,0,0,10" />
                                <CheckBox
                                         Content="Block Duplicate Songs in Session"
                                         IsChecked="{Binding BlockDuplicateSongsInSession}"
                                         Style="{StaticResource ModernCheckBoxStyle}"
                                         Margin="0,0,0,10"
                                         ToolTip="When enabled, patrons cannot request a song via the patron portal that has already been performed or queued in the current session." />
                                <Button
                                         Content="Save Current Rotation as Test List"
                                         Command="{Binding SaveCurrentAsTestListCommand}"
                                         HorizontalAlignment="Center"
                                         Width="260"
                                         Style="{StaticResource ModernButtonStyle}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Session Schedule &amp; Request Cutoff"
                                  Style="{StaticResource NavySettingsGroupBoxStyle}"
                                  Padding="14,10,14,12"
                                  Margin="0,0,0,12">
                            <StackPanel Margin="0,4,0,0">
                                <CheckBox
                                         Content="Enable Session Schedule"
                                         IsChecked="{Binding EnableSessionSchedule}"
                                         Style="{StaticResource ModernCheckBoxStyle}"
                                         Margin="0,0,0,8"
                                         ToolTip="Restrict patron and kiosk requests to the scheduled session timeframe." />
                                <Grid Margin="0,0,0,10" IsEnabled="{Binding EnableSessionSchedule}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Start Time" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                                        <ComboBox ItemsSource="{Binding TimeOptions}" Width="100" HorizontalAlignment="Left" SelectedItem="{Binding SessionStartTime, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Style="{StaticResource ModernComboBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Stop Time" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                                        <ComboBox ItemsSource="{Binding TimeOptions}" Width="100" HorizontalAlignment="Left" SelectedItem="{Binding SessionStopTime, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Style="{StaticResource ModernComboBoxStyle}" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox
                                         Content="Enable Last Request Cutoff"
                                         IsChecked="{Binding EnableLastRequestTime}"
                                         Style="{StaticResource ModernCheckBoxStyle}"
                                         Margin="0,0,0,8"
                                         ToolTip="Set a cutoff time after which patrons and kiosk users can no longer submit new song requests." />
                                <StackPanel IsEnabled="{Binding EnableLastRequestTime}" Margin="0,0,0,4">
                                    <TextBlock Text="Last Request Time" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                                    <ComboBox ItemsSource="{Binding TimeOptions}" Width="100" HorizontalAlignment="Left" SelectedItem="{Binding LastRequestTime, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Style="{StaticResource ModernComboBoxStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <!-- Appearance Settings in the 2nd column -->
                    <GroupBox Header="Appearance"
                              Style="{StaticResource BlueSettingsGroupBoxStyle}"
                              Grid.Column="1"
                              Grid.Row="1"
                              Grid.RowSpan="3"
                              Margin="15,0,0,61">
                        <StackPanel Height="497">
                            <!-- Theme -->
                            <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                            <ComboBox
                                    Width="120" HorizontalAlignment="Left"
                                    ItemsSource="{Binding Themes}"
                                    SelectedItem="{Binding SelectedTheme, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource ModernComboBoxStyle}"
                                    Margin="0,0,0,12" />

                            <!-- Banner Text -->
                            <TextBlock Text="Banner Text" FontWeight="SemiBold" Margin="0,4,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                            <TextBox
                                    Text="{Binding BannerText, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,0,0,12"
                                    Style="{StaticResource ModernTextBoxStyle}" />

                            <!-- Star Wars Crawl Text -->
                            <TextBlock Text="Star Wars Crawl Text" FontWeight="SemiBold" Margin="0,4,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                            <TextBox
                                    Text="{Binding CrawlBannerText, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap" Height="120"
                                    Margin="0,0,0,12"
                                    Style="{StaticResource ModernTextBoxStyle}" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" />

                            <!-- Marquee Speed -->
                            <TextBlock Text="Marquee Speed" FontWeight="SemiBold" Margin="0,4,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Slow" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Slider Grid.Column="1"
                                            Minimum="20" Maximum="200"
                                            SmallChange="5" LargeChange="20"
                                            TickFrequency="20" TickPlacement="BottomRight"
                                            Value="{Binding MarqueeSpeed, UpdateSourceTrigger=PropertyChanged}"
                                            VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Fast" VerticalAlignment="Center" Margin="8,0,8,0" />
                                <TextBlock Grid.Column="3"
                                               Text="{Binding MarqueeSpeed, StringFormat={}{0:F0}}"
                                               VerticalAlignment="Center" />
                            </Grid>

                            <!-- Estimated Wait Time -->
                            <CheckBox
                                Content="Show Estimated Wait Time on Rotation Screens"
                                IsChecked="{Binding ShowEstimatedWaitTime, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource ModernCheckBoxStyle}"
                                Margin="0,10,0,4"
                                ToolTip="Shows/hides the {N} minute wait-time badge next to each waiting singer's name on the audience-facing rotation displays." />

                            <!-- Default Song Length (Estimated Wait Time) -->
                            <TextBlock Text="Default Song Length (Estimated Wait Time)" FontWeight="SemiBold" Margin="0,4,0,4" Foreground="{DynamicResource AppHeaderBrush}"
                                       ToolTip="Used to estimate how long a queued singer's wait is on the rotation screen, whenever that singer's actual song length isn't known." />
                            <Grid Margin="0,0,0,4" IsEnabled="{Binding ShowEstimatedWaitTime}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Short" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Slider Grid.Column="1"
                                            Minimum="2" Maximum="8"
                                            SmallChange="0.25" LargeChange="1"
                                            TickFrequency="0.25" TickPlacement="BottomRight"
                                            Value="{Binding DefaultSongLengthMinutes, UpdateSourceTrigger=PropertyChanged}"
                                            VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Long" VerticalAlignment="Center" Margin="8,0,8,0" />
                                <TextBlock Grid.Column="3"
                                               Text="{Binding DefaultSongLengthMinutes, StringFormat={}{0:F2} min}"
                                               VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- Email settings container panel with shaded background -->
                    <GroupBox Header="Email Settings"
                              Style="{StaticResource SlateSettingsGroupBoxStyle}"
                              Grid.Row="3"
                              VerticalAlignment="Top"
                              Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Separate multiple addresses with  ,  or  ;" FontSize="11" Margin="0,0,0,4"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
                            <TextBox
                                    Text="{Binding EmailRecipient, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,0,0,6"
                                    ToolTip="One or more email addresses separated by comma or semicolon"
                                    Style="{StaticResource ModernTextBoxStyle}" />
                            <CheckBox
                                    Content="Send email automatically when saving rotation"
                                    IsChecked="{Binding SendEmailOnSave}"
                                    Style="{StaticResource ModernCheckBoxStyle}"
                                    Margin="0,2,0,0" />
                        </StackPanel>
                    </GroupBox>

                    <Button
                            Grid.Column="2"
                            Grid.Row="3"
                            Content="Save Settings"
                            Command="{Binding SaveSettingsCommand}"
                            Margin="15,0,0,0"
                            VerticalAlignment="Top"
                            Height="38"
                            Style="{StaticResource ModernButtonStyle}" />
                </Grid>
            </TabItem>

            <TabItem Header="Display" Width="65" Height="45">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Column 0: Target Monitor, Connect & Request Instructions, Casting Controls -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,0,12">
                            <!-- Display & Projection (Target Monitor) -->
                            <GroupBox Header="Display &amp; Projection" Style="{StaticResource BlueSettingsGroupBoxStyle}" Margin="0,0,0,12">
                                <StackPanel Margin="0,4,0,0">
                                    <TextBlock Text="Target Monitor" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            ItemsSource="{Binding AvailableMonitors}"
                                            SelectedValue="{Binding SelectedMonitorDevice, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="DeviceName"
                                            DisplayMemberPath="FriendlyName"
                                            Style="{StaticResource ModernComboBoxStyle}" />
                                        <Button
                                            Grid.Column="1"
                                            Content="Refresh"
                                            Command="{Binding RefreshMonitorsCommand}"
                                            Style="{StaticResource ModernSecondaryButtonStyle}"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Padding="8,4"
                                            Height="32" />
                                    </Grid>
                                    <TextBlock Text="Select which monitor will display the projection window. If not found, it defaults to the secondary or primary monitor."
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                    <CheckBox
                                        Content="Show QR Code on Rotation Screen"
                                        IsChecked="{Binding ShowQrCodeOnRotationScreen, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ModernCheckBoxStyle}"
                                        Margin="0,10,0,4"
                                        ToolTip="Displays the song-request QR code badge in the corner of the audience rotation display and billboard screens." />
                                </StackPanel>
                            </GroupBox>

                            <!-- Connect & Request Instructions GroupBox -->
                            <GroupBox Header="Connect &amp; Request Instructions" Style="{StaticResource GreenSettingsGroupBoxStyle}" Margin="0,0,0,12">
                                <StackPanel Margin="0,4,0,0">
                                    <TextBlock Text="Target Screen / Monitor" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                                    <ComboBox
                                        ItemsSource="{Binding AvailableMonitorsWithAll}"
                                        SelectedValue="{Binding ConnectInstructionsScreen, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="DeviceName"
                                        DisplayMemberPath="FriendlyName"
                                        Style="{StaticResource ModernComboBoxStyle}"
                                        Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Wi-Fi Password (Optional): " VerticalAlignment="Center" Foreground="{DynamicResource AppContrastTextBrush}" Margin="0,0,8,0" ToolTip="Enter password for travel router or venue Wi-Fi to generate scan-to-connect Wi-Fi QR code" />
                                        <TextBox Grid.Column="1" Text="{Binding WifiPassword, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernTextBoxStyle}" Height="28" Padding="6,2" ToolTip="Enter password for travel router or venue Wi-Fi to generate scan-to-connect Wi-Fi QR code" />
                                    </Grid>
                                    <TextBlock Text="Auto-detects active Wi-Fi SSID, and request portal URL." Foreground="{DynamicResource AppInfoTextBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8" />

                                    <Button Content="👁️ Preview Connect Screen"
                                            Command="{Binding PreviewConnectInstructionsCommand}"
                                            Style="{StaticResource ModernSecondaryButtonStyle}"
                                            Height="30" Padding="12,2" HorizontalAlignment="Center" />
                                </StackPanel>
                            </GroupBox>

                            <!-- Casting Controls GroupBox -->
                            <GroupBox Header="Casting Controls"
                                      Style="{StaticResource PurpleSettingsGroupBoxStyle}"
                                      Margin="0,0,0,12">
                                <StackPanel Orientation="Vertical" Margin="0,4,0,0">
                                    <TextBlock Text="Cast Rotation To:"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"
                                               Foreground="{DynamicResource AppHeaderBrush}" />

                                    <ComboBox ItemsSource="{Binding AvailableDisplayTargets}"
                                              SelectedItem="{Binding RotationTarget, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              FontSize="14"
                                              HorizontalAlignment="Stretch"
                                              Margin="0,0,0,12" />

                                    <!-- Chromecast Device Selection Dropdown -->
                                    <StackPanel Visibility="{Binding IsChromecastSelectionVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                                        <TextBlock Text="Target Chromecast Device" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableChromecasts}" SelectedItem="{Binding SelectedChromecast, Mode=TwoWay}" DisplayMemberPath="Name" Style="{StaticResource ModernComboBoxStyle}" />
                                            <Button Grid.Column="2" Content="Rescan" Command="{Binding DiscoverChromecastsCommand}" Style="{StaticResource ModernSecondaryButtonStyle}" Margin="8,0,0,0" VerticalAlignment="Center" Padding="8,4" Height="32" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Content="Cast Rotation"
                                                Command="{Binding CastCommand}"
                                                Width="140"
                                                Height="32"
                                                FontSize="14"
                                                Style="{StaticResource ModernButtonStyle}"
                                                Margin="0,0,10,0" />

                                        <Button Content="Stop Casting"
                                                Command="{Binding StopCommand}"
                                                Width="140"
                                                Height="32"
                                                FontSize="14"
                                                Style="{StaticResource ModernSecondaryButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <!-- Column 2: Synth Bars and New Performer Welcome Screen -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="15,0,0,12">
                            <!-- Synth Bars GroupBox: live frequency bars driven by a line-in / mic -->
                            <GroupBox Header="🎚 Synth Bars (Live Audio Input)" Style="{StaticResource NavySettingsGroupBoxStyle}">
                                <StackPanel Margin="0,4,0,0">
                                    <TextBlock Text="Animated bars that react to the music. KSRotation plays no audio itself, so pick the input they listen to: a line-in from the DJ's mixer (best) or a microphone."
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               Margin="0,0,0,10" />

                                    <TextBlock Text="Audio input:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppHeaderBrush}" Margin="0,0,0,4" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            ItemsSource="{Binding SpectrumInputDevices}"
                                            SelectedValue="{Binding SpectrumInputDeviceId, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Id"
                                            DisplayMemberPath="Name"
                                            Style="{StaticResource ModernComboBoxStyle}" />
                                        <Button
                                            Grid.Column="1"
                                            Content="Refresh"
                                            Command="{Binding RefreshSpectrumDevicesCommand}"
                                            Style="{StaticResource ModernSecondaryButtonStyle}"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Padding="8,4"
                                            Height="32" />
                                    </Grid>

                                    <TextBlock Text="Show the bars on:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppHeaderBrush}" Margin="0,0,0,4" />
                                    <CheckBox Content="Rotation screen"
                                              IsChecked="{Binding SpectrumOnRotation, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource ModernCheckBoxStyle}"
                                              Margin="0,0,0,6" />
                                    <CheckBox Content="DJ banner screen"
                                              IsChecked="{Binding SpectrumOnDjBanners, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource ModernCheckBoxStyle}"
                                              Margin="0,0,0,6" />
                                    <CheckBox Content="Special event screens"
                                              IsChecked="{Binding SpectrumOnSpecialEvents, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource ModernCheckBoxStyle}"
                                              Margin="0,0,0,10"
                                              ToolTip="Shown on the banner screen while a special event (Birthday, Wedding, Last Song, ...) is active." />

                                    <TextBlock Text="Color theme:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppHeaderBrush}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding SpectrumStyles}"
                                              SelectedItem="{Binding SpectrumStyle, Mode=TwoWay}"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              Margin="0,0,0,10"
                                              ToolTip="Same color themes as Lyracist's lyrics screen. Changes apply to open screens right away." />

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Sensitivity:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppHeaderBrush}" />
                                        <Slider Grid.Column="1"
                                                Minimum="0.25" Maximum="4" TickFrequency="0.25"
                                                Value="{Binding SpectrumSensitivity, Mode=TwoWay}"
                                                VerticalAlignment="Center" Margin="10,0"
                                                ToolTip="Raise this if the bars barely move (distant mic or quiet line-in)." />
                                        <TextBlock Grid.Column="2" Text="{Binding SpectrumSensitivity, StringFormat={}{0:0.00}x}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MaterialDesignBody}" />
                                    </Grid>

                                    <TextBlock Text="{Binding SpectrumStatus}"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="New Performer Welcome Screen"
                                      Style="{StaticResource BlueSettingsGroupBoxStyle}"
                                      Margin="0,15,0,0">
                                <StackPanel Margin="0,4,0,0">
                                    <CheckBox
                                        Content="Show 'Welcome to our new performer' screen when a new singer joins"
                                        IsChecked="{Binding WelcomeScreenEnabled, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="Covers the rotation and DJ Banner screens with a randomly designed welcome for each singer who is new to tonight's rotation."
                                        Style="{StaticResource ModernCheckBoxStyle}"
                                        Margin="0,0,0,6" />
                                    <TextBlock Text="Welcome Screen Display" FontWeight="SemiBold" Margin="0,4,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                                    <ComboBox
                                        ItemsSource="{Binding WelcomeScreenChoices}"
                                        SelectedValue="{Binding WelcomeScreenMonitor, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="DeviceName"
                                        DisplayMemberPath="Label"
                                        Style="{StaticResource ModernComboBoxStyle}"
                                        ToolTip="Default overlays the rotation and DJ Banner screens where they already are. Pick a monitor to show the welcome there instead; the rotation and DJ Banner are not changed and come back when it ends."
                                        Margin="0,0,0,8" />
                                    <TextBlock Text="Welcome Screen Style" FontWeight="SemiBold" Margin="0,4,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                                    <ComboBox
                                        ItemsSource="{Binding WelcomeDesignChoices}"
                                        SelectedValue="{Binding WelcomeScreenDesign, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Id"
                                        DisplayMemberPath="Name"
                                        Style="{StaticResource ModernComboBoxStyle}"
                                        ToolTip="Choose a specific welcome screen design to always display, or select 'All (Random)' to rotate through all models."
                                        Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Show welcome for:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource AppHeaderBrush}" />
                                        <TextBox Text="{Binding WelcomeScreenSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource ModernCompactTextBoxStyle}"
                                                 Width="50" Height="28" Padding="4,2" TextAlignment="Center" VerticalContentAlignment="Center"
                                                 ToolTip="3 to 120 seconds." />
                                        <TextBlock Text="sec" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,12,0" Foreground="{DynamicResource AppHeaderBrush}" />
                                        <Button Content="Preview"
                                                Command="{Binding PreviewWelcomeScreenCommand}"
                                                Style="{StaticResource ModernSecondaryButtonStyle}"
                                                Padding="10,4" Height="28"
                                                ToolTip="Shows a sample welcome on the rotation and DJ Banner screens." />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <!-- Column 1: Screen Rotation -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="15,0,0,12">
                            <!-- Screen Rotation GroupBox -->
                            <GroupBox Header="🔀 Screen Rotation" Style="{StaticResource NavySettingsGroupBoxStyle}">
                                <StackPanel Margin="0,4,0,0">
                                    <CheckBox
                                        Content="Automatically rotate through screens"
                                        IsChecked="{Binding AutoRotateProjectionViews, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ModernCheckBoxStyle}"
                                        Margin="0,0,0,10"
                                        ToolTip="When enabled, the projection display automatically randomly changes through the selected screens below every configured interval, instead of staying on one fixed screen." />

                                    <CheckBox
                                        Content="Reduced projection effects (slower PCs)"
                                        IsChecked="{Binding ReducedProjectionEffects, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ModernCheckBoxStyle}"
                                        Margin="0,0,0,10"
                                        ToolTip="Use fewer particles and skip glow/blur effects on the themed projection screens. Turn this on if the projection display stutters on an older laptop or a busy venue PC." />

                                    <!-- Single Duration Setting -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Change screen every:"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppHeaderBrush}" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding AutoRotateDurationSeconds, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 Width="60"
                                                 Height="28"
                                                 Padding="4,2"
                                                 TextAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Margin="8,0,4,0" />
                                        <TextBlock Grid.Column="2"
                                                   Text="sec"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                    </Grid>

                                    <!-- Select All / Clear All Buttons -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Content="✓ Select All"
                                                Command="{Binding SelectAllProjectionScreensCommand}"
                                                Style="{StaticResource ModernSecondaryButtonStyle}"
                                                Height="26"
                                                Padding="10,2"
                                                Margin="0,0,8,0"
                                                ToolTip="Select all projection screens with a single click" />
                                        <Button Content="✗ Clear All"
                                                Command="{Binding ClearAllProjectionScreensCommand}"
                                                Style="{StaticResource ModernSecondaryButtonStyle}"
                                                Height="26"
                                                Padding="10,2"
                                                ToolTip="Deselect all projection screens" />
                                    </StackPanel>

                                    <TextBlock Text="Check which screens to randomly rotate through:"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Margin="0,0,0,8"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                    <ItemsControl ItemsSource="{Binding ProjectionRotationSchedule}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                              Style="{StaticResource ModernCheckBoxStyle}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ViewName}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource MaterialDesignBody}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <GroupBox Header="DJ &amp; Special Event Banners"
                                  Style="{StaticResource BlueSettingsGroupBoxStyle}"
                                  Grid.Column="3"
                                  Grid.ColumnSpan="2"
                                  VerticalAlignment="Top"
                                  Margin="15,0,0,0">
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="15" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Target Monitor, Enable & Active Selection -->
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Target Monitor" FontWeight="SemiBold" Foreground="{DynamicResource AppHeaderBrush}" />
                                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource AppHeaderBrush}" Cursor="Help"
                                                   ToolTip="If broadcasting to an older TV, check its picture settings for 'Overscan', 'Just Scan', 'Screen Fit', or '1:1 Pixel Mapping' and disable overscan - otherwise the TV may crop and zoom into the banner, cutting off its edges." />
                                    </StackPanel>
                                    <ComboBox
                                            ItemsSource="{Binding AvailableMonitors}"
                                            SelectedValue="{Binding DjBannerMonitorDevice, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="DeviceName"
                                            DisplayMemberPath="FriendlyName"
                                            Style="{StaticResource ModernComboBoxStyle}"
                                            Margin="0,0,0,12" />
                                    <CheckBox
                                            Content="Enable DJ Banner Screen"
                                            IsChecked="{Binding IsDjBannerEnabled, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding IsDjBannerAvailable}"
                                            Style="{StaticResource ModernCheckBoxStyle}"
                                            Margin="0,4,0,4"
                                            ToolTip="The rotation display and DJ banner are typically shown on the same screen, so the banner is unavailable while 'Enable Display Window' is checked." />

                                    <Separator Style="{StaticResource MaterialDesignSeparator}" Margin="0,12,0,12" />
                                    <TextBlock Text="Active Special Event Banner" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource AppHeaderBrush}" />
                                    <ItemsControl ItemsSource="{Binding SpecialEventOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" GroupName="SpecialEventBanner" Margin="0,4,0,4" FontSize="14" Foreground="{DynamicResource AppContrastTextBrush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Column 2: Upload & Select Banner & Mapping -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Select DJ Banner" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                                ItemsSource="{Binding AvailableDjBanners}"
                                                SelectedValue="{Binding SelectedDjBannerPath, UpdateSourceTrigger=PropertyChanged}"
                                                SelectedValuePath="FullPath"
                                                DisplayMemberPath="FileName"
                                                Style="{StaticResource ModernComboBoxStyle}" />
                                        <Button
                                                Grid.Column="1"
                                                Content="Upload"
                                                Command="{Binding UploadDjBannerCommand}"
                                                Style="{StaticResource ModernSecondaryButtonStyle}"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Padding="8,4"
                                                Height="32" />
                                        <Button
                                                Grid.Column="2"
                                                Content="Delete"
                                                Command="{Binding DeleteDjBannerCommand}"
                                                Style="{StaticResource ModernSecondaryButtonStyle}"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Padding="8,4"
                                                Height="32" />
                                    </Grid>
                                    <CheckBox
                                        Content="Show request QR Code overlay on DJ Banner"
                                        IsChecked="{Binding IsDjBannerQrCodeEnabled, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ModernCheckBoxStyle}"
                                        Margin="0,8,0,4" />

                                    <TextBlock Text="Stadium Jumbotron Sponsor Banner" FontWeight="SemiBold" Margin="0,12,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                                    <ComboBox
                                            ItemsSource="{Binding JumbotronBannerOptions}"
                                            SelectedValue="{Binding SelectedJumbotronBannerPath, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="FullPath"
                                            DisplayMemberPath="FileName"
                                            Style="{StaticResource ModernComboBoxStyle}"
                                            ToolTip="Optional banner shown in the bottom sponsor box of the Stadium Jumbotron projection view. When 'None' is selected, a tip-your-bartenders-and-DJ reminder shows instead." />

                                    <Separator Style="{StaticResource MaterialDesignSeparator}" Margin="0,8,0,12" />
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Special Event Banners Mapping" FontWeight="SemiBold" VerticalAlignment="Top" Foreground="{DynamicResource AppHeaderBrush}" Margin="24,10,21,0" Width="200" Grid.ColumnSpan="2" />
                                        <Button Grid.Column="1" Content="Upload Banner" Command="{Binding UploadEventBannerCommand}" Style="{StaticResource ModernSecondaryButtonStyle}" Height="28" Padding="6,2" Margin="6,30,0,0" ToolTip="Upload an image or video file to the EventBanners folder" />
                                        <Button Grid.Column="2" Content="Add Event" Command="{Binding AddSpecialEventCommand}" Style="{StaticResource ModernSecondaryButtonStyle}" Height="28" Padding="6,2" Margin="6,30,0,0" ToolTip="Add a new special event banner entry" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding SpecialEvents}" Margin="0,0,0,12">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid x:Name="RootRow" Margin="0,3,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock x:Name="StandardTitleText" Grid.Column="0" Text="{Binding EventName}" FontWeight="SemiBold" Foreground="{DynamicResource AppContrastTextBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
                                                    <TextBox x:Name="CustomTitleInput" Grid.Column="0" Text="{Binding EventName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Foreground="{DynamicResource AppContrastTextBrush}" Height="28" Padding="4,2" />

                                                    <TextBlock x:Name="StandardFileText" Grid.Column="2" Text="{Binding BannerFileName, StringFormat='Standard Graphic ({0})'}" Foreground="{DynamicResource AppHeaderBrush}" FontStyle="Italic" VerticalAlignment="Center" Visibility="Collapsed" />
                                                    <ComboBox x:Name="CustomFileCombo" Grid.Column="2"
                                                               ItemsSource="{Binding DataContext.AvailableEventBannerFiles, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               SelectedItem="{Binding BannerFileName, Mode=TwoWay}"
                                                               Style="{StaticResource ModernComboBoxStyle}"
                                                               Height="28" Padding="4,2" />

                                                    <Button x:Name="DeleteBtn" Grid.Column="4" Content="Delete" Command="{Binding DataContext.DeleteSpecialEventCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource ModernSecondaryButtonStyle}" Height="28" Padding="6,2" ToolTip="Delete this special event banner entry" />
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsStandard}" Value="True">
                                                        <Setter TargetName="StandardTitleText" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="CustomTitleInput" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="StandardFileText" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="CustomFileCombo" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="DeleteBtn" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Save Special Events Mapping" Command="{Binding SaveSpecialEventsMappingCommand}" Style="{StaticResource ModernSecondaryButtonStyle}" Height="30" Padding="8,2" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Users & Singers Management Tab -->
            <TabItem Header="Users" Width="70" Height="45">
                <Grid Margin="16" TextElement.Foreground="{DynamicResource AppContrastTextBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Banner Header -->
                    <Border Grid.Row="0" Background="{DynamicResource MaterialDesignCardBackground}"
                            BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎤" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Singer Profiles &amp; User Accounts" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppHeaderBrush}" />
                                    <TextBlock Text="Manage performer credentials, PINs, default vocal key &amp; audio profiles, duplicate account merging, and past song history."
                                               FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🔄 Refresh"
                                        Command="{Binding RefreshUsersCommand}"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Height="34" Padding="14,0" Margin="0,0,8,0"
                                        ToolTip="Reload singer profiles and user accounts from database" />
                                <Button Content="New Singer"
                                        Command="{Binding AddNewUserCommand}"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Height="34" Padding="14,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main Two-Column Layout -->
                    <Grid Grid.Row="1" TextElement.Foreground="{DynamicResource AppContrastTextBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Pane: Singer Account List -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource MaterialDesignCardBackground}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                TextElement.Foreground="{DynamicResource AppContrastTextBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Search Box -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBox Text="{Binding UserSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             materialDesign:HintAssist.Hint="Search singers by name, email, or title..."
                                             Height="36"
                                             Padding="34,0,28,0" />
                                    <!-- Search Magnify Icon -->
                                    <materialDesign:PackIcon Kind="Magnify"
                                                             Width="18"
                                                             Height="18"
                                                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                             Opacity="0.65"
                                                             VerticalAlignment="Center"
                                                             HorizontalAlignment="Left"
                                                             Margin="10,0,0,0"
                                                             IsHitTestVisible="False" />
                                    <!-- Clear Button -->
                                    <Button Command="{Binding ClearUserSearchCommand}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Width="22"
                                            Height="22"
                                            Cursor="Hand"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"
                                            ToolTip="Clear search text"
                                            Visibility="{Binding HasUserSearchText, Converter={StaticResource BoolToVis}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent" CornerRadius="11">
                                                    <TextBlock Text="✕" FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <!-- Singer List -->
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding FilteredUsers}"
                                         SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         BorderThickness="0"
                                         Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="6,6" Margin="0,2" CornerRadius="6" Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Avatar Thumbnail -->
                                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                                                            BorderBrush="#0EA5E9" BorderThickness="1.5"
                                                            Margin="0,0,10,0" Background="#222" ClipToBounds="True">
                                                        <Grid>
                                                            <TextBlock Text="👤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888" />
                                                            <Image Source="{Binding AvatarImage}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- Name & Details -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"
                                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AppContrastTextBrush}" />
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding SongsText, Mode=OneWay}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding VocalRange, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- Level Badge -->
                                                    <Border Grid.Column="2" Background="#1E3A5F" BorderBrush="#0EA5E9" BorderThickness="1"
                                                            CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding LevelText}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Bottom Left Actions -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="Delete Singer"
                                            Command="{Binding DeleteUserCommand}"
                                            IsEnabled="{Binding HasSelectedUser}"
                                            Style="{StaticResource ModernSecondaryButtonStyle}"
                                            Height="32" Padding="12,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Right Pane: Singer Details & Settings Editor -->
                        <Border Grid.Column="2"
                                Background="{DynamicResource MaterialDesignCardBackground}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16"
                                TextElement.Foreground="{DynamicResource AppContrastTextBrush}">
                            <Grid>
                                <!-- Empty State Placeholder -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding HasNoSelectedUser, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="👥" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                    <TextBlock Text="No Performer Selected" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Choose a performer from the list on the left or create a new one."
                                               FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- Active Editor View -->
                                <Grid Visibility="{Binding HasSelectedUser, Converter={StaticResource BoolToVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Profile Header Card -->
                                    <Border Grid.Row="0"
                                            Background="{DynamicResource MaterialDesignPaper}"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar Preview & Actions -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <Border Width="68" Height="68" CornerRadius="34"
                                                        BorderBrush="#0EA5E9" BorderThickness="2"
                                                        Background="#181818" ClipToBounds="True">
                                                    <Grid>
                                                        <TextBlock Text="👤" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#666" />
                                                        <Image Source="{Binding EditUserAvatarImage}" Stretch="UniformToFill" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <Button Content="Take Photo"
                                                            Command="{Binding OpenUserWebcamCaptureCommand}"
                                                            Style="{StaticResource ModernButtonStyle}"
                                                            Height="28" Padding="8,0" Margin="0,0,0,4"
                                                            ToolTip="Take a live photo of the performer using a connected webcam" />
                                                    <Button Content="Upload Photo"
                                                            Command="{Binding UploadUserAvatarCommand}"
                                                            Style="{StaticResource ModernSecondaryButtonStyle}"
                                                            Height="28" Padding="8,0" Margin="0,0,0,4"
                                                            ToolTip="Select a custom photo from your computer" />
                                                    <Button Content="Center Face"
                                                            Command="{Binding AdjustUserAvatarCommand}"
                                                            Style="{StaticResource ModernSecondaryButtonStyle}"
                                                            Height="28" Padding="8,0" Margin="0,0,0,4"
                                                            ToolTip="Reposition and zoom the photo to center the performer's face" />
                                                    <Button Content="Rotate ↻"
                                                            Command="{Binding RotateUserAvatarCommand}"
                                                            Style="{StaticResource ModernSecondaryButtonStyle}"
                                                            Height="28" Padding="8,0" Margin="0,0,0,4"
                                                            ToolTip="Rotate the uploaded photo 90 degrees clockwise" />
                                                    <Button Content="Clear Photo"
                                                            Command="{Binding ClearUserAvatarCommand}"
                                                            Style="{StaticResource ModernSecondaryButtonStyle}"
                                                            Height="28" Padding="8,0" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Performer Name & Badges -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedUser.Name}" FontSize="22" FontWeight="Bold"
                                                           Foreground="{DynamicResource AppContrastTextBrush}" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Border Background="#2A1E35" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding SelectedUser.LevelText}" FontSize="11" FontWeight="Bold" Foreground="#FF8E53" />
                                                    </Border>
                                                    <Border Background="#1E3A5F" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding SelectedUser.Score, StringFormat='{}{0} XP'}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                                                    </Border>
                                                    <Border Background="#1B382B" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding SelectedUser.SongsText}" FontSize="11" FontWeight="SemiBold" Foreground="#34D399" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Merge Duplicate Button -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <Button Content="Merge Duplicate..."
                                                        Command="{Binding OpenUserMergePopupCommand}"
                                                        Style="{StaticResource ModernButtonStyle}"
                                                        Height="34" Padding="12,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Status Message Toast Banner -->
                                    <Border Grid.Row="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                                            Visibility="{Binding HasUserStatusMessage, Converter={StaticResource BoolToVis}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1E3A5F" />
                                                <Setter Property="BorderBrush" Value="#0EA5E9" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUserStatusSuccess}" Value="False">
                                                        <Setter Property="Background" Value="#3D1A1A" />
                                                        <Setter Property="BorderBrush" Value="#EF4444" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding UserStatusMessage}" FontWeight="SemiBold" FontSize="12" Foreground="White" />
                                    </Border>

                                    <!-- Sub-Tabs for Details, Defaults, and History -->
                                    <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Style="{StaticResource BorderedTabControlStyle}">
                                        <!-- TAB 1: Profile & PIN -->
                                        <TabItem Header="Profile &amp; PIN">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
                                                <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                                                    <!-- Performer Name -->
                                                    <TextBlock Text="Singer Name" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppContrastTextBrush}" Margin="0,0,0,4" />
                                                    <TextBox Text="{Binding EditUserName, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" Height="36" />

                                                    <!-- PIN & Email -->
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="14" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Portal PIN Code" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppContrastTextBrush}" Margin="0,0,0,4" />
                                                            <TextBox Text="{Binding EditUserPin, UpdateSourceTrigger=PropertyChanged}"
                                                                     materialDesign:HintAssist.Hint="4-digit PIN for portal login"
                                                                     Style="{StaticResource ModernTextBoxStyle}" Height="36" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Email Address" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppContrastTextBrush}" Margin="0,0,0,4" />
                                                            <TextBox Text="{Binding EditUserEmail, UpdateSourceTrigger=PropertyChanged}"
                                                                     materialDesign:HintAssist.Hint="Optional patron email"
                                                                     Style="{StaticResource ModernTextBoxStyle}" Height="36" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Vocal Range & Custom Title -->
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="14" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Vocal Range" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppContrastTextBrush}" Margin="0,0,0,4" />
                                                            <ComboBox ItemsSource="{Binding VocalRangeOptions}"
                                                                      SelectedItem="{Binding EditUserVocalRange, Mode=TwoWay}"
                                                                      Style="{StaticResource ModernComboBoxStyle}" Height="36" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Custom Title / Nickname" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppContrastTextBrush}" Margin="0,0,0,4" />
                                                            <TextBox Text="{Binding EditUserCustomTitle, UpdateSourceTrigger=PropertyChanged}"
                                                                     materialDesign:HintAssist.Hint="e.g. VIP Performer"
                                                                     Style="{StaticResource ModernTextBoxStyle}" Height="36" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- XP & Songs -->
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="14" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Experience Score (XP)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppContrastTextBrush}" Margin="0,0,0,4" />
                                                            <TextBox Text="{Binding EditUserScore, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource ModernTextBoxStyle}" Height="36" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Total Songs Sung" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppContrastTextBrush}" Margin="0,0,0,4" />
                                                            <TextBox Text="{Binding EditUserTotalSongs, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource ModernTextBoxStyle}" Height="36" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Notes -->
                                                    <TextBlock Text="Performer Notes" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppContrastTextBrush}" Margin="0,0,0,4" />
                                                    <TextBox Text="{Binding EditUserNotes, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource ModernTextBoxStyle}"
                                                             AcceptsReturn="True" Height="70" TextWrapping="Wrap" Margin="0,0,0,12" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabItem>

                                        <!-- TAB 2: Audio & Voice Defaults -->
                                        <TabItem Header="Audio Defaults">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
                                                <StackPanel MaxWidth="650" HorizontalAlignment="Left">
                                                    <TextBlock Text="These audio settings automatically apply whenever this singer performs:"
                                                               FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,16" />

                                                    <!-- Mic Gain -->
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="160" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="60" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Microphone Gain" FontWeight="SemiBold" Foreground="{DynamicResource AppContrastTextBrush}" VerticalAlignment="Center" />
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding EditUserGain, Mode=TwoWay}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding EditUserGain, StringFormat='{}{0:0}%'}" TextAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AppContrastTextBrush}" />
                                                    </Grid>

                                                    <!-- Key Transposition -->
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="160" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="60" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Key Transposition" FontWeight="SemiBold" Foreground="{DynamicResource AppContrastTextBrush}" VerticalAlignment="Center" />
                                                        <Slider Grid.Column="1" Minimum="-12" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                Value="{Binding EditUserKey, Mode=TwoWay}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding EditUserKey, StringFormat='{}{0:+0;-0;0}'}" TextAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AppContrastTextBrush}" />
                                                    </Grid>

                                                    <!-- Tempo -->
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="160" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="60" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Playback Speed" FontWeight="SemiBold" Foreground="{DynamicResource AppContrastTextBrush}" VerticalAlignment="Center" />
                                                        <Slider Grid.Column="1" Minimum="0.8" Maximum="1.2" TickFrequency="0.05"
                                                                Value="{Binding EditUserTempo, Mode=TwoWay}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding EditUserTempo, StringFormat='{}{0:0.0}x'}" TextAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AppContrastTextBrush}" />
                                                    </Grid>

                                                    <!-- 3-Band EQ -->
                                                    <GroupBox Header="3-Band EQ (Tone Controls)" Style="{StaticResource BlueSettingsGroupBoxStyle}" Margin="0,10,0,12" Padding="10">
                                                        <StackPanel>
                                                            <Grid Margin="0,4,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="60" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="Treble" Foreground="{DynamicResource AppContrastTextBrush}" VerticalAlignment="Center" />
                                                                <Slider Grid.Column="1" Minimum="-15" Maximum="15" Value="{Binding EditUserTreble, Mode=TwoWay}" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" Text="{Binding EditUserTreble, StringFormat='{}{0:0.0} dB'}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource AppContrastTextBrush}" />
                                                            </Grid>
                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="60" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="Mid" Foreground="{DynamicResource AppContrastTextBrush}" VerticalAlignment="Center" />
                                                                <Slider Grid.Column="1" Minimum="-15" Maximum="15" Value="{Binding EditUserMid, Mode=TwoWay}" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" Text="{Binding EditUserMid, StringFormat='{}{0:0.0} dB'}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource AppContrastTextBrush}" />
                                                            </Grid>
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="60" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="Bass" Foreground="{DynamicResource AppContrastTextBrush}" VerticalAlignment="Center" />
                                                                <Slider Grid.Column="1" Minimum="-15" Maximum="15" Value="{Binding EditUserBass, Mode=TwoWay}" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" Text="{Binding EditUserBass, StringFormat='{}{0:0.0} dB'}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource AppContrastTextBrush}" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </GroupBox>

                                                    <!-- Dynamics -->
                                                    <Grid Margin="0,0,0,14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="14" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Compressor Amount" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppContrastTextBrush}" Margin="0,0,0,4" />
                                                            <Slider Minimum="0" Maximum="100" Value="{Binding EditUserCompressor, Mode=TwoWay}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Limiter Threshold" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppContrastTextBrush}" Margin="0,0,0,4" />
                                                            <Slider Minimum="0" Maximum="100" Value="{Binding EditUserLimiter, Mode=TwoWay}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBlock Text="Audio Notes / Sound Check Remarks" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppContrastTextBrush}" Margin="0,0,0,4" />
                                                    <TextBox Text="{Binding EditUserSoundCheck, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource ModernTextBoxStyle}"
                                                             AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabItem>

                                        <!-- TAB 3: Song Performance History -->
                                        <TabItem Header="Performance History">
                                            <Grid Margin="0,10,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Text="All songs performed by this singer, with recalled key and speed settings:"
                                                           FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,8" />

                                                <DataGrid Grid.Row="1"
                                                          ItemsSource="{Binding UserPerformanceHistory}"
                                                          AutoGenerateColumns="False"
                                                          CanUserAddRows="False"
                                                          CanUserDeleteRows="False"
                                                          IsReadOnly="True"
                                                          SelectionMode="Single"
                                                          GridLinesVisibility="Horizontal"
                                                          Background="Transparent"
                                                          Foreground="{DynamicResource AppContrastTextBrush}"
                                                          BorderThickness="1"
                                                          BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                          RowHeight="36">
                                                    <DataGrid.Resources>
                                                        <Style TargetType="DataGridColumnHeader">
                                                            <Setter Property="Foreground" Value="{DynamicResource AppContrastTextBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </Style>
                                                        <Style TargetType="DataGridCell">
                                                            <Setter Property="Foreground" Value="{DynamicResource AppContrastTextBrush}" />
                                                        </Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource AppContrastTextBrush}" />
                                                        </Style>
                                                    </DataGrid.Resources>
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Song Title" Binding="{Binding SongTitle}" Width="*" />
                                                        <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="150" />
                                                        <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="60" />
                                                        <DataGridTextColumn Header="Speed" Binding="{Binding Tempo, StringFormat='{}{0:0.0}x'}" Width="70" />
                                                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="80" />
                                                        <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding FormattedDate}" Width="160" />
                                                        <DataGridTemplateColumn Header="Actions" Width="170">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                        <Button Content="Queue"
                                                                                Style="{StaticResource ModernButtonStyle}"
                                                                                Height="26" Padding="8,0"
                                                                                Margin="0,0,6,0"
                                                                                Command="{Binding DataContext.QueueUserHistoricalSongCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip="Queue this song into the active rotation" />
                                                                        <Button Content="Remove"
                                                                                Style="{StaticResource ModernSecondaryButtonStyle}"
                                                                                Height="26" Padding="8,0"
                                                                                Command="{Binding DataContext.DeleteUserHistoricalSongCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip="Remove this record from history" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                        </TabItem>
                                    </TabControl>

                                    <!-- Bottom Action Bar -->
                                    <Border Grid.Row="3" Margin="0,14,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Save Changes"
                                                    Command="{Binding SaveUserCommand}"
                                                    Style="{StaticResource ModernButtonStyle}"
                                                    FontWeight="SemiBold"
                                                    Height="36" Padding="20,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Merge Duplicate Accounts Modal / Overlay -->
                    <Border Grid.Row="0" Grid.RowSpan="2"
                            Background="#B0000000"
                            Panel.ZIndex="1000"
                            Visibility="{Binding IsUserMergeOpen, Converter={StaticResource BoolToVis}}">
                        <Border Background="{DynamicResource MaterialDesignPaper}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1.5"
                                CornerRadius="12"
                                Padding="24"
                                Width="500"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{DynamicResource AppContrastTextBrush}">
                            <StackPanel>
                                <TextBlock Text="Merge Duplicate Singer Account" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppHeaderBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="Consolidate another performer profile into the currently selected account:" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,8" />

                                <!-- Target Account -->
                                <Border Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Target (Keep): " FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        <TextBlock Text="{Binding SelectedUser.Name}" FontWeight="Bold" Foreground="#0EA5E9" />
                                    </StackPanel>
                                </Border>

                                <!-- Duplicate Account Selector -->
                                <TextBlock Text="Select Duplicate Account to Merge &amp; Remove:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppContrastTextBrush}" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding UserMergeCandidates}"
                                          SelectedItem="{Binding SelectedMergeUser, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          Margin="0,0,0,14" Height="36" />

                                <TextBlock Text="All historical song performances, requests, and XP points from the duplicate account will be transferred to the target account. The duplicate account will then be permanently deleted."
                                           TextWrapping="Wrap" FontSize="12" Foreground="#F59E0B" Margin="0,0,0,18" />

                                <!-- Dialog Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Cancel"
                                            Command="{Binding CancelUserMergeCommand}"
                                            Style="{StaticResource ModernSecondaryButtonStyle}"
                                            Height="32" Padding="14,0" Margin="0,0,10,0" />
                                    <Button Content="Confirm Merge"
                                            Command="{Binding ExecuteUserMergeCommand}"
                                            Style="{StaticResource ModernButtonStyle}"
                                            FontWeight="SemiBold"
                                            Height="32" Padding="14,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Webcam Photo Capture Modal / Overlay -->
                    <Border Grid.Row="0" Grid.RowSpan="2"
                            Background="#B0000000"
                            Panel.ZIndex="1000"
                            Visibility="{Binding IsUserWebcamOpen, Converter={StaticResource BoolToVis}}">
                        <Border Background="{DynamicResource MaterialDesignPaper}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1.5"
                                CornerRadius="12"
                                Padding="24"
                                Width="540"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{DynamicResource AppContrastTextBrush}">
                            <StackPanel>
                                <!-- Title & Close -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Webcam Performer Snapshot" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppHeaderBrush}" />
                                        <TextBlock Text="Capture a live photo of the performer for their avatar profile and rotation billboard."
                                                   FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="✕"
                                            Command="{Binding CloseUserWebcamCaptureCommand}"
                                            Style="{StaticResource ModernSecondaryButtonStyle}"
                                            Height="28" Width="28" Padding="0" VerticalAlignment="Top" />
                                </Grid>

                                <!-- Camera Selector (when cameras exist) -->
                                <Grid Margin="0,0,0,12" Visibility="{Binding HasUserWebcamDevice, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Select Camera:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AppContrastTextBrush}" Margin="0,0,10,0" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding UserAvailableCameras}"
                                              SelectedItem="{Binding SelectedUserCamera, Mode=TwoWay}"
                                              DisplayMemberPath="Name"
                                              Style="{StaticResource ModernComboBoxStyle}" Height="34" />
                                </Grid>

                                <!-- Live / Captured Viewport -->
                                <Border Width="480" Height="360" Background="#111" CornerRadius="8"
                                        BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                                        ClipToBounds="True" Margin="0,0,0,14">
                                    <Grid>
                                        <!-- No Camera Detected View -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Visibility="{Binding HasNoUserWebcamDevice, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="📷" FontSize="48" Foreground="#888" Margin="0,0,0,8" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding UserWebcamStatusMessage}" Foreground="#AAA" FontSize="12"
                                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
                                        </StackPanel>

                                        <!-- Live Stream Image -->
                                        <Image Source="{Binding UserWebcamLiveFrame}" Stretch="Uniform"
                                               Visibility="{Binding IsUserWebcamStreaming, Converter={StaticResource BoolToVis}}" />

                                        <!-- Captured Snapshot Image (Frozen) -->
                                        <Image Source="{Binding UserWebcamCapturedFrame}" Stretch="Uniform"
                                               Visibility="{Binding IsUserWebcamFrozen, Converter={StaticResource BoolToVis}}" />

                                        <!-- Framing Guideline Circle for Performer Headshot -->
                                        <Ellipse Width="260" Height="260" Stroke="#40FFFFFF" StrokeThickness="2" StrokeDashArray="3 3"
                                                 IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Visibility="{Binding HasUserWebcamDevice, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>

                                <!-- Action Buttons -->
                                <Grid>
                                    <!-- When No Camera Detected -->
                                    <Button Content="Close" Style="{StaticResource ModernSecondaryButtonStyle}"
                                            HorizontalAlignment="Right" Height="32" Padding="14,0"
                                            Command="{Binding CloseUserWebcamCaptureCommand}"
                                            Visibility="{Binding HasNoUserWebcamDevice, Converter={StaticResource BoolToVis}}" />

                                    <!-- When Streaming Live: Capture Button -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Visibility="{Binding IsUserWebcamStreaming, Converter={StaticResource BoolToVis}}">
                                        <Button Content="Cancel" Style="{StaticResource ModernSecondaryButtonStyle}"
                                                Command="{Binding CloseUserWebcamCaptureCommand}"
                                                Height="32" Padding="14,0" Margin="0,0,10,0" />
                                        <Button Content="Capture Snapshot" Style="{StaticResource ModernButtonStyle}"
                                                Command="{Binding CaptureUserWebcamSnapshotCommand}"
                                                FontWeight="SemiBold" Height="32" Padding="16,0" />
                                    </StackPanel>

                                    <!-- When Frozen (Snapshot Taken): Retake / Save & Apply -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Visibility="{Binding IsUserWebcamFrozen, Converter={StaticResource BoolToVis}}">
                                        <Button Content="Retake" Style="{StaticResource ModernSecondaryButtonStyle}"
                                                Command="{Binding RetakeUserWebcamSnapshotCommand}"
                                                Height="32" Padding="14,0" Margin="0,0,10,0" />
                                        <Button Content="Save &amp; Apply Photo" Style="{StaticResource ModernButtonStyle}"
                                                Command="{Binding ApplyUserWebcamSnapshotCommand}"
                                                FontWeight="SemiBold" Height="32" Padding="16,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 5. Live Trivia Host Console Tab -->
            <TabItem Header="Trivia" Width="70" Height="45">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Venue, Connected Players & Monitor Selector -->
                    <Border Grid.Row="0" Background="{DynamicResource MaterialDesignCardBackground}"
                            BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎯" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <StackPanel>
                                    <TextBlock Text="KSRotation LIVE TRIVIA MASTER" FontSize="16" FontWeight="ExtraBold" Foreground="#8B5CF6" />
                                    <TextBlock Text="{Binding TriviaVenueName, StringFormat='Active Venue: {0}'}" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Connected Players Badge -->
                                <Border Background="#243347" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding TriviaConnectedPlayerCount, StringFormat='👥 {0} Players Connected'}" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" />
                                </Border>

                                <!-- Open/Activate Big Screen Button -->
                                <Button Content="📡 Open Big Screen" Command="{Binding ToggleTriviaDisplayCommand}"
                                        Background="#8B5CF6" Foreground="White" FontWeight="Bold" Height="32" Padding="12,0"
                                        ToolTip="Open or focus the 16:9 Trivia Projection Window on the venue monitor" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main 3-Column Deck -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="290" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="290" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Pack Picker & GM Controls -->
                        <Border Grid.Column="0" Background="{DynamicResource MaterialDesignCardBackground}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="10" Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="GAME MASTER CONTROLS" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,6" />

                                    <!-- Category Pack Checklist -->
                                    <TextBlock Text="Question Pack(s) — check 2+ to mix:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="6">
                                            <ListBox ItemsSource="{Binding TriviaSelectablePacks}" MinHeight="80" MaxHeight="130" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="0">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Focusable" Value="False" />
                                                        <Setter Property="Padding" Value="4,2" />
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding Title}" Foreground="{DynamicResource AppContrastTextBrush}" FontSize="11" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                        <Button Grid.Column="1" Content="🔄" Command="{Binding RefreshTriviaPacksCommand}" Style="{StaticResource ModernSecondaryButtonStyle}" Margin="4,0,0,0" ToolTip="Refresh Packs" Height="26" Width="28" Padding="0" VerticalAlignment="Top" />
                                    </Grid>

                                    <!-- Questions Per Game -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Questions Per Game:" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding TriviaQuestionsPerGamePresets}" SelectedItem="{Binding TriviaQuestionsPerGame}" Style="{StaticResource ModernComboBoxStyle}" Height="28" Padding="6,2" FontWeight="Bold" />
                                    </Grid>

                                    <!-- Auto-Run Gameplay Switch -->
                                    <Border Background="#1E293B" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="⚡ Auto-Run Game" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                                                <TextBlock Text="{Binding TriviaAutoRunTimingSummary}" FontSize="9" Foreground="#94A3B8" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding TriviaAutoAdvance}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Primary 1-Click Launch Action -->
                                    <Button Content="🎯 Launch Pre-Game Countdown" Command="{Binding LaunchTriviaPreGameLobbyCommand}"
                                            Style="{StaticResource StandardGameButton}"
                                            Background="#6366F1" Foreground="White"  Margin="0,0,0,8"
                                            ToolTip="Opens big screen with category banner, countdown timer, and scan-to-join instructions." />

                                    <Button Content="▶ Start Game Now (Skip Countdown)" Command="{Binding StartTriviaCommand}"
                                            Style="{StaticResource StandardGameButton}"
                                            Background="#10B981" Foreground="White"  Margin="0,0,0,12" />

                                    <!-- Live Question Controls -->
                                    <TextBlock Text="LIVE QUESTION CONTROLS" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,6" />

                                    <!-- Question Navigation Row -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="⏮ Prev" Command="{Binding PreviousTriviaQuestionCommand}" Style="{StaticResource StandardGameButton}" Height="30" Margin="0,0,4,0" ToolTip="Go back to previous question" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding TriviaAvailableQuestionNumbers}" SelectedItem="{Binding TriviaCurrentQuestionNumber}" Style="{StaticResource ModernComboBoxStyle}" Width="60" Height="30" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="Jump directly to question #" />
                                        <Button Grid.Column="2" Content="Next ⏭" Command="{Binding NextTriviaQuestionCommand}" Style="{StaticResource StandardGameButton}" Height="30" Margin="4,0,0,0" ToolTip="Advance to next question" />
                                    </Grid>

                                    <!-- Timer Quick-Adjust Row -->
                                    <TextBlock Text="⏱ Timer Bump &amp; Pacing:" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,3" />
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="-5s" Command="{Binding AddTriviaTimerSecondsCommand}" CommandParameter="-5" Style="{StaticResource ModernSecondaryButtonStyle}" Height="28" Margin="0,0,2,0" ToolTip="Subtract 5 seconds from question countdown" />
                                        <Button Grid.Column="1" Content="+5s" Command="{Binding AddTriviaTimerSecondsCommand}" CommandParameter="5" Style="{StaticResource ModernSecondaryButtonStyle}" Height="28" Margin="2,0,2,0" ToolTip="Add 5 seconds to question countdown" />
                                        <Button Grid.Column="2" Content="+10s" Command="{Binding AddTriviaTimerSecondsCommand}" CommandParameter="10" Style="{StaticResource ModernSecondaryButtonStyle}" Height="28" Margin="2,0,2,0" ToolTip="Add 10 seconds to question countdown" />
                                        <Button Grid.Column="3" Content="🔄" Command="{Binding ResetTriviaTimerCommand}" Style="{StaticResource ModernSecondaryButtonStyle}" Height="28" Margin="2,0,0,0" ToolTip="Reset question countdown to full time" />
                                    </Grid>

                                    <Button Content="▶ Start Question &amp; Timer" Command="{Binding StartTriviaQuestionCommand}"
                                            Style="{StaticResource StandardGameButton}"
                                            Background="#3B82F6" Foreground="White"  Margin="0,0,0,6"
                                            ToolTip="Start/restart the countdown for the current question (with Auto-Run off, questions open in reading/standby mode until you press this)" />

                                    <Button Content="{Binding TriviaPauseButtonText}" Command="{Binding ToggleTriviaPauseCommand}"
                                            Style="{StaticResource StandardGameButton}"
                                            Background="#F59E0B" Foreground="White"  Margin="0,0,0,6" />

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="✂ Fade Option" Command="{Binding EliminateNextTriviaWrongCommand}" Style="{StaticResource ModernSecondaryButtonStyle}" Height="30" Margin="0,0,3,0" ToolTip="Manually eliminate/fade one wrong option" />
                                        <Button Grid.Column="1" Content="⚡ Instant Reveal" Command="{Binding InstantRevealTriviaCommand}" Style="{StaticResource ModernSecondaryButtonStyle}" Height="30" Margin="3,0,0,0" ToolTip="Immediately reveal the correct answer" />
                                    </Grid>

                                    <Button Content="🔓 Lock &amp; Reveal Answer" Command="{Binding LockAndRevealTriviaCommand}"
                                            Style="{StaticResource StandardGameButton}"
                                            Background="#8B5CF6" Foreground="White"  Margin="0,0,0,6" />

                                    <Button Content="❌ Void Question (No Penalty)" Command="{Binding VoidCurrentTriviaQuestionCommand}"
                                            Style="{StaticResource StandardGameButton}"
                                            Background="#DC2626" Foreground="White"  Margin="0,0,0,6"
                                            ToolTip="Cancel question without penalizing players and advance" />

                                    <Button Content="🔄 Reset Game Session" Command="{Binding ResetTriviaCommand}"
                                            Style="{StaticResource StandardGameButton}" Height="30" Margin="0,0,0,12" />

                                    <!-- Server & Join URL Card -->
                                    <Border Background="{DynamicResource MaterialDesignDivider}" CornerRadius="6" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="📱 Patron Mobile Portal" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,2" />
                                            <TextBlock Text="{Binding TriviaServerStatusText}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AppHeaderBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding TriviaPauseReason, StringFormat='⏸ PAUSED: {0}'}" Foreground="#EF4444" FontWeight="Bold" FontSize="10" Margin="0,2,0,0"
                                                       Visibility="{Binding IsTriviaPaused, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Middle Column: Live Question, Answer Distribution Visualizer & Option Cards -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Question Header Card -->
                            <Border Grid.Row="0" Background="{DynamicResource MaterialDesignCardBackground}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TriviaActiveRoundTitle}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AppHeaderBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding TriviaRemainingSeconds, StringFormat='⏱ {0}s left'}" FontWeight="Bold" FontSize="14" Foreground="#F59E0B" />
                                    </Grid>

                                    <TextBlock Text="{Binding TriviaCurrentQuestionPrompt}" FontSize="17" FontWeight="Bold"
                                               Foreground="{DynamicResource AppContrastTextBrush}" TextWrapping="Wrap" LineHeight="24" MinHeight="48" />
                                </StackPanel>
                            </Border>

                            <!-- Live Answer Distribution Graph -->
                            <Border Grid.Row="1" Background="{DynamicResource MaterialDesignCardBackground}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="📊 LIVE PATRON RESPONSE VISUALIZER" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding TriviaAnswerDistribution}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="55" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center" />
                                                    <ProgressBar Grid.Column="1" Value="{Binding Count}" Maximum="25" Height="10" Foreground="#8B5CF6" Background="#334155" Margin="6,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat='{}{0} votes'}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- 2x2 Answer Grid -->
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Option A (Red) -->
                                <Border Grid.Row="0" Grid.Column="0" Background="#DC2626" CornerRadius="8" Padding="12">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="▲ OPTION A" FontWeight="Bold" FontSize="11" Foreground="#FCA5A5" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding TriviaOptionA}" FontWeight="SemiBold" FontSize="15" Foreground="White" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Option B (Blue) -->
                                <Border Grid.Row="0" Grid.Column="2" Background="#2563EB" CornerRadius="8" Padding="12">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="◆ OPTION B" FontWeight="Bold" FontSize="11" Foreground="#93C5FD" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding TriviaOptionB}" FontWeight="SemiBold" FontSize="15" Foreground="White" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Option C (Yellow) -->
                                <Border Grid.Row="2" Grid.Column="0" Background="#D97706" CornerRadius="8" Padding="12">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="● OPTION C" FontWeight="Bold" FontSize="11" Foreground="#FDE68A" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding TriviaOptionC}" FontWeight="SemiBold" FontSize="15" Foreground="White" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Option D (Green) -->
                                <Border Grid.Row="2" Grid.Column="2" Background="#059669" CornerRadius="8" Padding="12">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="■ OPTION D" FontWeight="Bold" FontSize="11" Foreground="#A7F3D0" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding TriviaOptionD}" FontWeight="SemiBold" FontSize="15" Foreground="White" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Right Column: Live Players, Leaderboard & Moderation -->
                        <Border Grid.Column="4" Background="{DynamicResource MaterialDesignCardBackground}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="10" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🏆 Live Player Leaderboard" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding TriviaPlayers.Count, StringFormat='{}{0} Players'}" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center" />
                                </Grid>

                                <ListView Grid.Row="1" ItemsSource="{Binding TriviaPlayers}" BorderThickness="0" Background="Transparent">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource MaterialDesignDivider}" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                                        <TextBlock Text="{Binding TeamName, StringFormat='Team: {0}'}" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding TotalScore, StringFormat='{}{0:N0} pts'}" FontWeight="Bold" Foreground="#38BDF8" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <Button Grid.Column="2" Content="✕" Height="22" Width="22" Padding="0" Background="#EF4444" Foreground="White"
                                                            Command="{Binding DataContext.RemoveTriviaPlayerCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}" ToolTip="Kick Player" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 6. Dedicated Separate Trivia Settings Tab -->
            <TabItem Header="Trivia Settings" Width="128" Height="45" FocusManager.IsFocusScope="True">
                <ScrollViewer Focusable="True" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,12">
                    <Grid HorizontalAlignment="Stretch" TextElement.Foreground="{DynamicResource AppContrastTextBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header & Notification Banner -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="🎯 Trivia Rules &amp; Configuration" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                <TextBlock Text="Configure gameplay timers, scoring rules, speed multipliers, and local Wi-Fi credentials for mobile buzzer gameplay."
                                           FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,2,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1" Background="#10B981" CornerRadius="6" Padding="12,6" VerticalAlignment="Center"
                                    Visibility="{Binding IsTriviaSettingsStatusVisible, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding TriviaSettingsStatusMessage}" Foreground="White" FontWeight="Bold" FontSize="12" />
                            </Border>
                        </Grid>

                        <!-- 3-Column Dashboard Content Grid -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- COLUMN 0: Timers & Scoring -->
                            <StackPanel Grid.Column="0">
                                <!-- ⏱️ Question Timers & Flow -->
                                <GroupBox Header="⏱️ Question Timers &amp; Flow" Style="{StaticResource BlueSettingsGroupBoxStyle}" Margin="0,0,0,12">
                                    <StackPanel Margin="0,4,0,0">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Time (s)" FontWeight="SemiBold" FontSize="10" Margin="0,0,0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                                <TextBox Text="{Binding TriviaDefaultQuestionSeconds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernCompactTextBoxStyle}" Width="45" HorizontalAlignment="Left" TextAlignment="Center" Height="28" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Warn (s)" FontWeight="SemiBold" FontSize="10" Margin="0,0,0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                                <TextBox Text="{Binding TriviaWarningCountdownSeconds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernCompactTextBoxStyle}" Width="45" HorizontalAlignment="Left" TextAlignment="Center" Height="28" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Fade (s)" FontWeight="SemiBold" FontSize="10" Margin="0,0,0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" ToolTip="Wrong option elimination fade speed (seconds)" />
                                                <TextBox Text="{Binding TriviaAnswerEliminationIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernCompactTextBoxStyle}" Width="45" HorizontalAlignment="Left" TextAlignment="Center" Height="28" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="6">
                                                <TextBlock Text="Reveal (s)" FontWeight="SemiBold" FontSize="10" Margin="0,0,0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" ToolTip="Post-reveal answer display delay (seconds)" />
                                                <TextBox Text="{Binding TriviaPostRevealDelaySeconds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernCompactTextBoxStyle}" Width="45" HorizontalAlignment="Left" TextAlignment="Center" Height="28" />
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox Content="Auto-advance questions"
                                                  Style="{StaticResource ModernCheckBoxStyle}"
                                                  Foreground="{DynamicResource AppContrastTextBrush}"
                                                  IsChecked="{Binding TriviaAutoAdvance, UpdateSourceTrigger=PropertyChanged}"
                                                  FontWeight="SemiBold" FontSize="11" />
                                    </StackPanel>
                                </GroupBox>

                                <!-- 🏆 Scoring & Multipliers Card -->
                                <GroupBox Header="🏆 Scoring &amp; Bonus Multipliers" Style="{StaticResource PurpleSettingsGroupBoxStyle}" Margin="0,0,0,12">
                                    <StackPanel Margin="0,4,0,0">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Base Points Per Question" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                                <TextBox Text="{Binding TriviaBasePoints, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernCompactTextBoxStyle}" Width="75" HorizontalAlignment="Left" TextAlignment="Center" Height="28" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Wrong Answer Deduction" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" ToolTip="Points to deduct for wrong answer. Default: 0" />
                                                <TextBox Text="{Binding TriviaWrongAnswerDeduction, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernCompactTextBoxStyle}" Width="75" HorizontalAlignment="Left" TextAlignment="Center" Height="28" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Tiered Option Value Scoring (100% / 70% / 40%) -->
                                        <Border Background="#108B5CF6" BorderBrush="#338B5CF6" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                            <StackPanel>
                                                <CheckBox Content="Tiered Option Value (4=100%, 3=70%, 2=40%)"
                                                          Style="{StaticResource ModernCheckBoxStyle}"
                                                          Foreground="{DynamicResource AppContrastTextBrush}"
                                                          IsChecked="{Binding TriviaTieredScoringEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                          FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"
                                                          ToolTip="Awards full points if answered with all 4 options, 70% with 3 options, and 40% with 2 options." />
                                                <Grid IsEnabled="{Binding TriviaTieredScoringEnabled}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="4 Opt (%)" FontWeight="SemiBold" FontSize="10" Margin="0,0,0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                                        <TextBox Text="{Binding TriviaPoints4OptionsPercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernCompactTextBoxStyle}" Width="45" HorizontalAlignment="Left" TextAlignment="Center" Height="26" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="3 Opt (%)" FontWeight="SemiBold" FontSize="10" Margin="0,0,0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                                        <TextBox Text="{Binding TriviaPoints3OptionsPercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernCompactTextBoxStyle}" Width="45" HorizontalAlignment="Left" TextAlignment="Center" Height="26" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="2 Opt (%)" FontWeight="SemiBold" FontSize="10" Margin="0,0,0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                                        <TextBox Text="{Binding TriviaPoints2OptionsPercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernCompactTextBoxStyle}" Width="45" HorizontalAlignment="Left" TextAlignment="Center" Height="26" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <CheckBox Content="Speed Bonus"
                                                          Style="{StaticResource ModernCheckBoxStyle}"
                                                          Foreground="{DynamicResource AppContrastTextBrush}"
                                                          IsChecked="{Binding TriviaSpeedBonusEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                          FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding TriviaMaxSpeedBonus, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernCompactTextBoxStyle}" IsEnabled="{Binding TriviaSpeedBonusEnabled}" Width="75" HorizontalAlignment="Left" TextAlignment="Center" Height="28" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <CheckBox Content="Streak Bonus"
                                                          Style="{StaticResource ModernCheckBoxStyle}"
                                                          Foreground="{DynamicResource AppContrastTextBrush}"
                                                          IsChecked="{Binding TriviaStreakBonusEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                          FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding TriviaStreakMultiplier, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernCompactTextBoxStyle}" IsEnabled="{Binding TriviaStreakBonusEnabled}" Width="75" HorizontalAlignment="Left" TextAlignment="Center" Height="28" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>

                            <!-- COLUMN 1: Active Venue/Host & Intermission -->
                            <StackPanel Grid.Column="2">
                                <!-- 🏢 Active Venue & Game Master (Inherited from App Settings) -->
                                <GroupBox Header="🏢 Active Venue &amp; Host" Style="{StaticResource PurpleSettingsGroupBoxStyle}" Margin="0,0,0,12">
                                    <StackPanel Margin="0,4,0,0">
                                        <Border Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="4" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="🏢 Venue:" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding TriviaVenueName}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" TextTrimming="CharacterEllipsis" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="🎧 Host/DJ:" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding TriviaHostName}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="ℹ️ Automatically synchronized from primary Venue and DJ settings in KSRotation."
                                                   FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" Margin="0,0,0,8" />

                                        <TextBlock Text="Pre-Game Welcome Banner" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        <TextBox Text="{Binding TriviaInstructionBannerText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernCompactTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" Margin="0,0,0,2" />
                                        <TextBlock Text="Shown on the lobby screen before the game starts. Use {venue} and {dj} to insert the venue/host name."
                                                   FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </GroupBox>

                                <!-- 🔄 Intermission & Countdown Card -->
                                <GroupBox Header="🔄 Intermission &amp; Pre-Game" Style="{StaticResource BlueSettingsGroupBoxStyle}" Margin="0,0,0,12">
                                    <StackPanel Margin="0,4,0,0">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <CheckBox Content="Auto-start Next (Min)"
                                                          Style="{StaticResource ModernCheckBoxStyle}"
                                                          Foreground="{DynamicResource AppContrastTextBrush}"
                                                          IsChecked="{Binding TriviaAutoStartNextGame, UpdateSourceTrigger=PropertyChanged}"
                                                          FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding TriviaNextGameDelayMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernCompactTextBoxStyle}" IsEnabled="{Binding TriviaAutoStartNextGame}" Width="65" HorizontalAlignment="Left" TextAlignment="Center" Height="28" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <CheckBox Content="Pre-Game Delay (Min)"
                                                          Style="{StaticResource ModernCheckBoxStyle}"
                                                          Foreground="{DynamicResource AppContrastTextBrush}"
                                                          IsChecked="{Binding TriviaAutoStartAfterCountdown, UpdateSourceTrigger=PropertyChanged}"
                                                          FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding TriviaPreGameCountdownMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernCompactTextBoxStyle}" IsEnabled="{Binding TriviaAutoStartAfterCountdown}" Width="65" HorizontalAlignment="Left" TextAlignment="Center" Height="28" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>

                            <!-- COLUMN 2: Network, Wi-Fi & Save Actions -->
                            <StackPanel Grid.Column="4">
                                <!-- 📶 Wi-Fi & Network Card -->
                                <GroupBox Header="📶 Local Network &amp; Wi-Fi Access" Style="{StaticResource PurpleSettingsGroupBoxStyle}" Margin="0,0,0,12">
                                    <StackPanel Margin="0,4,0,0">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Port" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                                <TextBox Text="{Binding TriviaPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernCompactTextBoxStyle}" Width="65" HorizontalAlignment="Left" TextAlignment="Center" Height="28" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Wi-Fi SSID" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                                <TextBox Text="{Binding TriviaWifiSsid, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernCompactTextBoxStyle}" Height="28" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="Wi-Fi Password" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <TextBox Text="{Binding TriviaWifiPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernCompactTextBoxStyle}" Height="28" />
                                        </StackPanel>
                                        <Button Content="Auto-Detect Wi-Fi" Command="{Binding AutoDetectTriviaWifiCommand}"
                                                Style="{StaticResource ModernSecondaryButtonStyle}" Height="30" FontSize="11" ToolTip="Auto-detect current connected Wi-Fi and saved password" />
                                    </StackPanel>
                                </GroupBox>

                                <!-- 💾 Action Card -->
                                <Border Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <StackPanel>
                                        <Button Content="Save Settings" Command="{Binding SaveTriviaSettingsCommand}"
                                                Background="#8B5CF6" Foreground="#FFFFFF" Height="34" Margin="0,0,0,6" FontWeight="Bold" FontSize="12" />
                                        <Button Content="Reset Defaults" Command="{Binding ResetTriviaSettingsCommand}"
                                                Style="{StaticResource ModernSecondaryButtonStyle}" Height="28" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Help" Width="50" Height="45">

                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar: Help Topics -->
                    <Border Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0" Margin="0,0,12,0" Padding="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="HELP TOPICS" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="8,0,0,12" />
                            <ListBox ItemsSource="{Binding HelpTopics}"
                                     SelectedItem="{Binding SelectedHelpTopic}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" CornerRadius="4">
                                            <TextBlock Text="{Binding}" FontSize="14" />
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Margin" Value="0,2" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="4">
                                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHueMidBrush}" />
                                                            <Setter Property="Foreground" Value="White" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaterialDesignDivider}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- Content Panel -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="12,0,4,0">
                        <Grid>
                            <!-- Topic 1: Getting Started -->
                            <StackPanel x:Name="GettingStartedPanel">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedHelpTopic}" Value="🚀 Getting Started">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Getting Started" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppHeaderBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="Welcome to KSRotation, the premier Karaoke rotation manager. This app is designed to help hosts maintain a fair, structured, and dynamic singer queue."
                                           FontSize="14" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="20" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                <Border Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="🚀 Quick Start Guide" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" Foreground="{DynamicResource AppHeaderBrush}" />
                                        <TextBlock Text="1. Go to the Settings tab and add or select your current Venue Name." Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        <TextBlock Text="2. In the Rotation tab, click 'Add Singer' to enter singers, songs, and artists." Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        <TextBlock Text="3. Toggle 'Enable Display Window' to project the rotation onto a second monitor or TV." Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        <TextBlock Text="4. Click the '★' button next to a singer to mark them as currently singing." Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        <TextBlock Text="5. Check off numbered rounds as singers complete their songs to track stats." Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="🛜 Travel Router Field Setup (GL.iNet Slate AX)" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" Foreground="{DynamicResource AppHeaderBrush}" />
                                        <TextBlock Text="1. Connect your laptop and all singer phones to the same travel-router Wi-Fi network." Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                        <TextBlock Text="2. In the router admin page, reserve a fixed IP for the laptop running KSRotation (example: 192.168.50.10)." Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                        <TextBlock Text="3. In Windows Firewall, allow KSRotation on Private networks and allow port 5000." Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                        <TextBlock Text="4. Start KSRotation, then verify the portal URL card and QR code are visible on the main screen." Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                        <TextBlock Text="5. On a phone connected to the same router, open the shown URL (or scan the QR) and submit a test request before the show starts." Margin="0,2" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource PrimaryHueMidBrush}" BorderThickness="4,0,0,0" Padding="12" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="💡 Tip: Test Mode" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                                        <TextBlock Text="Enable 'Test Mode' in Settings to automatically pre-populate the queue with 15 sample singers on the next startup. Perfect for practicing or testing screen layouts!" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Topic 2: Rotation Management -->
                            <StackPanel x:Name="RotationPanel">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedHelpTopic}" Value="🎤 Rotation Management">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Rotation Management" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppHeaderBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="The Rotation grid is the heart of the application. Order is preserved sequentially from top to bottom."
                                           FontSize="14" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="20" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                <TextBlock Text="Key Actions &amp; Controls" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource AppHeaderBrush}" />
                                <BulletDecorator Margin="0,2">
                                    <BulletDecorator.Bullet>
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource MaterialDesignBodyLight}" />
                                    </BulletDecorator.Bullet>
                                    <TextBlock Text="Add Singer: Inserts a new performer at the end of the current active rotation round (right before whoever holds the '⚓ ANCHOR' badge). Automatically scrolls to the row, focuses the name field, and highlights 'New Singer' for immediate overwrite typing." Margin="10,0,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                </BulletDecorator>
                                <BulletDecorator Margin="0,2">
                                    <BulletDecorator.Bullet>
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource MaterialDesignBodyLight}" />
                                    </BulletDecorator.Bullet>
                                    <TextBlock Text="Add Special: Inserts a special guest or one-time performer immediately at the top of the queue (index 0) as the current singer. Automatically focuses the name field and highlights 'Special Guest' for immediate overwrite typing. When their song concludes, they are automatically marked inactive and normal rotation resumes." Margin="10,0,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                </BulletDecorator>
                                <BulletDecorator Margin="0,2">
                                    <BulletDecorator.Bullet>
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource MaterialDesignBodyLight}" />
                                    </BulletDecorator.Bullet>
                                    <TextBlock Text="Smart Proper-Casing: Automatically capitalizes performer names, duet partners, artists, and song titles while preserving intentional mixed-case capitalizations (such as 'DeaR' or 'LeBron') and correctly capitalizing prefix names (like 'O'Neal', 'D'Angelo', 'L'Amour') and Scottish/Irish 'Mc' surnames ('McDonald')." Margin="10,0,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                </BulletDecorator>
                                <BulletDecorator Margin="0,2">
                                    <BulletDecorator.Bullet>
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource MaterialDesignBodyLight}" />
                                    </BulletDecorator.Bullet>
                                    <TextBlock Text="⚓ Rotation Anchor: Marks the performer who started the rotation round with a red '⚓ ANCHOR' badge and card highlight, synced across desktop, DJ tablet (dj.html), and patron portals." Margin="10,0,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                </BulletDecorator>
                                <BulletDecorator Margin="0,2">
                                    <BulletDecorator.Bullet>
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource MaterialDesignBodyLight}" />
                                    </BulletDecorator.Bullet>
                                    <TextBlock Text="★ (Set Current): Designates the singer as active. This highlights their row in gold and updates the projector's 'NOW SINGING' banner." Margin="10,0,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                </BulletDecorator>
                                <BulletDecorator Margin="0,2">
                                    <BulletDecorator.Bullet>
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource MaterialDesignBodyLight}" />
                                    </BulletDecorator.Bullet>
                                    <TextBlock Text="▲ / ▼ (Reorder): Moves a singer up or down in the rotation list to adjust the queue manually. Estimated wait times and audience displays are recalculated and updated immediately based on their new position." Margin="10,0,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                </BulletDecorator>
                                <BulletDecorator Margin="0,2">
                                    <BulletDecorator.Bullet>
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource MaterialDesignBodyLight}" />
                                    </BulletDecorator.Bullet>
                                    <TextBlock Text="⏳ Estimated Wait Time Badges: Each performer row displays an estimated wait time badge (e.g. '⏳ 15m') when enabled in Settings, dynamically updating whenever performers sing, skip, or change queue positions." Margin="10,0,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                </BulletDecorator>
                                <BulletDecorator Margin="0,2">
                                    <BulletDecorator.Bullet>
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource MaterialDesignBodyLight}" />
                                    </BulletDecorator.Bullet>
                                    <TextBlock Text="⏱️ Round Completion Estimation Notice: A live status badge in the Rotation header (and on dj.html, tablet, and Lyracist) displays remaining performers, remaining round minutes, projected completion clock time (e.g. 'ends ~11:42 PM'), and full round duration. Updates dynamically every 15 seconds and recalculates on singer additions, reorders, skips, or finishes, providing vital end-of-night planning to know if there is time for another round." Margin="10,0,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                </BulletDecorator>
                                <BulletDecorator Margin="0,2">
                                    <BulletDecorator.Bullet>
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource MaterialDesignBodyLight}" />
                                    </BulletDecorator.Bullet>
                                    <TextBlock Text="✓ (Done): Marks the singer's current song as finished, automatically checks the next incomplete round checkbox to log it in history/database, and populates the Song/Artist fields with their next queued song or first pending request if available (otherwise clearing the fields)." Margin="10,0,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                </BulletDecorator>
                                <BulletDecorator Margin="0,2">
                                    <BulletDecorator.Bullet>
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource MaterialDesignBodyLight}" />
                                    </BulletDecorator.Bullet>
                                    <TextBlock Text="X (Toggle Inactive): Grays out the singer and excludes them from the display rotation and singer count badge. Use this if a singer steps out for a bit but will return later." Margin="10,0,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                </BulletDecorator>
                                <BulletDecorator Margin="0,2">
                                    <BulletDecorator.Bullet>
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource MaterialDesignBodyLight}" />
                                    </BulletDecorator.Bullet>
                                    <TextBlock Text="✓ (Accept Request): Adds a pending patron request to the rotation. If the singer is already listed, it avoids duplicate entries. If they have no song listed, it fills in their song/artist; if they already have a song, it queues it up as their next song." Margin="10,0,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                </BulletDecorator>
                                <BulletDecorator Margin="0,2">
                                    <BulletDecorator.Bullet>
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource MaterialDesignBodyLight}" />
                                    </BulletDecorator.Bullet>
                                    <TextBlock Text="Auto-accept incoming requests: Checkbox above the Incoming Requests list. When checked, patron requests skip the pending queue entirely and are added straight into the rotation the moment they come in." Margin="10,0,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                </BulletDecorator>

                                <Border Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="💾 Saving Reports" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,6" Foreground="{DynamicResource AppHeaderBrush}" />
                                        <TextBlock Text="Clicking 'Save Rotation' writes a text report of the night's performance to the 'Reports' directory. If 'Send email automatically' is enabled in Settings, the report will copy to your clipboard and prompt your default mail client with the rotation report pre-loaded." TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Topic 3: Device Switching & Live Handoff -->
                            <StackPanel x:Name="DeviceHandoffPanel">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedHelpTopic}" Value="🔄 Device Switching &amp; Live Handoff">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Device Switching &amp; Live Session Handoff" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppHeaderBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="Seamlessly migrate an ongoing karaoke show between a Windows laptop (KSRotation) and a mobile tablet (KSRotation.Maui on Android or Windows) without losing singer positions, completed rounds, or performance history."
                                           FontSize="14" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="20" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                <!-- Architectural Flow Graphic / Diagram Card -->
                                <Border Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource PrimaryHueMidBrush}" BorderThickness="2" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="📐 Architectural Flow: Live Session Handoff &amp; Remote DJ Takeover" FontWeight="Bold" FontSize="16" Margin="0,0,0,12" Foreground="{DynamicResource AppHeaderBrush}" />
                                        <Border Background="#1E1E2E" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <TextBlock FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12" Foreground="#89DDFF" TextWrapping="NoWrap" LineHeight="18">
                                                <Run Text="┌────────────────────────────────────────────────────────────────────────┐&#x0a;" />
                                                <Run Text="│        ARCHITECTURAL FLOW: LIVE SESSION HANDOFF &amp; REMOTE DJ TAKEOVER   │&#x0a;" />
                                                <Run Text="└────────────────────────────────────────────────────────────────────────┘&#x0a;&#x0a;" />
                                                <Run Foreground="#C792EA" Text="    DJ (Tablet: KSRotation.Maui)             KJ Host (Laptop: KSRotation)&#x0a;" />
                                                <Run Foreground="#C792EA" Text="    ┌───────────────────────────┐           ┌────────────────────────────┐&#x0a;" />
                                                <Run Foreground="#C792EA" Text="    │ Active rotation on tablet │           │ Arrives at venue &amp; opens   │&#x0a;" />
                                                <Run Foreground="#C792EA" Text="    │ Serves requests &amp; portal  │           │ 'Switch Device' on laptop  │&#x0a;" />
                                                <Run Foreground="#C792EA" Text="    └─────────────┬─────────────┘           └──────────────┬─────────────┘&#x0a;" />
                                                <Run Text="                  │                                        │&#x0a;" />
                                                <Run Foreground="#82AAFF" Text="                  │                                 [1] Wi-Fi Scan or IP&#x0a;" />
                                                <Run Foreground="#82AAFF" Text="                  │                                     Selects tablet&#x0a;" />
                                                <Run Text="                  │                                        │&#x0a;" />
                                                <Run Foreground="#FFCB6B" Text="                  │&lt;─────── 1. GET /api/session/handoff ───┤&#x0a;" />
                                                <Run Foreground="#FFCB6B" Text="                  │         (Sends Laptop IP, Port &amp; PIN)  │&#x0a;" />
                                                <Run Text="                  │                                        │&#x0a;" />
                                                <Run Foreground="#C3E88D" Text="                  ├─────── 2. 200 OK + Full Session JSON ─&gt;│&#x0a;" />
                                                <Run Foreground="#C3E88D" Text="                  │        (Queue, Checkmarks, History)    │&#x0a;" />
                                                <Run Text="                  │                                        │&#x0a;" />
                                                <Run Foreground="#82AAFF" Text="                  │                                 [2] Imports session&#x0a;" />
                                                <Run Foreground="#82AAFF" Text="                  │                                     Takes over host&#x0a;" />
                                                <Run Text="                  │                                        │&#x0a;" />
                                                <Run Foreground="#F78C6C" Text="  [3] Auto-switches to in-app                             │&#x0a;" />
                                                <Run Foreground="#F78C6C" Text="      Remote DJ (dj.html)                                  │&#x0a;" />
                                                <Run Foreground="#F78C6C" Text="      Pre-authenticated with PIN                           │&#x0a;" />
                                                <Run Text="                  │                                        │&#x0a;" />
                                                <Run Foreground="#C3E88D" Text="  [4] DJ manages show from floor via embedded tablet UI    │&#x0a;" />
                                                <Run Foreground="#89DDFF" Text="      ═════════════════════════════════════════════════════╪═══════════════&#x0a;" />
                                                <Run Foreground="#89DDFF" Text="      Seamless bi-directional synchronization over venue Wi-Fi!&#x0a;" />
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="The entire handoff process executes in under 2 seconds, migrating all live singers, historical data, and patron requests without skipping a beat."
                                                   FontSize="12" FontStyle="Italic" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Key Features List -->
                                <TextBlock Text="Key Capabilities &amp; Workflow" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource AppHeaderBrush}" />
