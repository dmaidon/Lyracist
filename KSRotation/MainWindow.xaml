                                <TextBlock Text="Add all your DJs to the list. Selecting a DJ updates the active DJ name instantly. Use '{dj}' in your banner and crawl text templates to automatically substitute the selected DJ's name. DJ files are saved in 'Settings/djs.json'." Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                <TextBlock Text="Theme Engine" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                                <TextBlock Text="Choose between Light, Dark, or System themes. Changing the theme instantly adjusts the main application visual styles dynamically using the Material Design in XAML Toolkit. With System selected, the app also follows live Windows light/dark switches automatically." Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                <TextBlock Text="Watermark Opacity" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                                <TextBlock Text="Adjust the background logo's transparency from 0% (Invisible) to 100% (Solid). This affects the centered logo watermarks on both the main dashboard and the audience projection screen in real-time." Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                <TextBlock Text="Email and Reports" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppHeaderBrush}" />
                                <TextBlock Text="Configure the Report Email Recipient. Check the box to launch your mail client automatically when 'Save Rotation' is clicked." Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" />

                                <Border Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource PrimaryHueMidBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,0">
