                                    <BulletDecorator.Bullet>
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource MaterialDesignBodyLight}" />
                                    </BulletDecorator.Bullet>
                                    <TextBlock Text="Kiosk Request Station (kiosk.html): Mount an Android/iPad tablet at the bar or near the stage in landscape mode. When idle, an attractive attractor screen greets patrons, inviting them to search songs and submit requests directly." Margin="10,0,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
                                </BulletDecorator>
                                <BulletDecorator Margin="0,2">
                                    <BulletDecorator.Bullet>
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource MaterialDesignBodyLight}" />
                                    </BulletDecorator.Bullet>
                                    <TextBlock Text="Chromecast TV Billboard (billboard.html): Stream the live stage billboard to Google Cast / Chromecast displays directly from KSRotation.Maui, featuring a dedicated full-height rotation queue and side-by-side QR code cards." Margin="10,0,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" />
