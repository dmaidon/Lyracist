                                    <TextBlock Text="Auto-accept incoming requests: Checkbox above the Incoming Requests list. When checked, patron requests skip the pending queue entirely and are added straight into the rotation the moment they come in." Margin="10,0,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                </BulletDecorator>

                                <Border Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
