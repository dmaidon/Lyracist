<!-- Edited on Oct 2, 2026 @ 13:16:00 -> Use Ellipse ImageBrush for circular performer avatars to prevent square edge bleed -->
<Window
    x:Class="KSRotation.Windows.SingerDisplayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:KSRotation.ViewModels"
    xmlns:conv="clr-namespace:KSRotation.Converters"
    xmlns:ctrl="clr-namespace:KSRotation.Controls"
    mc:Ignorable="d"
    Title="Singer Display"
    Width="450"
    Height="300"
    ResizeMode="CanResize"
    WindowStyle="SingleBorderWindow"
    Background="{DynamicResource MaterialDesignPaper}"
    Foreground="{DynamicResource MaterialDesignBody}"
    WindowStartupLocation="CenterOwner" Icon="/Windows/singer_64.png">

    <Window.DataContext>
        <vm:DisplayViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:FestivalTierFontSizeConverter x:Key="FestivalTierFontSizeConverter" />
    </Window.Resources>

    <!-- Fixed 1920x1080 design canvas scaled uniformly to the real window: a 1080p TV at 125-150% Windows
         scaling only offers ~720-864 DIPs of height, which truncated the tall themed panels (esp. Slot Machine). -->
    <Viewbox Stretch="Uniform">
    <Grid Width="1920" Height="1080" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- scrolling banner -->
            <RowDefinition Height="*" />
            <!-- content: normal list OR crawl -->
        </Grid.RowDefinitions>

        <!-- Row 0: Scrolling marquee and Last Round banner -->
        <StackPanel Grid.Row="0">
            <Border x:Name="BannerBorder"
                    Background="#222"
                    Padding="8"
                    Height="80"
                    ClipToBounds="True"
                    SizeChanged="BannerBorder_SizeChanged">
                <Canvas x:Name="BannerCanvas" ClipToBounds="True">
                    <TextBlock x:Name="BannerTextBlock"
                               FontSize="40"
                               Foreground="Cyan"
                               TextOptions.TextFormattingMode="Display" />
                </Canvas>
            </Border>

            <!-- Last Round Banner Strip -->
            <Border x:Name="LastRoundBanner"
                    Background="#D97706"
                    BorderBrush="#F59E0B"
                    BorderThickness="0,1,0,1"
                    Padding="16,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLastRound}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="★  THE LAST ROUND FOR THE NIGHT IS CURRENTLY UNDERWAY  ★"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextOptions.TextFormattingMode="Display" />
            </Border>
        </StackPanel>

        <!-- Row 1a: Normal singer list (hidden when crawl is active) -->
        <Grid Grid.Row="1" x:Name="NormalPanel" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="4,0,0,6"
                       Text="{}{} = Estimated wait time"
                       FontSize="20"
                       FontStyle="Italic"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       Visibility="{Binding ShowEstimatedWaitTime, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Panel.ZIndex="1">
                <ItemsControl ItemsSource="{Binding RotationEntries}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="12,4">
                                <Border Background="#8B5CF6" CornerRadius="4" Padding="4,1" Margin="0,0,8,0" VerticalAlignment="Center"
                                        ToolTip="Special Performer (one performance only)"
                                        Visibility="{Binding IsSpecial, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="⭐ SPECIAL" FontSize="14" FontWeight="ExtraBold" Foreground="White" />
                                </Border>
                                <Border Background="#DC2626" CornerRadius="4" Padding="4,1" Margin="0,0,8,0" VerticalAlignment="Center"
                                        ToolTip="Rotation Anchor (marks where a round begins)"
                                        Visibility="{Binding IsRotationStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="⚓ ANCHOR" FontSize="14" FontWeight="ExtraBold" Foreground="White" />
                                </Border>
                                <TextBlock FontSize="34">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Foreground" Value="Crimson" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding PrefixAndSinger, Mode=OneWay}" />
                                    <Run Text="{Binding SongSeparatorAndTitle, Mode=OneWay}" />
                                    <Run Text="{Binding ArtistInParentheses, Mode=OneWay}" FontStyle="Italic" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Row 1b: Star Wars crawl panel (replaces list when ShowCrawl=true) -->
        <!-- Sky uses a fixed near-black space color (not a theme brush) so the white stars stand out. -->
        <Grid Grid.Row="1" x:Name="CrawlPanel" Background="#FF04060B" Visibility="Collapsed">
            <!-- Hidden wrapper container to keep the visual brush source canvas rendering active without displaying it on the screen -->
            <Grid Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True">
                <Canvas x:Name="CrawlSourceCanvas" Width="800" Height="1200" Background="Transparent" />
            </Grid>

            <!-- The crawl text canvas is built in XAML and hosted as the VisualBrush.Visual on the 3D quad.
                 Wrapping it in a 0x0 clipped grid keeps layout and render passes active. -->

            <!-- Solid near-black backdrop behind the stars and 3D crawl. -->
            <Rectangle Fill="#FF04060B" />

            <!-- Stars added by code render above the black fill. -->
            <Canvas x:Name="CrawlStarCanvas" SizeChanged="CrawlStarCanvas_SizeChanged" Panel.ZIndex="2" />

            <Viewport3D x:Name="CrawlViewport" Panel.ZIndex="3">
                <Viewport3D.Camera>
                    <PerspectiveCamera
                        Position="0,3,-1"
                        LookDirection="0,-1.2,4"
                        UpDirection="0,1,0"
                        FieldOfView="50" />
                </Viewport3D.Camera>
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <GeometryModel3D>
                            <GeometryModel3D.Geometry>
                                <MeshGeometry3D
                                    Positions="-2.2,0,0  2.2,0,0  2.2,0,24  -2.2,0,24"
                                    TriangleIndices="0,2,1  0,3,2"
                                    TextureCoordinates="1,1  0,1  0,0  1,0" />
                            </GeometryModel3D.Geometry>
                            <!-- EmissiveMaterial: renders the brush at full brightness regardless of
                                 lighting. DiffuseMaterial requires lights; without them it renders black.
                                 BackMaterial ensures the quad is visible from both face directions so
                                 winding order can never hide it. -->
                            <GeometryModel3D.Material>
                                <EmissiveMaterial x:Name="CrawlMaterial" Brush="Transparent" />
                            </GeometryModel3D.Material>
                            <GeometryModel3D.BackMaterial>
                                <EmissiveMaterial x:Name="CrawlBackMaterial" Brush="Transparent" />
                            </GeometryModel3D.BackMaterial>
                        </GeometryModel3D>
                    </ModelVisual3D.Content>
                </ModelVisual3D>
            </Viewport3D>
        </Grid>

        <!-- Row 1d: Vegas / Broadway Marquee panel -->
        <Grid Grid.Row="1" x:Name="MarqueePanel" Visibility="Collapsed">
            <!-- Deep theatrical backdrop (fixed colors – this is a themed stage scene, not a UI surface). -->
            <Grid.Background>
                <RadialGradientBrush GradientOrigin="0.5,0.42" Center="0.5,0.42" RadiusX="0.75" RadiusY="0.75">
                    <GradientStop Color="#FF3A0A12" Offset="0.0" />
                    <GradientStop Color="#FF1A040A" Offset="0.55" />
                    <GradientStop Color="#FF080205" Offset="1.0" />
                </RadialGradientBrush>
            </Grid.Background>

            <!-- Brass marquee frame -->
            <Border x:Name="MarqueeFrame" Margin="54" CornerRadius="20" BorderThickness="5">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFFE9A8" Offset="0.0" />
                        <GradientStop Color="#FFE0A93B" Offset="0.5" />
                        <GradientStop Color="#FFB9822A" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#CC15060A" Offset="0.0" />
                        <GradientStop Color="#CC0A0205" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid Margin="40,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <TextBlock x:Name="MarqueeHeader"
                                   Text="{Binding PerformerHeaderText}"
                                   HorizontalAlignment="Center"
                                   FontSize="48"
                                   FontWeight="Bold"
                                   Foreground="#FFFFD86B"
                                   TextOptions.TextFormattingMode="Display">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FFB9822A" BlurRadius="14" ShadowDepth="0" Opacity="0.8" />
                            </TextBlock.Effect>
                        </TextBlock>

                        <!-- Active Singers in Rotation Pill -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="#33E0A93B" BorderBrush="#88E0A93B" BorderThickness="1.5"
                                CornerRadius="14" Padding="12,5" Margin="0,0,10,0"
                                Visibility="{Binding HasActiveSingers, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎤 " FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveSingerCountText}"
                                           FontSize="14" FontWeight="Bold" Foreground="#FFFFD86B"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Current singer name + song (vertically centered) -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Performer Selfie / Avatar -->
                        <Border Width="130" Height="130" CornerRadius="65" BorderThickness="4" BorderBrush="#FFFFD86B"
                                HorizontalAlignment="Center" Margin="0,0,0,16"
                                Visibility="{Binding HasCurrentSingerAvatar, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border.Effect>
                                <DropShadowEffect Color="#FFB9822A" BlurRadius="24" ShadowDepth="0" Opacity="0.85" />
                            </Border.Effect>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding CurrentSingerAvatar}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Border>

                        <Border Background="#DC2626" CornerRadius="8" Padding="10,4" Margin="0,0,0,10" HorizontalAlignment="Center"
                                ToolTip="Rotation Anchor (marks where a round begins)"
                                Visibility="{Binding CurrentSingerIsRotationStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="⚓ ANCHOR" FontSize="22" FontWeight="ExtraBold" Foreground="White" />
                        </Border>
                        <Border Background="#8B5CF6" CornerRadius="8" Padding="10,4" Margin="0,0,0,10" HorizontalAlignment="Center"
                                ToolTip="Special Performer (One-Time)"
                                Visibility="{Binding CurrentSingerIsSpecial, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="⭐ SPECIAL" FontSize="22" FontWeight="ExtraBold" Foreground="White" />
                        </Border>
                        <TextBlock x:Name="MarqueeSingerName" Text="{Binding CurrentSingerName}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="108"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFFFF"
                                   TextOptions.TextFormattingMode="Ideal">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FFFFD86B" BlurRadius="28" ShadowDepth="0" Opacity="0.85" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="MarqueeSingerSong" Text="{Binding CurrentSingerSong}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"
                                   FontSize="42"
                                   FontStyle="Italic"
                                   Foreground="#FFFFD86B" />
                    </StackPanel>

                    <!-- Divider -->
                    <Rectangle Grid.Row="2" Height="2" Margin="40,18" Fill="#55E0A93B" />

                    <!-- Up next strip -->
                    <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,0,0,4">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <!-- Lift the list above the synth bars only while they are showing -->
                                    <DataTrigger Binding="{Binding ShowSpectrum}" Value="True">
                                        <Setter Property="Margin" Value="0,0,0,180" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="UP NEXT"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#FFE0A93B" />
                            <Border Background="#33E0A93B" BorderBrush="#88E0A93B" BorderThickness="1"
                                    CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasActiveSingers, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding ActiveSingerCountText}"
                                           FontSize="12" FontWeight="Bold" Foreground="#FFFFD86B" />
                            </Border>
                            <TextBlock Text=" : {} = Estimated wait time"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#FFE0A93B"
                                       Visibility="{Binding ShowEstimatedWaitTime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding NextSingers}" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="6,4"
                                            Padding="14,6"
                                            CornerRadius="14"
                                            Background="#33E0A93B"
                                            BorderBrush="#66E0A93B"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#DC2626" CornerRadius="4" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center"
                                                    ToolTip="Rotation Anchor (marks where a round begins)"
                                                    Visibility="{Binding IsRotationStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="⚓ ANCHOR" FontSize="11" FontWeight="ExtraBold" Foreground="White" />
                                            </Border>
                                            <TextBlock Text="{Binding Text}"
                                                       FontSize="20"
                                                       Foreground="#FFF7E8C8" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Chasing light bulbs around the frame (built/animated in code-behind). -->
            <Canvas x:Name="MarqueeBulbCanvas" Margin="54" SizeChanged="MarqueeBulbCanvas_SizeChanged" Panel.ZIndex="5" />
        </Grid>

        <!-- Row 1d: Purple Velvet Curtain panel -->
        <Grid Grid.Row="1" x:Name="CurtainPanel" Visibility="Collapsed" ClipToBounds="True">
            <!-- Royal purple velvet horizontal backdrop -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF26073E" Offset="0.0" />
                    <GradientStop Color="#FF4A0F6D" Offset="0.25" />
                    <GradientStop Color="#FF8A21AC" Offset="0.5" />
                    <GradientStop Color="#FF4A0F6D" Offset="0.75" />
                    <GradientStop Color="#FF26073E" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Vertical procedural velvet drapery folds canvas -->
            <Canvas x:Name="CurtainFoldsCanvas" Panel.ZIndex="1" IsHitTestVisible="False" />

            <!-- Theatrical marquee bulbs around the outer display perimeter -->
            <Canvas x:Name="CurtainBulbCanvas" Panel.ZIndex="2" SizeChanged="CurtainBulbCanvas_SizeChanged" IsHitTestVisible="False" />

            <!-- Theatrical stage content (floats directly on the velvet curtain, inside bulb perimeter) -->
            <Grid Margin="110,75,110,75" Panel.ZIndex="3">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🎭 " FontSize="40" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock x:Name="CurtainHeader"
                                   Text="{Binding PerformerHeaderText}"
                                   FontSize="54"
                                   FontWeight="Bold"
                                   Foreground="#FFFFD76A"
                                   TextOptions.TextFormattingMode="Display">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="0" Opacity="0.95" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>

                    <!-- Active Singers in Rotation Pill -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="#55000000" BorderBrush="#88FFD76A" BorderThickness="1.5"
                            CornerRadius="16" Padding="14,6" Margin="0,0,10,0"
                            Visibility="{Binding HasActiveSingers, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎤 " FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActiveSingerCountText}"
                                       FontSize="16" FontWeight="Bold" Foreground="#FFFFD76A"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Current singer centerpiece (vertically centered on velvet) -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Performer Selfie / Avatar -->
                    <Border Width="140" Height="140" CornerRadius="70" BorderThickness="4" BorderBrush="#FFFFD76A"
                            HorizontalAlignment="Center" Margin="0,0,0,16"
                            Visibility="{Binding HasCurrentSingerAvatar, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="0" Opacity="0.95" />
                        </Border.Effect>
                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding CurrentSingerAvatar}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Border>

                    <!-- Anchor / Special Badges -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Border Background="#DC2626" CornerRadius="8" Padding="12,4" Margin="6,0"
                                ToolTip="Rotation Anchor (marks where a round begins)"
                                Visibility="{Binding CurrentSingerIsRotationStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                            </Border.Effect>
                            <TextBlock Text="⚓ ANCHOR" FontSize="22" FontWeight="ExtraBold" Foreground="White" />
                        </Border>
                        <Border Background="#8B5CF6" CornerRadius="8" Padding="12,4" Margin="6,0"
                                ToolTip="Special Performer (One-Time)"
                                Visibility="{Binding CurrentSingerIsSpecial, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                            </Border.Effect>
                            <TextBlock Text="⭐ SPECIAL" FontSize="22" FontWeight="ExtraBold" Foreground="White" />
                        </Border>
                    </StackPanel>

                    <!-- Current Singer Name (Viewbox for auto-fit scaling, pure white with black drop shadow) -->
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="1600" MaxHeight="220" HorizontalAlignment="Center">
                        <TextBlock x:Name="CurtainSingerName" Text="{Binding CurrentSingerName}"
                                   FontFamily="Segoe UI Black, Segoe UI"
                                   FontSize="128"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFFFF"
                                   TextAlignment="Center"
                                   TextOptions.TextFormattingMode="Ideal">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="36" ShadowDepth="0" Opacity="0.98" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </Viewbox>

                    <!-- Current Song -->
                    <TextBlock x:Name="CurtainSingerSong" Text="{Binding CurrentSingerSong}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,14,0,0"
                               FontSize="46"
                               FontStyle="Italic"
                               Foreground="#FFFFE9B0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.9" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- Up next strip -->
                <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,12,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <!-- Lift the list above the synth bars only while they are showing -->
                                <DataTrigger Binding="{Binding ShowSpectrum}" Value="True">
                                    <Setter Property="Margin" Value="0,12,0,190" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="UP NEXT"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#FFFFD76A">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="0" Opacity="0.9" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <Border Background="#44000000" BorderBrush="#88FFD76A" BorderThickness="1"
                                CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding HasActiveSingers, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding ActiveSingerCountText}"
                                       FontSize="12" FontWeight="Bold" Foreground="#FFFFD76A" />
                        </Border>
                        <TextBlock Text=" : {} = Estimated wait time"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#FFFFD76A"
                                   Visibility="{Binding ShowEstimatedWaitTime, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="0" Opacity="0.9" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding NextSingers}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="6,4"
                                        Padding="14,6"
                                        CornerRadius="14"
                                        Background="#44000000"
                                        BorderBrush="#66FFD76A"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="0" Opacity="0.6" />
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#DC2626" CornerRadius="4" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center"
                                                ToolTip="Rotation Anchor (marks where a round begins)"
                                                Visibility="{Binding IsRotationStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="⚓ ANCHOR" FontSize="10" FontWeight="ExtraBold" Foreground="White" />
                                        </Border>
                                        <Border Background="#8B5CF6" CornerRadius="4" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center"
                                                ToolTip="Special Performer (One-Time)"
                                                Visibility="{Binding IsSpecial, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="⭐ SPECIAL" FontSize="10" FontWeight="ExtraBold" Foreground="White" />
                                        </Border>
                                        <TextBlock Text="{Binding Text}"
                                                   FontSize="18"
                                                   Foreground="#FFFFE9B0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Grid>


        <!-- Row 1e: Vinyl "Now Spinning" turntable panel -->
        <Grid Grid.Row="1" x:Name="VinylPanel" Visibility="Collapsed">
            <!-- Warm dark DJ-booth backdrop (fixed colors – themed scene, not a UI surface). -->
            <Grid.Background>
                <RadialGradientBrush GradientOrigin="0.35,0.45" Center="0.35,0.45" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#FF1E1814" Offset="0.0" />
                    <GradientStop Color="#FF120D0A" Offset="0.55" />
                    <GradientStop Color="#FF070504" Offset="1.0" />
                </RadialGradientBrush>
            </Grid.Background>

            <Grid Margin="48,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Turntable (scales with the column via Viewbox; fixed internal coordinates) -->
                <Viewbox Grid.Column="0" Stretch="Uniform" Margin="0,0,24,0">
                    <Canvas Width="520" Height="520">
                        <!-- Spinning disc group -->
                        <Grid x:Name="VinylDisc" Width="440" Height="440" Canvas.Left="40" Canvas.Top="40"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="VinylRotate" />
                            </Grid.RenderTransform>

                            <!-- Disc body -->
                            <Ellipse Width="440" Height="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FF242424" Offset="0.0" />
                                        <GradientStop Color="#FF0E0E0E" Offset="0.75" />
                                        <GradientStop Color="#FF050505" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Stroke>
                                    <SolidColorBrush Color="#FF333333" />
                                </Ellipse.Stroke>
                            </Ellipse>

                            <!-- Rotating sheen so the spin is visible on the plain black disc -->
                            <Ellipse Width="440" Height="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#30FFFFFF" Offset="0.0" />
                                        <GradientStop Color="#00FFFFFF" Offset="0.45" />
                                        <GradientStop Color="#00FFFFFF" Offset="0.55" />
                                        <GradientStop Color="#14FFFFFF" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- Center label (large, like a 45 single) -->
                            <Ellipse Width="220" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FFE8BC52" Offset="0.0" />
                                        <GradientStop Color="#FFCB9533" Offset="0.7" />
                                        <GradientStop Color="#FFB9822A" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Stroke>
                                    <SolidColorBrush Color="#FF8A5F1C" />
                                </Ellipse.Stroke>
                            </Ellipse>

                            <!-- Singer name on the label, above the big 45 hole -->
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,84"
                                       Width="184" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Text="{Binding CurrentSingerName}"
                                       FontSize="22" FontWeight="Bold" Foreground="#FF2A1A05" />

                            <!-- Song title (no artist) on the label, below the big 45 hole -->
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,86,0,0"
                                       Width="184" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Text="{Binding CurrentSongTitle}"
                                       FontSize="16" FontStyle="Italic" Foreground="#FF3A2608" />

                            <!-- Large 45 RPM center hole -->
                            <Ellipse Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#FF120D0A" Stroke="#66000000" StrokeThickness="1.5" />
                        </Grid>

                        <!-- Tonearm (static), pivot at upper-right -->
                        <Grid Width="60" Height="300" Canvas.Left="392" Canvas.Top="46"
                              RenderTransformOrigin="0.5,0.12">
                            <Grid.RenderTransform>
                                <RotateTransform Angle="-26" />
                            </Grid.RenderTransform>
                            <!-- Counterweight -->
                            <Ellipse Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FF6B6B6B" Offset="0.0" />
                                        <GradientStop Color="#FF2C2C2C" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <!-- Pivot collar -->
                            <Ellipse Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0" Fill="#FF4A4A4A" />
                            <!-- Arm tube -->
                            <Rectangle Width="10" Height="232" RadiusX="5" RadiusY="5" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF8A8A8A" Offset="0.0" />
                                        <GradientStop Color="#FFCFCFCF" Offset="0.5" />
                                        <GradientStop Color="#FF6E6E6E" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <!-- Headshell -->
                            <Border Width="34" Height="24" CornerRadius="3" Background="#FF1C1C1C" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                        </Grid>
                    </Canvas>
                </Viewbox>

                <!-- Now-playing text -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NowSpinningText}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#FFE0A93B"
                                   TextOptions.TextFormattingMode="Display" />
                        <Border Background="#33E0A93B" BorderBrush="#88E0A93B" BorderThickness="1.5"
                                CornerRadius="12" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding HasActiveSingers, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎤 " FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveSingerCountText}"
                                           FontSize="13" FontWeight="Bold" Foreground="#FFFFD86B"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Performer Selfie / Avatar -->
                    <Border Width="110" Height="110" CornerRadius="55" BorderThickness="3.5" BorderBrush="#FFE0A93B"
                            HorizontalAlignment="Left" Margin="0,0,0,14"
                            Visibility="{Binding HasCurrentSingerAvatar, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border.Effect>
                            <DropShadowEffect Color="#FFE0A93B" BlurRadius="18" ShadowDepth="0" Opacity="0.75" />
                        </Border.Effect>
                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding CurrentSingerAvatar}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Border>

                    <Border Background="#DC2626" CornerRadius="6" Padding="8,3" Margin="0,0,0,8" HorizontalAlignment="Left"
                            ToolTip="Rotation Anchor (marks where a round begins)"
                            Visibility="{Binding CurrentSingerIsRotationStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="⚓ ANCHOR" FontSize="18" FontWeight="ExtraBold" Foreground="White" />
                    </Border>
                    <Border Background="#8B5CF6" CornerRadius="6" Padding="8,3" Margin="0,0,0,8" HorizontalAlignment="Left"
                            ToolTip="Special Performer (One-Time)"
                            Visibility="{Binding CurrentSingerIsSpecial, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="⭐ SPECIAL" FontSize="18" FontWeight="ExtraBold" Foreground="White" />
                    </Border>
                    <TextBlock Text="{Binding CurrentSingerName}"
                               TextWrapping="Wrap"
                               FontSize="78"
                               FontWeight="Bold"
                               Foreground="#FFFFFFFF"
                               TextOptions.TextFormattingMode="Ideal">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FFE0A93B" BlurRadius="22" ShadowDepth="0" Opacity="0.6" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <TextBlock Text="{Binding CurrentSingerSong}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               FontSize="34"
                               FontStyle="Italic"
                               Foreground="#FFE8BC52" />

                    <Rectangle Height="2" Margin="0,20,40,16" Fill="#44E0A93B" HorizontalAlignment="Stretch" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                        <TextBlock Text="ON DECK"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#FFB98A3A" />
                        <Border Background="#22E0A93B" BorderBrush="#66E0A93B" BorderThickness="1"
                                CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding HasActiveSingers, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding ActiveSingerCountText}"
                                       FontSize="14" FontWeight="Bold" Foreground="#FFE8BC52" />
                        </Border>
                        <TextBlock Text=" : {} = Estimated wait time"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#FFB98A3A"
                                   Visibility="{Binding ShowEstimatedWaitTime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding NextSingers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Border Background="#DC2626" CornerRadius="4" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center"
                                            ToolTip="Rotation Anchor (marks where a round begins)"
                                            Visibility="{Binding IsRotationStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="⚓ ANCHOR" FontSize="13" FontWeight="ExtraBold" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="{Binding Text}"
                                               FontSize="24"
                                               Foreground="#FFE6D6B8" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Row 1f: Disco Ball dance-floor panel -->
        <Grid Grid.Row="1" x:Name="DiscoPanel" Visibility="Collapsed">
            <!-- Dark club backdrop (fixed colors – themed scene, not a UI surface). -->
            <Grid.Background>
                <RadialGradientBrush GradientOrigin="0.5,0.15" Center="0.5,0.15" RadiusX="1.1" RadiusY="1.1">
                    <GradientStop Color="#FF241238" Offset="0.0" />
                    <GradientStop Color="#FF120A20" Offset="0.55" />
                    <GradientStop Color="#FF050308" Offset="1.0" />
                </RadialGradientBrush>
            </Grid.Background>

            <!-- Sweeping colored light beams, anchored at the ball (built/animated in code-behind) -->
            <Canvas x:Name="DiscoBeamCanvas" SizeChanged="DiscoBeamCanvas_SizeChanged" ClipToBounds="True" Panel.ZIndex="1" />

            <!-- Floating reflected light spots drifting across the floor (built/animated in code-behind) -->
            <Canvas x:Name="DiscoLightCanvas" SizeChanged="DiscoLightCanvas_SizeChanged" ClipToBounds="True" Panel.ZIndex="2" />

            <Grid Margin="48,20" Panel.ZIndex="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Mirror ball -->
                <Viewbox Grid.Row="0" Stretch="Uniform" Height="180" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <Canvas Width="260" Height="260">
                        <!-- Hanging cable -->
                        <Rectangle Width="3" Height="40" Canvas.Left="128.5" Canvas.Top="0" Fill="#66FFFFFF" />

                        <Grid x:Name="DiscoBall" Width="220" Height="220" Canvas.Left="20" Canvas.Top="40" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="DiscoBallRotate" />
                            </Grid.RenderTransform>

                            <!-- Sphere base -->
                            <Ellipse Width="220" Height="220">
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="0.35,0.3" Center="0.35,0.3">
                                        <GradientStop Color="#FFEDEDED" Offset="0.0" />
                                        <GradientStop Color="#FFB8B8C2" Offset="0.45" />
                                        <GradientStop Color="#FF6A6A78" Offset="0.85" />
                                        <GradientStop Color="#FF3A3A44" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- Mirror facet grid, tiled across the sphere -->
                            <Ellipse Width="220" Height="220">
                                <Ellipse.Fill>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,22,22" ViewportUnits="Absolute" Opacity="0.6">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing>
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,20,20" />
                                                </GeometryDrawing.Geometry>
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="#33101018" Thickness="1.2" />
                                                </GeometryDrawing.Pen>
                                                <GeometryDrawing.Brush>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#88FFFFFF" Offset="0.0" />
                                                        <GradientStop Color="#22FFFFFF" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </GeometryDrawing.Brush>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- Specular highlight -->
                            <Ellipse Width="70" Height="46" Canvas.Left="46" Canvas.Top="40">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#CCFFFFFF" Offset="0.0" />
                                        <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                    </Canvas>
                </Viewbox>

                <!-- Now performing / up next content -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <!-- Current singer -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🪩  NOW PERFORMING..." FontSize="24" FontWeight="Bold" Foreground="#FFE86BFF" TextOptions.TextFormattingMode="Display"
                                   HorizontalAlignment="Center" Margin="0,0,0,12" />

                        <!-- Performer Selfie / Avatar -->
                        <Border Width="130" Height="130" CornerRadius="65" BorderThickness="5" BorderBrush="#FFE86BFF" HorizontalAlignment="Center" Margin="0,0,0,16"
                                Visibility="{Binding HasCurrentSingerAvatar, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border.Effect>
                                <DropShadowEffect Color="#FFE86BFF" BlurRadius="30" ShadowDepth="0" Opacity="0.85" />
                            </Border.Effect>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding CurrentSingerAvatar}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Border>

                        <Border Background="#DC2626" CornerRadius="8" Padding="10,4" Margin="0,0,0,10" HorizontalAlignment="Center"
                                ToolTip="Rotation Anchor (marks where a round begins)"
                                Visibility="{Binding CurrentSingerIsRotationStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="⚓ ANCHOR" FontSize="22" FontWeight="ExtraBold" Foreground="White" />
                        </Border>
                        <Border Background="#8B5CF6" CornerRadius="8" Padding="10,4" Margin="0,0,0,10" HorizontalAlignment="Center"
                                ToolTip="Special Performer (One-Time)"
                                Visibility="{Binding CurrentSingerIsSpecial, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="⭐ SPECIAL" FontSize="22" FontWeight="ExtraBold" Foreground="White" />
                        </Border>

                        <TextBlock Text="{Binding CurrentSingerName}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="82"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextOptions.TextFormattingMode="Ideal">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FFE86BFF" BlurRadius="30" ShadowDepth="0" Opacity="0.85" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="{Binding CurrentSingerSong}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"
                                   FontSize="32"
                                   FontStyle="Italic"
                                   Foreground="#FF7BD8FF" />
                    </StackPanel>

                    <!-- Up next: deliberately smaller/dimmer than the current singer so attention stays there -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0" Opacity="0.82">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="UP NEXT" FontSize="18" FontWeight="Bold" Foreground="#AA9FC7E8" />
                            <Border Background="#1833CCFF" BorderBrush="#4433CCFF" BorderThickness="1" CornerRadius="10" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasActiveSingers, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding ActiveSingerCountText}" FontSize="12" FontWeight="Bold" Foreground="#AA9FC7E8" />
                            </Border>
                            <TextBlock Text=" : {} = Estimated wait time"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#AA9FC7E8"
                                       Visibility="{Binding ShowEstimatedWaitTime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding NextSingers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,3" Padding="10,6" CornerRadius="10" Background="#12FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#DC2626" CornerRadius="4" Padding="3,1" Margin="0,0,6,0" VerticalAlignment="Center"
                                                    ToolTip="Rotation Anchor (marks where a round begins)"
                                                    Visibility="{Binding IsRotationStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="⚓ ANCHOR" FontSize="12" FontWeight="ExtraBold" Foreground="White" />
                                            </Border>
                                            <TextBlock Text="{Binding Text}" FontSize="18" Foreground="#CCE6DCFF" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Row 1g: Synthwave Grid panel -->
        <Grid Grid.Row="1" x:Name="SynthwavePanel" Visibility="Collapsed" ClipToBounds="True">
            <!-- Retro sunset sky (fixed colors – themed scene, not a UI surface). -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF1A0B2E" Offset="0.0" />
                    <GradientStop Color="#FF3B0F5C" Offset="0.32" />
                    <GradientStop Color="#FFB0219E" Offset="0.58" />
                    <GradientStop Color="#FFFF6B4A" Offset="0.76" />
                    <GradientStop Color="#FFFFC24A" Offset="0.9" />
                    <GradientStop Color="#FF1A0B2E" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Sun, fixed position/size, drawn entirely in XAML -->
            <Viewbox Panel.ZIndex="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top" Height="200" Margin="0,20,0,0">
                <Canvas Width="300" Height="300">
                    <Ellipse Width="260" Height="260" Canvas.Left="20" Canvas.Top="20">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.5,0.4" Center="0.5,0.4">
                                <GradientStop Color="#FFFFF3B0" Offset="0.0" />
                                <GradientStop Color="#FFFFC24A" Offset="0.35" />
                                <GradientStop Color="#FFFF6B4A" Offset="0.65" />
                                <GradientStop Color="#FFE8398A" Offset="1.0" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#FFFF6B9E" BlurRadius="60" ShadowDepth="0" Opacity="0.85" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <!-- Retro "blinds" stripes across the lower half of the sun only -->
                    <Rectangle Width="260" Height="130" Canvas.Left="20" Canvas.Top="150">
                        <Rectangle.Clip>
                            <EllipseGeometry Center="130,0" RadiusX="130" RadiusY="130" />
                        </Rectangle.Clip>
                        <Rectangle.Fill>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,260,14" ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing Brush="#991A0B2E">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,260,6" />
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Canvas>
            </Viewbox>

            <!-- Perspective grid floor: static converging verticals + streaming horizontals (built/animated in code-behind) -->
            <Canvas x:Name="SynthGridCanvas" SizeChanged="SynthGridCanvas_SizeChanged" ClipToBounds="True" Panel.ZIndex="2" />

            <!-- Now performing / up next content -->
            <Grid Margin="48,20" Panel.ZIndex="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Current singer -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🌆  NOW PERFORMING..." FontSize="24" FontWeight="Bold" Foreground="#FF6BE8FF" TextOptions.TextFormattingMode="Display"
                               HorizontalAlignment="Center" Margin="0,0,0,12" />

                    <!-- Performer Selfie / Avatar -->
                    <Border Width="130" Height="130" CornerRadius="65" BorderThickness="5" BorderBrush="#FFFF6BE0" HorizontalAlignment="Center" Margin="0,0,0,16"
                            Visibility="{Binding HasCurrentSingerAvatar, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border.Effect>
                            <DropShadowEffect Color="#FFFF6BE0" BlurRadius="30" ShadowDepth="0" Opacity="0.85" />
                        </Border.Effect>
                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding CurrentSingerAvatar}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Border>

                    <Border Background="#DC2626" CornerRadius="8" Padding="10,4" Margin="0,0,0,10" HorizontalAlignment="Center"
                            ToolTip="Rotation Anchor (marks where a round begins)"
                            Visibility="{Binding CurrentSingerIsRotationStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="⚓ ANCHOR" FontSize="22" FontWeight="ExtraBold" Foreground="White" />
                    </Border>
                    <Border Background="#8B5CF6" CornerRadius="8" Padding="10,4" Margin="0,0,0,10" HorizontalAlignment="Center"
                            ToolTip="Special Performer (One-Time)"
                            Visibility="{Binding CurrentSingerIsSpecial, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="⭐ SPECIAL" FontSize="22" FontWeight="ExtraBold" Foreground="White" />
                    </Border>

                    <TextBlock Text="{Binding CurrentSingerName}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="82"
                               FontWeight="Bold"
                               Foreground="White"
                               TextOptions.TextFormattingMode="Ideal">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FFFF6BE0" BlurRadius="30" ShadowDepth="0" Opacity="0.85" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="{Binding CurrentSingerSong}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               FontSize="32"
                               FontStyle="Italic"
                               Foreground="#FF6BE8FF" />
                </StackPanel>

                <!-- Up next: deliberately smaller/dimmer than the current singer so attention stays there -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0" Opacity="0.82">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="UP NEXT" FontSize="18" FontWeight="Bold" Foreground="#AA9FE8E0" />
                        <Border Background="#1833D4FF" BorderBrush="#4433D4FF" BorderThickness="1" CornerRadius="10" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding HasActiveSingers, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding ActiveSingerCountText}" FontSize="12" FontWeight="Bold" Foreground="#AA9FE8E0" />
                        </Border>
                        <TextBlock Text=" : {} = Estimated wait time"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#AA9FE8E0"
                                   Visibility="{Binding ShowEstimatedWaitTime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding NextSingers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,3" Padding="10,6" CornerRadius="10" Background="#12FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#DC2626" CornerRadius="4" Padding="3,1" Margin="0,0,6,0" VerticalAlignment="Center"
                                                ToolTip="Rotation Anchor (marks where a round begins)"
                                                Visibility="{Binding IsRotationStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="⚓ ANCHOR" FontSize="12" FontWeight="ExtraBold" Foreground="White" />
                                        </Border>
                                        <TextBlock Text="{Binding Text}" FontSize="18" Foreground="#CCE0F0FF" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Row 1h: Concert Festival Lineup panel -->
        <Grid Grid.Row="1" x:Name="FestivalPanel" Visibility="Collapsed" ClipToBounds="True">
            <!-- Night-sky backdrop behind the stage (fixed colors – themed scene, not a UI surface). -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF120A24" Offset="0.0" />
                    <GradientStop Color="#FF1E0F3A" Offset="0.5" />
                    <GradientStop Color="#FF05030C" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Twinkling night-sky sparkles (built/animated in code-behind) -->
            <Canvas x:Name="FestivalSparkleCanvas" SizeChanged="FestivalSparkleCanvas_SizeChanged" ClipToBounds="True" Panel.ZIndex="1" />

            <!-- Sweeping stage light beams from below (built/animated in code-behind) -->
            <Canvas x:Name="FestivalBeamCanvas" SizeChanged="FestivalBeamCanvas_SizeChanged" ClipToBounds="True" Panel.ZIndex="2" />

            <!-- Poster content -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="3" Margin="48,20">
                <Border Background="#33FFC24A" BorderBrush="#66FFC24A" BorderThickness="1.5" CornerRadius="14" Padding="14,5" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="🎪 TONIGHT'S LINEUP" FontSize="16" FontWeight="Bold" Foreground="#FFFFC24A" TextOptions.TextFormattingMode="Display" />
                </Border>

                <!-- Performer Selfie / Avatar -->
                <Border Width="120" Height="120" CornerRadius="60" BorderThickness="5" BorderBrush="#FFFFC24A" HorizontalAlignment="Center" Margin="0,0,0,14"
                        Visibility="{Binding HasCurrentSingerAvatar, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Effect>
                        <DropShadowEffect Color="#FFFFC24A" BlurRadius="28" ShadowDepth="0" Opacity="0.85" />
                    </Border.Effect>
                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding CurrentSingerAvatar}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                </Border>

                <Border Background="#DC2626" CornerRadius="8" Padding="10,4" Margin="0,0,0,10" HorizontalAlignment="Center"
                        ToolTip="Rotation Anchor (marks where a round begins)"
                        Visibility="{Binding CurrentSingerIsRotationStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="⚓ ANCHOR" FontSize="20" FontWeight="ExtraBold" Foreground="White" />
                </Border>
                <Border Background="#8B5CF6" CornerRadius="8" Padding="10,4" Margin="0,0,0,10" HorizontalAlignment="Center"
                        ToolTip="Special Performer (One-Time)"
                        Visibility="{Binding CurrentSingerIsSpecial, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="⭐ SPECIAL" FontSize="20" FontWeight="ExtraBold" Foreground="White" />
                </Border>

                <TextBlock Text="{Binding CurrentSingerName}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           FontSize="86" FontWeight="Black" Foreground="White" TextOptions.TextFormattingMode="Ideal">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FFFFC24A" BlurRadius="32" ShadowDepth="0" Opacity="0.85" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="{Binding CurrentSingerSong}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Margin="0,10,0,0" FontSize="28" FontStyle="Italic" Foreground="#FFFF8A6B" />

                <!-- Ticket-style divider -->
                <Rectangle Width="220" Height="1.5" Fill="#55FFC24A" Margin="0,20,0,14" HorizontalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="ALSO PERFORMING" FontSize="16" FontWeight="Bold" Foreground="#AAFFC24A" />
                    <Border Background="#33FFC24A" BorderBrush="#66FFC24A" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding HasActiveSingers, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding ActiveSingerCountText}" FontSize="11" FontWeight="Bold" Foreground="#FFFFC24A" />
                    </Border>
                    <TextBlock Text=" : {} = Estimated wait time"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#AAFFC24A"
                               Visibility="{Binding ShowEstimatedWaitTime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <!-- Support acts, largest-to-smallest poster typography (AlternationIndex drives tier size) -->
                <ItemsControl ItemsSource="{Binding NextSingers}" HorizontalAlignment="Center" AlternationCount="6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3">
                                <Border Background="#DC2626" CornerRadius="4" Padding="3,1" Margin="0,0,8,0" VerticalAlignment="Center"
                                        ToolTip="Rotation Anchor (marks where a round begins)"
                                        Visibility="{Binding IsRotationStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="⚓" FontSize="12" FontWeight="ExtraBold" Foreground="White" />
                                </Border>
                                <TextBlock Text="{Binding Text}" Foreground="#FFF0E0FF" FontWeight="SemiBold" TextAlignment="Center">
                                    <TextBlock.FontSize>
                                        <Binding RelativeSource="{RelativeSource AncestorType=ContentPresenter}"
                                                 Path="(ItemsControl.AlternationIndex)"
                                                 Converter="{StaticResource FestivalTierFontSizeConverter}" />
                                    </TextBlock.FontSize>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- Row 1i: Casino Slot Reels panel -->
        <Grid Grid.Row="1" x:Name="SlotReelsPanel" Visibility="Collapsed" ClipToBounds="True">
            <!-- Casino velvet green backdrop with rich radial depth -->
            <Grid.Background>
                <RadialGradientBrush GradientOrigin="0.5,0.35" Center="0.5,0.35" RadiusX="1.1" RadiusY="1.1">
                    <GradientStop Color="#FF1E402B" Offset="0.0" />
                    <GradientStop Color="#FF0E2316" Offset="0.55" />
                    <GradientStop Color="#FF040B07" Offset="1.0" />
                </RadialGradientBrush>
            </Grid.Background>

            <!-- Floating gold coins and sparkle particles (animated in code-behind) -->
            <Canvas x:Name="SlotParticleCanvas" SizeChanged="SlotParticleCanvas_SizeChanged" ClipToBounds="True" Panel.ZIndex="1" />

            <!-- Main slot machine cabinet -->
            <Grid Margin="48,14" Panel.ZIndex="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Flashing / Glowing JACKPOT Marquee Topper -->
                <Border Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,12" CornerRadius="14" Padding="24,6" BorderThickness="3">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFF2A3" Offset="0.0" />
                            <GradientStop Color="#FFFFB700" Offset="0.5" />
                            <GradientStop Color="#FFFF8000" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF3D0B0B" Offset="0.0" />
                            <GradientStop Color="#FF1A0404" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎰 777" FontSize="20" FontWeight="Black" Foreground="#FFFFD700" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <TextBlock Text="★ JACKPOT PERFORMER ★" FontSize="24" FontWeight="Black" Foreground="#FFFFFAF0" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect x:Name="SlotJackpotGlow" Color="#FFFFD700" BlurRadius="25" ShadowDepth="0" Opacity="0.9" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="777 🎰" FontSize="20" FontWeight="Black" Foreground="#FFFFD700" Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Physical 3-Reel Slot Machine Cabinet -->
                <Border Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,16" CornerRadius="22" BorderThickness="7" Padding="26,22">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFF0A0" Offset="0.0" />
                            <GradientStop Color="#FFD4AF37" Offset="0.5" />
                            <GradientStop Color="#FF8B6508" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF2A0F0F" Offset="0.0" />
                            <GradientStop Color="#FF140505" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#FFFFD700" BlurRadius="34" ShadowDepth="0" Opacity="0.5" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Cabinet corner bolts (top-left / decorative) -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Ellipse Width="16" Height="16" Fill="#FFD4AF37" Margin="0,0,0,60" />
                            <Ellipse Width="16" Height="16" Fill="#FFD4AF37" />
                        </StackPanel>

                        <!-- Reel 1 -->
                        <Border Grid.Column="1" Width="150" Height="190" Margin="6,0" CornerRadius="10" BorderThickness="5" BorderBrush="#FFD4AF37" Background="#FF04140A" ClipToBounds="True">
                            <Grid>
                                <!-- Canvas, not StackPanel: a StackPanel here would sit inside this fixed-190-tall
                                     Border and get its Arrange size clamped to the Border's small content box - WPF
                                     then auto-clips anything beyond that BEFORE the RenderTransform below ever runs,
                                     so only the first ~180px of the 1960px stacked strip could ever render, no matter
                                     how far the translate then shifted it (the same class of bug fixed for the Movie
                                     Theater film strip - see TheaterFilmStripCanvas). A Canvas is never resized by its
                                     parent, so each symbol renders at its full size at its Canvas.Top slot. -->
                                <!-- BitmapCache: the strip's content never changes while it spins, so rasterize
                                     it once and let the GPU slide the finished bitmap every frame instead of
                                     re-rendering 14 large glyphs per reel per frame. -->
                                <Canvas x:Name="SlotReel1Strip" RenderTransformOrigin="0.5,0.5" CacheMode="BitmapCache">
                                    <Canvas.RenderTransform>
                                        <TranslateTransform x:Name="SlotReel1Translate" />
                                    </Canvas.RenderTransform>
                                    <TextBlock Text="🎤" FontSize="96" Width="140" Height="140" Canvas.Top="0" Foreground="#FFE8E8E8" TextAlignment="Center" />
                                    <TextBlock Text="🍒" FontSize="96" Width="140" Height="140" Canvas.Top="140" Foreground="#FFDC2626" TextAlignment="Center" />
                                    <TextBlock Text="🔔" FontSize="96" Width="140" Height="140" Canvas.Top="280" Foreground="#FFFFC107" TextAlignment="Center" />
                                    <TextBlock Text="💎" FontSize="96" Width="140" Height="140" Canvas.Top="420" Foreground="#FFB9F2FF" TextAlignment="Center" />
                                    <TextBlock Text="7️⃣" FontSize="96" Width="140" Height="140" Canvas.Top="560" Foreground="#FFFF6F00" TextAlignment="Center" />
                                    <TextBlock Text="⭐" FontSize="96" Width="140" Height="140" Canvas.Top="700" Foreground="#FFFFD700" TextAlignment="Center" />
                                    <TextBlock Text="🍋" FontSize="96" Width="140" Height="140" Canvas.Top="840" Foreground="#FFFFEE58" TextAlignment="Center" />
                                    <!-- Duplicate set so the Y-loop wraps seamlessly -->
                                    <TextBlock Text="🎤" FontSize="96" Width="140" Height="140" Canvas.Top="980" Foreground="#FFE8E8E8" TextAlignment="Center" />
                                    <TextBlock Text="🍒" FontSize="96" Width="140" Height="140" Canvas.Top="1120" Foreground="#FFDC2626" TextAlignment="Center" />
                                    <TextBlock Text="🔔" FontSize="96" Width="140" Height="140" Canvas.Top="1260" Foreground="#FFFFC107" TextAlignment="Center" />
                                    <TextBlock Text="💎" FontSize="96" Width="140" Height="140" Canvas.Top="1400" Foreground="#FFB9F2FF" TextAlignment="Center" />
                                    <TextBlock Text="7️⃣" FontSize="96" Width="140" Height="140" Canvas.Top="1540" Foreground="#FFFF6F00" TextAlignment="Center" />
                                    <TextBlock Text="⭐" FontSize="96" Width="140" Height="140" Canvas.Top="1680" Foreground="#FFFFD700" TextAlignment="Center" />
                                    <TextBlock Text="🍋" FontSize="96" Width="140" Height="140" Canvas.Top="1820" Foreground="#FFFFEE58" TextAlignment="Center" />
                                </Canvas>
                                <!-- Glass reflection + top/bottom shadow mask -->
                                <Rectangle Fill="#33000000" Height="24" VerticalAlignment="Top" />
                                <Rectangle Fill="#33000000" Height="24" VerticalAlignment="Bottom" />
                            </Grid>
                        </Border>

                        <!-- Reel 2 -->
                        <Border Grid.Column="2" Width="150" Height="190" Margin="6,0" CornerRadius="10" BorderThickness="5" BorderBrush="#FFD4AF37" Background="#FF04140A" ClipToBounds="True">
                            <Grid>
                                <Canvas x:Name="SlotReel2Strip" RenderTransformOrigin="0.5,0.5" CacheMode="BitmapCache">
                                    <Canvas.RenderTransform>
                                        <TranslateTransform x:Name="SlotReel2Translate" />
                                    </Canvas.RenderTransform>
                                    <TextBlock Text="💎" FontSize="96" Width="140" Height="140" Canvas.Top="0" Foreground="#FFB9F2FF" TextAlignment="Center" />
                                    <TextBlock Text="⭐" FontSize="96" Width="140" Height="140" Canvas.Top="140" Foreground="#FFFFD700" TextAlignment="Center" />
                                    <TextBlock Text="🎤" FontSize="96" Width="140" Height="140" Canvas.Top="280" Foreground="#FFE8E8E8" TextAlignment="Center" />
                                    <TextBlock Text="🍋" FontSize="96" Width="140" Height="140" Canvas.Top="420" Foreground="#FFFFEE58" TextAlignment="Center" />
                                    <TextBlock Text="🔔" FontSize="96" Width="140" Height="140" Canvas.Top="560" Foreground="#FFFFC107" TextAlignment="Center" />
                                    <TextBlock Text="7️⃣" FontSize="96" Width="140" Height="140" Canvas.Top="700" Foreground="#FFFF6F00" TextAlignment="Center" />
                                    <TextBlock Text="🍒" FontSize="96" Width="140" Height="140" Canvas.Top="840" Foreground="#FFDC2626" TextAlignment="Center" />
                                    <!-- Duplicate set so the Y-loop wraps seamlessly -->
                                    <TextBlock Text="💎" FontSize="96" Width="140" Height="140" Canvas.Top="980" Foreground="#FFB9F2FF" TextAlignment="Center" />
                                    <TextBlock Text="⭐" FontSize="96" Width="140" Height="140" Canvas.Top="1120" Foreground="#FFFFD700" TextAlignment="Center" />
                                    <TextBlock Text="🎤" FontSize="96" Width="140" Height="140" Canvas.Top="1260" Foreground="#FFE8E8E8" TextAlignment="Center" />
                                    <TextBlock Text="🍋" FontSize="96" Width="140" Height="140" Canvas.Top="1400" Foreground="#FFFFEE58" TextAlignment="Center" />
                                    <TextBlock Text="🔔" FontSize="96" Width="140" Height="140" Canvas.Top="1540" Foreground="#FFFFC107" TextAlignment="Center" />
                                    <TextBlock Text="7️⃣" FontSize="96" Width="140" Height="140" Canvas.Top="1680" Foreground="#FFFF6F00" TextAlignment="Center" />
                                    <TextBlock Text="🍒" FontSize="96" Width="140" Height="140" Canvas.Top="1820" Foreground="#FFDC2626" TextAlignment="Center" />
                                </Canvas>
                                <Rectangle Fill="#33000000" Height="24" VerticalAlignment="Top" />
                                <Rectangle Fill="#33000000" Height="24" VerticalAlignment="Bottom" />
                            </Grid>
                        </Border>

                        <!-- Reel 3 -->
                        <Border Grid.Column="3" Width="150" Height="190" Margin="6,0" CornerRadius="10" BorderThickness="5" BorderBrush="#FFD4AF37" Background="#FF04140A" ClipToBounds="True">
                            <Grid>
                                <Canvas x:Name="SlotReel3Strip" RenderTransformOrigin="0.5,0.5" CacheMode="BitmapCache">
                                    <Canvas.RenderTransform>
                                        <TranslateTransform x:Name="SlotReel3Translate" />
                                    </Canvas.RenderTransform>
                                    <TextBlock Text="⭐" FontSize="96" Width="140" Height="140" Canvas.Top="0" Foreground="#FFFFD700" TextAlignment="Center" />
                                    <TextBlock Text="🍋" FontSize="96" Width="140" Height="140" Canvas.Top="140" Foreground="#FFFFEE58" TextAlignment="Center" />
                                    <TextBlock Text="💎" FontSize="96" Width="140" Height="140" Canvas.Top="280" Foreground="#FFB9F2FF" TextAlignment="Center" />
                                    <TextBlock Text="🍒" FontSize="96" Width="140" Height="140" Canvas.Top="420" Foreground="#FFDC2626" TextAlignment="Center" />
                                    <TextBlock Text="🎤" FontSize="96" Width="140" Height="140" Canvas.Top="560" Foreground="#FFE8E8E8" TextAlignment="Center" />
                                    <TextBlock Text="🔔" FontSize="96" Width="140" Height="140" Canvas.Top="700" Foreground="#FFFFC107" TextAlignment="Center" />
                                    <TextBlock Text="7️⃣" FontSize="96" Width="140" Height="140" Canvas.Top="840" Foreground="#FFFF6F00" TextAlignment="Center" />
                                    <!-- Duplicate set so the Y-loop wraps seamlessly -->
                                    <TextBlock Text="⭐" FontSize="96" Width="140" Height="140" Canvas.Top="980" Foreground="#FFFFD700" TextAlignment="Center" />
                                    <TextBlock Text="🍋" FontSize="96" Width="140" Height="140" Canvas.Top="1120" Foreground="#FFFFEE58" TextAlignment="Center" />
                                    <TextBlock Text="💎" FontSize="96" Width="140" Height="140" Canvas.Top="1260" Foreground="#FFB9F2FF" TextAlignment="Center" />
                                    <TextBlock Text="🍒" FontSize="96" Width="140" Height="140" Canvas.Top="1400" Foreground="#FFDC2626" TextAlignment="Center" />
                                    <TextBlock Text="🎤" FontSize="96" Width="140" Height="140" Canvas.Top="1540" Foreground="#FFE8E8E8" TextAlignment="Center" />
                                    <TextBlock Text="🔔" FontSize="96" Width="140" Height="140" Canvas.Top="1680" Foreground="#FFFFC107" TextAlignment="Center" />
                                    <TextBlock Text="7️⃣" FontSize="96" Width="140" Height="140" Canvas.Top="1820" Foreground="#FFFF6F00" TextAlignment="Center" />
                                </Canvas>
                                <Rectangle Fill="#33000000" Height="24" VerticalAlignment="Top" />
                                <Rectangle Fill="#33000000" Height="24" VerticalAlignment="Bottom" />
                            </Grid>
                        </Border>

                        <!-- Chrome payline arrow markers either side of the reel row -->
                        <Path Grid.Column="1" Grid.ColumnSpan="3" Data="M0,95 L14,85 L14,105 Z" Fill="#FFFFD700" HorizontalAlignment="Left" Margin="-10,0,0,0" />
                        <Path Grid.Column="1" Grid.ColumnSpan="3" Data="M14,95 L0,85 L0,105 Z" Fill="#FFFFD700" HorizontalAlignment="Right" Margin="0,0,-10,0" />
                        <Rectangle Grid.Column="1" Grid.ColumnSpan="3" Height="3" Fill="#AAFFD700" VerticalAlignment="Center" />

                        <!-- Big red pull-handle lever on the cabinet's right side -->
                        <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="18,0,4,0">
                            <Ellipse Width="34" Height="34" Fill="#FFDC2626" Stroke="#FFFFD700" StrokeThickness="2" HorizontalAlignment="Center" />
                            <Rectangle Width="8" Height="74" Fill="#FFB0B0B0" HorizontalAlignment="Center" RadiusX="4" RadiusY="4" />
                            <Ellipse Width="18" Height="18" Fill="#FFD4AF37" HorizontalAlignment="Center" Margin="0,-4,0,0" />
                        </StackPanel>

                        <!-- Jackpot celebration burst - empty/idle until SlotMachineEffect (Shared/ProjectionEffects.cs)
                             fills it, once all three reels land (💎, or 7️⃣ for the anchor singer). Last child of this
                             Grid so the sparkle/shockwave burst renders on top of the reel row, but
                             ClipToBounds keeps it confined to the reel row itself instead of ballooning
                             up into the marquee header above or sideways past the cabinet edges. -->
                        <Canvas x:Name="SlotJackpotBurstCanvas" Grid.Column="1" Grid.ColumnSpan="3" Height="190" ClipToBounds="True" IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <!-- Winner ticket (current singer), horizontal ticket roll of next spins, and DJ sponsor banner -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Winner payout ticket -->
                    <Border Grid.Row="0" Margin="0,0,0,12" CornerRadius="14" BorderThickness="3" Padding="20,14">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFFF0A0" Offset="0.0" />
                                <GradientStop Color="#FFD4AF37" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#E60B120E" Offset="0.0" />
                                <GradientStop Color="#E6040806" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="88" Height="88" CornerRadius="44" BorderThickness="4" Margin="0,0,18,0"
                                    Visibility="{Binding HasCurrentSingerAvatar, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFFFF0A0" Offset="0.0" />
                                        <GradientStop Color="#FFFFD700" Offset="0.5" />
                                        <GradientStop Color="#FFC48800" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFFFD700" BlurRadius="22" ShadowDepth="0" Opacity="0.85" />
                                </Border.Effect>
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding CurrentSingerAvatar}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Background="#DC2626" CornerRadius="6" Padding="8,3" Margin="0,0,8,0"
                                            ToolTip="Rotation Anchor (marks where a round begins)"
                                            Visibility="{Binding CurrentSingerIsRotationStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="⚓ ANCHOR" FontSize="14" FontWeight="ExtraBold" Foreground="White" />
                                    </Border>
                                    <Border Background="#8B5CF6" CornerRadius="6" Padding="8,3"
                                            ToolTip="Special Performer (One-Time)"
                                            Visibility="{Binding CurrentSingerIsSpecial, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="⭐ SPECIAL" FontSize="14" FontWeight="ExtraBold" Foreground="White" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding CurrentSingerName}"
                                           TextWrapping="Wrap" FontSize="52" FontWeight="Black" Foreground="#FFFFFAF0" TextOptions.TextFormattingMode="Ideal">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#FFFFD700" BlurRadius="22" ShadowDepth="0" Opacity="0.85" />
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="{Binding CurrentSingerSong}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" FontSize="22" FontStyle="Italic" Foreground="#FFFFDF70" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Horizontal ticket roll of upcoming spins - Auto-height so the ticket-stub
                         chips size to their content instead of stretching to fill the panel. -->
                    <Border Grid.Row="1" Margin="0,0,0,12" CornerRadius="14" BorderThickness="2" Padding="16,12">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#88D4AF37" Offset="0.0" />
                                <GradientStop Color="#448B6508" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#E6080E0A" Offset="0.0" />
                                <GradientStop Color="#E6020503" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="🎟️ NEXT SPINS" FontSize="18" FontWeight="Bold" Foreground="#FFFFDF70" />
                                <Border Background="#33FFD700" BorderBrush="#66FFD700" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HasActiveSingers, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding ActiveSingerCountText}" FontSize="13" FontWeight="Bold" Foreground="#FFFFDF70" />
                                </Border>
                                <TextBlock Text=" : {} = Estimated wait time"
                                           FontSize="15" FontWeight="Bold" Foreground="#AAFFDF70" VerticalAlignment="Center"
                                           Visibility="{Binding ShowEstimatedWaitTime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding NextSingers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Ticket-stub styled chip with a dashed perforation edge. Fixed height
                                                 (instead of stretching to the row's height) keeps it a compact chip. -->
                                            <Border Margin="0,0,10,0" Padding="14,10" CornerRadius="8" Background="#18FFFFFF"
                                                    BorderBrush="#55FFDF70" BorderThickness="1.5" MinWidth="150" Height="120" VerticalAlignment="Top">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="🎰" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                    <Border Background="#DC2626" CornerRadius="4" Padding="4,1" Margin="0,0,0,4" HorizontalAlignment="Center"
                                                            ToolTip="Rotation Anchor (marks where a round begins)"
                                                            Visibility="{Binding IsRotationStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="⚓ ANCHOR" FontSize="11" FontWeight="ExtraBold" Foreground="White" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Text}" FontSize="16" FontWeight="Bold" Foreground="#FFFFF0D0" TextAlignment="Center" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Sponsor box - shows the DJ's chosen banner (image or video), or a tip
                         reminder when none is selected. Reuses the same JumbotronBannerPath /
                         HasJumbotronBanner / IsJumbotronBannerVideo selection as the Stadium
                         Jumbotron screen (one DJ banner picker, shared by every projection view
                         that has a sponsor box) - no separate Slot Machine banner setting to dupe. -->
                    <Border Grid.Row="2" MinHeight="150" CornerRadius="14" BorderThickness="2" BorderBrush="#66D4AF37" Background="#E6060B08" Padding="4">
                        <Grid>
                            <Grid ClipToBounds="True">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasJumbotronBanner}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Image Stretch="Uniform">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Source" Value="{Binding JumbotronBannerPath}" />
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsJumbotronBannerVideo}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <!-- Source is set imperatively in UpdateSlotBanner (not bound here), mirroring the
                                     Jumbotron's MediaElement handling, so picking an image never opens this file
                                     through the video pipeline. -->
                                <MediaElement x:Name="SlotBannerVideo" Stretch="Uniform"
                                              LoadedBehavior="Manual" UnloadedBehavior="Manual" IsMuted="True" MediaEnded="SlotBannerVideo_MediaEnded"
                                              Visibility="{Binding IsJumbotronBannerVideo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>

                            <!-- Fallback tip reminder shown when no sponsor banner is selected -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasJumbotronBanner}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="🍻 Don't forget, tip your bartenders and DJ! 🎧" FontSize="34" FontWeight="Black" Foreground="#FFFFD700"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#FFFFD700" BlurRadius="22" ShadowDepth="0" Opacity="0.7" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Row 1j: Jukebox panel -->
        <Grid Grid.Row="1" x:Name="JukeboxPanel" Visibility="Collapsed" ClipToBounds="True">
            <!-- 1950s Jukebox club ambiance backdrop -->
            <Grid.Background>
                <RadialGradientBrush GradientOrigin="0.5,0.2" Center="0.5,0.2" RadiusX="1.2" RadiusY="1.2">
                    <GradientStop Color="#FF241236" Offset="0.0" />
                    <GradientStop Color="#FF12081C" Offset="0.55" />
                    <GradientStop Color="#FF06020A" Offset="1.0" />
                </RadialGradientBrush>
            </Grid.Background>

            <!-- Animated rising bubble-tube lights along cabinet sides -->
            <Canvas x:Name="JukeboxBubbleCanvas" SizeChanged="JukeboxBubbleCanvas_SizeChanged" ClipToBounds="True" Panel.ZIndex="1" />

            <!-- Jukebox Cabinet -->
            <Grid Margin="54,16" Panel.ZIndex="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Arch Header with Chrome & Neon -->
                <Border Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,14" CornerRadius="16" Padding="28,6" BorderThickness="3">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFF357E" Offset="0.0" />
                            <GradientStop Color="#FFFFD269" Offset="0.5" />
                            <GradientStop Color="#FF00E5FF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF2A1038" Offset="0.0" />
                            <GradientStop Color="#FF12051A" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="🎶  JUKEBOX HIT SELECTION  🎶" FontSize="22" FontWeight="Bold" Foreground="#FFFF79C6" TextOptions.TextFormattingMode="Display">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FFFF357E" BlurRadius="25" ShadowDepth="0" Opacity="0.9" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Border>

                <!-- Cabinet Body: Left = Spinning Vinyl "Now Playing" Dome, Right = Push-Button Wall -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Illuminated Glass Dome housing a spinning vinyl record -->
                    <Border Grid.Column="0" Margin="0,0,16,0" CornerRadius="130,130,20,20" BorderThickness="3" Padding="20,26,20,18">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFF357E" Offset="0.0" />
                                <GradientStop Color="#FF8E44AD" Offset="0.5" />
                                <GradientStop Color="#FF00E5FF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#E6150A22" Offset="0.0" />
                                <GradientStop Color="#E608030F" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- Spinning vinyl record: concentric grooves + performer avatar as the center label -->
                            <Grid Width="190" Height="190" Margin="0,0,0,14" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="JukeboxRecordRotate" />
                                </Grid.RenderTransform>
                                <Ellipse Width="190" Height="190" Fill="#FF0A0A0C" />
                                <Ellipse Width="190" Height="190" Stroke="#22FFFFFF" StrokeThickness="1" />
                                <Ellipse Width="158" Height="158" Stroke="#22FFFFFF" StrokeThickness="1" />
                                <Ellipse Width="126" Height="126" Stroke="#22FFFFFF" StrokeThickness="1" />
                                <Ellipse Width="94" Height="94" Stroke="#33FFFFFF" StrokeThickness="1" />
                                <Border Width="88" Height="88" CornerRadius="44" BorderThickness="4">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFFF357E" Offset="0.0" />
                                            <GradientStop Color="#FF00E5FF" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding CurrentSingerAvatar}" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Border>
                                <Ellipse Width="10" Height="10" Fill="#FFFFD269" />
                            </Grid>

                            <Border Background="#DC2626" CornerRadius="8" Padding="10,4" Margin="0,0,0,8" HorizontalAlignment="Center"
                                    ToolTip="Rotation Anchor (marks where a round begins)"
                                    Visibility="{Binding CurrentSingerIsRotationStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="⚓ ANCHOR" FontSize="16" FontWeight="ExtraBold" Foreground="White" />
                            </Border>
                            <Border Background="#8B5CF6" CornerRadius="8" Padding="10,4" Margin="0,0,0,8" HorizontalAlignment="Center"
                                    ToolTip="Special Performer (One-Time)"
                                    Visibility="{Binding CurrentSingerIsSpecial, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="⭐ SPECIAL" FontSize="16" FontWeight="ExtraBold" Foreground="White" />
                            </Border>

                            <TextBlock Text="{Binding CurrentSingerName}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       FontSize="54" FontWeight="Black" Foreground="White" TextOptions.TextFormattingMode="Ideal">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FFFF357E" BlurRadius="24" ShadowDepth="0" Opacity="0.85" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="{Binding CurrentSingerSong}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       Margin="0,6,0,0" FontSize="24" FontStyle="Italic" Foreground="#FF00E5FF" />
                        </StackPanel>
                    </Border>

                    <!-- Right: Wall of illuminated push-buttons, one per upcoming singer -->
                    <Border Grid.Column="1" Margin="16,0,0,0" CornerRadius="20" BorderThickness="2" Padding="20,16">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8800E5FF" Offset="0.0" />
                                <GradientStop Color="#44FF357E" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#E610071C" Offset="0.0" />
                                <GradientStop Color="#E605020A" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="🔘 SELECT-A-SONG PANEL" FontSize="18" FontWeight="Bold" Foreground="#FF00E5FF" />
                                <Border Background="#3300E5FF" BorderBrush="#6600E5FF" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HasActiveSingers, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding ActiveSingerCountText}" FontSize="13" FontWeight="Bold" Foreground="#FF00E5FF" />
                                </Border>
                                <TextBlock Text=" : {} = Estimated wait time"
                                           FontSize="15" FontWeight="Bold" Foreground="#AA00E5FF" VerticalAlignment="Center"
                                           Visibility="{Binding ShowEstimatedWaitTime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding NextSingers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Chunky backlit push-button, like a real jukebox letter/number selector -->
                                        <Border Margin="0,0,8,8" Padding="14,10" CornerRadius="10" BorderThickness="2" BorderBrush="#55FF357E">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#3300E5FF" Offset="0.0" />
                                                    <GradientStop Color="#22FF357E" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Left: Enlarged PUSH button badge + optional rotation anchor -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <Border Background="#FFD700" BorderBrush="#FFF6B024" BorderThickness="1.5" CornerRadius="6" Padding="12,6" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="PUSH" FontSize="15" FontWeight="Black" Foreground="#FF12081C" />
                                                    </Border>
                                                    <Border Background="#DC2626" CornerRadius="5" Padding="5,3" VerticalAlignment="Center"
                                                            ToolTip="Rotation Anchor (marks where a round begins)"
                                                            Visibility="{Binding IsRotationStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="⚓ ANCHOR" FontSize="12" FontWeight="ExtraBold" Foreground="White" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- Right: Singer details (Line 1: Singer name & estimated wait time; Line 2: Song title) -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SingerName}" FontSize="20" Foreground="#FFFFFAF0" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding WaitTime}" FontSize="18" Foreground="#FF00E5FF" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                   Visibility="{Binding HasWaitTime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Song}" FontSize="18" FontStyle="Italic" Foreground="#FF00E5FF" TextWrapping="Wrap" Margin="0,3,0,0"
                                                               Visibility="{Binding HasSong, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Row 1k: Stadium Jumbotron panel -->
        <Grid Grid.Row="1" x:Name="JumbotronPanel" Visibility="Collapsed" ClipToBounds="True">
            <!-- Stadium arena dark night backdrop -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF0B1526" Offset="0.0" />
                    <GradientStop Color="#FF060D18" Offset="0.5" />
                    <GradientStop Color="#FF02050A" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Sweeping stadium arena spotlights (animated in code-behind) -->
            <Canvas x:Name="JumbotronSpotlightCanvas" SizeChanged="JumbotronSpotlightCanvas_SizeChanged" ClipToBounds="True" Panel.ZIndex="1" />

            <!-- Stadium Scoreboard / Jumbotron Frame -->
            <Grid Margin="48,16" Panel.ZIndex="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Steel Truss Scoreboard Header -->
                <Border Grid.Row="0" Margin="0,0,0,14" CornerRadius="10" Padding="20,8" BorderThickness="2" BorderBrush="#FF4B5E78" Background="#FF131C28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🏟️ ARENA LIVE" FontSize="18" FontWeight="Black" Foreground="#FFFFB000" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="STADIUM JUMBOTRON SCOREBOARD" FontSize="20" FontWeight="Black" Foreground="#FFFFFAF0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="PERIOD: KARAOKE" FontSize="16" FontWeight="Black" Foreground="#FF00FF88" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- LED Scoreboard Screen Area with dot-matrix overlay -->
                <Border Grid.Row="1" CornerRadius="12" BorderThickness="3" BorderBrush="#FF334155" Background="#FF070C12" Padding="24,18">
                    <Grid>
                        <!-- LED Dot-Matrix Texture -->
                        <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0.14">
                            <Rectangle.Fill>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="#FFFFFFFF">
                                            <GeometryDrawing.Geometry>
                                                <EllipseGeometry Center="3,3" RadiusX="1.2" RadiusY="1.2" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Top: wide "NOW ON STAGE" strip - avatar left, LED digits right -->
                            <Border Grid.Row="0" Margin="0,0,0,14" Background="#FF1E293B" BorderBrush="#FFFFB000" BorderThickness="1.5" CornerRadius="8" Padding="18,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="96" Height="96" CornerRadius="48" BorderThickness="4" BorderBrush="#FFFFB000" Margin="0,0,20,0"
                                            Visibility="{Binding HasCurrentSingerAvatar, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#FFFFB000" BlurRadius="20" ShadowDepth="0" Opacity="0.85" />
                                        </Border.Effect>
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding CurrentSingerAvatar}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="⚡ NOW ON STAGE" FontSize="16" FontWeight="Black" Foreground="#FFFFB000" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <Border Background="#DC2626" CornerRadius="6" Padding="8,2" Margin="0,0,8,0"
                                                    ToolTip="Rotation Anchor (marks where a round begins)"
                                                    Visibility="{Binding CurrentSingerIsRotationStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="⚓ ANCHOR" FontSize="12" FontWeight="ExtraBold" Foreground="White" />
                                            </Border>
                                            <Border Background="#8B5CF6" CornerRadius="6" Padding="8,2"
                                                    ToolTip="Special Performer (One-Time)"
                                                    Visibility="{Binding CurrentSingerIsSpecial, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="⭐ SPECIAL" FontSize="12" FontWeight="ExtraBold" Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CurrentSingerName}"
                                                   TextWrapping="Wrap"
                                                   FontSize="58" FontWeight="Black" Foreground="#FFFFB000" FontFamily="Consolas, Segoe UI">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="#FFFFB000" BlurRadius="26" ShadowDepth="0" Opacity="0.9" />
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <TextBlock Text="{Binding CurrentSingerSong}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" FontSize="22" FontWeight="Bold" Foreground="#FF00FF88" FontFamily="Consolas, Segoe UI" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Bottom: horizontal roster grid of jersey-number scoreboard tiles -->
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="⚾ TEAM ROSTER - ON DECK" FontSize="18" FontWeight="Bold" Foreground="#FFFFB000" />
                                    <Border Background="#33FFB000" BorderBrush="#66FFB000" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding HasActiveSingers, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding ActiveSingerCountText}" FontSize="13" FontWeight="Bold" Foreground="#FFFFB000" />
                                    </Border>
                                    <TextBlock Text=" : {} = Estimated wait time"
                                               FontSize="15" FontWeight="Bold" Foreground="#AAFFB000" VerticalAlignment="Center"
                                               Visibility="{Binding ShowEstimatedWaitTime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>

                                <ItemsControl Grid.Row="1" ItemsSource="{Binding NextSingers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Square jersey-number scoreboard tile -->
                                            <Border Width="230" Height="150" Margin="0,0,14,14" Padding="14,10" CornerRadius="8" Background="#1A1E293B" BorderBrush="#4400FF88" BorderThickness="1.5">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" Background="#DC2626" CornerRadius="4" Padding="4,2" HorizontalAlignment="Left" Margin="0,0,0,4"
                                                            ToolTip="Rotation Anchor (marks where a round begins)"
                                                            Visibility="{Binding IsRotationStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="⚓ ANCHOR" FontSize="12" FontWeight="ExtraBold" Foreground="White" />
                                                    </Border>
                                                    <TextBlock Grid.Row="1" Text="{Binding Text}" FontSize="23" Foreground="#FF00FF88" FontFamily="Consolas, Segoe UI" FontWeight="Bold"
                                                               TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!-- Bottom: sponsor box - shows the DJ's chosen banner (image or video), or a
                                 tip reminder when none is selected. Takes all remaining vertical space below
                                 the roster (star-sized row) rather than a small fixed strip, since this area
                                 was previously dead space. -->
                            <Border Grid.Row="2" Margin="0,14,0,0" MinHeight="150" CornerRadius="8" BorderThickness="2" BorderBrush="#FF4B5E78" Background="#FF0C1420" Padding="4">
                                <Grid>
                                    <Grid ClipToBounds="True">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasJumbotronBanner}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Image Stretch="Uniform">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Source" Value="{Binding JumbotronBannerPath}" />
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsJumbotronBannerVideo}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <!-- Source is set imperatively in UpdateJumbotronBanner (not bound here) so picking an
                                             image, or picking any banner while a different view is showing, never opens this
                                             file through the video pipeline. -->
                                        <MediaElement x:Name="JumbotronBannerVideo" Stretch="Uniform"
                                                      LoadedBehavior="Manual" UnloadedBehavior="Manual" IsMuted="True" MediaEnded="JumbotronBannerVideo_MediaEnded"
                                                      Visibility="{Binding IsJumbotronBannerVideo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>

                                    <!-- Fallback tip reminder shown when no sponsor banner is selected -->
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasJumbotronBanner}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="🍻 Don't forget, tip your bartenders and DJ! 🎧" FontSize="40" FontWeight="Black" Foreground="#FFFFB000"
                                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="#FFFFB000" BlurRadius="22" ShadowDepth="0" Opacity="0.7" />
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Row 1l: Movie Theater 'Now Showing' panel -->
        <Grid Grid.Row="1" x:Name="TheaterPanel" Visibility="Collapsed" ClipToBounds="True">
            <!-- Vintage cinema theater velvet ambiance backdrop -->
            <Grid.Background>
                <RadialGradientBrush GradientOrigin="0.5,0.25" Center="0.5,0.25" RadiusX="1.1" RadiusY="1.1">
                    <GradientStop Color="#FF261418" Offset="0.0" />
                    <GradientStop Color="#FF14080B" Offset="0.55" />
                    <GradientStop Color="#FF080304" Offset="1.0" />
                </RadialGradientBrush>
            </Grid.Background>

            <!-- Projector light cone from top (animated in code-behind) -->
            <Canvas x:Name="TheaterBeamCanvas" SizeChanged="TheaterBeamCanvas_SizeChanged" ClipToBounds="True" Panel.ZIndex="1" />

            <!-- Movie theater layout -->
            <Grid Margin="48,16" Panel.ZIndex="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Film Leader & Marquee Header Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Film-Reel Countdown Leader Widget (Left) -->
                    <Viewbox Grid.Column="0" Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Canvas Width="100" Height="100">
                            <!-- Outer Leader Circle -->
                            <Ellipse Width="96" Height="96" Canvas.Left="2" Canvas.Top="2" Stroke="#FFFFE8B0" StrokeThickness="3" Fill="#22000000" />
                            <!-- Inner Ring -->
                            <Ellipse Width="64" Height="64" Canvas.Left="18" Canvas.Top="18" Stroke="#AAFFE8B0" StrokeThickness="2" />
                            <!-- Crosshairs -->
                            <Line X1="50" Y1="0" X2="50" Y2="100" Stroke="#AAFFE8B0" StrokeThickness="1.5" />
                            <Line X1="0" Y1="50" X2="100" Y2="50" Stroke="#AAFFE8B0" StrokeThickness="1.5" />
                            <!-- Rotating Sweep Line -->
                            <Line X1="50" Y1="50" X2="50" Y2="4" Stroke="#FFFFE8B0" StrokeThickness="3" RenderTransformOrigin="0.5,0.5">
                                <Line.RenderTransform>
                                    <RotateTransform x:Name="TheaterLeaderSweep" CenterX="50" CenterY="50" />
                                </Line.RenderTransform>
                            </Line>
                        </Canvas>
                    </Viewbox>

                    <!-- Title Header -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" CornerRadius="12" Padding="28,6" BorderThickness="2" BorderBrush="#FFFFE8B0" Background="#FF1C0D10">
                        <TextBlock Text="🎬  NOW SHOWING: FEATURE PRESENTATION  🎬" FontSize="22" FontWeight="Black" Foreground="#FFFFE8B0" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FFFFE8B0" BlurRadius="22" ShadowDepth="0" Opacity="0.85" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </Border>

                    <!-- Film-Reel Countdown Leader Widget (Right) -->
                    <Viewbox Grid.Column="2" Width="56" Height="56" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Canvas Width="100" Height="100">
                            <Ellipse Width="96" Height="96" Canvas.Left="2" Canvas.Top="2" Stroke="#FFFFE8B0" StrokeThickness="3" Fill="#22000000" />
                            <Ellipse Width="64" Height="64" Canvas.Left="18" Canvas.Top="18" Stroke="#AAFFE8B0" StrokeThickness="2" />
                            <Line X1="50" Y1="0" X2="50" Y2="100" Stroke="#AAFFE8B0" StrokeThickness="1.5" />
                            <Line X1="0" Y1="50" X2="100" Y2="50" Stroke="#AAFFE8B0" StrokeThickness="1.5" />
                            <Line X1="50" Y1="50" X2="50" Y2="4" Stroke="#FFFFE8B0" StrokeThickness="3" RenderTransformOrigin="0.5,0.5">
                                <Line.RenderTransform>
                                    <RotateTransform x:Name="TheaterLeaderSweepRight" CenterX="50" CenterY="50" />
                                </Line.RenderTransform>
                            </Line>
                        </Canvas>
                    </Viewbox>
                </Grid>

                <!-- Theater Presentation Body: Top = Widescreen "On Screen" Feature, Bottom = Poster Lobby Row -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top: Letterboxed cinema screen flanked by red velvet curtains -->
                    <Grid Grid.Row="0" Height="260" Margin="0,0,0,16">
                        <!-- Left curtain -->
                        <Polygon Points="0,0 70,0 30,260 0,260" HorizontalAlignment="Left" Width="70">
                            <Polygon.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF3D0B10" Offset="0.0" />
                                    <GradientStop Color="#FF7A1420" Offset="0.5" />
                                    <GradientStop Color="#FF3D0B10" Offset="1.0" />
                                </LinearGradientBrush>
                            </Polygon.Fill>
                        </Polygon>
                        <!-- Right curtain -->
                        <Polygon Points="0,0 70,0 70,260 40,260" HorizontalAlignment="Right" Width="70">
                            <Polygon.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF3D0B10" Offset="0.0" />
                                    <GradientStop Color="#FF7A1420" Offset="0.5" />
                                    <GradientStop Color="#FF3D0B10" Offset="1.0" />
                                </LinearGradientBrush>
                            </Polygon.Fill>
                        </Polygon>

                        <!-- The screen itself: black letterbox bars top/bottom, feature content centered -->
                        <Border Margin="66,0" CornerRadius="4" Background="#FF040203" BorderThickness="2" BorderBrush="#66FFE8B0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Rectangle Grid.Row="0" Fill="#FF000000" />
                                <Rectangle Grid.Row="2" Fill="#FF000000" />

                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="18,14">
                                    <!-- Performer Avatar inside a 35mm film cell frame -->
                                    <Border BorderBrush="#FFFFE8B0" BorderThickness="3" CornerRadius="8" Padding="5" Background="#FF100608" Margin="0,0,20,0" VerticalAlignment="Center"
                                            Visibility="{Binding HasCurrentSingerAvatar, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#FFFFE8B0" BlurRadius="22" ShadowDepth="0" Opacity="0.8" />
                                        </Border.Effect>
                                        <Border Width="96" Height="96" CornerRadius="4" ClipToBounds="True">
                                            <Image Source="{Binding CurrentSingerAvatar}" Stretch="UniformToFill" />
                                        </Border>
                                    </Border>

                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Background="#DC2626" CornerRadius="6" Padding="8,2" Margin="0,0,8,0"
                                                    ToolTip="Rotation Anchor (marks where a round begins)"
                                                    Visibility="{Binding CurrentSingerIsRotationStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="⚓ ANCHOR" FontSize="12" FontWeight="ExtraBold" Foreground="White" />
                                            </Border>
                                            <Border Background="#8B5CF6" CornerRadius="6" Padding="8,2"
                                                    ToolTip="Special Performer (One-Time)"
                                                    Visibility="{Binding CurrentSingerIsSpecial, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="⭐ SPECIAL" FontSize="12" FontWeight="ExtraBold" Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CurrentSingerName}"
                                                   TextWrapping="Wrap"
                                                   FontSize="52" FontWeight="Black" Foreground="#FFFFFAF0">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="#FFFFE8B0" BlurRadius="26" ShadowDepth="0" Opacity="0.85" />
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <TextBlock Text="{Binding CurrentSingerSong}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" FontSize="22" FontStyle="Italic" Foreground="#FFFFD27F" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Bottom: Coming Up On The Reel - each of the next singers in its own 35mm film
                         frame (sprocket holes and all), continuously scrolling like film running
                         through a projector. -->
                    <Border Grid.Row="1" CornerRadius="18" BorderThickness="2" BorderBrush="#66FFE8B0" Padding="20,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#E615080C" Offset="0.0" />
                                <GradientStop Color="#E6080305" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="🎞️ COMING UP ON THE REEL" FontSize="18" FontWeight="Bold" Foreground="#FFFFE8B0" />
                                <Border Background="#33FFE8B0" BorderBrush="#66FFE8B0" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HasActiveSingers, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding ActiveSingerCountText}" FontSize="13" FontWeight="Bold" Foreground="#FFFFE8B0" />
                                </Border>
                                <TextBlock Text=" : {} = Estimated wait time"
                                           FontSize="15" FontWeight="Bold" Foreground="#AAFFE8B0" VerticalAlignment="Center"
                                           Visibility="{Binding ShowEstimatedWaitTime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>

                            <!-- Projector gate: clips the strip so frames scroll in/out of frame cleanly.
                                 Kept narrow (a middle column, not full width) so it reads as a projected
                                 filmstrip rather than a banner - content is built entirely in
                                 code-behind, see BuildTheaterFilmStrip. -->
                            <Border Grid.Row="1" CornerRadius="6" BorderThickness="2" BorderBrush="#66FFE8B0" Background="#FF050202" ClipToBounds="True"
                                    HorizontalAlignment="Center" Width="380">
                                <!-- ClipToBounds is intentionally NOT set here (only on the fixed Border above) - a
                                     RenderTransform-scrolled element's own ClipToBounds clips its children to its own
                                     layout bounds BEFORE the transform is applied, permanently discarding any content
                                     positioned beyond that height regardless of how many "copies" are stacked below it.
                                     The outer Border's clip is what should window the (already-transformed) result. -->
                                <!-- BitmapCache: the frames (including the glow-effect titles) only change when
                                     the queue does, so rasterize them once per rebuild and let the GPU slide the
                                     cached bitmap each frame rather than re-rendering every frame and blur. -->
                                <Canvas x:Name="TheaterFilmStripCanvas" SizeChanged="TheaterFilmStripCanvas_SizeChanged" CacheMode="BitmapCache" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Floating QR Code Overlay for audience scanning (shown on top of all projection panels) -->
        <Border Grid.Row="1"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="24"
                Padding="10"
                Background="#EE1E293B"
                BorderBrush="#475569"
                BorderThickness="1.5"
                CornerRadius="8"
                Width="180"
                Height="235"
                Panel.ZIndex="99">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ConnectionUrl}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ConnectionUrl}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShowQrCode}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="160"
                        Height="160"
                        Background="White"
                        CornerRadius="4"
                        Padding="3"
                        HorizontalAlignment="Center">
                    <Image Source="{Binding QrCodeImage}"
                           Stretch="Uniform" />
                </Border>
                <TextBlock Text="SCAN TO REQUEST"
                           FontWeight="Bold"
                           FontSize="12"
                           Foreground="#F8FAFC"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0" />
                <TextBlock Text="{Binding ConnectionUrl}"
                           FontSize="10"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Live synth bars driven by the DJ line-in (Settings > Synth Bars); only active when enabled for this screen -->
        <ctrl:SpectrumBarsOverlay Grid.RowSpan="2"
                                  Panel.ZIndex="110"
                                  VerticalAlignment="Bottom"
                                  Height="260"
                                  Opacity="0.85"
                                  IsActive="{Binding ShowSpectrum}" />

        <!-- Last Song Banner Overlay (shown on all non-lyric screens when Last Song is activated) -->
        <Grid x:Name="LastSongBannerOverlay"
              Grid.RowSpan="2"
              Panel.ZIndex="120"
              Background="Black"
              Visibility="Collapsed">
            <Image x:Name="LastSongBannerImage"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Grid>
    </Grid>
    </Viewbox>
</Window>
