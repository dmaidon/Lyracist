<!-- Edited on Oct 30, 2026 @ 06:12:00 -> Add manual category assignment and add-to-wheel controls to ScaryokeControlWindow -->
<Window x:Class="KSRotation.Windows.ScaryokeControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:KSRotation.Converters"
        xmlns:vm="clr-namespace:KSRotation.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="🎃 Scaryoke Wheel Controller"
        Height="880" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F0C1B"
        Foreground="White"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Step 1: Title & Project to Screen Toggle -->
        <Border Grid.Row="0" Margin="0,0,0,8" Background="#181328" BorderBrush="#35264F" BorderThickness="1.5" CornerRadius="10" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🎃 SCARYOKE WHEEL" FontSize="18" FontWeight="ExtraBold" Foreground="#FF6D00" />
                    <TextBlock Text="1. Set wheel projection to audience screen" FontSize="11" Foreground="#94A3B8" Margin="0,1,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding ToggleScaryokeProjectedCommand}"
                        Height="34" Padding="12,0"
                        FontSize="11" FontWeight="Bold"
                        materialDesign:ButtonAssist.CornerRadius="6"
                        Cursor="Hand"
                        ToolTip="Toggle whether the Scaryoke Wheel is projected live on the audience screen or kept booth-only">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                            <Setter Property="Background" Value="#332B45" />
                            <Setter Property="BorderBrush" Value="#4C3D66" />
                            <Setter Property="Foreground" Value="#CBD5E1" />
                            <Setter Property="Content" Value="📺 Booth Only (Off Screen)" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScaryokeProjected}" Value="True">
                                    <Setter Property="Background" Value="#15803D" />
                                    <Setter Property="BorderBrush" Value="#16A34A" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Content" Value="📺 Projected (Live on Screen)" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Step 2: Select # of Singers -->
        <Border Grid.Row="1" Margin="0,0,0,8" Background="#161224" BorderBrush="#35264F" BorderThickness="1.5" CornerRadius="10" Padding="12,8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="2. Select # of Singers:" FontWeight="Bold" FontSize="12" Foreground="#FFB74D" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Command="{Binding ClearAllScaryokeCategoriesCommand}"
                            Content="✕ Clear All" Height="22" Padding="6,0" FontSize="10"
                            Background="Transparent" BorderBrush="#EF4444" Foreground="#F87171"
                            materialDesign:ButtonAssist.CornerRadius="4" Cursor="Hand"
                            ToolTip="Clear Scaryoke categories from all singers" />
                </Grid>
                <UniformGrid Columns="5" Margin="0,6,0,6">
                    <Button Command="{Binding SetScaryokeBatchCountCommand}" CommandParameter="1"
                            Content="1 Singer" Height="28" FontSize="11" FontWeight="Bold"
                            materialDesign:ButtonAssist.CornerRadius="4" Cursor="Hand" Margin="0,0,3,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                <Setter Property="Background" Value="#251F38" />
                                <Setter Property="BorderBrush" Value="#3D3259" />
                                <Setter Property="Foreground" Value="#CBD5E1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScaryokeBatchCount}" Value="1">
                                        <Setter Property="Background" Value="#7C3AED" />
                                        <Setter Property="BorderBrush" Value="#8B5CF6" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding SetScaryokeBatchCountCommand}" CommandParameter="3"
                            Content="Next 3" Height="28" FontSize="11" FontWeight="Bold"
                            materialDesign:ButtonAssist.CornerRadius="4" Cursor="Hand" Margin="0,0,3,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                <Setter Property="Background" Value="#251F38" />
                                <Setter Property="BorderBrush" Value="#3D3259" />
                                <Setter Property="Foreground" Value="#CBD5E1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScaryokeBatchCount}" Value="3">
                                        <Setter Property="Background" Value="#7C3AED" />
                                        <Setter Property="BorderBrush" Value="#8B5CF6" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding SetScaryokeBatchCountCommand}" CommandParameter="5"
                            Content="Next 5" Height="28" FontSize="11" FontWeight="Bold"
                            materialDesign:ButtonAssist.CornerRadius="4" Cursor="Hand" Margin="0,0,3,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                <Setter Property="Background" Value="#251F38" />
                                <Setter Property="BorderBrush" Value="#3D3259" />
                                <Setter Property="Foreground" Value="#CBD5E1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScaryokeBatchCount}" Value="5">
                                        <Setter Property="Background" Value="#7C3AED" />
                                        <Setter Property="BorderBrush" Value="#8B5CF6" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding SetScaryokeBatchCountCommand}" CommandParameter="10"
                            Content="Next 10" Height="28" FontSize="11" FontWeight="Bold"
                            materialDesign:ButtonAssist.CornerRadius="4" Cursor="Hand" Margin="0,0,3,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                <Setter Property="Background" Value="#251F38" />
                                <Setter Property="BorderBrush" Value="#3D3259" />
                                <Setter Property="Foreground" Value="#CBD5E1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScaryokeBatchCount}" Value="10">
                                        <Setter Property="Background" Value="#7C3AED" />
                                        <Setter Property="BorderBrush" Value="#8B5CF6" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding SetScaryokeBatchCountCommand}" CommandParameter="0"
                            Content="All Active" Height="28" FontSize="11" FontWeight="Bold"
                            materialDesign:ButtonAssist.CornerRadius="4" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                <Setter Property="Background" Value="#251F38" />
                                <Setter Property="BorderBrush" Value="#3D3259" />
                                <Setter Property="Foreground" Value="#CBD5E1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScaryokeBatchCount}" Value="0">
                                        <Setter Property="Background" Value="#7C3AED" />
                                        <Setter Property="BorderBrush" Value="#8B5CF6" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </UniformGrid>
                <!-- Target Singer dropdown (when 1 Singer is selected) -->
                <Grid Margin="0,2,0,0" Visibility="{Binding IsSingleSingerSelected, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Target:" Foreground="#C4B5FD" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Singers}"
                              SelectedItem="{Binding SelectedSingerForScaryoke, Mode=TwoWay}"
                              DisplayMemberPath="DisplayNameWithDuet"
                              Background="#100C1F"
                              Foreground="White"
                              FontSize="12"
                              ToolTip="Choose specific singer to challenge" />
                </Grid>
                <!-- Manual Category Assignment -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Manual:" Foreground="#FFB74D" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Grid.Column="1"
                              IsEditable="True"
                              ItemsSource="{Binding ScaryokeCategories}"
                              Text="{Binding ManualScaryokeCategoryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              materialDesign:HintAssist.Hint="Pick or type category..."
                              Background="#100C1F"
                              Foreground="White"
                              FontSize="12"
                              Margin="0,0,4,0"
                              ToolTip="Select or type a Scaryoke category to assign to the target singer" />
                    <Button Grid.Column="2"
                            Command="{Binding AssignManualScaryokeToTargetCommand}"
                            Content="📌 Set Singer"
                            Height="26" Padding="8,0" Margin="0,0,3,0"
                            FontSize="10" FontWeight="Bold"
                            Background="#7C3AED" BorderBrush="#8B5CF6" Foreground="White"
                            materialDesign:ButtonAssist.CornerRadius="4" Cursor="Hand"
                            ToolTip="Manually assign this category to the target singer without spinning" />
                    <Button Grid.Column="3"
                            Command="{Binding ClearTargetSingerScaryokeCommand}"
                            Content="✕"
                            Height="26" Padding="6,0"
                            FontSize="10" FontWeight="Bold"
                            Background="Transparent" BorderBrush="#EF4444" Foreground="#F87171"
                            materialDesign:ButtonAssist.CornerRadius="4" Cursor="Hand"
                            ToolTip="Clear Scaryoke category from the target singer" />
                </Grid>
                <!-- Skip already assigned toggle (when multi-singer is selected) -->
                <CheckBox Content="Skip singers who already have an assigned category"
                          IsChecked="{Binding ScaryokeBatchOnlyUnassigned, Mode=TwoWay}"
                          Foreground="#A5B4FC" FontSize="11" Margin="0,4,0,0"
                          Visibility="{Binding IsSingleSingerSelected, Converter={StaticResource InverseBooleanConverter}}" />
            </StackPanel>
        </Border>

        <!-- Wheel Graphic -->
        <Viewbox Grid.Row="2" Stretch="Uniform" Margin="10,0,10,6">
            <Grid Width="450" Height="470">
                <!-- Outer Shadow Rim -->
                <Ellipse Width="446" Height="446" Fill="#050406" Stroke="#3E1A60" StrokeThickness="4" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#FF6D00" BlurRadius="20" ShadowDepth="0" Opacity="0.5" />
                    </Ellipse.Effect>
                </Ellipse>

                <!-- Wheel Canvas -->
                <Canvas x:Name="HostWheelCanvas" Width="430" Height="430" HorizontalAlignment="Center" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="HostWheelRotate" Angle="0" />
                    </Canvas.RenderTransform>
                </Canvas>

                <!-- Central Rim Cap -->
                <Ellipse Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,187" Fill="#1E133A" Stroke="#FF6D00" StrokeThickness="3.5" />
                <TextBlock Text="💀" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,202" Foreground="#FF6D00" />

                <!-- Pointer pointing down at 12 o'clock -->
                <Polygon Points="207,12 243,12 225,50" Fill="#FF3D00" Stroke="#FFD600" StrokeThickness="2.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-4,0,0">
                    <Polygon.Effect>
                        <DropShadowEffect Color="#FF3D00" BlurRadius="12" ShadowDepth="0" />
                    </Polygon.Effect>
                </Polygon>
            </Grid>
        </Viewbox>

        <!-- Result Banner -->
        <Border Grid.Row="3" Background="#1B1728" BorderBrush="#3D2E5A" BorderThickness="1.5" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="HostResultTextBlock"
                           Text="{Binding ScaryokeResultText}"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#00E676"
                           TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="HostResultScale" />
                            <TranslateTransform x:Name="HostResultShake" />
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock Text="{Binding ScaryokeResultDetail}" FontSize="11" Foreground="#C9C5D6" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- Step 3: Big Spin Action Button -->
        <Button Grid.Row="4"
                Command="{Binding SpinScaryokeConfiguredCommand}"
                Height="48"
                Margin="0,0,0,8"
                FontSize="15"
                FontWeight="ExtraBold"
                materialDesign:ButtonAssist.CornerRadius="8"
                Cursor="Hand"
                ToolTip="3. Start the spin(s) according to the configured project and singer selection above">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                    <Setter Property="Background" Value="#FF6D00" />
                    <Setter Property="BorderBrush" Value="#E65100" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Content" Value="{Binding ScaryokeSpinButtonText}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBatchSpinning}" Value="True">
                            <Setter Property="Background" Value="#DC2626" />
                            <Setter Property="BorderBrush" Value="#B91C1C" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsScaryokeSpinning}" Value="True">
                            <Setter Property="Background" Value="#DC2626" />
                            <Setter Property="BorderBrush" Value="#B91C1C" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.92" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Options Row -->
        <Border Grid.Row="5" Background="#151221" BorderBrush="#2A223B" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          Content="Prevent 2 singers in a row getting the same result"
                          IsChecked="{Binding ScaryokeAvoidConsecutiveRepeats, Mode=TwoWay}"
                          Foreground="#E2E8F0"
                          FontSize="11"
                          ToolTip="When enabled, prevents consecutive spins from landing on the same challenge category back-to-back."
                          VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Mute"
                              IsChecked="{Binding ScaryokeIsMuted, Mode=TwoWay}"
                              Foreground="#94A3B8"
                              FontSize="11"
                              Margin="0,0,4,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer / Close -->
        <Button Grid.Row="6"
                Command="{Binding ToggleScaryokeCommand}"
                Height="30"
                Style="{StaticResource MaterialDesignOutlinedButton}"
                BorderBrush="#EF4444"
                Foreground="#EF4444"
                Content="✕ Shut Down Wheel (Return to Normal Screen)"
                FontSize="11"
                FontWeight="SemiBold"
                HorizontalAlignment="Stretch"
                ToolTip="Turn off Scaryoke Wheel and restore normal audience and tablet screens" />
    </Grid>
</Window>
