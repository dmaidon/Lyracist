<Window x:Class="KSRotation.Windows.ScaryokeControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:KSRotation.Converters"
        xmlns:vm="clr-namespace:KSRotation.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="🎃 Scaryoke Wheel Controller"
        Height="720" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F0C1B"
        Foreground="White"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10" HorizontalAlignment="Center">
            <TextBlock Text="🎃 SCARYOKE WHEEL 🎃" FontSize="26" FontWeight="ExtraBold" Foreground="#FF6D00" HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FF6D00" BlurRadius="12" ShadowDepth="0" Opacity="0.5" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="{Binding NowSingingPerformerName, StringFormat='Now Singing: {0}', FallbackValue='Audience Singing Challenge'}"
                       FontSize="13" Foreground="#C4B5FD" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0" />
        </StackPanel>

        <!-- Wheel Graphic -->
        <Viewbox Grid.Row="1" Stretch="Uniform" Margin="10,0,10,10">
            <Grid Width="450" Height="470">
                <!-- Outer Shadow Rim -->
                <Ellipse Width="446" Height="446" Fill="#050406" Stroke="#3E1A60" StrokeThickness="4" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#FF6D00" BlurRadius="20" ShadowDepth="0" Opacity="0.5" />
                    </Ellipse.Effect>
                </Ellipse>

                <!-- Wheel Canvas -->
                <Canvas x:Name="HostWheelCanvas" Width="430" Height="430" HorizontalAlignment="Center" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="HostWheelRotate" Angle="0" />
                    </Canvas.RenderTransform>
                </Canvas>

                <!-- Central Rim Cap -->
                <Ellipse Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,187" Fill="#1E133A" Stroke="#FF6D00" StrokeThickness="3.5" />
                <TextBlock Text="💀" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,202" Foreground="#FF6D00" />

                <!-- Pointer pointing down at 12 o'clock -->
                <Polygon Points="207,12 243,12 225,50" Fill="#FF3D00" Stroke="#FFD600" StrokeThickness="2.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-4,0,0">
                    <Polygon.Effect>
                        <DropShadowEffect Color="#FF3D00" BlurRadius="12" ShadowDepth="0" />
                    </Polygon.Effect>
                </Polygon>
            </Grid>
        </Viewbox>

        <!-- Result Banner -->
        <Border Grid.Row="2" Background="#1B1728" BorderBrush="#3D2E5A" BorderThickness="1.5" CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="HostResultTextBlock"
                           Text="{Binding ScaryokeResultText}"
                           FontSize="22" FontWeight="Bold"
                           Foreground="#00E676"
                           TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="HostResultScale" />
                            <TranslateTransform x:Name="HostResultShake" />
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock Text="{Binding ScaryokeResultDetail}" FontSize="12" Foreground="#C9C5D6" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Spin Button -->
        <Button x:Name="HostSpinButton"
                Grid.Row="3"
                Command="{Binding SpinScaryokeWheelCommand}"
                IsEnabled="{Binding IsScaryokeSpinning, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                Height="48"
                Background="#FF6D00"
                BorderBrush="#E65100"
                Foreground="White"
                FontSize="18"
                FontWeight="ExtraBold"
                materialDesign:ButtonAssist.CornerRadius="8"
                Margin="0,0,0,10"
                Cursor="Hand"
                ToolTip="Spin the wheel to assign a challenge to the singer">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="CardsPlayingSpadeMultiple" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="🎲 SPIN THE WHEEL!" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- Options Row -->
        <Border Grid.Row="4" Background="#151221" BorderBrush="#2A223B" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          Content="Prevent 2 singers in a row getting the same result"
                          IsChecked="{Binding ScaryokeAvoidConsecutiveRepeats, Mode=TwoWay}"
                          Foreground="#E2E8F0"
                          FontSize="12"
                          ToolTip="When enabled, prevents consecutive spins from landing on the same challenge category back-to-back."
                          VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Mute"
                              IsChecked="{Binding ScaryokeIsMuted, Mode=TwoWay}"
                              Foreground="#94A3B8"
                              FontSize="12"
                              Margin="0,0,8,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer / Close -->
        <Button Grid.Row="5"
                Command="{Binding ToggleScaryokeCommand}"
                Height="32"
                Style="{StaticResource MaterialDesignOutlinedButton}"
                BorderBrush="#EF4444"
                Foreground="#EF4444"
                Content="✕ Shut Down Wheel (Return to Normal Screen)"
                FontSize="12"
                FontWeight="SemiBold"
                HorizontalAlignment="Stretch"
                ToolTip="Turn off Scaryoke Wheel and restore normal audience and tablet screens" />
    </Grid>
</Window>
