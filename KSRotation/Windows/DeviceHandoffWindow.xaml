<!-- Created on Sep 19, 2026 @ 17:52:00 -> Popout window for bidirectional session device handoff -->
<Window x:Class="KSRotation.Windows.DeviceHandoffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:KSRotation.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Switch Device / Session Handoff"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesignPaper}"
        Foreground="{DynamicResource MaterialDesignBody}"
        Icon="/mic_64.png">

    <Window.Resources>
        <Style x:Key="PopoutCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}" />
            <Setter Property="BorderBrush" Value="#33CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Mode Tabs -->
            <RowDefinition Height="*" />    <!-- Content Panel -->
            <RowDefinition Height="Auto" /> <!-- Footer Close -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="SwapHorizontalBold" Width="26" Height="26" Foreground="#8B5CF6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="SWITCH DEVICE / HANDOFF"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#8B5CF6"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Transfer your live karaoke session seamlessly between laptop and tablet"
                       FontSize="12"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"
                       TextAlignment="Center"/>
        </StackPanel>

        <!-- Mode Toggle Tabs -->
        <Border Grid.Row="1" Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="8" Padding="4" Margin="0,0,0,16" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabSendRadio"
                             Content="📤 Send to Tablet"
                             IsChecked="True"
                             GroupName="HandoffMode"
                             Style="{StaticResource MaterialDesignTabRadioButton}"
                             Checked="OnTabChanged"
                             Padding="16,6"
                             FontSize="13"
                             FontWeight="SemiBold" />
                <RadioButton x:Name="TabReceiveRadio"
                             Content="📥 Receive from Tablet"
                             GroupName="HandoffMode"
                             Style="{StaticResource MaterialDesignTabRadioButton}"
                             Checked="OnTabChanged"
                             Padding="16,6"
                             FontSize="13"
                             FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <!-- TAB 1: SEND TO TABLET -->
        <StackPanel x:Name="SendPanel" Grid.Row="2">
            <!-- QR Container -->
            <Border Width="240"
                    Height="240"
                    Background="White"
                    BorderBrush="#8B5CF6"
                    BorderThickness="3"
                    CornerRadius="10"
                    Padding="6"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12">
                <Image Source="{Binding HandoffQrCodeImage}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Border>

            <!-- URL and Copy -->
            <Border Style="{StaticResource PopoutCardBorder}"
                    Padding="12,8"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="HANDOFF ADDRESS"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
                        <TextBox Text="{Binding HandoffConnectionUrl, Mode=OneWay}"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Foreground="#38BDF8"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Click="OnCopyUrlClicked"
                            Padding="8,4"
                            Height="32"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Copy" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- PIN Code Box -->
            <Border Background="#1AF59E0B"
                    BorderBrush="#F59E0B"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="DJ PIN CODE (FOR SECURE HANDOFF)"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#F59E0B" />
                        <TextBlock Text="{Binding DjPin}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#F59E0B"
                                   FontFamily="Consolas"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Click="OnCopyPinClicked"
                            Padding="8,4"
                            Height="32"
                            Foreground="#F59E0B"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Copy PIN" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <TextBlock Text="Scan this QR code with the tablet's camera to open in KSRotation MAUI, or in KSRotation MAUI tap Switch Device -> Receive."
                       FontSize="11"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,10"/>
        </StackPanel>

        <!-- TAB 2: RECEIVE FROM TABLET -->
        <StackPanel x:Name="ReceivePanel" Grid.Row="2" Visibility="Collapsed">
            <Border Style="{StaticResource PopoutCardBorder}" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="LOCAL NETWORK DEVICES" FontSize="12" FontWeight="Bold" Foreground="#8B5CF6"/>
                            <TextBlock Text="Detect running tablets on the same Wi-Fi" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Click="OnScanNetworkClicked"
                                Background="#8B5CF6"
                                Foreground="White"
                                Height="30"
                                Padding="12,0"
                                FontSize="11"
                                FontWeight="Bold">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Radar" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Scan Wi-Fi" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Scanning Indicator -->
                    <ProgressBar x:Name="ScanProgressBar" IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="Collapsed"/>

                    <!-- Discovered Peers List -->
                    <ListBox x:Name="PeersListBox"
                             ItemsSource="{Binding DiscoveredPeers}"
                             SelectedItem="{Binding SelectedDiscoveredPeer}"
                             SelectionChanged="OnPeerSelectionChanged"
                             MaxHeight="120"
                             Margin="0,0,0,8"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource MaterialDesignCardBackground}" BorderThickness="1" BorderBrush="#338B5CF6" CornerRadius="6" Padding="8,6" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding VenueName}" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text="{Binding DisplayText}" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentSinger}" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Manual Input Fields -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Host IP Address" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBox x:Name="HostIpTextBox" Text="192.168.1." Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                            <TextBlock Text="Port" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBox x:Name="PortTextBox" Text="5000" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DJ PIN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBox x:Name="PinTextBox" Text="" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Pull Action Button -->
                    <Button Click="OnPullSessionClicked"
                            Background="#10B981"
                            Foreground="White"
                            Height="38"
                            FontWeight="Bold"
                            FontSize="12"
                            Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Download" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Import &amp; Take Over Session" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Result Feedback -->
            <TextBlock x:Name="ReceiveStatusLabel"
                       Text=""
                       FontSize="11"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,10"/>
        </StackPanel>

        <!-- Footer Close Button -->
        <Button Grid.Row="3"
                Style="{StaticResource MaterialDesignOutlinedButton}"
                Click="OnCloseClicked"
                Content="Close"
                Height="36"
                HorizontalAlignment="Center"
                Padding="32,0"
                Margin="0,8,0,0" />
    </Grid>
</Window>
