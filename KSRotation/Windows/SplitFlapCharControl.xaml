<!-- Last Edit: Jun 30, 2026 07:09 - Switched split-flap colors to app theme resources for dark/light contrast consistency. -->
<UserControl x:Class="KSRotation.Windows.SplitFlapCharControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="48" d:DesignWidth="32"
             Width="32" Height="48">
    <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <!-- 1. STATIC BACKGROUND (New character top, Old character bottom) -->
        
        <!-- Top Background (New Character Top Half) -->
        <Border Grid.Row="0" 
                Background="{DynamicResource AppSplitFlapBackgroundBrush}" 
                BorderBrush="{DynamicResource AppSplitFlapBorderBrush}" 
                BorderThickness="1,1,1,0" 
                CornerRadius="4,4,0,0" 
                ClipToBounds="True">
            <TextBlock x:Name="StaticTopText"
                       FontFamily="Arial"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Height="48"/>
        </Border>

        <!-- Bottom Background (Old Character Bottom Half) -->
        <Border Grid.Row="1" 
                Background="{DynamicResource AppSplitFlapBackgroundBrush}" 
                BorderBrush="{DynamicResource AppSplitFlapBorderBrush}" 
                BorderThickness="1,0,1,1" 
                CornerRadius="0,0,4,4" 
                ClipToBounds="True">
            <TextBlock x:Name="StaticBottomText"
                       FontFamily="Arial"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Height="48"/>
        </Border>

        <!-- 2. ANIMATING FOREGROUND FLAPS -->

        <!-- Top Flapper (Old Character Top Half - falls down) -->
        <Border x:Name="TopFlapper"
                Grid.Row="0" 
                Background="{DynamicResource AppSplitFlapBackgroundBrush}" 
                BorderBrush="{DynamicResource AppSplitFlapBorderBrush}" 
                BorderThickness="1,1,1,0" 
                CornerRadius="4,4,0,0" 
                ClipToBounds="True"
                RenderTransformOrigin="0.5, 1">
            <Border.RenderTransform>
                <ScaleTransform x:Name="TopFlapperScale" ScaleY="1" />
            </Border.RenderTransform>
            <TextBlock x:Name="TopFlapperText"
                       FontFamily="Arial"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Height="48"/>
        </Border>

        <!-- Bottom Flapper (New Character Bottom Half - appears falling down) -->
        <Border x:Name="BottomFlapper"
                Grid.Row="1" 
                Background="{DynamicResource AppSplitFlapBackgroundBrush}" 
                BorderBrush="{DynamicResource AppSplitFlapBorderBrush}" 
                BorderThickness="1,0,1,1" 
                CornerRadius="0,0,4,4" 
                ClipToBounds="True"
                RenderTransformOrigin="0.5, 0">
            <Border.RenderTransform>
                <ScaleTransform x:Name="BottomFlapperScale" ScaleY="0" />
            </Border.RenderTransform>
            <TextBlock x:Name="BottomFlapperText"
                       FontFamily="Arial"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Height="48"/>
        </Border>

        <!-- 3. MIDDLE HINGE / SPLIT LINE -->
        <Border Grid.Row="0" 
                Grid.RowSpan="2" 
                Height="1.5" 
                Background="{DynamicResource AppSplitFlapBorderBrush}" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Stretch" 
                IsHitTestVisible="False" />
    </Grid>
</UserControl>
