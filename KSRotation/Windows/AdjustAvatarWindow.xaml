<!-- Edited on Oct 2, 2026 @ 13:09:00 -> Set PreviewImage Stretch to Fill for accurate display scaling -->
<Window x:Class="KSRotation.Windows.AdjustAvatarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Center Performer Photo"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesignPaper}"
        Foreground="{DynamicResource MaterialDesignBody}"
        Icon="/mic_64.png">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Viewfinder -->
            <RowDefinition Height="Auto" /> <!-- Zoom / Rotate controls -->
            <RowDefinition Height="Auto" /> <!-- Bottom Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="🎯" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="TitleText"
                           Text="CENTER PERFORMER PHOTO"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AppHeaderBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Drag photo to center the face in the circle. Use slider or scroll wheel to zoom."
                       FontSize="11.5"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Viewfinder (340x340) -->
        <Border Grid.Row="1"
                x:Name="ViewportBorder"
                Width="340"
                Height="340"
                Background="#0C1017"
                BorderBrush="#0EA5E9"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True"
                Cursor="SizeAll"
                HorizontalAlignment="Center"
                MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                MouseMove="Viewport_MouseMove"
                MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
                MouseWheel="Viewport_MouseWheel">
            <Grid>
                <!-- Canvas containing moving/zooming image -->
                <Canvas x:Name="ImageCanvas" Width="340" Height="340" Background="Transparent" ClipToBounds="True">
                    <Image x:Name="PreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                </Canvas>

                <!-- Dimmed Mask with 280px cutout circle (F1 specifies EvenOdd fill rule to punch the circle hole) -->
                <Path IsHitTestVisible="False"
                      Fill="#C8090D14"
                      Data="F1 M 0,0 L 340,0 L 340,340 L 0,340 Z M 170,30 A 140,140 0 1,0 170,310 A 140,140 0 1,0 170,30 Z" />

                <!-- Circular Accent Frame Ring (280x280) -->
                <Ellipse Width="280"
                         Height="280"
                         Stroke="#0EA5E9"
                         StrokeThickness="2.5"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False" />

                <!-- Subtle Eye Level & Center Guides -->
                <Line X1="60" Y1="145" X2="280" Y2="145"
                      Stroke="#38BDF8" StrokeThickness="1" StrokeDashArray="3 3" Opacity="0.3"
                      IsHitTestVisible="False" />
                <Line X1="170" Y1="50" X2="170" Y2="290"
                      Stroke="#38BDF8" StrokeThickness="1" StrokeDashArray="3 3" Opacity="0.25"
                      IsHitTestVisible="False" />
            </Grid>
        </Border>

        <!-- Zoom & Rotate Controls -->
        <Border Grid.Row="2"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,14,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Zoom Slider Row -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🔍-" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Slider Grid.Column="1"
                            x:Name="ZoomSlider"
                            Minimum="1.0"
                            Maximum="3.5"
                            Value="1.0"
                            SmallChange="0.05"
                            LargeChange="0.2"
                            VerticalAlignment="Center"
                            ValueChanged="ZoomSlider_ValueChanged" />
                    <TextBlock Grid.Column="2" Text="🔍+" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center" Margin="6,0,8,0" />
                    <TextBlock Grid.Column="3"
                               x:Name="ZoomText"
                               Text="1.0x"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{DynamicResource AppContrastTextBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>

                <!-- Reset & Rotate Quick Buttons -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button Content="Reset / Fit"
                            Click="OnResetClicked"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="{DynamicResource MaterialDesignCardBackground}"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            Foreground="{DynamicResource AppContrastTextBrush}"
                            Height="28" Padding="10,0" Margin="0,0,8,0"
                            ToolTip="Reset pan and zoom to fit frame" />
                    <Button Content="Rotate ↻"
                            Click="OnRotateClicked"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="{DynamicResource MaterialDesignCardBackground}"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            Foreground="{DynamicResource AppContrastTextBrush}"
                            Height="28" Padding="10,0"
                            ToolTip="Rotate photo 90 degrees clockwise" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom Action Buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Cancel"
                    IsCancel="True"
                    Style="{StaticResource ActionButtonStyle}"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    Foreground="{DynamicResource AppContrastTextBrush}"
                    Click="OnCancelClicked" />

            <Button Grid.Column="2"
                    Content="Apply &amp; Save"
                    IsDefault="True"
                    Style="{StaticResource ActionButtonStyle}"
                    Background="#0EA5E9"
                    BorderBrush="#0EA5E9"
                    Foreground="White"
                    Click="OnApplyClicked" />
        </Grid>
    </Grid>
</Window>
