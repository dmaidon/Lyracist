<!-- Created on Aug 1, 2026 @ 09:46:00 -> Added DJ Banner projection window -->
<Window x:Class="KSRotation.Windows.DjBannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DJ Banner Screen"
        Width="1000"
        Height="600"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Black"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        MouseDoubleClick="OnMouseDoubleClick">

    <Grid>
        <Image x:Name="BannerImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <MediaElement x:Name="BannerVideo" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" LoadedBehavior="Manual" UnloadedBehavior="Stop" Visibility="Collapsed" MediaEnded="BannerVideo_MediaEnded" />

        <!-- Floating QR Code Overlay for audience scanning (shown in the corner of the screen) -->
        <Border VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="24"
                Padding="10"
                Background="#EE1E293B"
                BorderBrush="#475569"
                BorderThickness="1.5"
                CornerRadius="8"
                Width="180"
                Height="235"
                Panel.ZIndex="99">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ConnectionUrl}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ConnectionUrl}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDjBannerQrCodeEnabled}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="160" 
                        Height="160" 
                        Background="White" 
                        CornerRadius="4" 
                        Padding="3"
                        HorizontalAlignment="Center">
                    <Image Source="{Binding QrCodeImage}" 
                           Stretch="Uniform"/>
                </Border>
                <TextBlock Text="SCAN TO REQUEST"
                           FontWeight="Bold"
                           FontSize="12"
                           Foreground="#F8FAFC"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
                <TextBlock Text="{Binding ConnectionUrl}"
                           FontSize="10"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
