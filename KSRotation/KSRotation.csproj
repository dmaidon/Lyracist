<!-- Edited on Jul 30, 2026 @ 06:15:00 -> Redirected all icon and PNG references to central Lyracist/Assets folder -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EmitCompilerGeneratedFiles>false</EmitCompilerGeneratedFiles>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <DefineConstants>$(DefineConstants);WPF</DefineConstants>
    <AssemblyVersion>26.7.30.335</AssemblyVersion>
    <FileVersion>26.7.30.335</FileVersion>
    <Title>Karaoke Singer Rotation</Title>
    <AssemblyTitle>Karaoke Singer Rotation</AssemblyTitle>
    <Product>Karaoke Singer Rotation</Product>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NeutralLanguage>en-US</NeutralLanguage>
    <PackageIcon>rotation.png</PackageIcon>
    <ApplicationIcon>..\Lyracist\Assets\rotation.ico</ApplicationIcon>
    <BaseOutputPath>C:\VB26\Release\Lyracist</BaseOutputPath>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1701;1702</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="mic_64.png" />
    <None Remove="Windows\singer_64.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Lyracist\Assets\rotation.ico" Link="rotation.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Lyracist\Assets\rotation.png" Link="rotation.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\.editorconfig" Link=".editorconfig" />
    <None Include="..\Lyracist\Assets\mic_128.png" Link="mic_128.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\Lyracist\Assets\mic_64.png" Link="mic_64.png" />
    <Resource Include="Windows\singer_64.png" />
    <Resource Include="Resources\KSRotation.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\PatronPortal.html" />
    <EmbeddedResource Include="Resources\dj.html" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\Globals.cs" Link="Globals.cs" />
    <Compile Include="..\Shared\IRotationSinger.cs" Link="IRotationSinger.cs" />
    <Compile Include="..\Shared\RotationHelpers.cs" Link="RotationHelpers.cs" />
  </ItemGroup>

</Project>
