<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EmitCompilerGeneratedFiles>false</EmitCompilerGeneratedFiles>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <DefineConstants>$(DefineConstants);WPF</DefineConstants>
    <AssemblyVersion>26.8.27.552</AssemblyVersion>
    <FileVersion>26.8.27.552</FileVersion>
    <Title>Karaoke Singer Rotation</Title>
    <AssemblyTitle>Karaoke Singer Rotation</AssemblyTitle>
    <Product>Karaoke Singer Rotation</Product>
    <Authors>Dennis N. Maidon</Authors>
    <Company>PAROLE Software</Company>
    <Copyright>Copyright © 2026 PAROLE Software</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NeutralLanguage>en-US</NeutralLanguage>
    <PackageIcon>rotation.png</PackageIcon>
    <ApplicationIcon>..\Lyracist\Assets\rotation.ico</ApplicationIcon>
    <!-- Report each monitor's true physical resolution/DPI on mixed-DPI multi-monitor setups. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <BaseOutputPath>C:\VB26\Release\Lyracist</BaseOutputPath>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;0436</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1701;1702;0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="mic_64.png" />
    <None Remove="Windows\singer_64.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Lyracist\Assets\rotation.ico" Link="rotation.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Lyracist\Assets\rotation.png" Link="rotation.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\.editorconfig" Link=".editorconfig" />
    <None Include="..\Lyracist\Assets\mic_128.png" Link="mic_128.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\Lyracist\Assets\mic_64.png" Link="mic_64.png" />
    <Resource Include="Windows\singer_64.png" />
    <Resource Include="Resources\KSRotation.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\PatronPortal.html" />
    <EmbeddedResource Include="Resources\dj.html" />
    <EmbeddedResource Include="Resources\kiosk.html" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\Globals.cs" Link="Globals.cs" />
    <Compile Include="..\Shared\IRotationSinger.cs" Link="IRotationSinger.cs" />
    <Compile Include="..\Shared\RotationHelpers.cs" Link="RotationHelpers.cs" />
    <Compile Include="..\Shared\ChromecastDiscoveryService.cs" Link="ChromecastDiscoveryService.cs" />
    <Compile Include="..\Shared\ChromecastSender.cs" Link="ChromecastSender.cs" />
    <Compile Include="..\Shared\BrowserCastDiscoveryService.cs" Link="BrowserCastDiscoveryService.cs" />
    <Compile Include="..\Shared\LocalNetworkHelper.cs" Link="LocalNetworkHelper.cs" />
    <Compile Include="..\Shared\DisplayTarget.cs" Link="DisplayTarget.cs" />
    <Compile Include="..\Shared\ICaptureSource.cs" Link="ICaptureSource.cs" />
    <Compile Include="..\Shared\IRotationRenderer.cs" Link="IRotationRenderer.cs" />
    <Compile Include="..\Shared\RotationRenderer.cs" Link="RotationRenderer.cs" />
    <Compile Include="..\Shared\MiracastController.cs" Link="MiracastController.cs" />
    <Compile Include="..\Shared\BrowserCastServer.cs" Link="BrowserCastServer.cs" />
    <Compile Include="..\Shared\ICastingService.cs" Link="ICastingService.cs" />
    <Compile Include="..\Shared\CastingService.cs" Link="CastingService.cs" />
    <Compile Include="..\Shared\MonitorDpiHelper.cs" Link="MonitorDpiHelper.cs" />
    <Compile Include="..\Shared\DjBannerItem.cs" Link="DjBannerItem.cs" />
    <Compile Include="..\Shared\SpecialEventConfig.cs" Link="SpecialEventConfig.cs" />
    <Compile Include="..\Shared\DjBannerFileManager.cs" Link="DjBannerFileManager.cs" />
    <Compile Include="..\Shared\WindowPositioner.cs" Link="WindowPositioner.cs" />
    <Compile Include="..\Shared\MonitorInfo.cs" Link="MonitorInfo.cs" />
    <Compile Include="..\Shared\MonitorEnumerator.cs" Link="MonitorEnumerator.cs" />
    <Compile Include="..\Shared\AtomicJsonFile.cs" Link="AtomicJsonFile.cs" />
    <Compile Include="..\Shared\WifiHelper.cs" Link="WifiHelper.cs" />
    <Compile Include="..\Shared\WifiPasswordStore.cs" Link="WifiPasswordStore.cs" />
    <Compile Include="..\Shared\TriviaDisplayViewModel.cs" Link="TriviaDisplayViewModel.cs" />
    <Compile Include="..\Shared\TextBoxSelectionHelper.cs" Link="TextBoxSelectionHelper.cs" />
    <Compile Include="..\Shared\NameFormatting.cs" Link="NameFormatting.cs" />
    <Compile Include="..\Lyracist.Trivia\Services\TriviaBannerGenerator.cs" Link="Services\TriviaBannerGenerator.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lyracist.Data\Lyracist.Data.csproj" />
    <ProjectReference Include="..\Lyracist.Trivia.Core\Lyracist.Trivia.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\EventBanners\*" Link="EventBanners\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\TriviaData\**\*">
      <Link>TriviaData\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
