<!-- Edited on Aug 22, 2026 @ 11:40:00 -> Stacked Wifi Network and Password onto separate lines in connect screen -->
<Window x:Class="Lyracist.Trivia.Windows.TriviaDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lyracist Trivia Live Display"
        Icon="/LyracistTrivia.ico"
        Height="1080" Width="1920"
        WindowStyle="None"
        WindowState="Normal"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Background="#080314"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid>
        <Grid.ContextMenu>
            <ContextMenu Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334155" BorderThickness="1">
                <MenuItem Header="✕ Close Projection (Esc)" Click="CloseMenu_Click" FontWeight="Bold" Foreground="#EF4444" />
                <MenuItem Header="🗖 Toggle Fullscreen (F11 / Double-Click)" Click="ToggleFullscreen_Click" Foreground="#FFFFFF" />
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Dynamic Gradient Glow Background -->
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#2A0845" Offset="0.0" />
                    <GradientStop Color="#140628" Offset="0.5" />
                    <GradientStop Color="#070210" Offset="1.0" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Top-Right Floating Close Button -->
        <Button Width="36" Height="36" Margin="0,14,16,0"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="#66000000" BorderBrush="#33FFFFFF" BorderThickness="1"
                Click="CloseButton_Click" ToolTip="Close Projection Screen (Escape)"
                Cursor="Hand" Panel.ZIndex="100">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                        <TextBlock Text="✕" FontSize="16" FontWeight="Bold" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#EF4444" />
                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="#F87171" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Main Content Area -->
        <Grid Margin="24,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Scrolling Marquee Bar (Scores & Leader Ticker) -->
            <Border Grid.Row="0" Background="#26103A" CornerRadius="10" Padding="0,6" Margin="0,0,0,16" BorderBrush="#581C87" BorderThickness="1.5" ClipToBounds="True">
                <Canvas Height="24" ClipToBounds="True">
                    <TextBlock Text="{Binding MarqueeSummaryText}" FontSize="14" FontWeight="Bold" Foreground="#FBBF24" VerticalAlignment="Center">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(Canvas.Left)" From="1280" To="-3000" Duration="0:0:35" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </Canvas>
            </Border>

            <!-- Top Header & Timer Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Category / Live Pub Trivia Night Title & Inline Venue Name -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="24" FontWeight="Black" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding CategoryTitle}" />
                                <Setter Property="Foreground" Value="#A78BFA" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnectInstructionsActive}" Value="True">
                                        <Setter Property="Text" Value="🎮 LIVE PUB TRIVIA NIGHT" />
                                        <Setter Property="Foreground" Value="#FBBF24" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock FontSize="24" FontWeight="Black" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter Property="Text" Value="{Binding VenueName, StringFormat='•  {0}'}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VenueName}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding VenueName}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsConnectInstructionsActive}" Value="True">
                                        <Setter Property="Foreground" Value="#FBBF24" />
                                        <Setter Property="Text" Value="{Binding VenueName, StringFormat='—  {0}'}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Circular/Pill Countdown Timer -->
                <Border Grid.Column="1" CornerRadius="16" Padding="24,10" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#10B981" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWarningActive}" Value="True">
                                    <Setter Property="Background" Value="#EF4444" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsConnectInstructionsActive}" Value="True">
                                    <Setter Property="Background" Value="#6366F1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⏱ " FontSize="28" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <TextBlock FontSize="32" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding RemainingSeconds, StringFormat='{}{0}s'}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnectInstructionsActive}" Value="True">
                                            <Setter Property="Text" Value="{Binding PreGameCountdownText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Middle Screen State Switcher -->
            <Grid Grid.Row="2">
                <!-- 1. Unified Pre-Game Lobby Screen (Category Banner Left + Side-by-Side Dual QR Right) -->
                <Grid Margin="0,0,0,16">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsConnectInstructionsActive}" Value="True" />
                                        <Condition Binding="{Binding IsAnnouncementActive}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5.2*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="4.8*" />
                    </Grid.ColumnDefinitions>

                    <!-- Game Master's Instruction/Welcome Banner (customizable in Settings) -->
                    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="#1E1B4B" CornerRadius="14" Padding="20,12" Margin="0,0,0,14" BorderBrush="#FBBF24" BorderThickness="2">
                        <TextBlock Text="{Binding WelcomeBannerText}" FontSize="22" FontWeight="Black" Foreground="#FBBF24" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    </Border>

                    <!-- Left Column: Featured 16:9 Category Announcement Banner -->
                    <Border Grid.Row="1" Grid.Column="0" Background="#140E2A" CornerRadius="24" Padding="24" BorderBrush="#8B5CF6" BorderThickness="3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header Badge -->
                            <Border Grid.Row="0" Background="#2E1065" CornerRadius="12" Padding="18,8" HorizontalAlignment="Stretch" Margin="0,0,0,16" BorderBrush="#A78BFA" BorderThickness="1.5">
                                <TextBlock Text="{Binding FeaturedCategoryHeaderText}" FontSize="18" FontWeight="Black" Foreground="#FBBF24" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            </Border>

                            <!-- 16:9 Banner Display Container -->
                            <Border Grid.Row="1" CornerRadius="18" Background="#090514" BorderBrush="#A78BFA" BorderThickness="2" ClipToBounds="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Grid>
                                    <!-- Single-Category Banner Image -->
                                    <Image Source="{Binding CategoryBannerPath}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMixedCategoryGame}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <!-- Mixed-Category Banner Image: generated fresh, listing every checked category -->
                                    <Image Source="{Binding MixedCategoryBannerImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMixedCategoryGame}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <!-- Fallback when no banner (path or generated image) is available -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCategoryBanner}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="🎯" FontSize="80" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding CategoryTitle}" FontSize="32" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,10,0,0" TextAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Bottom Category Subtitle -->
                            <StackPanel Grid.Row="2" Margin="0,14,0,0" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding CategoryTitle}" FontSize="24" FontWeight="Black" Foreground="#F8FAFC" HorizontalAlignment="Center" TextAlignment="Center" />
                                <TextBlock Text="Lock in your answers on your smartphone • Fast buzzer speed bonus active!" FontSize="14" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right Column: Countdown + Side-by-Side Dual QR Cards (Wi-Fi & Trivia Join) -->
                    <Grid Grid.Row="1" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Top Card: Game Start Countdown -->
                        <Border Grid.Row="0" Background="#1E1B4B" CornerRadius="16" Padding="16,10" Margin="0,0,0,12" BorderBrush="#F59E0B" BorderThickness="2.5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="⏱️ GAME STARTS IN" FontSize="15" FontWeight="Black" Foreground="#FBBF24" />
                                    <TextBlock Text="Get your drinks and form your teams!" FontSize="11" Foreground="#CBD5E1" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#451A03" CornerRadius="10" Padding="16,4" VerticalAlignment="Center" BorderBrush="#F59E0B" BorderThickness="1.5">
                                    <TextBlock Text="{Binding PreGameCountdownText}" FontWeight="Black" FontSize="26" Foreground="#FBBF24" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Side-by-Side Dual QR Cards: Wi-Fi (Step 1) & Trivia Join (Step 2) -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Wi-Fi Scan-to-Connect -->
                            <Border Grid.Column="0" Background="#1B1744" CornerRadius="18" Padding="14,12" BorderBrush="#818CF8" BorderThickness="2.5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <TextBlock Text="📶 1. CONNECT WI-FI" FontSize="15" FontWeight="Black" Foreground="#FBBF24" TextAlignment="Center" />
                                        <TextBlock Text="Scan to join venue Wi-Fi" FontSize="11" Foreground="#CBD5E1" TextAlignment="Center" />
                                    </StackPanel>

                                    <!-- QR Code Box with Viewbox (scales cleanly, never scrunched) -->
                                    <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="12" Padding="8" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#818CF8" BorderThickness="2">
                                        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="210" MaxHeight="210">
                                            <Image Source="{Binding WifiQrCodeImage}" Width="200" Height="200" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        </Viewbox>
                                    </Border>

                                    <!-- Wi-Fi Credentials Info -->
                                    <StackPanel Grid.Row="2" Margin="0,8,0,0" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                            <TextBlock Text="Wifi Network: " FontWeight="Bold" FontSize="24" Foreground="#94A3B8" />
                                            <TextBlock Text="{Binding WifiSsid}" FontWeight="Black" FontSize="24" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" MaxWidth="225" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="Password: " FontWeight="Bold" FontSize="24" Foreground="#94A3B8" />
                                            <TextBlock Text="{Binding WifiPasswordDisplay}" FontWeight="ExtraBold" FontSize="24" Foreground="#FBBF24" TextTrimming="CharacterEllipsis" MaxWidth="225" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Card 2: Trivia Join & Buzzer -->
                            <Border Grid.Column="2" Background="#0A2436" CornerRadius="18" Padding="14,12" BorderBrush="#38BDF8" BorderThickness="2.5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <TextBlock Text="📱 2. JOIN TRIVIA" FontSize="15" FontWeight="Black" Foreground="#38BDF8" TextAlignment="Center" />
                                        <TextBlock Text="Scan to open mobile buzzer" FontSize="11" Foreground="#CBD5E1" TextAlignment="Center" />
                                    </StackPanel>

                                    <!-- QR Code Box with Viewbox (scales cleanly, never scrunched) -->
                                    <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="12" Padding="8" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#38BDF8" BorderThickness="2">
                                        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="210" MaxHeight="210">
                                            <Image Source="{Binding QrCodeImage}" Width="200" Height="200" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        </Viewbox>
                                    </Border>

                                    <!-- Web Link Text -->
                                    <StackPanel Grid.Row="2" Margin="0,8,0,0" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="🌐 " FontSize="24" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ConnectUrl}" FontWeight="Black" FontSize="24" Foreground="#38BDF8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="350" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 2. Question & Options View (Visible during active gameplay) -->
                <Grid Margin="0,0,0,16">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsConnectInstructionsActive}" Value="False" />
                                        <Condition Binding="{Binding IsGameComplete}" Value="False" />
                                        <Condition Binding="{Binding IsAnnouncementActive}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Question Prompt Card -->
                    <Border Grid.Row="0" Background="#E61A2234" CornerRadius="20" Padding="32,20" Margin="0,0,0,20" BorderBrush="#1FFFFFFF" BorderThickness="1.5">
                        <Viewbox MaxHeight="140" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding QuestionPrompt}" FontSize="34" FontWeight="Bold" LineHeight="44" TextWrapping="Wrap" Foreground="#FFFFFF" TextAlignment="Center" MaxWidth="1100" />
                        </Viewbox>
                    </Border>

                    <!-- 4 Answer Options (2x2 Grid) -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Option A -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#261A42" CornerRadius="16" Padding="20,14" Margin="8" BorderBrush="#8B5CF6" BorderThickness="3"
                                Opacity="{Binding OptionAOpacity}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#8B5CF6" CornerRadius="10" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="▲" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Viewbox Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="110">
                                    <TextBlock Text="{Binding OptionA}" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="600" />
                                </Viewbox>
                            </Grid>
                        </Border>

                        <!-- Option B -->
                        <Border Grid.Row="0" Grid.Column="1" Background="#13313F" CornerRadius="16" Padding="20,14" Margin="8" BorderBrush="#06B6D4" BorderThickness="3"
                                Opacity="{Binding OptionBOpacity}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#06B6D4" CornerRadius="10" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="◆" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Viewbox Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="110">
                                    <TextBlock Text="{Binding OptionB}" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="600" />
                                </Viewbox>
                            </Grid>
                        </Border>

                        <!-- Option C -->
                        <Border Grid.Row="1" Grid.Column="0" Background="#3D2912" CornerRadius="16" Padding="20,14" Margin="8" BorderBrush="#F59E0B" BorderThickness="3"
                                Opacity="{Binding OptionCOpacity}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#F59E0B" CornerRadius="10" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="●" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Viewbox Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="110">
                                    <TextBlock Text="{Binding OptionC}" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="600" />
                                </Viewbox>
                            </Grid>
                        </Border>

                        <!-- Option D -->
                        <Border Grid.Row="1" Grid.Column="1" Background="#3E1524" CornerRadius="16" Padding="20,14" Margin="8" BorderBrush="#F43F5E" BorderThickness="3"
                                Opacity="{Binding OptionDOpacity}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#F43F5E" CornerRadius="10" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="■" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Viewbox Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="110">
                                    <TextBlock Text="{Binding OptionD}" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="600" />
                                </Viewbox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 3. Game Complete & Winner Celebration View -->
                <Grid Margin="0,0,0,16">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsConnectInstructionsActive}" Value="False" />
                                        <Condition Binding="{Binding IsGameComplete}" Value="True" />
                                        <Condition Binding="{Binding IsAnnouncementActive}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Winner card and intermission countdown banner in Row 0 -->
                    <StackPanel Grid.Row="0">
                        <!-- Winner Highlight Card -->
                        <Border Background="#261A42" CornerRadius="16" Padding="24,12" Margin="0,0,0,10" BorderBrush="#F59E0B" BorderThickness="2">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🏆 GAME COMPLETE - CONGRATULATIONS! 🏆" FontSize="20" FontWeight="Black" Foreground="#FBBF24" TextAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding WinnerTitle}" FontSize="24" FontWeight="Black" Foreground="#FFFFFF" TextAlignment="Center" Margin="0,0,0,2" />

                                <!-- Winning Score -->
                                <TextBlock Text="{Binding WinningScore, StringFormat='Final Score: {0:N0} Points'}" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" TextAlignment="Center" Margin="0,0,0,2" />

                                <!-- Winning Team Members Roster (If team winner) -->
                                <Border Background="#1AFFFFFF" CornerRadius="8" Padding="12,4" Margin="0,2,0,0" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasTeamWinner}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="👥 Team Players: " FontWeight="Bold" FontSize="12" Foreground="#FBBF24" />
                                        <TextBlock Text="{Binding WinningTeamMembersRoster}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Intermission Next Game Countdown Banner -->
                        <Border Background="#1E1B4B" CornerRadius="12" Padding="16,8" Margin="0,0,0,10" BorderBrush="#6366F1" BorderThickness="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIntermissionActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="🎮 NEXT TRIVIA ROUND STARTS IN" FontWeight="Black" FontSize="13" Foreground="#A5B4FC" />
                                    <TextBlock Text="Keep your buzzers ready! A new randomized round will auto-start." FontSize="11" Foreground="#CBD5E1" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#312E81" CornerRadius="8" Padding="14,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IntermissionCountdownText}" FontWeight="ExtraBold" FontSize="20" Foreground="#FFFFFF" />
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Final Leaderboard & Intermission Sign-Up Section (Row 1) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Final Leaderboard Table -->
                        <Border Grid.Column="0" Background="#E61A2234" CornerRadius="16" Padding="20,12" BorderBrush="#14FFFFFF" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="FINAL LEADERBOARD &amp; SCORES" FontSize="15" FontWeight="Black" Foreground="#94A3B8" Margin="0,0,0,8" HorizontalAlignment="Center" />

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding TopPlayers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#14FFFFFF" CornerRadius="8" Padding="14,6" Margin="0,0,0,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding TotalScore, StringFormat='{}{0:N0} pts'}" FontSize="15" FontWeight="ExtraBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Intermission Sign-Up QR Card (Column 1) - lets players scan in during the break -->
                        <Border Grid.Column="1" Background="#0A2436" CornerRadius="16" Padding="16,12" Margin="14,0,0,0" BorderBrush="#38BDF8" BorderThickness="2" Width="360" VerticalAlignment="Stretch">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIntermissionActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,8" HorizontalAlignment="Center">
                                    <TextBlock Text="🎮 SIGN UP FOR NEXT ROUND" FontWeight="Black" FontSize="15" Foreground="#38BDF8" TextAlignment="Center" />
                                    <TextBlock Text="Scan to connect before next game starts" FontSize="11" Foreground="#94A3B8" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- QR Codes side by side -->
                                <UniformGrid Grid.Row="1" Columns="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <!-- Wi-Fi QR -->
                                    <StackPanel HorizontalAlignment="Center" Margin="6,0">
                                        <TextBlock Text="📶 WI-FI" FontSize="11" FontWeight="Black" Foreground="#FBBF24" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                        <Border Background="#FFFFFF" CornerRadius="8" Padding="6" HorizontalAlignment="Center">
                                            <Image Source="{Binding WifiQrCodeImage}" Width="120" Height="120" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Trivia Join QR -->
                                    <StackPanel HorizontalAlignment="Center" Margin="6,0">
                                        <TextBlock Text="📱 JOIN NOW" FontSize="11" FontWeight="Black" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                        <Border Background="#FFFFFF" CornerRadius="8" Padding="6" HorizontalAlignment="Center">
                                            <Image Source="{Binding QrCodeImage}" Width="120" Height="120" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        </Border>
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Grid.Row="2" Text="{Binding ConnectUrl}" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" TextAlignment="Center" Margin="0,6,0,0" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 4. Pre-Game Announcement/Advertisement Screen (game master triggered, shown
                     ahead of the connect instructions screen) -->
                <Grid Margin="0,0,0,16">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAnnouncementActive}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Border Background="#140E2A" CornerRadius="24" Padding="16" BorderBrush="#F59E0B" BorderThickness="3">
                        <Image Source="{Binding AnnouncementImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                </Grid>
            </Grid>

            <!-- Bottom Connection & Copyright Bar -->
            <Border Grid.Row="3" Background="#D90F172A" CornerRadius="14" Padding="20,10" BorderBrush="#14FFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Small persistent join QR code so latecomers can still scan in once the
                         game is underway, not just during the initial lobby screen. -->
                    <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" Padding="4" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnectInstructionsActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Image Source="{Binding QrCodeImage}" Width="56" Height="56" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📱 PLAY ON YOUR PHONE:" FontWeight="ExtraBold" FontSize="13" Foreground="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConnectUrl}" FontWeight="ExtraBold" FontSize="15" Foreground="#38BDF8" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Center Copyright Notice -->
                    <TextBlock Grid.Column="2" Text="{Binding Copyright}" FontSize="12" Foreground="#64748B" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <TextBlock Grid.Column="3" Text="Powered by Lyracist" FontSize="12" Foreground="#475569" VerticalAlignment="Center" FontWeight="Bold" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>