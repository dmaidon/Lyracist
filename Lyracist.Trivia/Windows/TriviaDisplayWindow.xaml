<!-- Edited on Aug 17, 2026 @ 15:23:00 -> Significantly enlarged QR codes and typography on Connect Instructions screen -->
<Window x:Class="Lyracist.Trivia.Windows.TriviaDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:Lyracist.Trivia.ViewModels"
        Title="Lyracist Trivia Live Display"
        Height="1080" Width="1920"
        WindowStyle="None"
        WindowState="Normal"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Background="#080314"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid>
        <Grid.ContextMenu>
            <ContextMenu Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334155" BorderThickness="1">
                <MenuItem Header="✕ Close Projection (Esc)" Click="CloseMenu_Click" FontWeight="Bold" Foreground="#EF4444" />
                <MenuItem Header="🗖 Toggle Fullscreen (F11 / Double-Click)" Click="ToggleFullscreen_Click" Foreground="#FFFFFF" />
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Dynamic Gradient Glow Background -->
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#2A0845" Offset="0.0" />
                    <GradientStop Color="#140628" Offset="0.5" />
                    <GradientStop Color="#070210" Offset="1.0" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Top-Right Floating Close Button -->
        <Button Width="36" Height="36" Margin="0,14,16,0"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="#66000000" BorderBrush="#33FFFFFF" BorderThickness="1"
                Click="CloseButton_Click" ToolTip="Close Projection Screen (Escape)"
                Cursor="Hand" Panel.ZIndex="100">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                        <TextBlock Text="✕" FontSize="16" FontWeight="Bold" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#EF4444" />
                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="#F87171" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Main Content Area -->
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Scrolling Marquee Bar (Scores & Leader Ticker) -->
            <Border Grid.Row="0" Background="#26103A" CornerRadius="10" Padding="0,6" Margin="0,0,0,16" BorderBrush="#581C87" BorderThickness="1.5" ClipToBounds="True">
                <Canvas Height="24" ClipToBounds="True">
                    <TextBlock Text="{Binding MarqueeSummaryText}" FontSize="14" FontWeight="Bold" Foreground="#FBBF24" VerticalAlignment="Center">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(Canvas.Left)" From="1280" To="-3000" Duration="0:0:35" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </Canvas>
            </Border>

            <!-- Top Header & Timer Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Category & Venue Title -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="24" FontWeight="Black" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding CategoryTitle}" />
                                <Setter Property="Foreground" Value="#A78BFA" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnectInstructionsActive}" Value="True">
                                        <Setter Property="Text" Value="🎮 HOW TO JOIN LIVE TRIVIA" />
                                        <Setter Property="Foreground" Value="#FBBF24" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding VenueName}" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" />
                </StackPanel>

                <!-- Circular/Pill Countdown Timer -->
                <Border Grid.Column="1" CornerRadius="16" Padding="24,10" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#10B981" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWarningActive}" Value="True">
                                    <Setter Property="Background" Value="#EF4444" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsConnectInstructionsActive}" Value="True">
                                    <Setter Property="Background" Value="#6366F1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⏱ " FontSize="28" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <TextBlock FontSize="32" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding RemainingSeconds, StringFormat='{}{0}s'}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnectInstructionsActive}" Value="True">
                                            <Setter Property="Text" Value="{Binding PreGameCountdownText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Middle Screen State Switcher -->
            <Grid Grid.Row="2">
                <!-- 1. Connect Instructions Screen (Dual QR Codes: Wi-Fi & Trivia Login) -->
                <Grid Margin="0,0,0,16">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnectInstructionsActive}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Dual Cards (Left: Wi-Fi, Right: Trivia Join) -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Card: Wi-Fi Scan-to-Connect -->
                        <Border Grid.Column="0" Background="#1E1B4B" CornerRadius="24" Padding="28,20" BorderBrush="#818CF8" BorderThickness="3.5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <TextBlock Text="1. CONNECT TO WI-FI" FontSize="26" FontWeight="Black" Foreground="#FBBF24" TextAlignment="Center" />
                                    <TextBlock Text="Point phone camera at QR code to join venue Wi-Fi" FontSize="15" Foreground="#E2E8F0" TextAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- Enlarged QR Code Box -->
                                <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="20" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#818CF8" BorderThickness="3">
                                    <Image Source="{Binding WifiQrCodeImage}" Width="380" Height="380" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>

                                <!-- Network Credentials Info -->
                                <StackPanel Grid.Row="2" Margin="0,14,0,0" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                        <TextBlock Text="📶 Network: " FontWeight="Bold" FontSize="18" Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding WifiSsid}" FontWeight="Black" FontSize="20" Foreground="#38BDF8" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="🔑 Password: " FontWeight="Bold" FontSize="16" Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding WifiPasswordDisplay}" FontWeight="ExtraBold" FontSize="18" Foreground="#FBBF24" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Right Card: Trivia Join & Buzzer -->
                        <Border Grid.Column="2" Background="#0C2B3E" CornerRadius="24" Padding="28,20" BorderBrush="#38BDF8" BorderThickness="3.5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <TextBlock Text="2. JOIN TRIVIA GAME" FontSize="26" FontWeight="Black" Foreground="#38BDF8" TextAlignment="Center" />
                                    <TextBlock Text="Scan to open mobile buzzer on your smartphone or tablet" FontSize="15" Foreground="#E2E8F0" TextAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- Enlarged QR Code Box -->
                                <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="20" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#38BDF8" BorderThickness="3">
                                    <Image Source="{Binding QrCodeImage}" Width="380" Height="380" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>

                                <!-- Web Portal URL Info -->
                                <StackPanel Grid.Row="2" Margin="0,14,0,0" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                        <TextBlock Text="🌐 Browser Link: " FontWeight="Bold" FontSize="18" Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding ConnectUrl}" FontWeight="Black" FontSize="20" Foreground="#38BDF8" />
                                    </StackPanel>
                                    <TextBlock Text="Enter your Name or Team Name and buzz in!" FontWeight="Bold" FontSize="16" Foreground="#10B981" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Bottom Pre-Game Countdown & Instructions Banner -->
                    <Border Grid.Row="1" Background="#26103A" CornerRadius="16" Padding="28,16" BorderBrush="#F59E0B" BorderThickness="2.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="⏱ TRIVIA GAME STARTS IN" FontWeight="Black" FontSize="18" Foreground="#FBBF24" />
                                <TextBlock Text="Get your drinks and form your teams! The game will automatically begin when the countdown completes." FontSize="14" Foreground="#E2E8F0" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#451A03" CornerRadius="12" Padding="26,6" VerticalAlignment="Center" BorderBrush="#F59E0B" BorderThickness="1.5">
                                <TextBlock Text="{Binding PreGameCountdownText}" FontWeight="Black" FontSize="36" Foreground="#FBBF24" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 2. Question & Options View (Visible during active gameplay) -->
                <Grid Margin="0,0,0,16">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsConnectInstructionsActive}" Value="False" />
                                        <Condition Binding="{Binding IsGameComplete}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Question Prompt Card -->
                    <Border Grid.Row="0" Background="#E61A2234" CornerRadius="20" Padding="32,24" Margin="0,0,0,24" BorderBrush="#1FFFFFFF" BorderThickness="1.5">
                        <TextBlock Text="{Binding QuestionPrompt}" FontSize="28" FontWeight="Bold" LineHeight="38" TextWrapping="Wrap" Foreground="#FFFFFF" TextAlignment="Center" />
                    </Border>

                    <!-- 4 Answer Options (2x2 Grid) -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Option A -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#261A42" CornerRadius="16" Padding="20" Margin="8" BorderBrush="#8B5CF6" BorderThickness="3"
                                Opacity="{Binding OptionAOpacity}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#8B5CF6" CornerRadius="10" Width="44" Height="44" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="▲" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding OptionA}" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <!-- Option B -->
                        <Border Grid.Row="0" Grid.Column="1" Background="#13313F" CornerRadius="16" Padding="20" Margin="8" BorderBrush="#06B6D4" BorderThickness="3"
                                Opacity="{Binding OptionBOpacity}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#06B6D4" CornerRadius="10" Width="44" Height="44" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="◆" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding OptionB}" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <!-- Option C -->
                        <Border Grid.Row="1" Grid.Column="0" Background="#3D2912" CornerRadius="16" Padding="20" Margin="8" BorderBrush="#F59E0B" BorderThickness="3"
                                Opacity="{Binding OptionCOpacity}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#F59E0B" CornerRadius="10" Width="44" Height="44" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="●" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding OptionC}" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <!-- Option D -->
                        <Border Grid.Row="1" Grid.Column="1" Background="#3E1524" CornerRadius="16" Padding="20" Margin="8" BorderBrush="#F43F5E" BorderThickness="3"
                                Opacity="{Binding OptionDOpacity}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#F43F5E" CornerRadius="10" Width="44" Height="44" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="■" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding OptionD}" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 3. Game Complete & Winner Celebration View -->
                <Grid Margin="0,0,0,16">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsConnectInstructionsActive}" Value="False" />
                                        <Condition Binding="{Binding IsGameComplete}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Winner Highlight Card -->
                    <Border Grid.Row="0" Background="#261A42" CornerRadius="20" Padding="32,18" Margin="0,0,0,12" BorderBrush="#F59E0B" BorderThickness="2.5">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🏆 GAME COMPLETE - CONGRATULATIONS! 🏆" FontSize="22" FontWeight="Black" Foreground="#FBBF24" TextAlignment="Center" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding WinnerTitle}" FontSize="26" FontWeight="Black" Foreground="#FFFFFF" TextAlignment="Center" Margin="0,0,0,4" />
                            
                            <!-- Winning Score -->
                            <TextBlock Text="{Binding WinningScore, StringFormat='Final Score: {0:N0} Points'}" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" TextAlignment="Center" Margin="0,0,0,4" />

                            <!-- Winning Team Members Roster (If team winner) -->
                            <Border Background="#1AFFFFFF" CornerRadius="10" Padding="14,6" Margin="0,4,0,0" HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasTeamWinner}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="👥 Team Players: " FontWeight="Bold" FontSize="13" Foreground="#FBBF24" />
                                    <TextBlock Text="{Binding WinningTeamMembersRoster}" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Intermission Next Game Countdown Banner -->
                    <Border Background="#1E1B4B" CornerRadius="12" Padding="20,10" Margin="0,0,0,12" BorderBrush="#6366F1" BorderThickness="2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsIntermissionActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🎮 NEXT TRIVIA ROUND STARTS IN" FontWeight="Black" FontSize="14" Foreground="#A5B4FC" />
                                <TextBlock Text="Keep your buzzers ready! A new randomized round will auto-start." FontSize="11" Foreground="#CBD5E1" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#312E81" CornerRadius="10" Padding="16,6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding IntermissionCountdownText}" FontWeight="ExtraBold" FontSize="24" Foreground="#FFFFFF" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Final Leaderboard Table -->
                    <Border Grid.Row="1" Background="#E61A2234" CornerRadius="16" Padding="20,12" BorderBrush="#14FFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="FINAL LEADERBOARD &amp; SCORES" FontSize="15" FontWeight="Black" Foreground="#94A3B8" Margin="0,0,0,8" HorizontalAlignment="Center" />
                            
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding TopPlayers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#14FFFFFF" CornerRadius="8" Padding="14,6" Margin="0,0,0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding TotalScore, StringFormat='{}{0:N0} pts'}" FontSize="15" FontWeight="ExtraBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Bottom Connection Bar -->
            <Border Grid.Row="3" Background="#D90F172A" CornerRadius="14" Padding="20,12" BorderBrush="#14FFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📱 PLAY ON YOUR PHONE:" FontWeight="ExtraBold" FontSize="14" Foreground="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConnectUrl}" FontWeight="ExtraBold" FontSize="16" Foreground="#38BDF8" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="Powered by Lyracist" FontSize="12" Foreground="#475569" VerticalAlignment="Center" FontWeight="Bold" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
