<!-- Edited on Aug 18, 2026 @ 18:05:00 -> Constrain numeric input boxes to concise compact widths -->
<Window x:Class="Lyracist.Trivia.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:Lyracist.Trivia.ViewModels"
        Title="Lyracist Trivia Pro - Game Master Console"
        Height="936" Width="1200"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Closing="Window_Closing">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="12" Padding="16,12" Margin="0,0,0,14" BorderBrush="#14FFFFFF" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎯" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock Text="LYRACIST TRIVIA PRO" FontSize="18" FontWeight="ExtraBold" Foreground="#A78BFA" FontFamily="Segoe UI" />
                        <TextBlock Text="{Binding VenueName, StringFormat='Venue: {0}'}" FontSize="12" Foreground="#94A3B8" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <!-- Connected Players Count Badge -->
                    <Border Background="#334155" CornerRadius="8" Padding="10,6" Margin="0,0,12,0">
                        <TextBlock Text="{Binding ConnectedPlayerCount, StringFormat='👥 {0} Players Connected'}" FontWeight="Bold" Foreground="#38BDF8" />
                    </Border>

                    <!-- Target Monitor Selection Dropdown -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="🖥️" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding AvailableMonitors}"
                                  SelectedItem="{Binding SelectedMonitor}"
                                  Width="180" Height="36"
                                  Background="#334155" Foreground="#FFFFFF"
                                  Padding="8,4" VerticalContentAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Index, StringFormat='{}Monitor {0}: '}" FontWeight="Bold" Foreground="#38BDF8" />
                                        <TextBlock Text="{Binding Width, StringFormat='{}{0}x'}" Foreground="#CBD5E1" />
                                        <TextBlock Text="{Binding Height}" Foreground="#CBD5E1" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Open/Activate TV Projection Button -->
                    <Button Content="📺 Open TV Projection" Background="#8B5CF6" Foreground="#FFFFFF" Click="OpenProjectionWindow_Click" FontWeight="Bold" Height="36" Padding="14,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="#94A3B8" />
                    <Setter Property="Padding" Value="18,10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" Background="#1E293B" CornerRadius="8,8,0,0" Margin="0,0,6,0" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#3B82F6" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: Live Game Master -->
            <TabItem Header="🎯 Live Game Master">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <!-- Column 1: Game Pack & Control Panel -->
                    <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Padding="14" Margin="0,0,10,0" BorderBrush="#14FFFFFF" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="GAME MASTER CONTROLS" FontWeight="Bold" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,8" />

                                <!-- Pack Selector -->
                                <TextBlock Text="Select Question Pack:" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailablePacks}" SelectedItem="{Binding SelectedPack}" DisplayMemberPath="Title" Margin="0,0,0,10" Background="#0F172A" Foreground="#FFFFFF" Padding="8,6" />

                                <!-- Number of Questions per Game -->
                                <TextBlock Text="Questions Per Game:" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding QuestionsPerGamePresets}" SelectedItem="{Binding QuestionsPerGame}" IsEditable="True" Margin="0,0,0,10" Background="#0F172A" Foreground="#FFFFFF" Padding="8,6" />

                                <!-- Auto-Run Gameplay Switch -->
                                <Border Background="#243347" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="⚡ Auto-Run Game" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" />
                                            <TextBlock Text="15s answer • 5s fade • 5s reveal" FontSize="10" Foreground="#94A3B8" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding AutoAdvanceQuestions}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Button Content="🚀 Start New Game" Command="{Binding StartGameWithSelectedPackCommand}" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" Height="40" Margin="0,0,0,14" />

                                <!-- Pre-Game Countdown & Connect Instructions Screen Controller -->
                                <Border Background="#1E1B4B" CornerRadius="10" Padding="12,10" Margin="0,0,0,12" BorderBrush="#818CF8" BorderThickness="1.5">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="📺 CONNECT INSTRUCTIONS" FontWeight="Black" FontSize="11" Foreground="#FBBF24" />
                                                <TextBlock Text="Dual QR codes (Wi-Fi + Game)" FontSize="10" Foreground="#CBD5E1" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Toggle Screen" Command="{Binding ToggleConnectInstructionsScreenCommand}" Background="#6366F1" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Height="28" Padding="10,0" />
                                        </Grid>

                                        <!-- Countdown Timer Pill -->
                                        <Border Background="#312E81" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Game Starts In:" FontWeight="SemiBold" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding PreGameCountdownText}" FontWeight="Black" FontSize="18" Foreground="#FBBF24" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- Quick Timer Adjustment Buttons -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="+1m" Command="{Binding Add1MinuteCommand}" Background="#334155" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" Height="26" Margin="0,0,3,0" Padding="0" />
                                            <Button Grid.Column="1" Content="+5m" Command="{Binding Add5MinutesCommand}" Background="#334155" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" Height="26" Margin="2,0,2,0" Padding="0" />
                                            <Button Grid.Column="2" Content="Reset" Command="{Binding Reset5MinutesCommand}" Background="#334155" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" Height="26" Margin="2,0,2,0" Padding="0" />
                                            <Button Grid.Column="3" Content="⏸/▶" Command="{Binding TogglePreGameTimerCommand}" Background="#334155" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" Height="26" Margin="3,0,0,0" Padding="0" />
                                        </Grid>

                                        <CheckBox Content="Auto-start when timer reaches 00:00" IsChecked="{Binding AutoStartAfterCountdown}" FontSize="10" Foreground="#94A3B8" />
                                    </StackPanel>
                                </Border>

                                <!-- Round Flow Action Buttons -->
                                <TextBlock Text="LIVE QUESTION CONTROLS" FontWeight="Bold" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,8" />
                                <Button Content="▶ Start Question &amp; Timer" Command="{Binding StartQuestionCommand}" Background="#3B82F6" Foreground="#FFFFFF" FontWeight="Bold" Height="40" Margin="0,0,0,8" />
                                <Button Content="⏸ Pause / Resume Timer" Command="{Binding ToggleTimerCommand}" Background="#64748B" Foreground="#FFFFFF" FontWeight="Bold" Height="36" Margin="0,0,0,8" />
                                <Button Content="🔓 Lock &amp; Reveal Answer" Command="{Binding LockAndRevealCommand}" Background="#F59E0B" Foreground="#FFFFFF" FontWeight="Bold" Height="40" Margin="0,0,0,8" />
                                <Button Content="🏆 Show Round Leaderboard" Command="{Binding ShowLeaderboardCommand}" Background="#8B5CF6" Foreground="#FFFFFF" FontWeight="Bold" Height="36" Margin="0,0,0,8" />
                                <Button Content="⏭ Next Question" Command="{Binding NextQuestionCommand}" Background="#06B6D4" Foreground="#FFFFFF" FontWeight="Bold" Height="40" Margin="0,0,0,14" />

                                <Separator Background="#1AFFFFFF" Margin="0,0,0,14" />

                                <!-- Player Mobile Connection QR Code -->
                                <TextBlock Text="PLAYER CONNECT QR CODE" FontWeight="Bold" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,8" />
                                <Border Background="#FFFFFF" CornerRadius="8" Padding="10" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <Image Source="{Binding QrCodeImage}" Width="150" Height="150" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                                <TextBlock Text="{Binding ConnectUrl}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Column 2: Active Question & Live Visual Monitor Preview -->
                    <Border Grid.Column="1" Background="#1E293B" CornerRadius="12" Padding="18" Margin="0,0,10,0" BorderBrush="#14FFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Round Info & Timer Badge -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#334155" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding CurrentRoundTitle}" FontWeight="Bold" Foreground="#CBD5E1" FontSize="12" />
                                    </Border>
                                    <Border Background="#475569" CornerRadius="6" Padding="8,4">
                                        <TextBlock Text="{Binding CurrentQuestionNumber, StringFormat='Question #{0}'}" FontWeight="Bold" Foreground="#38BDF8" FontSize="12" />
                                    </Border>
                                </StackPanel>

                                <!-- Live Countdown Display -->
                                <Border Grid.Column="1" CornerRadius="10" Padding="16,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#10B981" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWarningActive}" Value="True">
                                                    <Setter Property="Background" Value="#EF4444" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⏱ " FontSize="16" />
                                        <TextBlock Text="{Binding RemainingSeconds, StringFormat='{}{0}s'}" FontWeight="ExtraBold" FontSize="18" Foreground="#FFFFFF" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Intermission Countdown Alert Banner -->
                            <Border Grid.Row="1" Background="#1E1B4B" CornerRadius="12" Padding="16,12" Margin="0,0,0,14" BorderBrush="#818CF8" BorderThickness="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsIntermissionActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🎮 NEXT GAME STARTS IN:" FontWeight="Black" FontSize="13" Foreground="#A5B4FC" />
                                        <TextBlock Text="{Binding IntermissionCountdownText}" FontSize="24" FontWeight="ExtraBold" Foreground="#FFFFFF" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="▶ Start Now" Command="{Binding SkipIntermissionAndStartNowCommand}" Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" Height="36" Padding="14,0" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Winner Announcement Banner (When Game Complete) -->
                            <Border Grid.Row="1" Background="#2E1C0C" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="#F59E0B" BorderThickness="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsGameComplete}" Value="True" />
                                                    <Condition Binding="{Binding IsIntermissionActive}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding WinnerAnnouncement}" FontSize="20" FontWeight="Black" Foreground="#FBBF24" TextAlignment="Center" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding WinningTeamRoster}" FontSize="13" Foreground="#E2E8F0" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Question Prompt Box -->
                            <Border Grid.Row="1" Background="#0F172A" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="#1AFFFFFF" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGameComplete}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ActiveQuestion.Prompt, FallbackValue='No question active. Select a pack and start game.'}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="26" Foreground="#FFFFFF" TextAlignment="Center" />
                            </Border>

                            <!-- Options 2x2 Grid Preview -->
                            <Grid Grid.Row="2" Margin="0,0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Option A -->
                                <Border Grid.Row="0" Grid.Column="0" Background="#261A42" CornerRadius="10" Padding="14" Margin="4" BorderBrush="#8B5CF6" BorderThickness="2">
                                    <StackPanel>
                                        <TextBlock Text="▲ Option A" FontWeight="Bold" Foreground="#A78BFA" FontSize="12" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding ActiveQuestion.Options[0], FallbackValue='Option A'}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Option B -->
                                <Border Grid.Row="0" Grid.Column="1" Background="#13313F" CornerRadius="10" Padding="14" Margin="4" BorderBrush="#06B6D4" BorderThickness="2">
                                    <StackPanel>
                                        <TextBlock Text="◆ Option B" FontWeight="Bold" Foreground="#38BDF8" FontSize="12" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding ActiveQuestion.Options[1], FallbackValue='Option B'}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Option C -->
                                <Border Grid.Row="1" Grid.Column="0" Background="#3D2912" CornerRadius="10" Padding="14" Margin="4" BorderBrush="#F59E0B" BorderThickness="2">
                                    <StackPanel>
                                        <TextBlock Text="● Option C" FontWeight="Bold" Foreground="#FBBF24" FontSize="12" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding ActiveQuestion.Options[2], FallbackValue='Option C'}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Option D -->
                                <Border Grid.Row="1" Grid.Column="1" Background="#3E1524" CornerRadius="10" Padding="14" Margin="4" BorderBrush="#F43F5E" BorderThickness="2">
                                    <StackPanel>
                                        <TextBlock Text="■ Option D" FontWeight="Bold" Foreground="#FB7185" FontSize="12" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding ActiveQuestion.Options[3], FallbackValue='Option D'}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Explanation & Correct Answer Footer -->
                            <Border Grid.Row="3" Background="#0F172A" CornerRadius="10" Padding="14" BorderBrush="#0FFFFFFF" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding ActiveQuestion.CorrectAnswerText, StringFormat='⭐ Correct Answer: {0}'}" FontWeight="Bold" Foreground="#10B981" FontSize="14" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding ActiveQuestion.Explanation}" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Column 3: Live Player Leaderboard & Score Adjustments -->
                    <Border Grid.Column="2" Background="#1E293B" CornerRadius="12" Padding="14" BorderBrush="#14FFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="LIVE SCOREBOARD" FontWeight="Bold" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,10" />

                            <ListBox Grid.Row="1" ItemsSource="{Binding Players}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0F172A" CornerRadius="8" Padding="10,8" Margin="0,0,0,6" BorderBrush="#0DFFFFFF" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13" />
                                                    <TextBlock Text="{Binding CurrentStreak, StringFormat='🔥 Streak: {0}'}" FontSize="11" Foreground="#F59E0B" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{Binding TotalScore, StringFormat='{}{0} pts'}" FontWeight="ExtraBold" Foreground="#10B981" FontSize="14" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: Settings & Display -->
            <TabItem Header="⚙️ Settings &amp; Display">
                <Border Background="#1E293B" CornerRadius="12" Padding="24" Margin="0,12,0,0" BorderBrush="#14FFFFFF" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                            <TextBlock Text="VENUE &amp; GAMEPLAY CONFIGURATION" FontWeight="Black" FontSize="16" Foreground="#38BDF8" Margin="0,0,0,16" />

                            <!-- Venue & Game Master Branding -->
                            <Border Background="#0F172A" CornerRadius="10" Padding="16" Margin="0,0,0,14" BorderBrush="#38BDF8" BorderThickness="1.5">
                                <StackPanel>
                                    <TextBlock Text="🏢 Venue &amp; Game Master Branding" FontWeight="Bold" FontSize="14" Foreground="#38BDF8" Margin="0,0,0,12" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="300" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Venue Name:" FontSize="13" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding VenueName, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" Foreground="#FFFFFF" Padding="8,4" />
                                        <TextBlock Grid.Column="2" Text="(Displayed on projection &amp; mobile buzzer)" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </Grid>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="300" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Game Master / Host Name:" FontSize="13" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding HostName, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" Foreground="#FFFFFF" Padding="8,4" />
                                        <TextBlock Grid.Column="2" Text="(Host identity on scoreboard &amp; intro screens)" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Intermission Auto-Start Countdown -->
                            <Border Background="#0F172A" CornerRadius="10" Padding="16" Margin="0,0,0,14" BorderBrush="#14FFFFFF" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Auto-Start Next Game After Intermission" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                                            <TextBlock Text="When game completes, starts a countdown and automatically launches the next pack" FontSize="12" Foreground="#94A3B8" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding AutoStartNextGameEnabled}" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Intermission Delay (Minutes):" FontSize="13" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding NextGameDelayMinutes, UpdateSourceTrigger=PropertyChanged}" Width="65" TextAlignment="Center" Background="#1E293B" Foreground="#FFFFFF" Padding="8,4" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="(1 to 30 minutes)" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Question Timers -->
                            <Border Background="#0F172A" CornerRadius="10" Padding="16" Margin="0,0,0,14" BorderBrush="#14FFFFFF" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Timer &amp; Elimination Speeds" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Default Question Time (Seconds):" FontSize="13" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding DefaultQuestionSeconds, UpdateSourceTrigger=PropertyChanged}" Width="65" TextAlignment="Center" Background="#1E293B" Foreground="#FFFFFF" Padding="8,4" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Wrong Answer Fade Speed (Seconds):" FontSize="13" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding AnswerEliminationIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Width="65" TextAlignment="Center" Background="#1E293B" Foreground="#FFFFFF" Padding="8,4" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Post-Reveal Pause Delay (Seconds):" FontSize="13" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding PostRevealDelaySeconds, UpdateSourceTrigger=PropertyChanged}" Width="65" TextAlignment="Center" Background="#1E293B" Foreground="#FFFFFF" Padding="8,4" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Scoring Rules -->
                            <Border Background="#0F172A" CornerRadius="10" Padding="16" Margin="0,0,0,14" BorderBrush="#14FFFFFF" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Scoring &amp; Multipliers" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Base Points per Question:" FontSize="13" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding BasePointsPerQuestion, UpdateSourceTrigger=PropertyChanged}" Width="75" TextAlignment="Center" Background="#1E293B" Foreground="#FFFFFF" Padding="8,4" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Points to Deduct for Wrong Answer:" FontSize="13" Foreground="#CBD5E1" VerticalAlignment="Center" ToolTip="Points deducted for an incorrect answer (Default: 0)" />
                                        <TextBox Grid.Column="1" Text="{Binding WrongAnswerDeductionPoints, UpdateSourceTrigger=PropertyChanged}" Width="75" TextAlignment="Center" Background="#1E293B" Foreground="#FFFFFF" Padding="8,4" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Enable Fast Buzzer Speed Bonus" FontSize="13" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding SpeedBonusEnabled}" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Wi-Fi & Connect Instructions Configuration -->
                            <Border Background="#0F172A" CornerRadius="10" Padding="16" Margin="0,0,0,16" BorderBrush="#818CF8" BorderThickness="1.5">
                                <StackPanel>
                                    <TextBlock Text="Wi-Fi Credentials &amp; Connect Instructions Screen" FontWeight="Bold" FontSize="14" Foreground="#FBBF24" Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="250" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Wi-Fi SSID / Network Name:" FontSize="13" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding WifiSsid, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" Foreground="#FFFFFF" Padding="8,4" />
                                        <Button Grid.Column="2" Content="🔍 Auto-Detect Active Wi-Fi" Command="{Binding AutoDetectWifiSsidCommand}" Background="#334155" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" Height="28" Padding="10,0" Margin="10,0,0,0" HorizontalAlignment="Left" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="250" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Wi-Fi Password:" FontSize="13" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding WifiPassword, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" Foreground="#FFFFFF" Padding="8,4" />
                                        <TextBlock Grid.Column="2" Text="(Leave blank if open Wi-Fi)" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Pre-Game Countdown (Minutes):" FontSize="13" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding PreGameCountdownMinutes, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" Foreground="#FFFFFF" Padding="8,4" />
                                        <TextBlock Grid.Column="2" Text="(e.g., 5 min before game time)" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Auto-Start Game When Countdown Reaches 00:00" FontSize="13" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding AutoStartAfterCountdown}" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button Content="💾 Save All Settings" Command="{Binding SaveAllSettingsCommand}" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" Height="44" Width="200" HorizontalAlignment="Left" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- TAB 3: Players & Teams -->
            <TabItem Header="👥 Players &amp; Teams">
                <Border Background="#1E293B" CornerRadius="12" Padding="20" Margin="0,12,0,0" BorderBrush="#14FFFFFF" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="CONNECTED PLAYERS &amp; TEAMS ROSTER" FontWeight="Black" FontSize="16" Foreground="#38BDF8" Margin="0,0,0,16" />

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Players}" AutoGenerateColumns="False" CanUserAddRows="False" Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#14FFFFFF" RowBackground="#0F172A" AlternatingRowBackground="#162032" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1AFFFFFF">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Player Name" Binding="{Binding Name}" FontWeight="Bold" Width="200" />
                                <DataGridTextColumn Header="Team Name" Binding="{Binding TeamName}" Width="180" />
                                <DataGridTextColumn Header="Total Score" Binding="{Binding TotalScore, StringFormat='{}{0:N0}'}" FontWeight="ExtraBold" Width="120" />
                                <DataGridTextColumn Header="Streak" Binding="{Binding CurrentStreak, StringFormat='🔥 {0}'}" Width="100" />
                                <DataGridTextColumn Header="Correct" Binding="{Binding TotalCorrect}" Width="90" />
                                <DataGridTextColumn Header="Answered" Binding="{Binding TotalAnswered}" Width="90" />
                                <DataGridTemplateColumn Header="Actions" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Kick" Command="{Binding DataContext.RemovePlayerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#EF4444" Foreground="#FFFFFF" FontWeight="Bold" Height="28" Padding="10,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>