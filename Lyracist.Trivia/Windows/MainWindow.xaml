<!-- Edited on Aug 20, 2026 @ 12:17:00 -> Added Exit button to header bar in Lyracist.Trivia MainWindow.xaml -->
<Window x:Class="Lyracist.Trivia.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:Lyracist.Trivia.ViewModels"
        Title="Lyracist Trivia Pro - Game Master Console"
        Icon="/LyracistTrivia.ico"
        Height="835" Width="1398"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Closing="Window_Closing">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="12" Padding="16,12" Margin="0,0,0,14" BorderBrush="#14FFFFFF" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎯" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock Text="LYRACIST TRIVIA PRO" FontSize="18" FontWeight="ExtraBold" Foreground="#A78BFA" FontFamily="Segoe UI" />
                        <TextBlock Text="{Binding VenueName, StringFormat='Venue: {0}'}" FontSize="12" Foreground="#94A3B8" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <!-- Connected Players Count Badge -->
                    <Border Background="#334155" CornerRadius="8" Padding="10,6" Margin="0,0,12,0">
                        <TextBlock Text="{Binding ConnectedPlayerCount, StringFormat='👥 {0} Players Connected'}" FontWeight="Bold" Foreground="#38BDF8" />
                    </Border>

                    <!-- Target Monitor Selection Dropdown -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="🖥️" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding AvailableMonitors}"
                                  SelectedItem="{Binding SelectedMonitor}"
                                  Width="180" Height="36"
                                  Background="#334155" Foreground="#FFFFFF"
                                  Padding="8,4" VerticalContentAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Index, StringFormat='{}Monitor {0}: '}" FontWeight="Bold" Foreground="#38BDF8" />
                                        <TextBlock Text="{Binding Width, StringFormat='{}{0}x'}" Foreground="#CBD5E1" />
                                        <TextBlock Text="{Binding Height}" Foreground="#CBD5E1" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Open/Activate TV Projection Button -->
                    <Button Content="📺 Open TV Projection" Background="#8B5CF6" Foreground="#FFFFFF" Click="OpenProjectionWindow_Click" FontWeight="Bold" Height="36" Padding="14,0" />

                    <!-- Exit Application Button -->
                    <Button Content="✕ Exit" Background="#EF4444" Foreground="#FFFFFF" Click="ExitButton_Click" FontWeight="Bold" Height="36" Padding="14,0" Margin="10,0,0,0" ToolTip="Exit Lyracist Trivia" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="#94A3B8" />
                    <Setter Property="Padding" Value="18,10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" Background="#1E293B" CornerRadius="8,8,0,0" Margin="0,0,6,0" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#3B82F6" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: Live Game Host & Projection Deck -->
            <TabItem Header="🎯 Trivia Game Control" FontWeight="Bold" FontSize="14">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <!-- Column 1: Game Pack & Control Panel -->
                    <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Padding="14" Margin="0,0,10,0" BorderBrush="#14FFFFFF" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="GAME MASTER CONTROLS" FontWeight="Bold" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,8" />

                                <!-- Pack Selector: check 2+ packs to shuffle them together into one mixed game -->
                                <TextBlock Text="Select Question Pack(s) — check 2+ to mix categories:" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4" TextWrapping="Wrap" />
                                <Border Background="#0F172A" CornerRadius="6" Margin="0,0,0,10" BorderBrush="#1AFFFFFF" BorderThickness="1">
                                    <Grid>
                                        <ListBox x:Name="LbxSelectPack" ItemsSource="{Binding SelectablePacks}" Background="Transparent" BorderThickness="0" MinHeight="120" MaxHeight="280" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Focusable" Value="False" />
                                                    <Setter Property="Padding" Value="6,3" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Foreground="#FFFFFF">
                                                        <TextBlock Text="{Binding Title}" FontSize="12" />
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- Shown instead of a silently-empty box when no packs were found -->
                                        <TextBlock Text="⚠ No question packs found.&#10;Check that the TriviaData\packs folder (with .json pack files) exists next to the app, or see the Logs folder for details." FontSize="11" Foreground="#F87171" TextWrapping="Wrap" TextAlignment="Center" Margin="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectablePacks.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Number of Questions per Game -->
                                <TextBlock Text="Questions Per Game:" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding QuestionsPerGamePresets}" SelectedItem="{Binding QuestionsPerGame}" IsEditable="True" Margin="0,0,0,10" Background="#0F172A" Foreground="#FFFFFF" Padding="8,6" />

                                <!-- Auto-Run Gameplay Switch -->
                                <Border Background="#243347" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="⚡ Auto-Run Game" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" />
                                            <TextBlock Text="{Binding AutoRunTimingSummary}" FontSize="10" Foreground="#94A3B8" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding AutoAdvanceQuestions}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Primary Unified 1-Click Launch Action -->
                                <Button Content="🎯 Launch Pre-Game Countdown" Command="{Binding LaunchPreGameLobbyCommand}" Style="{StaticResource StandardGameButton}" Background="#6366F1" Foreground="#FFFFFF"  Margin="0,0,0,8" ToolTip="Opens big screen with category banner, countdown timer, and scan-to-join instructions." />
                                <Button Content="▶ Start Game Now (Skip Countdown)" Command="{Binding StartGameWithSelectedPackCommand}"  Style="{StaticResource StandardGameButton}"  Background="#10B981" Foreground="#FFFFFF"   Margin="0,0,0,14" />

                                <!-- Live countdown/connect-screen controls moved to the Settings &amp; Display
                                     tab ("Wi-Fi & Connect Instructions" card) to free up room here for the
                                     pack selection list on smaller, non-4K laptop screens. -->

                                <!-- Round Flow Action Buttons -->
                                <TextBlock Text="LIVE QUESTION CONTROLS" FontWeight="Bold" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,8" />
                                <Button Content="▶ Start Question &amp; Timer" Command="{Binding StartQuestionCommand}"  Style="{StaticResource StandardGameButton}"  Background="#3B82F6" Foreground="#FFFFFF"   Margin="0,0,0,8" />
                                <Button Content="⏸ Pause / Resume Timer" Command="{Binding ToggleTimerCommand}"  Style="{StaticResource StandardGameButton}"  Background="#64748B" Foreground="#FFFFFF"   Margin="0,0,0,8" />
                                <Button Content="🔓 Lock &amp; Reveal Answer" Command="{Binding LockAndRevealCommand}"  Style="{StaticResource StandardGameButton}" Background="#F59E0B" Foreground="#FFFFFF"   Margin="0,0,0,8" />
                                <Button Content="🏆 Show Round Leaderboard" Command="{Binding ShowLeaderboardCommand}" Style="{StaticResource StandardGameButton}"  Background="#8B5CF6" Foreground="#FFFFFF"   Margin="0,0,0,8" />
                                <Button Content="⏭ Next Question" Command="{Binding NextQuestionCommand}" Style="{StaticResource StandardGameButton}"  Background="#06B6D4" Foreground="#FFFFFF"  Margin="0,0,0,14" />

                                <Separator Background="#1AFFFFFF" Margin="0,0,0,14" />

                                <!-- Player Mobile Connection QR Code -->
                                <TextBlock Text="PLAYER CONNECT QR CODE" FontWeight="Bold" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,8" />
                                <Border Background="#FFFFFF" CornerRadius="8" Padding="10" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <Image Source="{Binding QrCodeImage}" Width="150" Height="150" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                                <TextBlock Text="{Binding ConnectUrl}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Column 2: Active Question & Live Visual Monitor Preview -->
                    <Border Grid.Column="1" Background="#1E293B" CornerRadius="12" Padding="18" Margin="0,0,10,0" BorderBrush="#14FFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Round Info & Timer Badge -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#334155" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding CurrentRoundTitle}" FontWeight="Bold" Foreground="#CBD5E1" FontSize="12" />
                                    </Border>
                                    <Border Background="#475569" CornerRadius="6" Padding="8,4">
                                        <TextBlock Text="{Binding CurrentQuestionNumber, StringFormat='Question #{0}'}" FontWeight="Bold" Foreground="#38BDF8" FontSize="12" />
                                    </Border>
                                    <Border Background="#312E81" CornerRadius="6" Padding="8,4" Margin="8,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TotalGamesToPlay}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding GameProgressText}" FontWeight="Bold" Foreground="#A5B4FC" FontSize="12" />
                                    </Border>
                                </StackPanel>

                                <!-- Live Countdown Display -->
                                <Border Grid.Column="1" CornerRadius="10" Padding="16,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#10B981" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWarningActive}" Value="True">
                                                    <Setter Property="Background" Value="#EF4444" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⏱ " FontSize="16" />
                                        <TextBlock Text="{Binding RemainingSeconds, StringFormat='{}{0}s'}" FontWeight="ExtraBold" FontSize="18" Foreground="#FFFFFF" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Intermission Countdown Alert Banner -->
                            <Border Grid.Row="1" Background="#1E1B4B" CornerRadius="12" Padding="16,12" Margin="0,0,0,14" BorderBrush="#818CF8" BorderThickness="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsIntermissionActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🎮 NEXT GAME STARTS IN:" FontWeight="Black" FontSize="13" Foreground="#A5B4FC" />
                                        <TextBlock Text="{Binding IntermissionCountdownText}" FontSize="24" FontWeight="ExtraBold" Foreground="#FFFFFF" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="▶ Start Now" Command="{Binding SkipIntermissionAndStartNowCommand}" Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" Height="36" Padding="14,0" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Winner Announcement Banner (When Game Complete) -->
                            <Border Grid.Row="1" Background="#2E1C0C" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="#F59E0B" BorderThickness="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsGameComplete}" Value="True" />
                                                    <Condition Binding="{Binding IsIntermissionActive}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding WinnerAnnouncement}" FontSize="20" FontWeight="Black" Foreground="#FBBF24" TextAlignment="Center" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding WinningTeamRoster}" FontSize="13" Foreground="#E2E8F0" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Question Prompt Box -->
                            <Border Grid.Row="1" Background="#0F172A" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="#1AFFFFFF" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGameComplete}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ActiveQuestion.Prompt, FallbackValue='No question active. Select a pack and start game.'}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="26" Foreground="#FFFFFF" TextAlignment="Center" />
                            </Border>

                            <!-- Options 2x2 Grid Preview -->
                            <Grid Grid.Row="2" Margin="0,0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Option A -->
                                <Border Grid.Row="0" Grid.Column="0" Background="#261A42" CornerRadius="10" Padding="14" Margin="4" BorderBrush="#8B5CF6" BorderThickness="2">
                                    <StackPanel>
                                        <TextBlock Text="▲ Option A" FontWeight="Bold" Foreground="#A78BFA" FontSize="12" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding ActiveQuestion.Options[0], FallbackValue='Option A'}" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Option B -->
                                <Border Grid.Row="0" Grid.Column="1" Background="#13313F" CornerRadius="10" Padding="14" Margin="4" BorderBrush="#06B6D4" BorderThickness="2">
                                    <StackPanel>
                                        <TextBlock Text="◆ Option B" FontWeight="Bold" Foreground="#38BDF8" FontSize="12" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding ActiveQuestion.Options[1], FallbackValue='Option B'}" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Option C -->
                                <Border Grid.Row="1" Grid.Column="0" Background="#3D2912" CornerRadius="10" Padding="14" Margin="4" BorderBrush="#F59E0B" BorderThickness="2">
                                    <StackPanel>
                                        <TextBlock Text="● Option C" FontWeight="Bold" Foreground="#FBBF24" FontSize="12" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding ActiveQuestion.Options[2], FallbackValue='Option C'}" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Option D -->
                                <Border Grid.Row="1" Grid.Column="1" Background="#3E1524" CornerRadius="10" Padding="14" Margin="4" BorderBrush="#F43F5E" BorderThickness="2">
                                    <StackPanel>
                                        <TextBlock Text="■ Option D" FontWeight="Bold" Foreground="#FB7185" FontSize="12" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding ActiveQuestion.Options[3], FallbackValue='Option D'}" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Explanation & Correct Answer Footer -->
                            <Border Grid.Row="3" Background="#0F172A" CornerRadius="10" Padding="14" BorderBrush="#0FFFFFFF" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding ActiveQuestion.CorrectAnswerText, StringFormat='⭐ Correct Answer: {0}'}" FontWeight="Bold" Foreground="#10B981" FontSize="14" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding ActiveQuestion.Explanation}" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Column 3: Live Player Leaderboard & Score Adjustments -->
                    <Border Grid.Column="2" Background="#1E293B" CornerRadius="12" Padding="14" BorderBrush="#14FFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="LIVE SCOREBOARD" FontWeight="Bold" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,10" />

                            <ListBox Grid.Row="1" ItemsSource="{Binding Players}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0F172A" CornerRadius="8" Padding="10,8" Margin="0,0,0,6" BorderBrush="#0DFFFFFF" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13" />
                                                    <TextBlock Text="{Binding CurrentStreak, StringFormat='🔥 Streak: {0}'}" FontSize="11" Foreground="#F59E0B" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{Binding TotalScore, StringFormat='{}{0} pts'}" FontWeight="ExtraBold" Foreground="#10B981" FontSize="14" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: Settings & Display -->
            <TabItem Header="⚙️ Settings &amp; Display">
                <Border Background="#1E293B" CornerRadius="12" Padding="20,16" Margin="0,12,0,0" BorderBrush="#14FFFFFF" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Top Header & Save Button Bar -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="VENUE &amp; GAMEPLAY CONFIGURATION" FontWeight="Black" FontSize="16" Foreground="#38BDF8" />
                                    <TextBlock Text="Configure venue branding, game flow, question timers, scoring rules, and player Wi-Fi credentials." FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
                                </StackPanel>

                                <Button Grid.Column="1" Content="💾 Save All Settings" Command="{Binding SaveAllSettingsCommand}" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" Height="36" Padding="20,0" VerticalAlignment="Center" />
                            </Grid>

                            <!-- 3-Column Equal Grid -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- COLUMN 1: Venue & Host Branding, Intermission Flow -->
                                <StackPanel Grid.Column="0">
                                    <!-- Venue & Game Master Branding -->
                                    <Border Background="#0F172A" CornerRadius="10" Padding="14" Margin="0,0,0,14" BorderBrush="#38BDF8" BorderThickness="1.5">
                                        <StackPanel>
                                            <TextBlock Text="🏢 Venue &amp; Host Branding" FontWeight="Bold" FontSize="13" Foreground="#38BDF8" Margin="0,0,0,10" />

                                            <TextBlock Text="Venue Name:" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding VenueName, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" Foreground="#FFFFFF" Padding="8,5" Margin="0,0,0,4" />
                                            <TextBlock Text="Displayed on TV projection &amp; mobile buzzer" FontSize="11" Foreground="#64748B" Margin="0,0,0,10" />

                                            <TextBlock Text="Game Master / Host Name:" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding HostName, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" Foreground="#FFFFFF" Padding="8,5" Margin="0,0,0,4" />
                                            <TextBlock Text="Host identity on scoreboard &amp; intro screens" FontSize="11" Foreground="#64748B" Margin="0,0,0,10" />

                                            <TextBlock Text="Pre-Game Welcome Banner:" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding InstructionBannerText, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" Foreground="#FFFFFF" Padding="8,5" Margin="0,0,0,4" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" />
                                            <TextBlock Text="Shown on the lobby screen before the game starts. Use {venue} and {dj} to insert the venue/host name." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Pre-Game Announcement Screen -->
                                    <Border Background="#0F172A" CornerRadius="10" Padding="14" Margin="0,0,0,14" BorderBrush="#F59E0B" BorderThickness="1.5">
                                        <StackPanel>
                                            <TextBlock Text="📢 Pre-Game Announcement Screen" FontWeight="Bold" FontSize="13" Foreground="#F59E0B" Margin="0,0,0,10" />
                                            <TextBlock Text="Optional advertisement banner shown on the TV before the connect/lobby screen. Pick one, then Show/Hide it on demand." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,10" />

                                            <TextBlock Text="Banner:" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding AvailableAnnouncements}" SelectedItem="{Binding SelectedAnnouncement}" DisplayMemberPath="DisplayName" Background="#1E293B" Foreground="#FFFFFF" Padding="8,5" Margin="0,0,0,8" />

                                            <!-- Preview thumbnail -->
                                            <Border Background="#000000" CornerRadius="6" Height="90" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
                                                <Image Source="{Binding SelectedAnnouncement.FullPath}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="📺 Show Now" Command="{Binding ShowAnnouncementCommand}" Background="#F59E0B" Foreground="#FFFFFF" FontWeight="Bold" Height="34" />
                                                <Button Grid.Column="2" Content="✕ Hide" Command="{Binding HideAnnouncementCommand}" Background="#334155" Foreground="#FFFFFF" FontWeight="Bold" Height="34" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Intermission & Game Flow -->
                                    <Border Background="#0F172A" CornerRadius="10" Padding="14" BorderBrush="#14FFFFFF" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="🔄 Intermission &amp; Auto-Flow" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,10" />

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Auto-Start Next Game" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" />
                                                    <TextBlock Text="Launches countdown upon game completion" FontSize="11" Foreground="#94A3B8" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding AutoStartNextGameEnabled}" VerticalAlignment="Center" />
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Intermission Delay (Minutes):" FontSize="12" Foreground="#CBD5E1" />
                                                    <TextBlock Text="1 to 30 minutes duration" FontSize="11" Foreground="#64748B" />
                                                </StackPanel>
                                                <TextBox Grid.Column="1" Text="{Binding NextGameDelayMinutes, UpdateSourceTrigger=PropertyChanged}" Width="65" TextAlignment="Center" Background="#1E293B" Foreground="#FFFFFF" Padding="6,4" VerticalAlignment="Center" />
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Number of Games to Play:" FontSize="12" Foreground="#CBD5E1" />
                                                    <TextBlock Text="0 = unlimited. Preloads all games' questions up front so nothing repeats." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBox Grid.Column="1" Text="{Binding TotalGamesToPlay, UpdateSourceTrigger=PropertyChanged}" Width="65" TextAlignment="Center" Background="#1E293B" Foreground="#FFFFFF" Padding="6,4" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- COLUMN 2: Timers & Elimination, Scoring & Multipliers -->
                                <StackPanel Grid.Column="2">
                                    <!-- Question Timers -->
                                    <Border Background="#0F172A" CornerRadius="10" Padding="14" Margin="0,0,0,14" BorderBrush="#14FFFFFF" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="⏱️ Timer &amp; Elimination Speeds" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,10" />

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Default Question Time (Sec):" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Text="{Binding DefaultQuestionSeconds, UpdateSourceTrigger=PropertyChanged}" Width="65" TextAlignment="Center" Background="#1E293B" Foreground="#FFFFFF" Padding="6,4" />
                                            </Grid>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Wrong Answer Fade Speed (Sec):" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Text="{Binding AnswerEliminationIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Width="65" TextAlignment="Center" Background="#1E293B" Foreground="#FFFFFF" Padding="6,4" />
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Post-Reveal Pause Delay (Sec):" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Text="{Binding PostRevealDelaySeconds, UpdateSourceTrigger=PropertyChanged}" Width="65" TextAlignment="Center" Background="#1E293B" Foreground="#FFFFFF" Padding="6,4" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Scoring Rules -->
                                    <Border Background="#0F172A" CornerRadius="10" Padding="14" BorderBrush="#14FFFFFF" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="🏆 Scoring &amp; Multipliers" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,10" />

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Base Points per Question:" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Text="{Binding BasePointsPerQuestion, UpdateSourceTrigger=PropertyChanged}" Width="75" TextAlignment="Center" Background="#1E293B" Foreground="#FFFFFF" Padding="6,4" />
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Wrong Answer Deduction Points:" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" ToolTip="Points deducted for an incorrect answer (Default: 0)" />
                                                <TextBox Grid.Column="1" Text="{Binding WrongAnswerDeductionPoints, UpdateSourceTrigger=PropertyChanged}" Width="75" TextAlignment="Center" Background="#1E293B" Foreground="#FFFFFF" Padding="6,4" />
                                            </Grid>

                                            <!-- Tiered Option Value Scoring (100% / 70% / 40%) -->
                                            <Border Background="#188B5CF6" BorderBrush="#338B5CF6" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="Tiered Option Value (4=100%, 3=70%, 2=40%)" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                                            <TextBlock Text="Reduces points awarded as wrong options fade out" FontSize="10" Foreground="#64748B" />
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding TieredScoringEnabled}" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <Grid IsEnabled="{Binding TieredScoringEnabled}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="4 Opt (%)" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2" />
                                                            <TextBox Text="{Binding Points4OptionsPercent, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Background="#1E293B" Foreground="#FFFFFF" Padding="4,2" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="3 Opt (%)" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2" />
                                                            <TextBox Text="{Binding Points3OptionsPercent, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Background="#1E293B" Foreground="#FFFFFF" Padding="4,2" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4">
                                                            <TextBlock Text="2 Opt (%)" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2" />
                                                            <TextBox Text="{Binding Points2OptionsPercent, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Background="#1E293B" Foreground="#FFFFFF" Padding="4,2" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Fast Buzzer Speed Bonus" FontSize="12" Foreground="#CBD5E1" />
                                                    <TextBlock Text="Awards extra points for faster response times" FontSize="11" Foreground="#64748B" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding SpeedBonusEnabled}" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- COLUMN 3: Wi-Fi Credentials & Pre-Game Countdown -->
                                <StackPanel Grid.Column="4">
                                    <!-- Wi-Fi & Connect Instructions Configuration -->
                                    <Border Background="#0F172A" CornerRadius="10" Padding="14" BorderBrush="#818CF8" BorderThickness="1.5">
                                        <StackPanel>
                                            <TextBlock Text="📶 Wi-Fi &amp; Connect Instructions" FontWeight="Bold" FontSize="13" Foreground="#FBBF24" Margin="0,0,0,10" />

                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Wi-Fi SSID / Network Name:" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="🔍 Auto-Detect" Command="{Binding AutoDetectWifiSsidCommand}" Background="#334155" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" Height="24" Padding="8,0" />
                                            </Grid>
                                            <TextBox Text="{Binding WifiSsid, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" Foreground="#FFFFFF" Padding="8,5" Margin="0,0,0,8" />

                                            <TextBlock Text="Wi-Fi Password:" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding WifiPassword, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" Foreground="#FFFFFF" Padding="8,5" Margin="0,0,0,4" />
                                            <TextBlock Text="Leave blank if open or passwordless Wi-Fi" FontSize="11" Foreground="#64748B" Margin="0,0,0,10" />

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Pre-Game Countdown (Min):" FontSize="12" Foreground="#CBD5E1" />
                                                    <TextBlock Text="Duration before first round begins" FontSize="11" Foreground="#64748B" />
                                                </StackPanel>
                                                <TextBox Grid.Column="1" Text="{Binding PreGameCountdownMinutes, UpdateSourceTrigger=PropertyChanged}" Width="65" TextAlignment="Center" Background="#1E293B" Foreground="#FFFFFF" Padding="6,4" VerticalAlignment="Center" />
                                            </Grid>

                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Auto-Start at 00:00" FontSize="12" Foreground="#CBD5E1" />
                                                    <TextBlock Text="Starts game when countdown reaches 00:00" FontSize="11" Foreground="#64748B" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding AutoStartAfterCountdown}" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Live Pre-Game Countdown Controls (moved here from the Trivia
                                                 Game Control tab to free up room there for the pack selection
                                                 list on smaller, non-4K laptop screens) -->
                                            <Separator Background="#1AFFFFFF" Margin="0,0,0,12" />
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="📺 LIVE CONNECT SCREEN" FontWeight="Black" FontSize="11" Foreground="#FBBF24" />
                                                    <TextBlock Text="Toggles the lobby QR/countdown screen" FontSize="10" Foreground="#CBD5E1" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Toggle Screen" Command="{Binding ToggleConnectInstructionsScreenCommand}" Background="#6366F1" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Height="28" Padding="10,0" />
                                            </Grid>

                                            <Border Background="#312E81" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Game Starts In:" FontWeight="SemiBold" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding PreGameCountdownText}" FontWeight="Black" FontSize="18" Foreground="#FBBF24" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="+1m" Command="{Binding Add1MinuteCommand}" Background="#334155" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" Height="26" Margin="0,0,3,0" Padding="0" />
                                                <Button Grid.Column="1" Content="+5m" Command="{Binding Add5MinutesCommand}" Background="#334155" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" Height="26" Margin="2,0,2,0" Padding="0" />
                                                <Button Grid.Column="2" Content="Reset" Command="{Binding Reset5MinutesCommand}" Background="#334155" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" Height="26" Margin="2,0,2,0" Padding="0" />
                                                <Button Grid.Column="3" Content="⏸/▶" Command="{Binding TogglePreGameTimerCommand}" Background="#334155" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" Height="26" Margin="3,0,0,0" Padding="0" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- TAB 3: Players & Teams -->
            <TabItem Header="👥 Players &amp; Teams">
                <Border Background="#1E293B" CornerRadius="12" Padding="20" Margin="0,12,0,0" BorderBrush="#14FFFFFF" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="CONNECTED PLAYERS &amp; TEAMS ROSTER" FontWeight="Black" FontSize="16" Foreground="#38BDF8" Margin="0,0,0,16" />

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Players}" AutoGenerateColumns="False" CanUserAddRows="False" Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#14FFFFFF" RowBackground="#0F172A" AlternatingRowBackground="#162032" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1AFFFFFF">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Player Name" Binding="{Binding Name}" FontWeight="Bold" Width="200" />
                                <DataGridTextColumn Header="Team Name" Binding="{Binding TeamName}" Width="180" />
                                <DataGridTextColumn Header="Total Score" Binding="{Binding TotalScore, StringFormat='{}{0:N0}'}" FontWeight="ExtraBold" Width="120" />
                                <DataGridTextColumn Header="Streak" Binding="{Binding CurrentStreak, StringFormat='🔥 {0}'}" Width="100" />
                                <DataGridTextColumn Header="Correct" Binding="{Binding TotalCorrect}" Width="90" />
                                <DataGridTextColumn Header="Answered" Binding="{Binding TotalAnswered}" Width="90" />
                                <DataGridTemplateColumn Header="Actions" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Kick" Command="{Binding DataContext.RemovePlayerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#EF4444" Foreground="#FFFFFF" FontWeight="Bold" Height="28" Padding="10,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 4: Help -->
            <TabItem Header="❓ Help">
                <Border Background="#1E293B" CornerRadius="12" Padding="20" Margin="0,12,0,0" BorderBrush="#14FFFFFF" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Topic Selector -->
                        <Border Grid.Column="0" Background="#0F172A" CornerRadius="8" Padding="8" Margin="0,0,16,0" BorderBrush="#14FFFFFF" BorderThickness="1">
                            <ListBox ItemsSource="{Binding HelpTopics}" SelectedItem="{Binding SelectedHelpTopic}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,2" CornerRadius="6" Background="#1E293B">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="{Binding AccentColor}" />
                                                <TextBlock Text="{Binding DescriptionHeader}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Right Topic Content -->
                        <Border Grid.Column="1" Background="#0F172A" CornerRadius="8" Padding="24" BorderBrush="#14FFFFFF" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel DataContext="{Binding SelectedHelpTopic}">
                                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Black" Foreground="{Binding AccentColor}" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding DescriptionHeader}" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,12" />
                                    <Border Height="2" Background="{Binding AccentColor}" HorizontalAlignment="Stretch" Margin="0,0,0,16" Opacity="0.5" />
                                    <TextBlock Text="{Binding DescriptionContent}" FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="22" FontFamily="Segoe UI" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 5: About -->
            <TabItem Header="ℹ️ About">
                <Border Background="#1E293B" CornerRadius="12" Padding="24" Margin="0,12,0,0" BorderBrush="#14FFFFFF" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="800" HorizontalAlignment="Center">
                            <!-- App Emblem & Title -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,16,0,20">
                                <Image Source="/LyracistTrivia_logo.png" Width="140" Height="140" Margin="0,0,0,12" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding AppName}" FontSize="28" FontWeight="Black" Foreground="#A78BFA" HorizontalAlignment="Center" />
                                <Border Background="#334155" CornerRadius="12" Padding="12,4" Margin="0,6,0,0" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}'}" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" />
                                </Border>
                            </StackPanel>

                            <!-- Author & Company Info Card -->
                            <Border Background="#0F172A" CornerRadius="8" Padding="20" Margin="0,0,0,16" BorderBrush="#14FFFFFF" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Company:" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Company}" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Author / Creator:" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Author}" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Copyright:" FontWeight="Bold" Foreground="#94A3B8" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Copyright}" Foreground="#CBD5E1" />
                                </Grid>
                            </Border>

                            <!-- System Overview Description -->
                            <Border Background="#0F172A" CornerRadius="8" Padding="20" Margin="0,0,0,16" BorderBrush="#14FFFFFF" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="SYSTEM SPECIFICATIONS &amp; OVERVIEW" FontWeight="Bold" FontSize="14" Foreground="#F59E0B" Margin="0,0,0,10" />
                                    <TextBlock Text="{Binding AppDescription}" FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,14" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="• Runtime: .NET 10.0 (WPF x64)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4" />
                                            <TextBlock Text="• Storage: SQLite 3 (WAL Mode &amp; Shared Cache)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4" />
                                            <TextBlock Text="• Web Server: Embedded HTTP &amp; WebSockets" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="• Questions: 2,100 Questions (14 Curated Packs)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4" />
                                            <TextBlock Text="• Banners: 16:9 1080p Category Showcase" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4" />
                                            <TextBlock Text="• Displays: DPI-Aware Multi-Monitor Projection" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>