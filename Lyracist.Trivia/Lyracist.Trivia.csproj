<!-- Edited on Aug 30, 2026 @ 08:26:00 -> Update Content links for consolidated Packs, Banners, and Data directories -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>LyracistTrivia</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Company>PAROLE Software</Company>
    <Copyright>Copyright © 2026 PAROLE Software</Copyright>
    <Title>Lyracist Trivia Host</Title>
    <NeutralLanguage>en-US</NeutralLanguage>
    <BaseOutputPath>C:\VB26\Release\Lyracist</BaseOutputPath>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
    <AssemblyVersion>26.9.6.103</AssemblyVersion>
    <FileVersion>26.9.6.103</FileVersion>
    <Authors>Dennis N. Maidon</Authors>
    <PackageIcon>LyracistTrivia_128.png</PackageIcon>
    <ApplicationIcon>LyracistTrivia.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lyracist.Trivia.Core\Lyracist.Trivia.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Globals.cs" Link="Shared\Globals.cs" />
    <Compile Include="..\Shared\MonitorInfo.cs" Link="Shared\MonitorInfo.cs" />
    <Compile Include="..\Shared\MonitorDpiHelper.cs" Link="Shared\MonitorDpiHelper.cs" />
    <Compile Include="..\Shared\WindowPositioner.cs" Link="Shared\WindowPositioner.cs" />
    <Compile Include="..\Shared\LocalNetworkHelper.cs" Link="Shared\LocalNetworkHelper.cs" />
    <Compile Include="..\Shared\WifiHelper.cs" Link="Shared\WifiHelper.cs" />
    <Compile Include="..\Shared\TextBoxSelectionHelper.cs" Link="Shared\TextBoxSelectionHelper.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Packs\**\*">
      <Link>Packs\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Only CategoryBanners ships with the app - it's the pre-built art for the 15 starter
         packs (one PNG per Packs/*.json). Announcements is per-venue, user-supplied content. -->
    <Content Include="..\Banners\LyracistTrivia\CategoryBanners\*">
      <Link>Banners\LyracistTrivia\CategoryBanners\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Data\**\*">
      <Link>Data\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="LyracistTrivia.ico" />
    <Resource Include="LyracistTrivia_128.png" />
    <Resource Include="LyracistTrivia_logo.png" />
    <None Include="LyracistTrivia_128.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
