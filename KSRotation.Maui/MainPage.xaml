<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KSRotation.ViewModels"
             xmlns:models="clr-namespace:KSRotation.Models"
             xmlns:views="clr-namespace:KSRotation.Maui.Views"
             x:Class="KSRotation.Maui.MainPage"
             x:DataType="viewmodels:MainViewModel"
             Title="KSRotation Console (Master)"
             BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#12141C}">

    <Grid x:Name="RootLayoutGrid" ColumnDefinitions="*, 280" RowDefinitions="*" Padding="12" ColumnSpacing="12" RowSpacing="12">

        <!-- LEFT (OR TOP) SECTION: ACTIVE ROTATION QUEUE -->
        <Grid x:Name="RotationSectionGrid" Grid.Column="0" Grid.Row="0" RowDefinitions="*" RowSpacing="12">

            <!-- Rotation List View -->
            <Grid Grid.Row="0" RowDefinitions="Auto, *">
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,0,0,6">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="ACTIVE ROTATION" TextColor="{AppThemeBinding Light=#7C3AED, Dark=#C4B5FD}" FontSize="12" FontAttributes="Bold" CharacterSpacing="1.5" VerticalOptions="Center" />
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <CheckBox IsChecked="{Binding FloatCurrentSingerToTop}" Color="#7C3AED" Scale="0.8" VerticalOptions="Center" />
                            <Label Text="Float to Top" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Button x:Name="LoadTestDataBtn" Text="Load Test Data" Clicked="OnLoadTestDataClicked" IsEnabled="{Binding CanLoadTestData}" BackgroundColor="Transparent" TextColor="#3B82F6" FontSize="10" Padding="8,2" HeightRequest="26" BorderWidth="1" BorderColor="#3B82F6" VerticalOptions="Center">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding CanLoadTestData}" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button x:Name="ThemeBtn" Text="☀️ Light Mode" Clicked="OnThemeToggled" BackgroundColor="Transparent" BorderColor="{AppThemeBinding Light=#6D28D9, Dark=#C4B5FD}" TextColor="{AppThemeBinding Light=#6D28D9, Dark=#C4B5FD}" FontSize="10" Padding="8,2" HeightRequest="26" BorderWidth="1" VerticalOptions="Center" />
                        <Button Text="🎃 Scaryoke" Clicked="OnScaryokeWheelClicked" BackgroundColor="Transparent" BorderColor="#F97316" TextColor="#F97316" FontSize="10" Padding="8,2" HeightRequest="26" BorderWidth="1" VerticalOptions="Center" />
                        <Button Text="Clear Queue" Clicked="OnClearQueueClicked" BackgroundColor="Transparent" TextColor="#F87171" FontSize="10" Padding="8,2" HeightRequest="26" BorderWidth="1" BorderColor="#F87171" VerticalOptions="Center" />
                        <Button Text="Last Round"
                                Command="{Binding ToggleLastRoundCommand}"
                                BackgroundColor="#059669"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="10"
                                Padding="8,2"
                                HeightRequest="26"
                                VerticalOptions="Center">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsLastRound}" Value="True">
                                    <Setter Property="Text" Value="✓ Last Round" />
                                    <Setter Property="BackgroundColor" Value="#2563EB" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="ⓘ About" Clicked="OnAboutClicked" BackgroundColor="Transparent" BorderColor="{AppThemeBinding Light=#6D28D9, Dark=#C4B5FD}" TextColor="{AppThemeBinding Light=#6D28D9, Dark=#C4B5FD}" FontSize="10" Padding="8,2" HeightRequest="26" BorderWidth="1" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </ScrollView>
                <ScrollView Grid.Row="1">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Singers}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:SingerEntry">
                                <Border x:Name="ItemBorder"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="0"
                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E2230}"
                                        Margin="0,0,0,6"
                                        Padding="8">
                                    <Border.Stroke>
                                        <SolidColorBrush Color="Transparent" />
                                    </Border.Stroke>

                                    <Border.Triggers>
                                        <!-- Red border outline and pink/maroon background for the 1st singer (round start) — lowest
                                             priority, overridden below by Inactive/Paused (grey), Current (orange), and Next (blue) -->
                                        <DataTrigger TargetType="Border" Binding="{Binding IsRotationStart}" Value="True">
                                            <Setter Property="StrokeThickness" Value="2" />
                                            <Setter Property="Stroke" Value="#DC2626" />
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FEF2F2, Dark=#2D1414}" />
                                        </DataTrigger>

                                        <!-- Grey out item if inactive/paused, but keep it in the list layout and position -->
                                        <DataTrigger TargetType="Border" Binding="{Binding IsInactive}" Value="True">
                                            <Setter Property="Opacity" Value="0.4" />
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E2E8F0, Dark=#151722}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Opacity" Value="0.4" />
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E2E8F0, Dark=#151722}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSkipped}" Value="True">
                                            <Setter Property="Opacity" Value="0.6" />
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FEF3C7, Dark=#261E14}" />
                                        </DataTrigger>

                                        <!-- Orange border outline and peach/rust background for current singer -->
                                        <DataTrigger TargetType="Border" Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="StrokeThickness" Value="2" />
                                            <Setter Property="Stroke" Value="#F97316" />
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF7ED, Dark=#2D1A10}" />
                                        </DataTrigger>

                                        <!-- Blue border outline and ice blue/navy background for next singer -->
                                        <DataTrigger TargetType="Border" Binding="{Binding IsNext}" Value="True">
                                            <Setter Property="StrokeThickness" Value="2" />
                                            <Setter Property="Stroke" Value="#3B82F6" />
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EFF6FF, Dark=#151F32}" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <!-- Stacked into its own full-width row per section (name/badges, checkboxes, actions) rather than a
                                         2-column Grid — the previous Grid.Column="1" actions panel used VerticalOptions="Center", which
                                         centered it across the whole (now taller, since the checkboxes row was added) left column, landing
                                         it visually on top of the checkboxes instead of beside the name. -->
                                    <VerticalStackLayout Spacing="4">

                                        <!-- Singer and Song Info (Combined into a single line, uniform size) -->
                                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                                <Label Text="{Binding DuetPartnerName, StringFormat='(with {0})'}" TextColor="{AppThemeBinding Light=#6D28D9, Dark=#C4B5FD}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding DuetPartnerName}" Value="">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding DuetPartnerName}" Value="{x:Null}">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>

                                                <!-- Indicator badges (Rotation Anchor [Red], Now Singing [Orange], Next [Blue], Music [Green], Linked [Blue]) -->
                                                <Border StrokeShape="RoundRectangle 4" BackgroundColor="#DC2626" Padding="4,2" IsVisible="{Binding IsRotationStart}" StrokeThickness="0" ToolTipProperties.Text="Rotation Anchor (marks where a round begins)">
                                                    <Label Text="⚓ ANCHOR" TextColor="White" FontSize="9" FontAttributes="Bold" />
                                                </Border>
                                                <Border StrokeShape="RoundRectangle 4" BackgroundColor="#1E3A5F" Stroke="#0EA5E9" StrokeThickness="1" Padding="4,2" IsVisible="{Binding IsLinked}" ToolTipProperties.Text="{Binding LinkedPartnerName, StringFormat='Linked with {0} - always stays adjacent in the rotation'}">
                                                    <Label Text="{Binding LinkedPartnerName, StringFormat='🔗 {0}'}" TextColor="#0EA5E9" FontSize="9" FontAttributes="Bold" />
                                                </Border>
                                                <Border StrokeShape="RoundRectangle 4" BackgroundColor="#F97316" Padding="4,2" IsVisible="{Binding IsCurrent}" StrokeThickness="0">
                                                    <Label Text="NOW PERFORMING" TextColor="White" FontSize="9" FontAttributes="Bold" />
                                                </Border>
                                                <Border StrokeShape="RoundRectangle 4" BackgroundColor="#3B82F6" Padding="4,2" IsVisible="{Binding IsNext}" StrokeThickness="0">
                                                    <Label Text="NEXT" TextColor="White" FontSize="9" FontAttributes="Bold" />
                                                </Border>
                                                <Border StrokeShape="RoundRectangle 4" BackgroundColor="#10B981" Padding="4,2" IsVisible="{Binding IsMusic}" StrokeThickness="0">
                                                    <Label Text="MUSIC" TextColor="White" FontSize="9" FontAttributes="Bold" />
                                                </Border>
                                                <Border StrokeShape="RoundRectangle 4" BackgroundColor="#D97706" Padding="4,2" IsVisible="{Binding IsSkipped}" StrokeThickness="0" ToolTipProperties.Text="Singer is skipped for this round">
                                                    <Label Text="SKIP" TextColor="White" FontSize="9" FontAttributes="Bold" />
                                                </Border>
                                                <Border StrokeShape="RoundRectangle 4" BackgroundColor="#8B5CF6" Padding="4,2" IsVisible="{Binding IsSpecial}" StrokeThickness="0" ToolTipProperties.Text="Special one-time performer">
                                                    <Label Text="⭐ SPECIAL" TextColor="White" FontSize="9" FontAttributes="Bold" />
                                                </Border>

                                                <Label Text="-" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="13" VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Song}" Value="">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Song}" Value="{x:Null}">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>

                                                <Label Text="{Binding Song}" TextColor="{AppThemeBinding Light=#6D28D9, Dark=#A78BFA}" FontSize="13"  FontAttributes="Bold,Italic" VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Song}" Value="">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Song}" Value="{x:Null}">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>

                                                <Label Text="(" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="13" VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Artist}" Value="">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Artist}" Value="{x:Null}">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>

                                                <Label Text="{Binding Artist}" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="13" VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Artist}" Value="">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Artist}" Value="{x:Null}">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>

                                                <Label Text=")" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="13" VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Artist}" Value="">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Artist}" Value="{x:Null}">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </HorizontalStackLayout>

                                            <!-- 10 Checkboxes for Song Rounds -->
                                            <HorizontalStackLayout Spacing="0" Margin="0,2,0,0">
                                                <HorizontalStackLayout.Triggers>
                                                    <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding IsMusic}" Value="True">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </DataTrigger>
                                                </HorizontalStackLayout.Triggers>
                                                <CheckBox IsChecked="{Binding Song1Completed}" Color="#E74C3C" Scale="0.65" WidthRequest="26" HeightRequest="26" />
                                                <CheckBox IsChecked="{Binding Song2Completed}" Color="#E67E22" Scale="0.65" WidthRequest="26" HeightRequest="26" />
                                                <CheckBox IsChecked="{Binding Song3Completed}" Color="#F1C40F" Scale="0.65" WidthRequest="26" HeightRequest="26" />
                                                <CheckBox IsChecked="{Binding Song4Completed}" Color="#2ECC71" Scale="0.65" WidthRequest="26" HeightRequest="26" />
                                                <CheckBox IsChecked="{Binding Song5Completed}" Color="#1ABC9C" Scale="0.65" WidthRequest="26" HeightRequest="26" />
                                                <CheckBox IsChecked="{Binding Song6Completed}" Color="#3498DB" Scale="0.65" WidthRequest="26" HeightRequest="26" />
                                                <CheckBox IsChecked="{Binding Song7Completed}" Color="#9B59B6" Scale="0.65" WidthRequest="26" HeightRequest="26" />
                                                <CheckBox IsChecked="{Binding Song8Completed}" Color="#FF1493" Scale="0.65" WidthRequest="26" HeightRequest="26" />
                                                <CheckBox IsChecked="{Binding Song9Completed}" Color="#00E5FF" Scale="0.65" WidthRequest="26" HeightRequest="26" />
                                                <CheckBox IsChecked="{Binding Song10Completed}" Color="#E040FB" Scale="0.65" WidthRequest="26" HeightRequest="26" />
                                            </HorizontalStackLayout>

                                            <!-- Background Music Label -->
                                            <Label Text="♪ Background Music Track" TextColor="#10B981" FontSize="11" FontAttributes="Bold, Italic" Margin="4,2,0,0">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsMusic}" Value="False">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>

                                        <!-- Actions Panel -->
                                        <HorizontalStackLayout Spacing="4" Margin="0,2,8,0">

                                            <!-- Complete current round -->
                                            <Button Text="✓" Clicked="OnFinishSingerSongClicked" CommandParameter="{Binding .}"  BackgroundColor="Transparent" BorderColor="#3B82F6" BorderWidth="1" TextColor="#3B82F6" FontSize="17" WidthRequest="28" HeightRequest="28" CornerRadius="4" Padding="0" ToolTipProperties.Text="Song Completed" />

                                            <!-- Edit Name/Song/Artist -->
                                            <Button Text="✏" Clicked="OnEditSingerClicked" CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderColor="#8B5CF6" BorderWidth="1" TextColor="#8B5CF6" FontSize="17" WidthRequest="28" HeightRequest="28" CornerRadius="4" Padding="0" ToolTipProperties.Text="Edit Performer" />

                                            <!-- Highlight as Current -->
                                            <Button Text="🎙" Clicked="OnSetCurrentSingerClicked" CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderColor="#10B981" BorderWidth="1" TextColor="#10B981" FontSize="17" WidthRequest="28" HeightRequest="28" CornerRadius="4" Padding="0" ToolTipProperties.Text="Mark Current">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsPaused}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="Opacity" Value="0.4" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsInactive}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="Opacity" Value="0.4" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsSkipped}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="Opacity" Value="0.4" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>

                                            <!-- Set/Clear Rotation Anchor -->
                                            <Button Text="⚓" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=SetRotationStartSingerCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderColor="#DC2626" BorderWidth="1" TextColor="#DC2626" FontSize="17" WidthRequest="28" HeightRequest="28" CornerRadius="4" Padding="0" ToolTipProperties.Text="Set as Rotation Anchor">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsRotationStart}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="#DC2626" />
                                                        <Setter Property="TextColor" Value="White" />
                                                        <Setter Property="ToolTipProperties.Text" Value="Clear Rotation Anchor (accidental flag? tap to remove)" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>

                                            <!-- Up/Down buttons -->
                                            <Button Text="▲" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=MoveSingerUpCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderColor="{AppThemeBinding Light=#CBD5E1, Dark=#4B5563}" BorderWidth="1" TextColor="{AppThemeBinding Light=#475569, Dark=White}" FontSize="18" WidthRequest="28" HeightRequest="28" CornerRadius="4" Padding="0" />
                                            <Button Text="▼" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=MoveSingerDownCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderColor="{AppThemeBinding Light=#CBD5E1, Dark=#4B5563}" BorderWidth="1" TextColor="{AppThemeBinding Light=#475569, Dark=White}" FontSize="18" WidthRequest="28" HeightRequest="28" CornerRadius="4" Padding="0" />

                                            <!-- Link/Unlink with another singer -->
                                            <Button Text="🔗" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=ToggleLinkSingerCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderColor="#0EA5E9" BorderWidth="1" TextColor="#0EA5E9" FontSize="15" WidthRequest="28" HeightRequest="28" CornerRadius="4" Padding="0" ToolTipProperties.Text="Link with another singer - they'll always stay adjacent in the rotation">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsLinked}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="#0EA5E9" />
                                                        <Setter Property="TextColor" Value="White" />
                                                        <Setter Property="ToolTipProperties.Text" Value="Linked - tap to unlink" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>

                                            <!-- Toggle Paused (Pause/Resume) -->
                                            <Button Text="❚❚" Clicked="OnToggleSingerPausedClicked" CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderColor="#D97706" BorderWidth="1" TextColor="#D97706" FontSize="17" FontAttributes="Bold" HeightRequest="28" Padding="6,0">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsPaused}" Value="True">
                                                        <Setter Property="Text" Value="▶ Resume" />
                                                        <Setter Property="BorderColor" Value="#10B981" />
                                                        <Setter Property="TextColor" Value="#10B981" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsInactive}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="Opacity" Value="0.4" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>

                                            <!-- Toggle Skipped (Skip/Unskip for this round) -->
                                            <Button Text="⏭" Clicked="OnToggleSingerSkippedClicked" CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderColor="#D97706" BorderWidth="1" TextColor="#D97706" FontSize="15" FontAttributes="Bold" HeightRequest="28" Padding="6,0" ToolTipProperties.Text="Skip singer for this round">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsSkipped}" Value="True">
                                                        <Setter Property="Text" Value="▶ Unskip" />
                                                        <Setter Property="BorderColor" Value="#F59E0B" />
                                                        <Setter Property="TextColor" Value="#F59E0B" />
                                                        <Setter Property="ToolTipProperties.Text" Value="Unskip singer for this round" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsInactive}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="Opacity" Value="0.4" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>

                                            <!-- Toggle Special (One-Time Singer) -->
                                            <Button Text="⭐" Clicked="OnToggleSingerSpecialClicked" CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderColor="#8B5CF6" BorderWidth="1" TextColor="#8B5CF6" FontSize="14" FontAttributes="Bold" HeightRequest="28" Padding="6,0" ToolTipProperties.Text="Toggle special one-time performer status">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsSpecial}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="#8B5CF6" />
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsInactive}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="Opacity" Value="0.4" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>

                                            <!-- Delete singer row -->
                                            <Button Text="🗑" Clicked="OnDeleteSingerClicked" CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderColor="#EF4444" BorderWidth="1" TextColor="#EF4444" FontSize="17" WidthRequest="28" HeightRequest="28" CornerRadius="4" Padding="0" ToolTipProperties.Text="Delete Performer">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsInactive}" Value="True">
                                                        <Setter Property="Text" Value="↺" />
                                                        <Setter Property="BorderColor" Value="#10B981" />
                                                        <Setter Property="TextColor" Value="#10B981" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>

        <!-- RIGHT (OR BOTTOM) SECTION: WEB PORTAL SERVER & INCOMING REQUESTS -->
        <Grid x:Name="PortalAndRequestsGrid" Grid.Column="1" Grid.Row="0" RowDefinitions="Auto, *" ColumnDefinitions="*" RowSpacing="12" ColumnSpacing="12">

            <!-- Portal Connection Card: just the two entry points now. The QR code, connection URL,
                 and full connect info moved into ConnectQrOverlay; the "Add Performer" entry fields
                 moved into AddSingerOverlay. Both used to scrunch on narrow/portrait tablets. -->
            <Border x:Name="PortalConnectionCard" Grid.Row="0" Grid.Column="0" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E2230}" StrokeThickness="0" Padding="8">
                <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                    <Button Text="+ Add Performer" Clicked="OnAddPerformerClicked" BackgroundColor="#6D28D9" TextColor="White" FontAttributes="Bold" FontSize="12" Padding="8,0" HeightRequest="40" HorizontalOptions="Fill" />
                    <Button Text="📱 Connect QR" Clicked="OnShowConnectQrClicked" BackgroundColor="Transparent" BorderColor="{AppThemeBinding Light=#6D28D9, Dark=#C4B5FD}" TextColor="{AppThemeBinding Light=#6D28D9, Dark=#C4B5FD}" BorderWidth="1" FontAttributes="Bold" FontSize="12" Padding="8,0" HeightRequest="40" HorizontalOptions="Fill" />
                    <Button Text="Legend" Clicked="OnShowLegendClicked" BackgroundColor="Transparent" BorderColor="{AppThemeBinding Light=#6D28D9, Dark=#C4B5FD}" TextColor="{AppThemeBinding Light=#6D28D9, Dark=#C4B5FD}" BorderWidth="1" FontAttributes="Bold" FontSize="12" Padding="8,0" HeightRequest="40" HorizontalOptions="Fill" />
                    <Button Text="📺 Billboard" Clicked="OnShowBillboardClicked" BackgroundColor="Transparent" BorderColor="{AppThemeBinding Light=#D97706, Dark=#FBBF24}" TextColor="{AppThemeBinding Light=#D97706, Dark=#FBBF24}" BorderWidth="1" FontAttributes="Bold" FontSize="12" Padding="8,0" HeightRequest="40" HorizontalOptions="Fill" />
                    <Button Text="📡 Cast to TV" Clicked="OnShowCastDialogClicked" BackgroundColor="Transparent" BorderColor="{AppThemeBinding Light=#D97706, Dark=#FBBF24}" TextColor="{AppThemeBinding Light=#D97706, Dark=#FBBF24}" BorderWidth="1" FontAttributes="Bold" FontSize="12" Padding="8,0" HeightRequest="40" HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>

            <!-- Incoming Requests List -->
            <Grid x:Name="IncomingRequestsGrid" Grid.Row="1" Grid.Column="0" RowDefinitions="Auto, Auto, *">
                <Label Text="INCOMING REQUESTS" TextColor="{AppThemeBinding Light=#7C3AED, Dark=#C4B5FD}" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.5" Margin="0,0,0,4" />

                <HorizontalStackLayout Grid.Row="1" Spacing="6" Margin="0,0,0,6">
                    <CheckBox IsChecked="{Binding AutoAcceptRequests}" Scale="0.85" />
                    <Label Text="Auto-accept incoming requests" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <CollectionView Grid.Row="2" ItemsSource="{Binding IncomingRequests}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="No pending requests" TextColor="#70768F" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,32,0,0" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PatronRequest">
                            <Border StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E2230}" StrokeThickness="0" Margin="0,0,0,6" Padding="8">
                                <Grid RowDefinitions="Auto, Auto" RowSpacing="6">
                                    <!-- Request Details -->
                                    <VerticalStackLayout Grid.Row="0" Spacing="1">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                            <Label Text="{Binding DuetPartnerName, StringFormat='(with {0})'}" TextColor="{AppThemeBinding Light=#6D28D9, Dark=#C4B5FD}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding DuetPartnerName}" Value="">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding DuetPartnerName}" Value="{x:Null}">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <!-- Music Badge -->
                                            <Border StrokeShape="RoundRectangle 4" BackgroundColor="#10B981" Padding="4,2" StrokeThickness="0" VerticalOptions="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="IsVisible" Value="False" />
                                                        <Style.Triggers>
                                                            <DataTrigger TargetType="Border" Binding="{Binding RequestType}" Value="Music">
                                                                <Setter Property="IsVisible" Value="True" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Label Text="MUSIC" TextColor="White" FontSize="8" FontAttributes="Bold" />
                                            </Border>
                                            <!-- Karaoke Badge -->
                                            <Border StrokeShape="RoundRectangle 4" BackgroundColor="#8B5CF6" Padding="4,2" StrokeThickness="0" VerticalOptions="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="IsVisible" Value="True" />
                                                        <Style.Triggers>
                                                            <DataTrigger TargetType="Border" Binding="{Binding RequestType}" Value="Music">
                                                                <Setter Property="IsVisible" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Label Text="KARAOKE" TextColor="White" FontSize="8" FontAttributes="Bold" />
                                            </Border>
                                        </HorizontalStackLayout>
                                        <StackLayout BindableLayout.ItemsSource="{Binding Songs}" Spacing="0">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:RequestedSong">
                                                    <Label FontSize="10" TextColor="{AppThemeBinding Light=#6D28D9, Dark=#A78BFA}">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="• " />
                                                                <Span Text="{Binding Song}" FontAttributes="Italic" />
                                                                <Span Text=" - " />
                                                                <Span Text="{Binding Artist}" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="9" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </StackLayout>
                                    </VerticalStackLayout>

                                    <!-- Action Buttons -->
                                    <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="6">
                                        <Button Grid.Column="0" Text="✓ Accept" Clicked="OnAcceptRequestClicked" CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderColor="#10B981" BorderWidth="1" TextColor="#10B981" FontSize="10" FontAttributes="Bold" HeightRequest="26" Padding="0" />
                                        <Button Grid.Column="1" Text="✕ Decline" Clicked="OnDeclineRequestClicked" CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderColor="#EF4444" BorderWidth="1" TextColor="#EF4444" FontSize="10" FontAttributes="Bold" HeightRequest="26" Padding="0" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <!-- About overlay: hidden by default, toggled by the ⓘ About button above. Placed last so it
             renders on top of both columns without affecting their layout. -->
        <Grid x:Name="AboutOverlay" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="#99000000" IsVisible="False">
            <Border StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E2230}" StrokeThickness="0" Padding="20" WidthRequest="360" MaximumHeightRequest="620" HorizontalOptions="Center" VerticalOptions="Center">
                <Grid RowDefinitions="*,Auto" RowSpacing="10">
                    <ScrollView Grid.Row="0">
                        <VerticalStackLayout Spacing="4">
                            <Image Source="ksr_logo.png" HeightRequest="96" WidthRequest="96" Aspect="AspectFit" HorizontalOptions="Center" Margin="0,0,0,8" />

                            <Label Text="{Binding AppTitle}" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="{Binding AppVersion, StringFormat='Version {0}'}" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="12" HorizontalOptions="Center" Margin="0,0,0,8" />

                            <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="Author:" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="12" FontAttributes="Bold" />
                                <Label Text="{Binding AppAuthor}" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="12" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="Company:" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="12" FontAttributes="Bold" />
                                <Label Text="{Binding AppCompany}" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="12" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding AppCopyright}" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="10" FontAttributes="Italic" HorizontalOptions="Center" Margin="0,4,0,8" />

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" Margin="0,4,0,8" />

                            <Label Text="DJ / Host Name" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" Margin="0,0,0,2" />
                            <Entry x:Name="DjNameEntry"
                                   Text="{Binding DjName, Mode=TwoWay}"
                                   TextChanged="OnDjNameTextChanged"
                                   Unfocused="OnDjNameUnfocused"
                                   Completed="OnDjNameCompleted"
                                   Placeholder="e.g. DJ Dave or Host"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                   PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#70768F}"
                                   FontSize="12" />
                            <Label Text="Name of the DJ or karaoke host. Displayed on TV billboard, reports, and banners." TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="9" Margin="0,2,0,8" />

                            <Label Text="Venue Name" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" Margin="0,0,0,2" />
                            <Entry x:Name="VenueNameEntry"
                                   Text="{Binding VenueName, Mode=TwoWay}"
                                   TextChanged="OnVenueNameTextChanged"
                                   Unfocused="OnVenueNameUnfocused"
                                   Completed="OnVenueNameCompleted"
                                   Placeholder="e.g. Main Stage Lounge"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                   PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#70768F}"
                                   FontSize="12" />
                            <Label Text="Name of the venue or location. Displayed on TV billboard, reports, and patron portal." TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="9" Margin="0,2,0,4" />

                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                <Label x:Name="LocationStatusLabel"
                                       Text="📍 Location: Checking..."
                                       TextColor="{AppThemeBinding Light=#0284C7, Dark=#38BDF8}"
                                       FontSize="10"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation" />
                                <Button Grid.Column="1"
                                        Text="📍 Tag Location"
                                        Clicked="OnTagLocationClicked"
                                        BackgroundColor="#059669"
                                        TextColor="White"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        Padding="8,0"
                                        HeightRequest="26" />
                            </Grid>

                            <HorizontalStackLayout Spacing="6" Margin="0,0,0,8">
                                <CheckBox x:Name="IsTravelRouterCheckBox"
                                          CheckedChanged="OnIsTravelRouterCheckedChanged"
                                          Scale="0.85" />
                                <Label Text="Current Wi-Fi is my Travel Router / Hotspot"
                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=White}"
                                       FontSize="10"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="6" Margin="0,0,0,8">
                                <CheckBox x:Name="ListDjAndVenueCheckBox"
                                          IsChecked="{Binding ListDjAndVenueOnBillboard}"
                                          CheckedChanged="OnListDjAndVenueCheckedChanged"
                                          Scale="0.85" />
                                <Label Text="List DJ Name &amp; Venue on Billboard &amp; TV"
                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=White}"
                                       FontSize="11"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" Margin="0,0,0,8" />

                            <Label Text="Manual Portal IPv4 (Optional)" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" Margin="0,0,0,2" />
                            <Entry x:Name="PreferredIpEntry" Text="{Binding PreferredHostIp, Mode=OneWay}" Unfocused="OnPreferredHostIpUnfocused" Completed="OnPreferredHostIpCompleted" Placeholder="e.g. 192.168.50.20" TextColor="{AppThemeBinding Light=Black, Dark=White}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#70768F}" FontSize="12" />
                            <Label Text="Leave blank to auto-detect. Set this if the app picks the wrong network adapter (e.g. on a travel router)." TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="9" Margin="0,2,0,12" />

                            <Label Text="Report Email Recipient (Optional)" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" Margin="0,0,0,2" />
                            <Entry x:Name="EmailRecipientEntry" Text="{Binding EmailRecipient, Mode=OneWay}" Unfocused="OnEmailRecipientUnfocused" Completed="OnEmailRecipientCompleted" Placeholder="e.g. dj@venue.com" Keyboard="Email" TextColor="{AppThemeBinding Light=Black, Dark=White}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#70768F}" FontSize="12" />
                            <HorizontalStackLayout Spacing="6" Margin="0,4,0,2">
                                <CheckBox IsChecked="{Binding SendEmailOnSave}" Scale="0.85" />
                                <Label Text="Email the report when the night is saved" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Text="Save &amp; Email below also clears the active queue and performance history, like Reset Session does." TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="9" Margin="0,2,0,0" />
                        </VerticalStackLayout>
                    </ScrollView>

                    <VerticalStackLayout Grid.Row="1" Spacing="8">
                        <Button Text="💾 Save &amp; Email Night's Report" Clicked="OnSaveRotationClicked" BackgroundColor="#0EA5E9" TextColor="White" FontAttributes="Bold" HeightRequest="36" />
                        <Button Text="Reset Session (Clear Queue &amp; DJ Pin)" Clicked="OnResetSessionClicked" BackgroundColor="#DC2626" TextColor="White" FontAttributes="Bold" HeightRequest="36" />
                        <Button Text="Close" Clicked="OnCloseAboutClicked" BackgroundColor="#6D28D9" TextColor="White" FontAttributes="Bold" HeightRequest="36" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>

        <!-- Connect QR overlay: replaces the always-on QR card with a popup and 3-way mode switcher. -->
        <Grid x:Name="ConnectQrOverlay" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="#99000000" IsVisible="False">
            <Border StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E2230}" StrokeThickness="0" Padding="20" WidthRequest="300" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="6">
                    <!-- Mode Switcher Tabs (Patron / Kiosk / TV / DJ) -->
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4" Margin="0,0,0,6">
                        <Button Text="📱 Patron" Clicked="OnSelectPatronQrClicked" FontSize="10" HeightRequest="30" Padding="0" CornerRadius="6"
                                BackgroundColor="{AppThemeBinding Light=#EDE9FE, Dark=#312E81}" TextColor="{AppThemeBinding Light=#6D28D9, Dark=#C4B5FD}" FontAttributes="Bold" />
                        <Button Text="📟 Kiosk" Clicked="OnSelectKioskQrClicked" FontSize="10" HeightRequest="30" Padding="0" CornerRadius="6"
                                BackgroundColor="{AppThemeBinding Light=#EDE9FE, Dark=#312E81}" TextColor="{AppThemeBinding Light=#6D28D9, Dark=#C4B5FD}" FontAttributes="Bold" />
                        <Button Text="📺 TV" Clicked="OnSelectBillboardQrClicked" FontSize="10" HeightRequest="30" Padding="0" CornerRadius="6"
                                BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#78350F}" TextColor="{AppThemeBinding Light=#D97706, Dark=#FDE68A}" FontAttributes="Bold" />
                        <Button Text="🎧 DJ" Clicked="OnSelectDjQrClicked" FontSize="10" HeightRequest="30" Padding="0" CornerRadius="6"
                                BackgroundColor="{AppThemeBinding Light=#FEE2E2, Dark=#7F1D1D}" TextColor="{AppThemeBinding Light=#DC2626, Dark=#FCA5A5}" FontAttributes="Bold" />
                    </Grid>

                    <!-- Title Header -->
                    <Label Text="PATRON REQUEST PORTAL" TextColor="{AppThemeBinding Light=#7C3AED, Dark=#C4B5FD}" FontSize="12" FontAttributes="Bold" CharacterSpacing="1.2" HorizontalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsKioskQrVisible}" Value="True">
                                <Setter Property="Text" Value="📟 TABLET KIOSK STATION" />
                                <Setter Property="TextColor" Value="#8B5CF6" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsBillboardQrVisible}" Value="True">
                                <Setter Property="Text" Value="📺 TV AUDIENCE BILLBOARD" />
                                <Setter Property="TextColor" Value="#F59E0B" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsDjQrVisible}" Value="True">
                                <Setter Property="Text" Value="⚠️ DJ CONTROL PORTAL" />
                                <Setter Property="TextColor" Value="#EF4444" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <Border StrokeShape="RoundRectangle 8" BackgroundColor="White" Padding="8" WidthRequest="180" HeightRequest="180" HorizontalOptions="Center" Margin="0,8">
                        <Image Source="{Binding QrCodeImage}" Aspect="AspectFit">
                            <Image.Triggers>
                                <DataTrigger TargetType="Image" Binding="{Binding IsKioskQrVisible}" Value="True">
                                    <Setter Property="Source" Value="{Binding KioskQrCodeImage}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Image" Binding="{Binding IsBillboardQrVisible}" Value="True">
                                    <Setter Property="Source" Value="{Binding BillboardQrCodeImage}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Image" Binding="{Binding IsDjQrVisible}" Value="True">
                                    <Setter Property="Source" Value="{Binding DjQrCodeImage}" />
                                </DataTrigger>
                            </Image.Triggers>
                        </Image>
                    </Border>

                    <Label Text="{Binding ConnectionUrl}" TextColor="#10B981" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsKioskQrVisible}" Value="True">
                                <Setter Property="Text" Value="{Binding KioskConnectionUrl}" />
                                <Setter Property="TextColor" Value="#8B5CF6" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsBillboardQrVisible}" Value="True">
                                <Setter Property="Text" Value="{Binding BillboardConnectionUrl}" />
                                <Setter Property="TextColor" Value="#F59E0B" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsDjQrVisible}" Value="True">
                                <Setter Property="Text" Value="{Binding DjConnectionUrl}" />
                                <Setter Property="TextColor" Value="#EF4444" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <Label Text="Singers scan to connect &amp; request songs" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="10" HorizontalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsKioskQrVisible}" Value="True">
                                <Setter Property="Text" Value="Place tablet in landscape for self-service song requests" />
                                <Setter Property="TextColor" Value="#8B5CF6" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsBillboardQrVisible}" Value="True">
                                <Setter Property="Text" Value="Open on any Smart TV / Fire Stick browser on Travel Router" />
                                <Setter Property="TextColor" Value="#F59E0B" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsDjQrVisible}" Value="True">
                                <Setter Property="Text" Value="DJ ONLY: Remote dashboard login URL" />
                                <Setter Property="TextColor" Value="#EF4444" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <Label Text="{Binding DjPin, StringFormat='PIN: {0}'}" TextColor="#EF4444" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" IsVisible="{Binding IsDjQrVisible}" />

                    <Button Text="📡 Cast to Chromecast" Clicked="OnShowCastDialogClicked"
                            BackgroundColor="#D97706" TextColor="White" FontAttributes="Bold" FontSize="12" HeightRequest="36" Margin="0,4,0,0"
                            IsVisible="{Binding IsBillboardQrVisible}" />

                    <Button Text="Close" Clicked="OnCloseConnectQrClicked" BackgroundColor="Transparent" BorderColor="{AppThemeBinding Light=#CBD5E1, Dark=#4B5563}" BorderWidth="1" TextColor="{AppThemeBinding Light=#475569, Dark=White}" HeightRequest="36" Margin="0,12,0,0" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Add Singer overlay: replaces the old inline row of Entry fields (which scrunched together
             and clipped their text on narrow/portrait tablets) with a single button + popup form. -->
        <Grid x:Name="AddSingerOverlay" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="#99000000" IsVisible="False">
            <Border StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E2230}" StrokeThickness="0" Padding="20" WidthRequest="320" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Add Performer" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,0,0,12" />

                    <Label Text="Name" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" />
                    <Entry x:Name="AddNameEntry" Placeholder="Performer Name" TextColor="{AppThemeBinding Light=Black, Dark=White}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#70768F}" Margin="0,0,0,8" />

                    <Label Text="Duet Partner (Optional)" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" />
                    <Entry x:Name="AddDuetEntry" Placeholder="Partner Name" TextColor="{AppThemeBinding Light=Black, Dark=White}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#70768F}" Margin="0,0,0,8" />

                    <Label Text="Song" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" />
                    <Entry x:Name="AddSongEntry" Placeholder="Song Title" TextColor="{AppThemeBinding Light=Black, Dark=White}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#70768F}" Margin="0,0,0,8" />

                    <Label Text="Artist" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" />
                    <Entry x:Name="AddArtistEntry" Placeholder="Artist Name" TextColor="{AppThemeBinding Light=Black, Dark=White}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#70768F}" Margin="0,0,0,10" />

                    <HorizontalStackLayout Spacing="6" Margin="0,0,0,14">
                        <CheckBox x:Name="AddSpecialCheckBox" Scale="0.85" />
                        <Label Text="Special (One-Time Performance)" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Button Text="Add" Clicked="OnSaveAddPerformerClicked" BackgroundColor="#6D28D9" TextColor="White" FontAttributes="Bold" HeightRequest="36" Margin="0,0,0,8" />
                    <Button Text="Cancel" Clicked="OnCancelAddPerformerClicked" BackgroundColor="Transparent" BorderColor="{AppThemeBinding Light=#CBD5E1, Dark=#4B5563}" BorderWidth="1" TextColor="{AppThemeBinding Light=#475569, Dark=White}" HeightRequest="36" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Edit Singer overlay: lets the DJ fix a typo'd name or add/change the song & artist
             (e.g. a singer added with no song yet) without deleting and re-adding the row. -->
        <Grid x:Name="EditSingerOverlay" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="#99000000" IsVisible="False">
            <Border StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E2230}" StrokeThickness="0" Padding="20" WidthRequest="320" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Edit Performer" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,0,0,12" />

                    <Label Text="Name" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" />
                    <Entry x:Name="EditNameEntry" Placeholder="Performer Name" TextColor="{AppThemeBinding Light=Black, Dark=White}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#70768F}" Margin="0,0,0,8" />

                    <Label Text="Duet Partner (Optional)" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" />
                    <Entry x:Name="EditDuetEntry" Placeholder="Partner Name" TextColor="{AppThemeBinding Light=Black, Dark=White}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#70768F}" Margin="0,0,0,8" />

                    <Label Text="Song" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" />
                    <Entry x:Name="EditSongEntry" Placeholder="Song Title" TextColor="{AppThemeBinding Light=Black, Dark=White}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#70768F}" Margin="0,0,0,8" />

                    <Label Text="Artist" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" />
                    <Entry x:Name="EditArtistEntry" Placeholder="Artist Name" TextColor="{AppThemeBinding Light=Black, Dark=White}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#70768F}" Margin="0,0,0,10" />

                    <HorizontalStackLayout Spacing="6" Margin="0,0,0,14">
                        <CheckBox x:Name="EditSpecialCheckBox" Scale="0.85" />
                        <Label Text="Special (One-Time Performance)" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Button Text="Save" Clicked="OnSaveEditSingerClicked" BackgroundColor="#6D28D9" TextColor="White" FontAttributes="Bold" HeightRequest="36" Margin="0,0,0,8" />
                    <Button Text="Cancel" Clicked="OnCancelEditSingerClicked" BackgroundColor="Transparent" BorderColor="{AppThemeBinding Light=#CBD5E1, Dark=#4B5563}" BorderWidth="1" TextColor="{AppThemeBinding Light=#475569, Dark=White}" HeightRequest="36" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Legend overlay: explains what the various icons, badges, colors, and buttons mean in the singer block -->
        <Grid x:Name="LegendOverlay" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="#99000000" IsVisible="False">
            <Border StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E2230}" StrokeThickness="0" Padding="20" WidthRequest="360" MaximumHeightRequest="620" HorizontalOptions="Center" VerticalOptions="Center">
                <Grid RowDefinitions="*,Auto" RowSpacing="12">
                    <ScrollView Grid.Row="0">
                        <VerticalStackLayout Spacing="14">
                            <!-- Header -->
                            <VerticalStackLayout Spacing="2">
                                <Label Text="SINGER BLOCK LEGEND" TextColor="{AppThemeBinding Light=#7C3AED, Dark=#C4B5FD}" FontSize="15" FontAttributes="Bold" CharacterSpacing="1.2" HorizontalOptions="Center" />
                                <Label Text="Visual guide to status indicators, buttons &amp; rounds" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="10" HorizontalOptions="Center" />
                            </VerticalStackLayout>

                            <!-- Section 1: Row Status & Colors -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="ROW COLORS &amp; BADGES" TextColor="{AppThemeBinding Light=#7C3AED, Dark=#C4B5FD}" FontSize="11" FontAttributes="Bold" CharacterSpacing="1.0" />

                                <!-- Rotation Anchor -->
                                <Border StrokeShape="RoundRectangle 6" BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#2D1414}" Stroke="#DC2626" StrokeThickness="1" Padding="8,6">
                                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                        <Border StrokeShape="RoundRectangle 4" BackgroundColor="#DC2626" Padding="5,2" StrokeThickness="0" VerticalOptions="Center">
                                            <Label Text="⚓ ANCHOR" TextColor="White" FontSize="10" FontAttributes="Bold" />
                                        </Border>
                                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                            <Label Text="Rotation Anchor" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" />
                                            <Label Text="Marks the start of the rotation cycle / round" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="10" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Current Singer -->
                                <Border StrokeShape="RoundRectangle 6" BackgroundColor="{AppThemeBinding Light=#FFF7ED, Dark=#2D1A10}" Stroke="#F97316" StrokeThickness="1" Padding="8,6">
                                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                        <Border StrokeShape="RoundRectangle 4" BackgroundColor="#F97316" Padding="5,2" StrokeThickness="0" VerticalOptions="Center">
                                            <Label Text="NOW" TextColor="White" FontSize="10" FontAttributes="Bold" />
                                        </Border>
                                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                            <Label Text="Now Performing (Orange)" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" />
                                            <Label Text="The active performer currently on stage singing" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="10" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Next Singer -->
                                <Border StrokeShape="RoundRectangle 6" BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#151F32}" Stroke="#3B82F6" StrokeThickness="1" Padding="8,6">
                                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                        <Border StrokeShape="RoundRectangle 4" BackgroundColor="#3B82F6" Padding="5,2" StrokeThickness="0" VerticalOptions="Center">
                                            <Label Text="NEXT" TextColor="White" FontSize="10" FontAttributes="Bold" />
                                        </Border>
                                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                            <Label Text="On Deck / Next Up (Blue)" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" />
                                            <Label Text="The performer who sings next after current song" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="10" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Music Track -->
                                <Border StrokeShape="RoundRectangle 6" BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}" Stroke="#10B981" StrokeThickness="1" Padding="8,6">
                                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                        <Border StrokeShape="RoundRectangle 4" BackgroundColor="#10B981" Padding="5,2" StrokeThickness="0" VerticalOptions="Center">
                                            <Label Text="MUSIC" TextColor="White" FontSize="10" FontAttributes="Bold" />
                                        </Border>
                                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                            <Label Text="Background Music Track" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" />
                                            <Label Text="Scheduled DJ music break or intermission" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="10" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Paused / Inactive -->
                                <Border StrokeShape="RoundRectangle 6" BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#151722}" StrokeThickness="0" Padding="8,6" Opacity="0.75">
                                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                        <Border StrokeShape="RoundRectangle 4" BackgroundColor="#64748B" Padding="5,2" StrokeThickness="0" VerticalOptions="Center">
                                            <Label Text="PAUSED" TextColor="White" FontSize="10" FontAttributes="Bold" />
                                        </Border>
                                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                            <Label Text="Paused / Dimmed Row" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" />
                                            <Label Text="Performer stepped out; skipped without deleting" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="10" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Special Singer -->
                                <Border StrokeShape="RoundRectangle 6" BackgroundColor="{AppThemeBinding Light=#EDE9FE, Dark=#1E1B4B}" StrokeThickness="0" Padding="8,6">
                                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                        <Border StrokeShape="RoundRectangle 4" BackgroundColor="#8B5CF6" Padding="5,2" StrokeThickness="0" VerticalOptions="Center">
                                            <Label Text="⭐ SPECIAL" TextColor="White" FontSize="10" FontAttributes="Bold" />
                                        </Border>
                                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                            <Label Text="Special (One-Time)" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" />
                                            <Label Text="Performs once then automatically becomes inactive" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="10" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Section 2: Action Buttons -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="ACTION BUTTONS" TextColor="{AppThemeBinding Light=#7C3AED, Dark=#C4B5FD}" FontSize="11" FontAttributes="Bold" CharacterSpacing="1.0" />

                                <!-- Complete Song -->
                                <Grid ColumnDefinitions="32,*" ColumnSpacing="10" VerticalOptions="Center">
                                    <Border Grid.Column="0" StrokeShape="RoundRectangle 4" Stroke="#3B82F6" StrokeThickness="1" BackgroundColor="Transparent" WidthRequest="28" HeightRequest="28" Padding="0">
                                        <Label Text="✓" TextColor="#3B82F6" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="Complete Song" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" />
                                        <Label Text="Checks off round, logs history, and advances queue" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="10" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Edit Singer -->
                                <Grid ColumnDefinitions="32,*" ColumnSpacing="10" VerticalOptions="Center">
                                    <Border Grid.Column="0" StrokeShape="RoundRectangle 4" Stroke="#8B5CF6" StrokeThickness="1" BackgroundColor="Transparent" WidthRequest="28" HeightRequest="28" Padding="0">
                                        <Label Text="✏" TextColor="#8B5CF6" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="Edit Performer" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" />
                                        <Label Text="Edit name, duet partner, song title, or artist" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="10" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Mark Current -->
                                <Grid ColumnDefinitions="32,*" ColumnSpacing="10" VerticalOptions="Center">
                                    <Border Grid.Column="0" StrokeShape="RoundRectangle 4" Stroke="#10B981" StrokeThickness="1" BackgroundColor="Transparent" WidthRequest="28" HeightRequest="28" Padding="0">
                                        <Label Text="🎙" TextColor="#10B981" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="Mark Current (Now Performing)" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" />
                                        <Label Text="Immediately sets performer as active singer on stage" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="10" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Rotation Anchor Flag -->
                                <Grid ColumnDefinitions="32,*" ColumnSpacing="10" VerticalOptions="Center">
                                    <Border Grid.Column="0" StrokeShape="RoundRectangle 4" Stroke="#DC2626" StrokeThickness="1" BackgroundColor="Transparent" WidthRequest="28" HeightRequest="28" Padding="0">
                                        <Label Text="⚓" TextColor="#DC2626" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="Set / Clear Rotation Anchor" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" />
                                        <Label Text="Sets anchor for round start (tap again to clear)" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="10" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Reorder Up / Down -->
                                <Grid ColumnDefinitions="32,*" ColumnSpacing="10" VerticalOptions="Center">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <Border StrokeShape="RoundRectangle 4" Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#4B5563}" StrokeThickness="1" BackgroundColor="Transparent" WidthRequest="13" HeightRequest="26" Padding="0">
                                            <Label Text="▲" TextColor="{AppThemeBinding Light=#475569, Dark=White}" FontSize="9" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <Border StrokeShape="RoundRectangle 4" Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#4B5563}" StrokeThickness="1" BackgroundColor="Transparent" WidthRequest="13" HeightRequest="26" Padding="0">
                                            <Label Text="▼" TextColor="{AppThemeBinding Light=#475569, Dark=White}" FontSize="9" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </HorizontalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="Move Up / Move Down" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" />
                                        <Label Text="Manually changes performer position in rotation" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="10" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Pause / Resume -->
                                <Grid ColumnDefinitions="32,*" ColumnSpacing="10" VerticalOptions="Center">
                                    <Border Grid.Column="0" StrokeShape="RoundRectangle 4" Stroke="#D97706" StrokeThickness="1" BackgroundColor="Transparent" WidthRequest="28" HeightRequest="28" Padding="0">
                                        <Label Text="❚❚" TextColor="#D97706" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="Pause / Resume" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" />
                                        <Label Text="Toggles pause state (displays ▶ Resume when paused)" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="10" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Delete / Restore -->
                                <Grid ColumnDefinitions="32,*" ColumnSpacing="10" VerticalOptions="Center">
                                    <Border Grid.Column="0" StrokeShape="RoundRectangle 4" Stroke="#EF4444" StrokeThickness="1" BackgroundColor="Transparent" WidthRequest="28" HeightRequest="28" Padding="0">
                                        <Label Text="🗑" TextColor="#EF4444" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="Delete / Restore" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" />
                                        <Label Text="Deletes performer (turns into ↺ to restore if inactive)" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="10" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>

                            <!-- Section 3: Song Round Checkboxes -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="ROUND CHECKBOXES (1 - 10)" TextColor="{AppThemeBinding Light=#7C3AED, Dark=#C4B5FD}" FontSize="11" FontAttributes="Bold" CharacterSpacing="1.0" />
                                <HorizontalStackLayout Spacing="2" HorizontalOptions="Start">
                                    <Border StrokeShape="RoundRectangle 3" BackgroundColor="#E74C3C" WidthRequest="18" HeightRequest="18" StrokeThickness="0">
                                        <Label Text="1" TextColor="White" FontSize="9" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 3" BackgroundColor="#E67E22" WidthRequest="18" HeightRequest="18" StrokeThickness="0">
                                        <Label Text="2" TextColor="White" FontSize="9" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 3" BackgroundColor="#F1C40F" WidthRequest="18" HeightRequest="18" StrokeThickness="0">
                                        <Label Text="3" TextColor="White" FontSize="9" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 3" BackgroundColor="#2ECC71" WidthRequest="18" HeightRequest="18" StrokeThickness="0">
                                        <Label Text="4" TextColor="White" FontSize="9" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 3" BackgroundColor="#1ABC9C" WidthRequest="18" HeightRequest="18" StrokeThickness="0">
                                        <Label Text="5" TextColor="White" FontSize="9" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 3" BackgroundColor="#3498DB" WidthRequest="18" HeightRequest="18" StrokeThickness="0">
                                        <Label Text="6" TextColor="White" FontSize="9" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 3" BackgroundColor="#9B59B6" WidthRequest="18" HeightRequest="18" StrokeThickness="0">
                                        <Label Text="7" TextColor="White" FontSize="9" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 3" BackgroundColor="#FF1493" WidthRequest="18" HeightRequest="18" StrokeThickness="0">
                                        <Label Text="8" TextColor="White" FontSize="9" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 3" BackgroundColor="#00E5FF" WidthRequest="18" HeightRequest="18" StrokeThickness="0">
                                        <Label Text="9" TextColor="White" FontSize="9" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 3" BackgroundColor="#E040FB" WidthRequest="18" HeightRequest="18" StrokeThickness="0">
                                        <Label Text="10" TextColor="White" FontSize="9" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label Text="Each colored box tracks a completed song for that round. Automatically checked when ✓ Complete is tapped." TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="10" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>

                    <Button Grid.Row="1" Text="Close" Clicked="OnCloseLegendClicked" BackgroundColor="#6D28D9" TextColor="White" FontAttributes="Bold" HeightRequest="36" />
                </Grid>
            </Border>
        </Grid>

        <!-- FULL-SCREEN AUDIENCE BILLBOARD OVERLAY (ATTRACTOR / BREAK MODE) -->
        <Grid x:Name="BillboardOverlay"
              Grid.Row="0" Grid.Column="0"
              IsVisible="False"
              BackgroundColor="#070B14"
              ZIndex="100">
            <Grid RowDefinitions="*,Auto">
                <views:BillboardView Grid.Row="0" />

                <!-- Bottom Floating Controls Bar -->
                <Border Grid.Row="1"
                        StrokeShape="RoundRectangle 24"
                        BackgroundColor="#1E293B"
                        Stroke="#334155"
                        StrokeThickness="1"
                        Padding="16,8"
                        Margin="0,0,0,16"
                        HorizontalOptions="Center"
                        Shadow="{Shadow Brush=Black, Offset='0,4', Radius=12, Opacity=0.6}">
                    <HorizontalStackLayout Spacing="16" VerticalOptions="Center">
                        <Label Text="📺 Billboard / Attractor Mode Active"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#FBBF24"
                               VerticalOptions="Center" />
                        <Button Text="📺 Output To TV / HDMI"
                                Clicked="OnToggleExternalDisplayClicked"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="12"
                                HeightRequest="32"
                                Padding="12,0" />
                        <Button Text="📡 Cast to TV"
                                Clicked="OnShowCastDialogClicked"
                                BackgroundColor="#D97706"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="12"
                                HeightRequest="32"
                                Padding="12,0" />
                        <Button Text="Exit Billboard"
                                Clicked="OnCloseBillboardClicked"
                                BackgroundColor="#EF4444"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="12"
                                HeightRequest="32"
                                Padding="12,0" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <!-- CAST TO TV / CHROMECAST DEVICE PICKER OVERLAY -->
        <Grid x:Name="CastDeviceOverlay" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="#99000000" IsVisible="False" ZIndex="200">
            <Border StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E2230}" StrokeThickness="0" Padding="20" WidthRequest="340" MaximumHeightRequest="520" HorizontalOptions="Center" VerticalOptions="Center">
                <Grid RowDefinitions="Auto, Auto, *, Auto" RowSpacing="10">
                    <!-- Title Header -->
                    <VerticalStackLayout Grid.Row="0" Spacing="4">
                        <Label Text="📡 CAST TO CHROMECAST" TextColor="{AppThemeBinding Light=#D97706, Dark=#FBBF24}" FontSize="13" FontAttributes="Bold" CharacterSpacing="1.2" HorizontalOptions="Center" />
                        <Label Text="Stream Audience Billboard to TV" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="11" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Active Casting Status / Control -->
                    <Border Grid.Row="1" x:Name="CastActiveStatusCard" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#2E2315}" Stroke="#F59E0B" StrokeThickness="1" Padding="10" IsVisible="False">
                        <VerticalStackLayout Spacing="6">
                            <Label x:Name="CastActiveDeviceLabel" Text="Currently Casting to TV" TextColor="{AppThemeBinding Light=#92400E, Dark=#FDE68A}" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Button Text="Stop Casting" Clicked="OnStopCastingClicked" BackgroundColor="#DC2626" TextColor="White" FontAttributes="Bold" FontSize="11" HeightRequest="32" CornerRadius="6" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Discovery State & Discovered Device List -->
                    <Grid Grid.Row="2" RowDefinitions="Auto, *">
                        <HorizontalStackLayout Grid.Row="0" Spacing="8" Margin="0,0,0,6" VerticalOptions="Center">
                            <ActivityIndicator x:Name="CastScanningSpinner" IsRunning="False" IsVisible="False" WidthRequest="18" HeightRequest="18" Color="{AppThemeBinding Light=#D97706, Dark=#FBBF24}" />
                            <Label x:Name="CastStatusLabel" Text="Scanning for devices on Wi-Fi..." TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="11" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <ScrollView Grid.Row="1" HeightRequest="200">
                            <VerticalStackLayout x:Name="CastDevicesList" Spacing="6">
                                <!-- Populated dynamically by RefreshCastDeviceListUI -->
                            </VerticalStackLayout>
                        </ScrollView>
                    </Grid>

                    <!-- Actions Footer -->
                    <Grid Grid.Row="3" ColumnDefinitions="*, *" ColumnSpacing="8" Margin="0,8,0,0">
                        <Button Grid.Column="0" Text="🔄 Rescan" Clicked="OnRescanCastDevicesClicked" BackgroundColor="{AppThemeBinding Light=#EDE9FE, Dark=#312E81}" TextColor="{AppThemeBinding Light=#6D28D9, Dark=#C4B5FD}" FontAttributes="Bold" FontSize="12" HeightRequest="36" CornerRadius="6" />
                        <Button Grid.Column="1" Text="Close" Clicked="OnCloseCastDialogClicked" BackgroundColor="Transparent" BorderColor="{AppThemeBinding Light=#CBD5E1, Dark=#4B5563}" BorderWidth="1" TextColor="{AppThemeBinding Light=#475569, Dark=White}" FontSize="12" HeightRequest="36" CornerRadius="6" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>