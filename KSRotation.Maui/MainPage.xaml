<?xml version="1.0" encoding="utf-8" ?>
<!-- Edited on Jul 28, 2026 @ 18:46:00 - Add music request badges and overlay background music labels to queue list -->
<!-- Edited on Jul 28, 2026 @ 12:46:00 - Add paused state triggers, disable mic when paused/inactive, update pause and delete button triggers -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KSRotation.ViewModels"
             xmlns:models="clr-namespace:KSRotation.Models"
             x:Class="KSRotation.Maui.MainPage"
             x:DataType="viewmodels:MainViewModel"
             Title="KSRotation Console (Master)"
             BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#12141C}">

    <Grid ColumnDefinitions="*, 280" RowDefinitions="*" Padding="12" ColumnSpacing="12">

        <!-- LEFT COLUMN: ACTIVE ROTATION QUEUE -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *" RowSpacing="12">

            <!-- Top Panel: Add New Singer -->
            <Border Grid.Row="0" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E2230}" StrokeThickness="0" Padding="12">
                <Grid ColumnDefinitions="*, *, *, Auto" ColumnSpacing="8" VerticalOptions="Center">
                    <Entry x:Name="NameEntry" Placeholder="Performer Name" TextColor="{AppThemeBinding Light=Black, Dark=White}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#70768F}" Grid.Column="0" VerticalOptions="Center" />
                    <Entry x:Name="SongEntry" Placeholder="Song Title" TextColor="{AppThemeBinding Light=Black, Dark=White}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#70768F}" Grid.Column="1" VerticalOptions="Center" />
                    <Entry x:Name="ArtistEntry" Placeholder="Artist Name" TextColor="{AppThemeBinding Light=Black, Dark=White}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#70768F}" Grid.Column="2" VerticalOptions="Center" />
                    <Button Text="Add Performer" Clicked="OnAddPerformerClicked" BackgroundColor="#6D28D9" TextColor="White" FontAttributes="Bold" Grid.Column="3" Padding="16,0" HeightRequest="40" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Rotation List View -->
            <Grid Grid.Row="1" RowDefinitions="Auto, *">
                <HorizontalStackLayout Spacing="8" Margin="0,0,0,6" VerticalOptions="Center">
                    <Label Text="ACTIVE ROTATION QUEUE" TextColor="{AppThemeBinding Light=#7C3AED, Dark=#C4B5FD}" FontSize="12" FontAttributes="Bold" CharacterSpacing="1.5" VerticalOptions="Center" />
                    <Button Text="Clear Queue" Clicked="OnClearQueueClicked" BackgroundColor="Transparent" TextColor="#F87171" FontSize="10" Padding="8,2" HeightRequest="26" BorderWidth="1" BorderColor="#F87171" VerticalOptions="Center" />
                    <Button x:Name="LoadTestDataBtn" Text="Load Test Data" Clicked="OnLoadTestDataClicked" BackgroundColor="Transparent" TextColor="#3B82F6" FontSize="10" Padding="8,2" HeightRequest="26" BorderWidth="1" BorderColor="#3B82F6" VerticalOptions="Center" />
                    <Button x:Name="ThemeBtn" Text="☀️ Light Mode" Clicked="OnThemeToggled" BackgroundColor="Transparent" BorderColor="{AppThemeBinding Light=#6D28D9, Dark=#C4B5FD}" TextColor="{AppThemeBinding Light=#6D28D9, Dark=#C4B5FD}" FontSize="10" Padding="8,2" HeightRequest="26" BorderWidth="1" VerticalOptions="Center" />
                    <Button Text="🎃 Scaryoke" Clicked="OnScaryokeWheelClicked" BackgroundColor="Transparent" BorderColor="#F97316" TextColor="#F97316" FontSize="10" Padding="8,2" HeightRequest="26" BorderWidth="1" VerticalOptions="Center" />
                    <Button Text="ⓘ About" Clicked="OnAboutClicked" BackgroundColor="Transparent" BorderColor="{AppThemeBinding Light=#6D28D9, Dark=#C4B5FD}" TextColor="{AppThemeBinding Light=#6D28D9, Dark=#C4B5FD}" FontSize="10" Padding="8,2" HeightRequest="26" BorderWidth="1" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <ScrollView Grid.Row="1">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Singers}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:SingerEntry">
                                <Border x:Name="ItemBorder"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="0"
                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E2230}"
                                        Margin="0,0,0,6"
                                        Padding="8">
                                    <Border.Stroke>
                                        <SolidColorBrush Color="Transparent" />
                                    </Border.Stroke>

                                    <Border.Triggers>
                                        <!-- Grey out item if inactive/paused, but keep it in the list layout and position -->
                                        <DataTrigger TargetType="Border" Binding="{Binding IsInactive}" Value="True">
                                            <Setter Property="Opacity" Value="0.4" />
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E2E8F0, Dark=#151722}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Opacity" Value="0.4" />
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E2E8F0, Dark=#151722}" />
                                        </DataTrigger>

                                        <!-- Orange border outline and peach/rust background for current singer -->
                                        <DataTrigger TargetType="Border" Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="StrokeThickness" Value="2" />
                                            <Setter Property="Stroke" Value="#F97316" />
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF7ED, Dark=#2D1A10}" />
                                        </DataTrigger>

                                        <!-- Blue border outline and ice blue/navy background for next singer -->
                                        <DataTrigger TargetType="Border" Binding="{Binding IsNext}" Value="True">
                                            <Setter Property="StrokeThickness" Value="2" />
                                            <Setter Property="Stroke" Value="#3B82F6" />
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EFF6FF, Dark=#151F32}" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8" VerticalOptions="Center">

                                        <!-- Singer and Song Info (Combined into a single line, uniform size) -->
                                        <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />

                                                <!-- Indicator badges (Now Singing [Orange], Next [Blue], Music [Green]) -->
                                                <Border StrokeShape="RoundRectangle 4" BackgroundColor="#F97316" Padding="4,2" IsVisible="{Binding IsCurrent}" StrokeThickness="0">
                                                    <Label Text="NOW PERFORMING" TextColor="White" FontSize="9" FontAttributes="Bold" />
                                                </Border>
                                                <Border StrokeShape="RoundRectangle 4" BackgroundColor="#3B82F6" Padding="4,2" IsVisible="{Binding IsNext}" StrokeThickness="0">
                                                    <Label Text="NEXT" TextColor="White" FontSize="9" FontAttributes="Bold" />
                                                </Border>
                                                <Border StrokeShape="RoundRectangle 4" BackgroundColor="#10B981" Padding="4,2" IsVisible="{Binding IsMusic}" StrokeThickness="0">
                                                    <Label Text="MUSIC" TextColor="White" FontSize="9" FontAttributes="Bold" />
                                                </Border>

                                                <Label Text="-" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="13" VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Song}" Value="">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Song}" Value="{x:Null}">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>

                                                <Label Text="{Binding Song}" TextColor="{AppThemeBinding Light=#6D28D9, Dark=#A78BFA}" FontSize="13" FontAttributes="Italic" VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Song}" Value="">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Song}" Value="{x:Null}">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>

                                                <Label Text="(" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="13" VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Artist}" Value="">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Artist}" Value="{x:Null}">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>

                                                <Label Text="{Binding Artist}" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="13" VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Artist}" Value="">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Artist}" Value="{x:Null}">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>

                                                <Label Text=")" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="13" VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Artist}" Value="">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Artist}" Value="{x:Null}">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </HorizontalStackLayout>

                                            <!-- 10 Checkboxes for Song Rounds -->
                                            <HorizontalStackLayout Spacing="0" Margin="0,2,0,0">
                                                <HorizontalStackLayout.Triggers>
                                                    <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding IsMusic}" Value="True">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </DataTrigger>
                                                </HorizontalStackLayout.Triggers>
                                                <CheckBox IsChecked="{Binding Song1Completed}" Color="#E74C3C" Scale="0.65" WidthRequest="26" HeightRequest="26" />
                                                <CheckBox IsChecked="{Binding Song2Completed}" Color="#E67E22" Scale="0.65" WidthRequest="26" HeightRequest="26" />
                                                <CheckBox IsChecked="{Binding Song3Completed}" Color="#F1C40F" Scale="0.65" WidthRequest="26" HeightRequest="26" />
                                                <CheckBox IsChecked="{Binding Song4Completed}" Color="#2ECC71" Scale="0.65" WidthRequest="26" HeightRequest="26" />
                                                <CheckBox IsChecked="{Binding Song5Completed}" Color="#1ABC9C" Scale="0.65" WidthRequest="26" HeightRequest="26" />
                                                <CheckBox IsChecked="{Binding Song6Completed}" Color="#3498DB" Scale="0.65" WidthRequest="26" HeightRequest="26" />
                                                <CheckBox IsChecked="{Binding Song7Completed}" Color="#9B59B6" Scale="0.65" WidthRequest="26" HeightRequest="26" />
                                                <CheckBox IsChecked="{Binding Song8Completed}" Color="#FF1493" Scale="0.65" WidthRequest="26" HeightRequest="26" />
                                                <CheckBox IsChecked="{Binding Song9Completed}" Color="#00E5FF" Scale="0.65" WidthRequest="26" HeightRequest="26" />
                                                <CheckBox IsChecked="{Binding Song10Completed}" Color="#E040FB" Scale="0.65" WidthRequest="26" HeightRequest="26" />
                                            </HorizontalStackLayout>

                                            <!-- Background Music Label -->
                                            <Label Text="♪ Background Music Track" TextColor="#10B981" FontSize="11" FontAttributes="Bold, Italic" Margin="4,2,0,0">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsMusic}" Value="False">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>

                                        <!-- Actions Panel -->
                                        <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <!-- Edit Name/Song/Artist -->
                                            <Button Text="✏" Clicked="OnEditSingerClicked" CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderColor="#8B5CF6" BorderWidth="1" TextColor="#8B5CF6" FontSize="10" WidthRequest="28" HeightRequest="28" CornerRadius="4" Padding="0" ToolTipProperties.Text="Edit Performer" />

                                            <!-- Highlight as Current -->
                                            <Button Text="🎙" Clicked="OnSetCurrentSingerClicked" CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderColor="#10B981" BorderWidth="1" TextColor="#10B981" FontSize="10" WidthRequest="28" HeightRequest="28" CornerRadius="4" Padding="0" ToolTipProperties.Text="Mark Current">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsPaused}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="Opacity" Value="0.4" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsInactive}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="Opacity" Value="0.4" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>

                                            <!-- Complete current round -->
                                            <Button Text="✓" Clicked="OnFinishSingerSongClicked" CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderColor="#3B82F6" BorderWidth="1" TextColor="#3B82F6" FontSize="10" WidthRequest="28" HeightRequest="28" CornerRadius="4" Padding="0" ToolTipProperties.Text="Song Completed" />

                                            <!-- Up/Down buttons -->
                                            <Button Text="▲" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=MoveSingerUpCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderColor="{AppThemeBinding Light=#CBD5E1, Dark=#4B5563}" BorderWidth="1" TextColor="{AppThemeBinding Light=#475569, Dark=White}" FontSize="10" WidthRequest="28" HeightRequest="28" CornerRadius="4" Padding="0" />
                                            <Button Text="▼" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=MoveSingerDownCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderColor="{AppThemeBinding Light=#CBD5E1, Dark=#4B5563}" BorderWidth="1" TextColor="{AppThemeBinding Light=#475569, Dark=White}" FontSize="10" WidthRequest="28" HeightRequest="28" CornerRadius="4" Padding="0" />

                                            <!-- Toggle Paused (Pause/Resume) -->
                                            <Button Text="❚❚ Pause" Clicked="OnToggleSingerPausedClicked" CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderColor="#D97706" BorderWidth="1" TextColor="#D97706" FontSize="11" FontAttributes="Bold" HeightRequest="28" Padding="6,0">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsPaused}" Value="True">
                                                        <Setter Property="Text" Value="▶ Resume" />
                                                        <Setter Property="BorderColor" Value="#10B981" />
                                                        <Setter Property="TextColor" Value="#10B981" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsInactive}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="Opacity" Value="0.4" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>

                                            <!-- Delete singer row -->
                                            <Button Text="🗑" Clicked="OnDeleteSingerClicked" CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderColor="#EF4444" BorderWidth="1" TextColor="#EF4444" FontSize="10" WidthRequest="28" HeightRequest="28" CornerRadius="4" Padding="0" ToolTipProperties.Text="Delete Performer">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsInactive}" Value="True">
                                                        <Setter Property="Text" Value="↺" />
                                                        <Setter Property="BorderColor" Value="#10B981" />
                                                        <Setter Property="TextColor" Value="#10B981" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>

        <!-- RIGHT COLUMN: WEB PORTAL SERVER & INCOMING REQUESTS -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *" RowSpacing="12">

            <!-- Portal Connection Card -->
            <Border Grid.Row="0" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E2230}" StrokeThickness="0" Padding="8">
                <VerticalStackLayout Spacing="6">
                    <!-- Tapping this title toggles DJ mode -->
                    <Label Text="PATRON REQUEST PORTAL" TextColor="{AppThemeBinding Light=#7C3AED, Dark=#C4B5FD}" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.5" HorizontalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPortalTitleTapped" />
                        </Label.GestureRecognizers>
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsDjQrVisible}" Value="True">
                                <Setter Property="Text" Value="⚠️ DJ CONTROL PORTAL" />
                                <Setter Property="TextColor" Value="#EF4444" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <Border StrokeShape="RoundRectangle 8" BackgroundColor="White" Padding="4" WidthRequest="96" HeightRequest="96" HorizontalOptions="Center">
                        <Image Source="{Binding QrCodeImage}" Aspect="AspectFit">
                            <Image.Triggers>
                                <DataTrigger TargetType="Image" Binding="{Binding IsDjQrVisible}" Value="True">
                                    <Setter Property="Source" Value="{Binding DjQrCodeImage}" />
                                </DataTrigger>
                            </Image.Triggers>
                        </Image>
                    </Border>

                    <Label Text="{Binding ConnectionUrl}" TextColor="#10B981" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsDjQrVisible}" Value="True">
                                <Setter Property="Text" Value="{Binding DjConnectionUrl}" />
                                <Setter Property="TextColor" Value="#EF4444" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <Label Text="Singers scan to connect &amp; request songs" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="9" HorizontalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsDjQrVisible}" Value="True">
                                <Setter Property="Text" Value="DJ ONLY: Remote dashboard login URL" />
                                <Setter Property="TextColor" Value="#EF4444" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <Label Text="{Binding DjPin, StringFormat='PIN: {0}'}" TextColor="#EF4444" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" IsVisible="{Binding IsDjQrVisible}" />
                </VerticalStackLayout>
            </Border>

            <!-- Incoming Requests List -->
            <Grid Grid.Row="1" RowDefinitions="Auto, Auto, *">
                <Label Text="INCOMING REQUESTS" TextColor="{AppThemeBinding Light=#7C3AED, Dark=#C4B5FD}" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.5" Margin="0,0,0,4" />

                <HorizontalStackLayout Grid.Row="1" Spacing="6" Margin="0,0,0,6">
                    <CheckBox IsChecked="{Binding AutoAcceptRequests}" Scale="0.85" />
                    <Label Text="Auto-accept incoming requests" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <CollectionView Grid.Row="2" ItemsSource="{Binding IncomingRequests}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="No pending requests" TextColor="#70768F" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,32,0,0" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PatronRequest">
                            <Border StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E2230}" StrokeThickness="0" Margin="0,0,0,6" Padding="8">
                                <Grid RowDefinitions="Auto, Auto" RowSpacing="6">
                                    <!-- Request Details -->
                                    <VerticalStackLayout Grid.Row="0" Spacing="1">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                            <!-- Music Badge -->
                                            <Border StrokeShape="RoundRectangle 4" BackgroundColor="#10B981" Padding="4,2" StrokeThickness="0" VerticalOptions="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="IsVisible" Value="False" />
                                                        <Style.Triggers>
                                                            <DataTrigger TargetType="Border" Binding="{Binding RequestType}" Value="Music">
                                                                <Setter Property="IsVisible" Value="True" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Label Text="MUSIC" TextColor="White" FontSize="8" FontAttributes="Bold" />
                                            </Border>
                                            <!-- Karaoke Badge -->
                                            <Border StrokeShape="RoundRectangle 4" BackgroundColor="#8B5CF6" Padding="4,2" StrokeThickness="0" VerticalOptions="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="IsVisible" Value="True" />
                                                        <Style.Triggers>
                                                            <DataTrigger TargetType="Border" Binding="{Binding RequestType}" Value="Music">
                                                                <Setter Property="IsVisible" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Label Text="KARAOKE" TextColor="White" FontSize="8" FontAttributes="Bold" />
                                            </Border>
                                        </HorizontalStackLayout>
                                        <StackLayout BindableLayout.ItemsSource="{Binding Songs}" Spacing="0">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:RequestedSong">
                                                    <Label FontSize="10" TextColor="{AppThemeBinding Light=#6D28D9, Dark=#A78BFA}">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="• " />
                                                                <Span Text="{Binding Song}" FontAttributes="Italic" />
                                                                <Span Text=" - " />
                                                                <Span Text="{Binding Artist}" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="9" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </StackLayout>
                                    </VerticalStackLayout>

                                    <!-- Action Buttons -->
                                    <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="6">
                                        <Button Grid.Column="0" Text="✓ Accept" Clicked="OnAcceptRequestClicked" CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderColor="#10B981" BorderWidth="1" TextColor="#10B981" FontSize="10" FontAttributes="Bold" HeightRequest="26" Padding="0" />
                                        <Button Grid.Column="1" Text="✕ Decline" Clicked="OnDeclineRequestClicked" CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderColor="#EF4444" BorderWidth="1" TextColor="#EF4444" FontSize="10" FontAttributes="Bold" HeightRequest="26" Padding="0" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <!-- About overlay: hidden by default, toggled by the ⓘ About button above. Placed last so it
             renders on top of both columns without affecting their layout. -->
        <Grid x:Name="AboutOverlay" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="#99000000" IsVisible="False">
            <Border StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E2230}" StrokeThickness="0" Padding="20" WidthRequest="360" MaximumHeightRequest="620" HorizontalOptions="Center" VerticalOptions="Center">
                <Grid RowDefinitions="*,Auto" RowSpacing="10">
                    <ScrollView Grid.Row="0">
                        <VerticalStackLayout Spacing="4">
                            <Image Source="ksr_logo.png" HeightRequest="96" WidthRequest="96" Aspect="AspectFit" HorizontalOptions="Center" Margin="0,0,0,8" />

                            <Label Text="{Binding AppTitle}" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="{Binding AppVersion, StringFormat='Version {0}'}" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="12" HorizontalOptions="Center" Margin="0,0,0,8" />

                            <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="Author:" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="12" FontAttributes="Bold" />
                                <Label Text="{Binding AppAuthor}" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="12" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="Company:" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="12" FontAttributes="Bold" />
                                <Label Text="{Binding AppCompany}" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="12" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding AppCopyright}" TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="10" FontAttributes="Italic" HorizontalOptions="Center" Margin="0,4,0,12" />

                            <Label Text="Manual Portal IPv4 (Optional)" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" Margin="0,0,0,2" />
                            <Entry x:Name="PreferredIpEntry" Text="{Binding PreferredHostIp, Mode=OneWay}" Unfocused="OnPreferredHostIpUnfocused" Completed="OnPreferredHostIpCompleted" Placeholder="e.g. 192.168.50.20" TextColor="{AppThemeBinding Light=Black, Dark=White}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#70768F}" FontSize="12" />
                            <Label Text="Leave blank to auto-detect. Set this if the app picks the wrong network adapter (e.g. on a travel router)." TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="9" Margin="0,2,0,12" />

                            <Label Text="Report Email Recipient (Optional)" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" Margin="0,0,0,2" />
                            <Entry x:Name="EmailRecipientEntry" Text="{Binding EmailRecipient, Mode=OneWay}" Unfocused="OnEmailRecipientUnfocused" Completed="OnEmailRecipientCompleted" Placeholder="e.g. dj@venue.com" Keyboard="Email" TextColor="{AppThemeBinding Light=Black, Dark=White}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#70768F}" FontSize="12" />
                            <HorizontalStackLayout Spacing="6" Margin="0,4,0,2">
                                <CheckBox IsChecked="{Binding SendEmailOnSave}" Scale="0.85" />
                                <Label Text="Email the report when the night is saved" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Text="Save &amp; Email below also clears the active queue and performance history, like Reset Session does." TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="9" Margin="0,2,0,0" />
                        </VerticalStackLayout>
                    </ScrollView>

                    <VerticalStackLayout Grid.Row="1" Spacing="8">
                        <Button Text="💾 Save &amp; Email Night's Report" Clicked="OnSaveRotationClicked" BackgroundColor="#0EA5E9" TextColor="White" FontAttributes="Bold" HeightRequest="36" />
                        <Button Text="Reset Session (Clear Queue &amp; DJ Pin)" Clicked="OnResetSessionClicked" BackgroundColor="#DC2626" TextColor="White" FontAttributes="Bold" HeightRequest="36" />
                        <Button Text="Close" Clicked="OnCloseAboutClicked" BackgroundColor="#6D28D9" TextColor="White" FontAttributes="Bold" HeightRequest="36" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>

        <!-- Edit Singer overlay: lets the DJ fix a typo'd name or add/change the song & artist
             (e.g. a singer added with no song yet) without deleting and re-adding the row. -->
        <Grid x:Name="EditSingerOverlay" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="#99000000" IsVisible="False">
            <Border StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E2230}" StrokeThickness="0" Padding="20" WidthRequest="320" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Edit Performer" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,0,0,12" />

                    <Label Text="Name" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" />
                    <Entry x:Name="EditNameEntry" Placeholder="Performer Name" TextColor="{AppThemeBinding Light=Black, Dark=White}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#70768F}" Margin="0,0,0,8" />

                    <Label Text="Song" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" />
                    <Entry x:Name="EditSongEntry" Placeholder="Song Title" TextColor="{AppThemeBinding Light=Black, Dark=White}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#70768F}" Margin="0,0,0,8" />

                    <Label Text="Artist" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="11" FontAttributes="Bold" />
                    <Entry x:Name="EditArtistEntry" Placeholder="Artist Name" TextColor="{AppThemeBinding Light=Black, Dark=White}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#70768F}" Margin="0,0,0,14" />

                    <Button Text="Save" Clicked="OnSaveEditSingerClicked" BackgroundColor="#6D28D9" TextColor="White" FontAttributes="Bold" HeightRequest="36" Margin="0,0,0,8" />
                    <Button Text="Cancel" Clicked="OnCancelEditSingerClicked" BackgroundColor="Transparent" BorderColor="{AppThemeBinding Light=#CBD5E1, Dark=#4B5563}" BorderWidth="1" TextColor="{AppThemeBinding Light=#475569, Dark=White}" HeightRequest="36" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>