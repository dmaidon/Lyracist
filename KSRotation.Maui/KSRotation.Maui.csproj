<!-- Edited on Aug 13, 2026 @ 07:28:00 -> Add MSB3374 & XARLP7000 designtime file lock & tmp zip cleanup targets for Android builds -->
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>KSRotation.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<DefineConstants>MAUI;$(DefineConstants)</DefineConstants>

		<!-- Enable XAML source generation for faster build times and improved performance. -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>KSRotation.Maui</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.ksrotation.maui</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>

		<AssemblyVersion>26.8.13.185</AssemblyVersion>

		<FileVersion>26.8.13.185</FileVersion>

		<Authors>Dennis Maidon</Authors>

		<PackageIcon>ksr_logo.png</PackageIcon>

		<PackageOutputPath Condition="!$(TargetFramework.Contains('-android'))">C:\VB26\Release\KSRotation.MAUI</PackageOutputPath>

		<NeutralLanguage>en-US</NeutralLanguage>

		<Title>Karaoke Singer Rotation</Title>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\ksr_logo.png" Link="appicon.png" />
	</ItemGroup>



	<ItemGroup>

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />


		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- Shared C# Code Linking from WPF Project -->
	<ItemGroup>
		<Compile Include="..\KSRotation\Models\*.cs" Link="Models\%(Filename)%(Extension)" />

		<!-- Wildcard so newly-added WPF services are picked up automatically instead of requiring a manual
		     edit here. Excludes the three services that have MAUI-specific replacements in Shims\WpfShims.cs
		     (compiling both would be a duplicate-type error). -->
		<Compile Include="..\KSRotation\Services\*.cs" Exclude="..\KSRotation\Services\DisplayWindowService.cs;..\KSRotation\Services\ThemeService.cs;..\KSRotation\Services\RotationReportService.cs;..\KSRotation\Services\DjBannerWindowService.cs;..\KSRotation\Services\CastingService.cs;..\KSRotation\Services\BrowserCastServer.cs;..\KSRotation\Services\ChromecastSender.cs;..\KSRotation\Services\MiracastController.cs;..\KSRotation\Services\RotationRenderer.cs;..\KSRotation\Services\IRotationRenderer.cs;..\KSRotation\Services\ICastingService.cs" Link="Services\%(Filename)%(Extension)" />


		<Compile Include="..\KSRotation\ViewModels\MainViewModel.cs" Link="ViewModels\MainViewModel.cs" />
		<Compile Include="..\KSRotation\ViewModels\MainViewModel.Requests.cs" Link="ViewModels\MainViewModel.Requests.cs" />
		<Compile Include="..\KSRotation\ViewModels\MainViewModel.KnownSingers.cs" Link="ViewModels\MainViewModel.KnownSingers.cs" />
	</ItemGroup>

	<!-- Shared Embedded Resources (Patron Web Portal HTML) -->
	<ItemGroup>
		<EmbeddedResource Include="..\KSRotation\Resources\PatronPortal.html" Link="Resources\PatronPortal.html" />
		<EmbeddedResource Include="..\KSRotation\Resources\dj.html" Link="Resources\dj.html" />
	</ItemGroup>
	<ItemGroup>
	  <None Include="..\Lyracist\Assets\rotation_m.png" Link="rotation_m.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="Resources\ksr_logo.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="QRCoder" Version="1.8.0" />
		<PackageReference Include="System.Resources.Extensions" Version="10.0.10" />
		<PackageReference Include="PDFsharp" Version="6.2.4" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Properties\Resources.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resources.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Properties\Resources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>
	<ItemGroup>
		<Compile Include="..\Shared\Globals.cs" Link="Globals.cs" />
		<Compile Include="..\Shared\IRotationSinger.cs" Link="IRotationSinger.cs" />
		<Compile Include="..\Shared\RotationHelpers.cs" Link="RotationHelpers.cs" />
		<Compile Include="..\Shared\ChromecastDiscoveryService.cs" Link="ChromecastDiscoveryService.cs" />
		<Compile Include="..\Shared\ChromecastSender.cs" Link="ChromecastSender.cs" />
		<Compile Include="..\Shared\LocalNetworkHelper.cs" Link="LocalNetworkHelper.cs" />
		<Compile Include="..\Shared\DisplayTarget.cs" Link="DisplayTarget.cs" />
		<Compile Include="..\Shared\DjBannerItem.cs" Link="DjBannerItem.cs" />
		<Compile Include="..\Shared\SpecialEventConfig.cs" Link="SpecialEventConfig.cs" />
		<Compile Include="..\Shared\DjBannerFileManager.cs" Link="DjBannerFileManager.cs" />
		<Compile Include="..\Shared\AtomicJsonFile.cs" Link="AtomicJsonFile.cs" />
		<Compile Include="..\Shared\WifiHelper.cs" Link="WifiHelper.cs" />
		<Compile Include="..\Shared\WifiPasswordStore.cs" Link="WifiPasswordStore.cs" />
	</ItemGroup>

	<!-- Ensure resizetizer, designtime & android output directories exist before _ResolveLibraryProjectImports, ResizetizeImages, ProcessMauiSplashScreens, _CompileDex & _CompileToDalvik run across all target platforms (fixes MSB3371/MSB3374/CS7064/MAUIR0001/MAUIR0004/JAVA0000 DirectoryNotFoundExceptions) -->
	<Target Name="EnsureMauiResizetizerDirectoriesExist" BeforeTargets="_ResolveLibraryProjectImports;ResizetizeImages;ProcessMauiSplashScreens;_CreateDesignTimeResourceDesigner;_CompileDex;_CompileToDalvik">
		<MakeDir Directories="$(IntermediateOutputPath)designtime\stamp;$(IntermediateOutputPath)android\bin;$(IntermediateOutputPath)android\assets;$(IntermediateOutputPath)resizetizer\r;$(IntermediateOutputPath)resizetizer\sp;$(IntermediateOutputPath)resizetizer\sp\drawable-mdpi;$(IntermediateOutputPath)resizetizer\sp\drawable-hdpi;$(IntermediateOutputPath)resizetizer\sp\drawable-xhdpi;$(IntermediateOutputPath)resizetizer\sp\drawable-xxhdpi;$(IntermediateOutputPath)resizetizer\sp\drawable-xxxhdpi;$(IntermediateOutputPath)resizetizer\r\drawable-mdpi;$(IntermediateOutputPath)resizetizer\r\drawable-hdpi;$(IntermediateOutputPath)resizetizer\r\drawable-xhdpi;$(IntermediateOutputPath)resizetizer\r\drawable-xxhdpi;$(IntermediateOutputPath)resizetizer\r\drawable-xxxhdpi;$(IntermediateOutputPath)resizetizer\r\mipmap-mdpi;$(IntermediateOutputPath)resizetizer\r\mipmap-hdpi;$(IntermediateOutputPath)resizetizer\r\mipmap-xhdpi;$(IntermediateOutputPath)resizetizer\r\mipmap-xxhdpi;$(IntermediateOutputPath)resizetizer\r\mipmap-xxxhdpi" />
	</Target>

	<!-- Workaround for MSB3374: Handle Visual Studio background design-time file lock on __Microsoft.Android.Resource.Designer.cs -->
	<Target Name="AndroidDesignTimeFileLockWorkaround" BeforeTargets="_CreateDesignTimeResourceDesigner" Condition="Exists('$(IntermediateOutputPath)designtime\__Microsoft.Android.Resource.Designer.cs')">
		<Exec Command="powershell -Command &quot;$file = '$(IntermediateOutputPath)designtime\__Microsoft.Android.Resource.Designer.cs'; try { [System.IO.File]::SetLastWriteTimeUtc($file, [System.DateTime]::UtcNow) } catch { exit 0 }&quot;" ContinueOnError="true" />
	</Target>

	<!-- Workaround for Xamarin.Android directory lock issue on Clean/Rebuild -->
	<Target Name="AndroidCleanWorkaround" BeforeTargets="Clean">
		<PropertyGroup>
			<AndroidObjDir>obj\Debug\net10.0-android</AndroidObjDir>
			<AndroidObjDirRelease>obj\Release\net10.0-android</AndroidObjDirRelease>
		</PropertyGroup>
		<Exec Command="powershell -Command &quot;if (Test-Path '$(AndroidObjDir)') { Rename-Item -Path '$(AndroidObjDir)' -NewName ('net10.0-android-stale_' + [System.Guid]::NewGuid().ToString()) -ErrorAction SilentlyContinue }&quot;" ContinueOnError="true" Condition="Exists('$(AndroidObjDir)')" />
		<Exec Command="powershell -Command &quot;if (Test-Path '$(AndroidObjDirRelease)') { Rename-Item -Path '$(AndroidObjDirRelease)' -NewName ('net10.0-android-stale_' + [System.Guid]::NewGuid().ToString()) -ErrorAction SilentlyContinue }&quot;" ContinueOnError="true" Condition="Exists('$(AndroidObjDirRelease)')" />
		<Exec Command="powershell -Command &quot;Get-ChildItem -Path 'obj' -Filter 'net10.0-android-stale_*' -Directory -Recurse -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue; exit 0&quot;" ContinueOnError="true" />
	</Target>

</Project>
