<!-- Edited on Aug 1, 2026 @ 13:48:00 -> Link shared ChromecastSender in MAUI project -->
<!-- Edited on Aug 1, 2026 @ 13:14:00 -> Link ChromecastDiscoveryService in MAUI project -->
<!-- Edited on Jul 30, 2026 @ 08:00:00 -> Enable cross-platform MauiSplashScreen for Android and Windows and update comments -->
<!-- Edited on Jul 30, 2026 @ 06:15:00 -> Redirected all icon and PNG references to central Lyracist/Assets folder -->
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>KSRotation.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<DefineConstants>MAUI;$(DefineConstants)</DefineConstants>

		<!-- Enable XAML source generation for faster build times and improved performance. -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>KSRotation.Maui</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.ksrotation.maui</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>

		<AssemblyVersion>26.8.4.152</AssemblyVersion>

		<FileVersion>26.8.4.152</FileVersion>

		<Authors>Dennis Maidon</Authors>

		<PackageIcon>rotation_m.png</PackageIcon>

		<PackageOutputPath>C:\VB26\Release\KSRotation.MAUI</PackageOutputPath>

		<NeutralLanguage>en-US</NeutralLanguage>

		<Title>Karaoke Singer Rotation</Title>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#512BD4" />
	</ItemGroup>

	<!-- Platform-specific Splash Screens -->
	<ItemGroup>
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#12091a" BaseSize="128,128" />
	</ItemGroup>

	<ItemGroup>

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- App logo, also used as the About-popup image (shares the file packed as the NuGet/MSIX icon below) -->
		<MauiImage Include="Resources\ksr_logo.png" Resize="True" BaseSize="200,200" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- Shared C# Code Linking from WPF Project -->
	<ItemGroup>
		<Compile Include="..\KSRotation\Models\*.cs" Link="Models\%(Filename)%(Extension)" />

		<!-- Wildcard so newly-added WPF services are picked up automatically instead of requiring a manual
		     edit here. Excludes the three services that have MAUI-specific replacements in Shims\WpfShims.cs
		     (compiling both would be a duplicate-type error). -->
		<Compile Include="..\KSRotation\Services\*.cs" Exclude="..\KSRotation\Services\DisplayWindowService.cs;..\KSRotation\Services\ThemeService.cs;..\KSRotation\Services\RotationReportService.cs;..\KSRotation\Services\DjBannerWindowService.cs;..\KSRotation\Services\CastingService.cs;..\KSRotation\Services\BrowserCastServer.cs;..\KSRotation\Services\ChromecastSender.cs;..\KSRotation\Services\MiracastController.cs;..\KSRotation\Services\RotationRenderer.cs;..\KSRotation\Services\IRotationRenderer.cs;..\KSRotation\Services\ICastingService.cs" Link="Services\%(Filename)%(Extension)" />


		<Compile Include="..\KSRotation\ViewModels\MainViewModel.cs" Link="ViewModels\MainViewModel.cs" />
		<Compile Include="..\KSRotation\ViewModels\MainViewModel.Requests.cs" Link="ViewModels\MainViewModel.Requests.cs" />
		<Compile Include="..\KSRotation\ViewModels\MainViewModel.KnownSingers.cs" Link="ViewModels\MainViewModel.KnownSingers.cs" />
	</ItemGroup>

	<!-- Shared Embedded Resources (Patron Web Portal HTML) -->
	<ItemGroup>
		<EmbeddedResource Include="..\KSRotation\Resources\PatronPortal.html" Link="Resources\PatronPortal.html" />
		<EmbeddedResource Include="..\KSRotation\Resources\dj.html" Link="Resources\dj.html" />
	</ItemGroup>
	<ItemGroup>
	  <None Include="..\Lyracist\Assets\rotation_m.png" Link="rotation_m.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="Resources\ksr_logo.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="QRCoder" Version="1.8.0" />
		<PackageReference Include="System.Resources.Extensions" Version="10.0.10" />
		<PackageReference Include="PDFsharp" Version="6.2.4" />
	</ItemGroup>

	<!-- Platform-specific compilation adjustments to ensure Windows platform code is not compiled on Android (and vice-versa) -->
	<ItemGroup Condition="!$(TargetFramework.Contains('-windows'))">
		<Compile Remove="Platforms\Windows\**" />
		<None Include="Platforms\Windows\**" />
		<MauiXaml Remove="Platforms\Windows\**\*.xaml" />
	</ItemGroup>

	<ItemGroup Condition="!$(TargetFramework.Contains('-android'))">
		<Compile Remove="Platforms\Android\**" />
		<None Include="Platforms\Android\**" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Properties\Resources.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resources.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Properties\Resources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>
	<ItemGroup>
		<Compile Include="..\Shared\Globals.cs" Link="Globals.cs" />
		<Compile Include="..\Shared\IRotationSinger.cs" Link="IRotationSinger.cs" />
		<Compile Include="..\Shared\RotationHelpers.cs" Link="RotationHelpers.cs" />
		<Compile Include="..\Shared\ChromecastDiscoveryService.cs" Link="ChromecastDiscoveryService.cs" />
		<Compile Include="..\Shared\ChromecastSender.cs" Link="ChromecastSender.cs" />
		<Compile Include="..\Shared\LocalNetworkHelper.cs" Link="LocalNetworkHelper.cs" />
		<Compile Include="..\Shared\DisplayTarget.cs" Link="DisplayTarget.cs" />
		<Compile Include="..\Shared\DjBannerItem.cs" Link="DjBannerItem.cs" />
		<Compile Include="..\Shared\DjBannerFileManager.cs" Link="DjBannerFileManager.cs" />
		<Compile Include="..\Shared\AtomicJsonFile.cs" Link="AtomicJsonFile.cs" />
	</ItemGroup>

</Project>
