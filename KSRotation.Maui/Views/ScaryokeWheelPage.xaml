<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KSRotation.Maui.ViewModels"
             xmlns:services="clr-namespace:KSRotation.Maui.Services"
             xmlns:models="clr-namespace:KSRotation.Models"
             x:Class="KSRotation.Maui.Views.ScaryokeWheelPage"
             x:DataType="viewmodels:ScaryokeWheelViewModel"
             Title="Scaryoke Wheel"
             BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#12141C}">

    <ScrollView>
        <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="16">

            <!-- Wheel + fixed pointer -->
            <Grid Grid.Row="0" HeightRequest="340" HorizontalOptions="Center">
                <GraphicsView x:Name="WheelView" WidthRequest="320" HeightRequest="320" VerticalOptions="End" />
                <Label Text="▼" FontSize="30" TextColor="#EF4444" HorizontalOptions="Center" VerticalOptions="Start" />
            </Grid>

            <Label Grid.Row="1" Text="{Binding ResultText}" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" />

            <Button Grid.Row="2" x:Name="SpinButton" Text="🎃 SPIN" Clicked="OnSpinClicked" BackgroundColor="#6D28D9" TextColor="White" FontAttributes="Bold" HeightRequest="48" WidthRequest="160" HorizontalOptions="Center" />

            <!-- Manual Category Assignment to Singer -->
            <Border Grid.Row="3" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E2230}" StrokeThickness="0" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Target Singer &amp; Manual Challenge" FontSize="12" FontAttributes="Bold" CharacterSpacing="1.5" TextColor="{AppThemeBinding Light=#EA580C, Dark=#FB923C}" />

                    <Picker Title="Target Singer (for Spin or Manual Set)"
                            ItemsSource="{Binding Singers}"
                            ItemDisplayBinding="{Binding Name, x:DataType=models:SingerEntry}"
                            SelectedItem="{Binding SelectedTargetSinger}"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <Picker Grid.Column="0"
                                Title="Select Category..."
                                ItemsSource="{Binding AssignableCategories}"
                                SelectedItem="{Binding SelectedManualCategory}"
                                TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                        <Button Grid.Column="1" Text="📌 Set Singer" Command="{Binding AssignManualCategoryCommand}" BackgroundColor="#EA580C" TextColor="White" FontAttributes="Bold" />
                        <Button Grid.Column="2" Text="✕ Clear" Command="{Binding ClearManualCategoryCommand}" BackgroundColor="#475569" TextColor="White" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Category management -->
            <Border Grid.Row="4" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E2230}" StrokeThickness="0" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Categories" FontSize="12" FontAttributes="Bold" CharacterSpacing="1.5" TextColor="{AppThemeBinding Light=#7C3AED, Dark=#C4B5FD}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding CustomCategories}" Spacing="2">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:CategoryItem">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4" Padding="0,2">
                                    <Label Text="{Binding Name}" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}" FontSize="13" />
                                    <Button Grid.Column="1"
                                            BackgroundColor="{Binding DisplayColor}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ScaryokeWheelViewModel}, Mode=FindAncestorBindingContext}, Path=CycleColorCommand}"
                                            CommandParameter="{Binding .}"
                                            WidthRequest="32" HeightRequest="32" Padding="0" CornerRadius="16" />
                                    <Button Grid.Column="2"
                                            Text="{Binding Weight, StringFormat='{0:0}×'}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ScaryokeWheelViewModel}, Mode=FindAncestorBindingContext}, Path=CycleWeightCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#2A2F42}"
                                            TextColor="{AppThemeBinding Light=#1E293B, Dark=White}"
                                            WidthRequest="44" HeightRequest="32" Padding="0" FontSize="12" />
                                    <Button Grid.Column="3"
                                            Text="✕"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ScaryokeWheelViewModel}, Mode=FindAncestorBindingContext}, Path=RemoveCategoryCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent"
                                            TextColor="#EF4444"
                                            WidthRequest="32" HeightRequest="32" Padding="0" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,8,0,0">
                        <Entry Grid.Column="0" Text="{Binding NewCategoryName}" Placeholder="Add a category..." TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                        <Button Grid.Column="1" Text="Add" Command="{Binding AddCategoryCommand}" BackgroundColor="#6D28D9" TextColor="White" />
                    </Grid>

                    <Label Text="{Binding ValidationError}" TextColor="#EF4444" FontSize="11">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding ValidationError}" Value="">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <Label Text="Presets" FontSize="12" FontAttributes="Bold" CharacterSpacing="1.5" Margin="0,8,0,0" TextColor="{AppThemeBinding Light=#7C3AED, Dark=#C4B5FD}" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <Picker Grid.Column="0" Title="Saved presets" ItemsSource="{Binding Presets}" ItemDisplayBinding="{Binding Name, x:DataType=services:CategoryPreset}" SelectedItem="{Binding SelectedPreset}" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                        <Button Grid.Column="1" Text="Load" Command="{Binding LoadPresetCommand}" BackgroundColor="#6D28D9" TextColor="White" />
                        <Button Grid.Column="2" Text="Delete" Command="{Binding DeletePresetCommand}" BackgroundColor="#EF4444" TextColor="White" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <Entry Grid.Column="0" Text="{Binding NewPresetName}" Placeholder="Preset name..." TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                        <Button Grid.Column="1" Text="Save Preset" Command="{Binding SavePresetCommand}" BackgroundColor="#6D28D9" TextColor="White" />
                    </Grid>

                    <Label Text="Up to 11 categories. The wheel also always includes a Singer's Choice segment and two small DJ's Choice slivers." TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" FontSize="9" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
