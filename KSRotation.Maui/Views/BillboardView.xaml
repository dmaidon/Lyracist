<?xml version="1.0" encoding="utf-8" ?>
<!-- Edited on Sep 3, 2026 @ 23:52:55 -> Add Last Round announcement banner to BillboardView -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KSRotation.ViewModels;assembly=KSRotation"
             xmlns:models="clr-namespace:KSRotation.Models;assembly=KSRotation"
             x:Class="KSRotation.Maui.Views.BillboardView"
             x:DataType="vm:MainViewModel"
             BackgroundColor="#070B14">

    <Grid RowDefinitions="64,*" RowSpacing="12" Padding="16">
        <!-- Top Header Bar -->
        <Border Grid.Row="0"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="#0F172A"
                StrokeThickness="1"
                Stroke="#1E293B"
                Padding="16,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16" VerticalOptions="Center">
                <Label Grid.Column="0" Text="🎤" FontSize="26" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                    <Label Text="{Binding VenueName}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White"
                           LineBreakMode="TailTruncation" />
                    <Label Text="{Binding DjName, StringFormat='Hosted by {0}'}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#A78BFA"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>

                <!-- Active Singers Count Pill -->
                <Border Grid.Column="2"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="#1E293B"
                        StrokeThickness="0"
                        Padding="12,4"
                        VerticalOptions="Center">
                    <Label Text="{Binding ActiveSingerCountText}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#94A3B8" />
                </Border>

                <!-- Live Clock -->
                <Label Grid.Column="3"
                       x:Name="LiveClockLabel"
                       Text="--:-- --"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Main 2-Column Content Grid -->
        <Grid Grid.Row="1" ColumnDefinitions="1.3*,1*" ColumnSpacing="16">
            <!-- Left Column: Stage Queue -->
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
                <!-- 0. LAST ROUND ANNOUNCEMENT BANNER -->
                <Border Grid.Row="0"
                        IsVisible="{Binding IsLastRound}"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="#B45309"
                        StrokeThickness="2"
                        Stroke="#F59E0B"
                        Padding="14,10">
                    <Label Text="★ THE LAST ROUND FOR THE NIGHT IS CURRENTLY UNDERWAY ★"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"
                           CharacterSpacing="1" />
                </Border>

                <!-- 1. NOW PERFORMING SPOTLIGHT -->
                <Border Grid.Row="1"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="#152238"
                        StrokeThickness="2"
                        Stroke="#F59E0B"
                        Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="6">
                            <Border HorizontalOptions="Start"
                                    StrokeShape="RoundRectangle 6"
                                    BackgroundColor="#D97706"
                                    StrokeThickness="0"
                                    Padding="8,2">
                                <Label Text="🎙️ NOW PERFORMING"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       CharacterSpacing="1" />
                            </Border>
                            <Border HorizontalOptions="Start"
                                    IsVisible="{Binding CurrentSingerIsRotationStart}"
                                    StrokeShape="RoundRectangle 6"
                                    BackgroundColor="#DC2626"
                                    StrokeThickness="0"
                                    Padding="8,2">
                                <Label Text="🚩 1ST" FontSize="11" FontAttributes="Bold" TextColor="White" CharacterSpacing="1" />
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Singer Name -->
                        <Label Text="{Binding CurrentSingerNameDisplay}"
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="White"
                               LineBreakMode="TailTruncation" />

                        <!-- Song & Artist -->
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="{Binding CurrentSingerSongDisplay, StringFormat='&quot;{0}&quot;'}"
                                   FontSize="16"
                                   FontAttributes="Bold,Italic"
                                   TextColor="#FBBF24"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding CurrentSingerArtistDisplay, StringFormat='by {0}'}"
                                   FontSize="15"
                                   TextColor="#94A3B8"
                                   LineBreakMode="TailTruncation" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 2. UP NEXT SPOTLIGHT -->
                <Border Grid.Row="2"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="#0E1A2E"
                        StrokeThickness="1.5"
                        Stroke="#3B82F6"
                        Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <HorizontalStackLayout Spacing="6">
                            <Border HorizontalOptions="Start"
                                    StrokeShape="RoundRectangle 6"
                                    BackgroundColor="#2563EB"
                                    StrokeThickness="0"
                                    Padding="8,2">
                                <Label Text="⏭️ UP NEXT"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       CharacterSpacing="1" />
                            </Border>
                            <Border HorizontalOptions="Start"
                                    IsVisible="{Binding NextSingerIsRotationStart}"
                                    StrokeShape="RoundRectangle 6"
                                    BackgroundColor="#DC2626"
                                    StrokeThickness="0"
                                    Padding="8,2">
                                <Label Text="🚩 1ST" FontSize="10" FontAttributes="Bold" TextColor="White" CharacterSpacing="1" />
                            </Border>
                        </HorizontalStackLayout>

                        <Label Text="{Binding NextSingerNameDisplay}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="White"
                               LineBreakMode="TailTruncation" />

                        <Label Text="{Binding NextSingerSongDisplay, StringFormat='&quot;{0}&quot;'}"
                               FontSize="14"
                               FontAttributes="Italic"
                               TextColor="#93C5FD"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Border>

                <!-- 3. UPCOMING ROTATION LIST -->
                <Border Grid.Row="3"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="#0E1626"
                        StrokeThickness="1"
                        Stroke="#1E293B"
                        Padding="14">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <Label Grid.Row="0"
                               Text="UPCOMING IN ROTATION"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#64748B"
                               CharacterSpacing="1.5" />

                        <CollectionView Grid.Row="1"
                                        ItemsSource="{Binding UpcomingSingers}"
                                        EmptyView="Rotation is open. Add your song to get on stage!">
                            <CollectionView.EmptyViewTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6" Padding="20">
                                        <Label Text="📋" FontSize="28" HorizontalTextAlignment="Center" />
                                        <Label Text="Rotation is open. Submit your song to take the stage!"
                                               FontSize="12"
                                               TextColor="#64748B"
                                               HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.EmptyViewTemplate>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:SingerEntry">
                                    <Border StrokeShape="RoundRectangle 8"
                                            BackgroundColor="#152033"
                                            StrokeThickness="1"
                                            Stroke="#1E293B"
                                            Padding="10,6"
                                            Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                                <HorizontalStackLayout Spacing="6">
                                                    <Border IsVisible="{Binding IsRotationStart}"
                                                            StrokeShape="RoundRectangle 4"
                                                            BackgroundColor="#DC2626"
                                                            StrokeThickness="0"
                                                            Padding="4,1"
                                                            VerticalOptions="Center">
                                                        <Label Text="🚩 1ST" FontSize="9" FontAttributes="Bold" TextColor="White" />
                                                    </Border>
                                                    <Label Text="{Binding DisplayNameWithDuet}"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           TextColor="White"
                                                           LineBreakMode="TailTruncation" />
                                                </HorizontalStackLayout>
                                                <Label Text="{Binding Song}"
                                                       FontSize="11"
                                                       FontAttributes="Italic"
                                                       TextColor="#94A3B8"
                                                       LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>

                                            <!-- Paused badge -->
                                            <Border Grid.Column="1"
                                                    IsVisible="{Binding IsPaused}"
                                                    StrokeShape="RoundRectangle 4"
                                                    BackgroundColor="#475569"
                                                    StrokeThickness="0"
                                                    Padding="6,2"
                                                    VerticalOptions="Center">
                                                <Label Text="PAUSED" FontSize="9" FontAttributes="Bold" TextColor="White" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right Column: Connect & Request Hub -->
            <Grid Grid.Column="1" RowDefinitions="1.2*,1*" RowSpacing="12">
                <!-- 1. SONG REQUEST HUB -->
                <Border Grid.Row="0"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="#141E33"
                        StrokeThickness="1.5"
                        Stroke="#8B5CF6"
                        Padding="16">
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                        <Border HorizontalOptions="Center"
                                StrokeShape="RoundRectangle 6"
                                BackgroundColor="#2E1065"
                                StrokeThickness="1"
                                Stroke="#8B5CF6"
                                Padding="10,3">
                            <Label Text="📱 SONG REQUESTS"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#C4B5FD"
                                   CharacterSpacing="1" />
                        </Border>

                        <Border StrokeShape="RoundRectangle 10"
                                BackgroundColor="White"
                                StrokeThickness="0"
                                Padding="8"
                                HorizontalOptions="Center"
                                IsVisible="{Binding ShowQrCodeOnRotationScreen}">
                            <Image Source="{Binding QrCodeImage}"
                                   WidthRequest="140"
                                   HeightRequest="140"
                                   Aspect="AspectFit" />
                        </Border>

                        <Label Text="Scan To Pick Your Song"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalTextAlignment="Center" />

                        <Label Text="{Binding ConnectionUrl}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#A78BFA"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Border>

                <!-- 2. WI-FI JOIN HUB -->
                <Border Grid.Row="1"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="#0F172A"
                        StrokeThickness="1"
                        Stroke="#10B981"
                        Padding="14">
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                        <Border HorizontalOptions="Center"
                                StrokeShape="RoundRectangle 6"
                                BackgroundColor="#064E3B"
                                StrokeThickness="1"
                                Stroke="#10B981"
                                Padding="8,2">
                            <Label Text="📶 FAST WI-FI JOIN"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#6EE7B7"
                                   CharacterSpacing="1" />
                        </Border>

                        <Border StrokeShape="RoundRectangle 8"
                                BackgroundColor="White"
                                StrokeThickness="0"
                                Padding="6"
                                HorizontalOptions="Center"
                                IsVisible="{Binding ShowQrCodeOnRotationScreen}">
                            <Image Source="{Binding WifiQrCodeImage}"
                                   WidthRequest="95"
                                   HeightRequest="95"
                                   Aspect="AspectFit" />
                        </Border>

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="Network:" FontSize="11" TextColor="#94A3B8" />
                            <Label Text="{Binding WifiSsidDisplay}" FontSize="11" FontAttributes="Bold" TextColor="White" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="Password:" FontSize="11" TextColor="#94A3B8" />
                            <Label Text="{Binding WifiPasswordDisplay}" FontSize="11" FontAttributes="Bold" TextColor="White" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentView>
