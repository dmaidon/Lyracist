<!-- Edited on Oct 31, 2026 @ 10:54:00 -> Set ShutdownMode to OnMainWindowClose so hidden AudienceWindow never blocks app exit -->
<Application x:Class="KnockoutTrivia.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:KnockoutTrivia.ViewModels"
             xmlns:views="clr-namespace:KnockoutTrivia.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Official Knockout Trivia Logo Resource -->
            <BitmapImage x:Key="KnockoutLogo" UriSource="pack://application:,,,/Assets/kotrv_logo.png" />

            <!-- MVVM ViewModel -> View DataTemplates -->
            <DataTemplate DataType="{x:Type vm:ConnectViewModel}">
                <views:ConnectView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GameViewModel}">
                <views:MainView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ScoreboardViewModel}">
                <views:ScoreboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:QuestionViewModel}">
                <views:QuestionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:WheelViewModel}">
                <views:WheelView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BannerViewModel}">
                <views:BannerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SimulatorViewModel}">
                <views:SimulatorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HelpViewModel}">
                <views:HelpView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                <views:AboutView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
