<!-- Created on Aug 27, 2026 @ 14:37:25 -> QuestionView for high-visibility game-show question and answer presentation -->
<UserControl x:Class="KnockoutTrivia.Views.QuestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#0B0A0E">

    <!-- 16:9 Aspect Ratio Container for bar screens -->
    <Viewbox Stretch="Uniform" Margin="20">
        <Border Width="1280" Height="720" Background="#121019" CornerRadius="16" BorderBrush="#2F2942" BorderThickness="2" Padding="40">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Top Bar: Category & Question Counter & Timer -->
                    <RowDefinition Height="Auto" />
                    <!-- Big Question Prompt -->
                    <RowDefinition Height="*" />
                    <!-- Option Cards (2x2 Grid) -->
                    <RowDefinition Height="Auto" />
                    <!-- Explanation / Answer Reveal Box -->
                    <RowDefinition Height="Auto" />
                    <!-- Host Action Bar -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Info Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Category Badge -->
                    <Border Grid.Column="0" Background="#1F1B2E" BorderBrush="#8B5CF6" BorderThickness="1.5" CornerRadius="8" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁 " FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentQuestion.Category}" FontSize="18" FontWeight="Bold" Foreground="#A78BFA" />
                        </StackPanel>
                    </Border>

                    <!-- Question Number Header -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentQuestionNumber, StringFormat='QUESTION {0}'}" FontSize="24" FontWeight="Black" Foreground="#F59E0B" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding TotalQuestions, StringFormat='OF {0} QUESTIONS'}" FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>

                    <!-- Timer Countdown -->
                    <Border Grid.Column="2" Background="#1F1B2E" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="8" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏱️ " FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SecondsRemaining, StringFormat='{}{0}s'}" FontSize="18" FontWeight="Bold" Foreground="#34D399" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Question Prompt Box -->
                <Border Grid.Row="1" Background="#181524" CornerRadius="12" BorderBrush="#3B3454" BorderThickness="1.5" Padding="35,25" Margin="0,0,0,25" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentQuestion.Prompt}"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="White"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               LineHeight="44" />
                </Border>

                <!-- 2x2 Answer Choices (for Multiple Choice) -->
                <ItemsControl Grid.Row="2" ItemsSource="{Binding Options}" Margin="0,0,0,20">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" Rows="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="8" Background="#1C182A" CornerRadius="10" BorderBrush="#352F4B" BorderThickness="2" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#29233D" Width="36" Height="36" CornerRadius="6" Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="✦" FontSize="16" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding}" FontSize="22" FontWeight="SemiBold" Foreground="#E5E7EB" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Answer Reveal Banner (Visible when Answer is Revealed) -->
                <Border Grid.Row="3" Background="#0F2D1F" BorderBrush="#10B981" BorderThickness="2" CornerRadius="10" Padding="20,12" Margin="0,0,0,20">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAnswerRevealed}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding CurrentQuestion.CorrectAnswerText, StringFormat='CORRECT ANSWER: {0}'}"
                                   FontSize="22" FontWeight="Black" Foreground="#10B981" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentQuestion.Explanation}"
                                   FontSize="15" Foreground="#D1FAE5" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Host Action Bar -->
                <Grid Grid.Row="4">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:Button Content="REVEAL ANSWER"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Height="48"
                                   Width="200"
                                   Margin="0,0,15,0"
                                   Appearance="Primary"
                                   Background="#10B981"
                                   Foreground="White"
                                   Command="{Binding RevealAnswerCommand}"
                                   Cursor="Hand" />

                        <ui:Button Content="NEXT QUESTION ▶"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Height="48"
                                   Width="200"
                                   Appearance="Primary"
                                   Background="#3B82F6"
                                   Foreground="White"
                                   Command="{Binding NextQuestionCommand}"
                                   Cursor="Hand" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Viewbox>
</UserControl>
