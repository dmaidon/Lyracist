<!-- Edited on Aug 29, 2026 @ 10:34:00 -> Bound streak meter visual blocks to StreakMeterProgress for multi-tier streak progression -->
<UserControl x:Class="KnockoutTrivia.Views.ScoreboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:KnockoutTrivia.Models"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#0B0A0E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header & Add Player Bar -->
            <RowDefinition Height="Auto" />
            <!-- Player Scoreboard List -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Quick Add Player -->
        <Border Grid.Row="0" Background="#14131A" CornerRadius="10" Padding="15" Margin="0,0,0,15" BorderBrush="#262333" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛡️" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="KNOCKOUT SCOREBOARD" FontSize="18" FontWeight="Bold" Foreground="#10B981" />
                        <TextBlock Text="Green (0 strikes) • Yellow (1 strike) • Orange (2 strikes) • Red (Knocked Out)" FontSize="11" Foreground="#9CA3AF" />
                    </StackPanel>
                </StackPanel>

                <!-- Add Player Quick Input -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBox Text="{Binding NewPlayerName, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Add new player / team..."
                                Width="220" Height="36"
                                Margin="0,0,10,0"
                                VerticalContentAlignment="Center"
                                Background="#1C1A24"
                                BorderBrush="#332B45" />
                    <ui:Button Content="Add Player"
                               Appearance="Primary"
                               Height="36"
                               Command="{Binding AddPlayerCommand}"
                               Background="#10B981"
                               Foreground="White"
                               Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Player Bars (Horizontal Layout) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Players}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:KnockoutPlayer}">
                        <!-- Horizontal Player Bar Card -->
                        <Border Margin="0,0,0,10" CornerRadius="8" Padding="12,10" BorderThickness="2">
                            <!-- Dynamic Strike Tinting -->
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#0F2D1F" />
                                    <Setter Property="BorderBrush" Value="#10B981" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StrikeCount}" Value="0">
                                            <Setter Property="Background" Value="#0F2D1F" />
                                            <Setter Property="BorderBrush" Value="#10B981" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StrikeCount}" Value="1">
                                            <Setter Property="Background" Value="#332B0D" />
                                            <Setter Property="BorderBrush" Value="#EAB308" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StrikeCount}" Value="2">
                                            <Setter Property="Background" Value="#3A1C0A" />
                                            <Setter Property="BorderBrush" Value="#F97316" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StrikeCount}" Value="3">
                                            <Setter Property="Background" Value="#250B0B" />
                                            <Setter Property="BorderBrush" Value="#EF4444" />
                                            <Setter Property="Opacity" Value="0.65" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Player Name & Status -->
                                    <ColumnDefinition Width="220" />
                                    <!-- Shield Tokens -->
                                    <ColumnDefinition Width="150" />
                                    <!-- Streak Meter (5 Blocks) -->
                                    <ColumnDefinition Width="200" />
                                    <!-- Score -->
                                    <ColumnDefinition Width="110" />
                                    <!-- Action Controls -->
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Player Name & Strikes -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Border CornerRadius="4" Padding="6,2" Background="#1E1C28" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold" Foreground="{Binding StrikeColorBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding StrikeCount, StringFormat='Strikes: {0}/3'}" FontSize="11" Foreground="#D1D5DB" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Column 1: Shield Tokens -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="SHIELD TOKENS" FontSize="9" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,4" />
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Shield Token 1 -->
                                        <Border Width="28" Height="28" CornerRadius="6" Margin="0,0,5,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1E1C28" />
                                                    <Setter Property="BorderBrush" Value="#374151" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tokens, ConverterParameter=1}" Value="1">
                                                            <Setter Property="Background" Value="#0284C7" />
                                                            <Setter Property="BorderBrush" Value="#38BDF8" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Tokens, ConverterParameter=2}" Value="2">
                                                            <Setter Property="Background" Value="#0284C7" />
                                                            <Setter Property="BorderBrush" Value="#38BDF8" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Tokens, ConverterParameter=3}" Value="3">
                                                            <Setter Property="Background" Value="#0284C7" />
                                                            <Setter Property="BorderBrush" Value="#38BDF8" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="🛡️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Shield Token 2 -->
                                        <Border Width="28" Height="28" CornerRadius="6" Margin="0,0,5,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1E1C28" />
                                                    <Setter Property="BorderBrush" Value="#374151" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tokens, ConverterParameter=2}" Value="2">
                                                            <Setter Property="Background" Value="#0284C7" />
                                                            <Setter Property="BorderBrush" Value="#38BDF8" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Tokens, ConverterParameter=3}" Value="3">
                                                            <Setter Property="Background" Value="#0284C7" />
                                                            <Setter Property="BorderBrush" Value="#38BDF8" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="🛡️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Shield Token 3 -->
                                        <Border Width="28" Height="28" CornerRadius="6" Margin="0,0,5,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1E1C28" />
                                                    <Setter Property="BorderBrush" Value="#374151" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tokens, ConverterParameter=3}" Value="3">
                                                            <Setter Property="Background" Value="#0284C7" />
                                                            <Setter Property="BorderBrush" Value="#38BDF8" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="🛡️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Column 2: Streak Meter (5 Blocks) -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="STREAK METER" FontSize="9" FontWeight="Bold" Foreground="#9CA3AF" />
                                        <TextBlock Text="{Binding StreakCount, StringFormat=' ({0})'}" FontSize="9" Foreground="#38BDF8" FontWeight="Bold" Margin="4,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Block 1 -->
                                        <Border Width="26" Height="14" CornerRadius="3" Margin="0,0,4,0" Background="#1E1C28" BorderBrush="#374151" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StreakMeterProgress}" Value="1"><Setter Property="Background" Value="#10B981" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding StreakMeterProgress}" Value="2"><Setter Property="Background" Value="#10B981" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding StreakMeterProgress}" Value="3"><Setter Property="Background" Value="#10B981" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding StreakMeterProgress}" Value="4"><Setter Property="Background" Value="#10B981" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding StreakMeterProgress}" Value="5"><Setter Property="Background" Value="#10B981" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <!-- Block 2 -->
                                        <Border Width="26" Height="14" CornerRadius="3" Margin="0,0,4,0" Background="#1E1C28" BorderBrush="#374151" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StreakMeterProgress}" Value="2"><Setter Property="Background" Value="#10B981" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding StreakMeterProgress}" Value="3"><Setter Property="Background" Value="#10B981" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding StreakMeterProgress}" Value="4"><Setter Property="Background" Value="#10B981" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding StreakMeterProgress}" Value="5"><Setter Property="Background" Value="#10B981" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <!-- Block 3 -->
                                        <Border Width="26" Height="14" CornerRadius="3" Margin="0,0,4,0" Background="#1E1C28" BorderBrush="#374151" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StreakMeterProgress}" Value="3"><Setter Property="Background" Value="#10B981" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding StreakMeterProgress}" Value="4"><Setter Property="Background" Value="#10B981" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding StreakMeterProgress}" Value="5"><Setter Property="Background" Value="#10B981" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <!-- Block 4 -->
                                        <Border Width="26" Height="14" CornerRadius="3" Margin="0,0,4,0" Background="#1E1C28" BorderBrush="#374151" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StreakMeterProgress}" Value="4"><Setter Property="Background" Value="#10B981" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding StreakMeterProgress}" Value="5"><Setter Property="Background" Value="#10B981" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <!-- Block 5 -->
                                        <Border Width="26" Height="14" CornerRadius="3" Margin="0,0,4,0" Background="#1E1C28" BorderBrush="#374151" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StreakMeterProgress}" Value="5"><Setter Property="Background" Value="#F59E0B" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Column 3: Score Display -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="SCORE" FontSize="9" FontWeight="Bold" Foreground="#9CA3AF" />
                                    <TextBlock Text="{Binding Score}" FontSize="24" FontWeight="Bold" Foreground="#FBBF24" />
                                </StackPanel>

                                <!-- Column 4: Quick Host Controls -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button ToolTip="Award Shield Token (+🛡️)"
                                            Width="32" Height="32"
                                            Background="#1E293B"
                                            BorderThickness="0"
                                            Margin="0,0,4,0"
                                            Command="{Binding DataContext.AwardTokenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand">
                                        <TextBlock Text="🛡️+" FontSize="11" Foreground="#38BDF8" FontWeight="Bold" />
                                    </Button>

                                    <Button ToolTip="Add Strike (+X)"
                                            Width="32" Height="32"
                                            Background="#3B1219"
                                            BorderThickness="0"
                                            Margin="0,0,4,0"
                                            Command="{Binding DataContext.AddStrikeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand">
                                        <TextBlock Text="❌" FontSize="11" Foreground="#EF4444" FontWeight="Bold" />
                                    </Button>

                                    <Button ToolTip="Reset Strikes"
                                            Width="32" Height="32"
                                            Background="#1E293B"
                                            BorderThickness="0"
                                            Margin="0,0,4,0"
                                            Command="{Binding DataContext.ResetStrikesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand">
                                        <TextBlock Text="🔄" FontSize="11" Foreground="#9CA3AF" />
                                    </Button>

                                    <Button ToolTip="Remove Player"
                                            Width="32" Height="32"
                                            Background="#2D1515"
                                            BorderThickness="0"
                                            Command="{Binding DataContext.RemovePlayerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand">
                                        <ui:SymbolIcon Symbol="Delete24" Foreground="#EF4444" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
