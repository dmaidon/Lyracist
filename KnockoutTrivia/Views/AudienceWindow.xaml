<!-- Created on Aug 27, 2026 @ 15:26:45 -> AudienceWindow.xaml for dedicated secondary monitor and TV projection -->
<Window x:Class="KnockoutTrivia.Views.AudienceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Knockout Trivia — Audience Big Screen"
        Height="720" Width="1280"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        Background="#07060A"
        Foreground="#F3F4F6"
        KeyDown="OnWindowKeyDown">

    <Grid>
        <!-- 16:9 Scaled Audience Content Canvas -->
        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="1920" Height="1080" Background="#0B0A0E">
                <ContentControl Content="{Binding CurrentView}" />
            </Border>
        </Viewbox>

        <!-- Subtle Top Hover Controls for DJ Window Management -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Opacity="0.15">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1.0" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal" Background="#20000000">
                <Button Width="36" Height="28" Background="#33000000" BorderThickness="0" Click="OnMinimizeClick" Cursor="Hand" ToolTip="Minimize">
                    <ui:SymbolIcon Symbol="Subtract16" Foreground="#9CA3AF" />
                </Button>
                <Button Width="36" Height="28" Background="#33000000" BorderThickness="0" Click="OnToggleFullscreenClick" Cursor="Hand" ToolTip="Toggle Fullscreen">
                    <ui:SymbolIcon Symbol="Maximize16" Foreground="#9CA3AF" />
                </Button>
                <Button Width="36" Height="28" Background="#66EF4444" BorderThickness="0" Click="OnCloseClick" Cursor="Hand" ToolTip="Close Display Window">
                    <ui:SymbolIcon Symbol="Dismiss16" Foreground="White" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
