<!-- Edited on Aug 27, 2026 @ 15:20:25 -> Added Shuffle Deck button to Host Live Question Console -->
<UserControl x:Class="KnockoutTrivia.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:KnockoutTrivia.Models"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="#0B0A0E">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <!-- Left: Current Question & Reveal Console -->
            <ColumnDefinition Width="1.1*" />
            <!-- Right: Active Player Adjudication Cards -->
            <ColumnDefinition Width="0.9*" />
        </Grid.ColumnDefinitions>

        <!-- Left Column: Active Question Overview & Host Controls -->
        <Border Grid.Column="0" Background="#14121F" CornerRadius="16" BorderBrush="#28233A" BorderThickness="1.5" Padding="25" Margin="0,0,15,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="Auto" />
                    <!-- Prompt -->
                    <RowDefinition Height="*" />
                    <!-- Options List -->
                    <RowDefinition Height="Auto" />
                    <!-- Revealed Answer -->
                    <RowDefinition Height="Auto" />
                    <!-- Host Actions -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

<!-- Edited on Aug 28, 2026 @ 09:30:00 -> Added real-time countdown timer and mobile responses counter to Live Question Console -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="LIVE QUESTION CONSOLE" FontSize="16" FontWeight="Black" Foreground="#10B981" />
                        <TextBlock Text="{Binding GameState.CurrentQuestion.Category, StringFormat='Category: {0}'}" FontSize="12" Foreground="#9CA3AF" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Submissions Count Badge -->
                        <Border Background="#1E192E" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                            <TextBlock Text="{Binding GameState.AnsweredCount, StringFormat='📱 {0} Locked In'}" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" />
                        </Border>
                        <!-- Timer Badge -->
                        <Border Background="#1E281F" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                            <TextBlock Text="{Binding GameState.SecondsRemaining, StringFormat='⏱️ {0}s'}" FontWeight="Bold" FontSize="11" Foreground="#34D399" />
                        </Border>
                        <!-- Question # Badge -->
                        <Border Background="#261E38" CornerRadius="6" Padding="10,4">
                            <TextBlock Text="{Binding GameState.CurrentQuestionIndex, StringFormat='Q #{0}'}" FontWeight="Bold" Foreground="#F59E0B" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Prompt Card -->
                <Border Grid.Row="1" Background="#1B1729" CornerRadius="10" Padding="20" Margin="0,0,0,15" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GameState.CurrentQuestion.Prompt}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </Border>

                <!-- Option choices -->
                <ItemsControl Grid.Row="2" ItemsSource="{Binding GameState.CurrentQuestion.Options}" Margin="0,0,0,15">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" Background="#221C34" CornerRadius="6" Padding="12,8">
                                <TextBlock Text="{Binding}" FontSize="14" Foreground="#E5E7EB" FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Revealed Answer Banner -->
                <Border Grid.Row="3" Background="#0F2D1F" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="8" Padding="12,8" Margin="0,0,0,15">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GameState.IsAnswerRevealed}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding GameState.CurrentQuestion.CorrectAnswerText, StringFormat='Correct: {0}'}"
                               FontWeight="Bold" Foreground="#34D399" FontSize="14" HorizontalAlignment="Center" />
                </Border>

                <!-- Controls -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:Button Content="Reveal Answer"
                               Height="40"
                               Width="140"
                               Margin="0,0,10,0"
                               Appearance="Primary"
                               Background="#10B981"
                               Foreground="White"
                               Command="{Binding RevealAnswerCommand}"
                               Cursor="Hand" />

                    <ui:Button Content="Next Question ▶"
                               Height="40"
                               Width="140"
                               Margin="0,0,10,0"
                               Appearance="Primary"
                               Background="#3B82F6"
                               Foreground="White"
                               Command="{Binding NextQuestionCommand}"
                               Cursor="Hand" />

                    <ui:Button Content="🔀 Shuffle"
                               Height="40"
                               Width="100"
                               Margin="0,0,10,0"
                               Appearance="Secondary"
                               Command="{Binding ShuffleQuestionsCommand}"
                               Cursor="Hand" />

                    <ui:Button Content="Reset Game"
                               Height="40"
                               Width="105"
                               Appearance="Secondary"
                               Command="{Binding ResetGameCommand}"
                               Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right Column: Fast Player Response Adjudication -->
        <Border Grid.Column="1" Background="#14121F" CornerRadius="16" BorderBrush="#28233A" BorderThickness="1.5" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="PLAYER ADJUDICATION" FontSize="16" FontWeight="Black" Foreground="#F59E0B" />
                    <TextBlock Text="Mark correct (+Pts, +Streak) or wrong (absorb Shield or +Strike)." FontSize="11" Foreground="#9CA3AF" />
                </StackPanel>

                <!-- Player List with Quick Action Buttons -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Players}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:KnockoutPlayer}">
                                <Border Margin="0,0,0,10" Background="#1C182A" CornerRadius="10" Padding="12,10" BorderBrush="{Binding StrikeColorBrush}" BorderThickness="1.5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Player Info -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="White" />
                                                <TextBlock Text="{Binding Tokens, StringFormat=' [{0} 🛡️]'}" FontSize="12" Foreground="#38BDF8" FontWeight="Bold" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding Score, StringFormat='Score: {0}'}" FontSize="11" Foreground="#FBBF24" FontWeight="SemiBold" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold" Foreground="{Binding StrikeColorBrush}" />
                                                <TextBlock Text="{Binding StreakCount, StringFormat=' • Streak: {0}'}" FontSize="11" Foreground="#A78BFA" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Quick Correct / Wrong Buttons -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button ToolTip="Mark Answer Correct"
                                                    Width="38" Height="38"
                                                    Background="#059669"
                                                    BorderThickness="0"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding DataContext.MarkCorrectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand">
                                                <TextBlock Text="✓" FontSize="18" FontWeight="Black" Foreground="White" />
                                            </Button>

                                            <Button ToolTip="Mark Answer Wrong (Shield/Strike)"
                                                    Width="38" Height="38"
                                                    Background="#DC2626"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.MarkIncorrectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand">
                                                <TextBlock Text="✗" FontSize="18" FontWeight="Black" Foreground="White" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Quick Add Player Bar -->
                <Grid Grid.Row="2" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0"
                                Text="{Binding QuickPlayerName, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Add player..."
                                Height="36"
                                Margin="0,0,8,0"
                                Background="#1C182A"
                                BorderBrush="#352F4B" />
                    <ui:Button Grid.Column="1"
                               Content="+ Add"
                               Height="36"
                               Appearance="Primary"
                               Background="#10B981"
                               Foreground="White"
                               Command="{Binding AddPlayerCommand}"
                               Cursor="Hand" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
