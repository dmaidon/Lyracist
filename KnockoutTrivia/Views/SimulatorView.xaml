<!-- Created on Aug 29, 2026 @ 10:45:30 -> SimulatorView.xaml presenting in-app DJ bot simulation, load testing, and diagnostics -->
<UserControl x:Class="KnockoutTrivia.Views.SimulatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewmodels="clr-namespace:KnockoutTrivia.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="#0B0A0E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Top Header & Metrics -->
            <RowDefinition Height="Auto" />
            <!-- Main Content: Left Controls + Right Live Console -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Live Metrics -->
        <Border Grid.Row="0" Background="#14121F" CornerRadius="12" Padding="16,12" Margin="0,0,0,16" BorderBrush="#262238" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🧪 DJ GAME SIMULATOR &amp; DIAGNOSTICS" FontSize="18" FontWeight="Black" Foreground="#8B5CF6" />
                        <Border Background="#1E192E" CornerRadius="6" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveBotsCount, StringFormat='{}{0} Bots Active'}" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" />
                        </Border>
                        <Border Background="#1E192E" CornerRadius="6" Padding="10,3" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalPlayersCount, StringFormat='{}{0} Total Players'}" FontWeight="Bold" FontSize="12" Foreground="#10B981" />
                        </Border>
                        <Border Background="#2E1B1B" CornerRadius="6" Padding="10,3" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentPhaseText, StringFormat='Phase: {0}'}" FontWeight="Bold" FontSize="12" Foreground="#F59E0B" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Simulate virtual mobile players, test answer submissions with human delays, and rehearse full game flows without physical phones."
                               FontSize="11" Foreground="#9CA3AF" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="⏩ Fast-Forward Step"
                               Height="36"
                               Padding="14,0"
                               Margin="0,0,8,0"
                               Command="{Binding FastForwardCommand}" />
                    <ui:Button Content="⚡ Trigger Super Streak"
                               Appearance="Secondary"
                               Height="36"
                               Padding="14,0"
                               Command="{Binding TriggerSuperStreakCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area: Left Control Columns + Right Diagnostic Terminal -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Controls Panel (Left) -->
                <ColumnDefinition Width="420" />
                <!-- Terminal Console (Right) -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT CONTROLS PANEL -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                <StackPanel>
                    <!-- Group 1: Bot Player Management -->
                    <Border Background="#14121F" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="#262238" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🤖 BOT PLAYER MANAGEMENT" FontSize="13" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,12" />
                            
                            <!-- Slider: Bots Count -->
                            <TextBlock Text="{Binding BotCountToSpawn, StringFormat='Bots to Spawn: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" />
                            <Slider Minimum="1" Maximum="30" Value="{Binding BotCountToSpawn, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Content="➕ Spawn Bots" Appearance="Primary" Height="36" Margin="0,0,6,0" Command="{Binding SpawnBotsCommand}" HorizontalAlignment="Stretch" />
                                <ui:Button Grid.Column="1" Content="🧹 Clear Bots" Appearance="Danger" Height="36" Margin="6,0,0,0" Command="{Binding ClearBotsCommand}" HorizontalAlignment="Stretch" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Group 2: Answer Simulation & Auto-Play -->
                    <Border Background="#14121F" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="#262238" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="⚡ ANSWER SIMULATION &amp; AUTO-PLAY" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,12" />

                            <!-- Accuracy Rate Slider -->
                            <TextBlock Text="{Binding AccuracyRate, StringFormat='Bot Correct Accuracy: {0}%'}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" />
                            <Slider Minimum="0" Maximum="100" Value="{Binding AccuracyRate, Mode=TwoWay}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,6,0,12" />

                            <!-- Auto-Play Toggle -->
                            <Border Background="#1E192E" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" BorderBrush="#352F4F" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Auto-Answer Every Question" FontWeight="Bold" FontSize="12" Foreground="#F8FAFC" />
                                        <TextBlock Text="Bots automatically submit answers each round with human-like delays." FontSize="10" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsAutoPlayEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </Border>

                            <ui:Button Content="▶ Simulate Answers for Current Question" Appearance="Secondary" Height="38" Command="{Binding SimulateAnswersCommand}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <!-- Group 3: Rehearsal & Feature Triggers -->
                    <Border Background="#14121F" CornerRadius="12" Padding="16" BorderBrush="#262238" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🎯 FEATURE &amp; WHEEL REHEARSAL" FontSize="13" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,12" />
                            <TextBlock Text="Force game events to verify audience projection and scoreboard animations:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10" />

                            <ui:Button Content="🎡 Trigger Super Streak Wheel (Set Bot to 20)" Height="36" Margin="0,0,0,8" Command="{Binding TriggerSuperStreakCommand}" HorizontalAlignment="Stretch" />
                            <ui:Button Content="⏩ Step Game Phase / Reveal Answer" Height="36" Command="{Binding FastForwardCommand}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT LIVE ACTIVITY TERMINAL -->
            <Border Grid.Column="1" Background="#0F0E17" CornerRadius="12" Padding="16" BorderBrush="#262238" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📊 LIVE SIMULATION ACTIVITY LOG" FontSize="13" FontWeight="Bold" Foreground="#E2E8F0" />
                            <TextBlock Text=" (Most recent first)" FontSize="11" Foreground="#64748B" Margin="4,2,0,0" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="Clear Log" Height="28" Padding="10,0" Command="{Binding ClearLogsCommand}" />
                    </Grid>

                    <!-- Log Items -->
                    <Border Grid.Row="1" Background="#08070D" BorderBrush="#1F1D2B" BorderThickness="1" CornerRadius="8" Padding="4">
                        <ListBox ItemsSource="{Binding ActivityLogs}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="4"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontFamily="Consolas, Cascadia Code, Courier New"
                                               FontSize="11"
                                               Foreground="#A7F3D0"
                                               TextWrapping="Wrap"
                                               Margin="0,2" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
