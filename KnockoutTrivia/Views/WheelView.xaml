<!-- Created on Aug 27, 2026 @ 14:37:35 -> WheelView for Scaryoke-style Super Streak target rotary wheel -->
<UserControl x:Class="KnockoutTrivia.Views.WheelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="950"
             Background="#0B0A0E">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <!-- Left: Rotary Wheel -->
            <ColumnDefinition Width="1.2*" />
            <!-- Right: Status, Results, and Action Controls -->
            <ColumnDefinition Width="0.8*" />
        </Grid.ColumnDefinitions>

        <!-- Left: Rotary Wheel Viewbox -->
        <Viewbox Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15">
            <Grid Width="500" Height="500">
                <!-- Outer Glow Ring -->
                <Ellipse Width="500" Height="500" Fill="#07060A" Stroke="#8B5CF6" StrokeThickness="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#8B5CF6" BlurRadius="30" ShadowDepth="0" Opacity="0.6" />
                    </Ellipse.Effect>
                </Ellipse>

                <!-- Rotating Canvas for Wheel Wedges -->
                <Canvas x:Name="WheelCanvas" Width="480" Height="480" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform Angle="{Binding WheelAngle}" CenterX="240" CenterY="240" />
                    </Canvas.RenderTransform>
                </Canvas>

                <!-- Pointer Arrow at 12 O'Clock -->
                <Polygon Points="0,24 -16,-10 16,-10" Fill="#F59E0B" Stroke="#FBBF24" StrokeThickness="3" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-6,0,0">
                    <Polygon.Effect>
                        <DropShadowEffect Color="#F59E0B" BlurRadius="12" ShadowDepth="0" />
                    </Polygon.Effect>
                </Polygon>

                <!-- Central Cap with Lightning Icon -->
                <Ellipse Width="70" Height="70" Fill="#161224" Stroke="#F59E0B" StrokeThickness="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#F59E0B" BlurRadius="15" ShadowDepth="0" />
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock Text="⚡" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FBBF24" />
            </Grid>
        </Viewbox>

        <!-- Right: Challenge Info & Spin Actions -->
        <Border Grid.Column="1" Background="#14121F" CornerRadius="16" BorderBrush="#2C273E" BorderThickness="2" Padding="25" Margin="10,15,10,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="{Binding StatusHeader}"
                               FontSize="20" FontWeight="Black" Foreground="#8B5CF6" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="Spin to randomly target a shield from an opponent!"
                               FontSize="13" Foreground="#9CA3AF" TextAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Live Results Callout Card -->
                <Border Grid.Row="1" Background="#1A1728" CornerRadius="12" BorderBrush="#3A3352" BorderThickness="1.5" Padding="20" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="TARGET RESULT" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding ResultText}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#34D399"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" />
                        
                        <Border Margin="0,15,0,0" Padding="10,6" Background="#261E38" CornerRadius="6" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Segments.Count, StringFormat='{}{0} Targetable Opponents'}" FontSize="12" Foreground="#C4B5FD" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Actions: Spin & Refresh -->
                <StackPanel Grid.Row="2" Margin="0,20,0,0">
                    <ui:Button Content="SPIN THE WHEEL ⚡"
                               FontSize="18"
                               FontWeight="Black"
                               Height="58"
                               Appearance="Primary"
                               Background="#8B5CF6"
                               Foreground="White"
                               Command="{Binding SpinWheelCommand}"
                               IsEnabled="{Binding IsSpinning, Converter={x:Null}}"
                               Cursor="Hand"
                               Margin="0,0,0,10">
                        <ui:Button.Effect>
                            <DropShadowEffect Color="#8B5CF6" BlurRadius="16" ShadowDepth="0" Opacity="0.5" />
                        </ui:Button.Effect>
                    </ui:Button>

                    <ui:Button Content="Reload Segments"
                               Height="36"
                               Appearance="Secondary"
                               Command="{Binding RefreshSegmentsCommand}"
                               Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
