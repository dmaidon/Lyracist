<!-- Created on Aug 27, 2026 @ 14:37:45 -> BannerView presenting 16:9 auto-scaling dynamic and static event banners -->
<UserControl x:Class="KnockoutTrivia.Views.BannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="950"
             Background="#0B0A0E">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- 16:9 Auto-scaling Canvas Preview -->
            <RowDefinition Height="*" />
            <!-- Controls & Banner Selector Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 16:9 Auto-Scaling Canvas Screen -->
        <Border Grid.Row="0" Background="Black" CornerRadius="12" BorderBrush="#252136" BorderThickness="2" Margin="0,0,0,15">
            <Viewbox Stretch="Uniform">
                <!-- 16:9 Logical Canvas (1920x1080) -->
                <Grid Width="1920" Height="1080" Background="#0C0A14">
                    <!-- Background Glow & Particle Gradients -->
                    <Rectangle Width="1920" Height="1080">
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.7" RadiusY="0.7">
                                <GradientStop Color="#2B1A4A" Offset="0" />
                                <GradientStop Color="#0D0B18" Offset="0.6" />
                                <GradientStop Color="#05040A" Offset="1" />
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Content Layout -->
                    <Grid Margin="120,80">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Official Knockout Trivia Logo (Top Center) -->
                        <Image Grid.Row="0"
                               Source="{StaticResource KnockoutLogo}"
                               Height="220"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Effect>
                                <DropShadowEffect Color="#10B981" BlurRadius="40" ShadowDepth="0" Opacity="0.7" />
                            </Image.Effect>
                        </Image>

                        <!-- Center Dynamic Banner Messaging -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- Main Title -->
                            <TextBlock Text="{Binding CurrentBanner.Title}"
                                       FontSize="72"
                                       FontWeight="Black"
                                       Foreground="#FBBF24"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#F59E0B" BlurRadius="25" ShadowDepth="0" Opacity="0.8" />
                                </TextBlock.Effect>
                            </TextBlock>

                            <!-- Subtitle -->
                            <TextBlock Text="{Binding CurrentBanner.Subtitle}"
                                       FontSize="40"
                                       FontWeight="Bold"
                                       Foreground="#F3F4F6"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="0,20,0,0"
                                       TextWrapping="Wrap" />

                            <!-- Detail Message -->
                            <TextBlock Text="{Binding CurrentBanner.DetailText}"
                                       FontSize="28"
                                       FontWeight="Medium"
                                       Foreground="#9CA3AF"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="0,15,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Bottom Tagline / Branding -->
                        <Border Grid.Row="2" Background="#161224" CornerRadius="30" Padding="40,14" HorizontalAlignment="Center" BorderBrush="#352B52" BorderThickness="2">
                            <TextBlock Text="KNOCKOUT TRIVIA • PAROLE SOFTWARE"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#10B981" />
                        </Border>
                    </Grid>
                </Grid>
            </Viewbox>
        </Border>

        <!-- Banner Selection Toolbar -->
        <Border Grid.Row="1" Background="#14121F" CornerRadius="10" Padding="15,10" BorderBrush="#252136" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Preview Presets:" VerticalAlignment="Center" Foreground="#9CA3AF" FontWeight="SemiBold" Margin="0,0,15,0" />

                <ui:Button Content="Intro Screen"
                           Margin="0,0,8,0"
                           Appearance="Primary"
                           Background="#10B981"
                           Command="{Binding ShowIntroCommand}"
                           Cursor="Hand" />

                <ui:Button Content="Intermission"
                           Margin="0,0,8,0"
                           Appearance="Primary"
                           Background="#3B82F6"
                           Command="{Binding ShowIntermissionCommand}"
                           Cursor="Hand" />

                <ui:Button Content="Winner Celebration"
                           Margin="0,0,8,0"
                           Appearance="Primary"
                           Background="#F59E0B"
                           Command="{Binding ShowWinnerCommand}"
                           Cursor="Hand" />

                <ui:Button Content="Super Streak Alert"
                           Appearance="Primary"
                           Background="#8B5CF6"
                           Command="{Binding ShowSuperStreakCommand}"
                           Cursor="Hand" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
