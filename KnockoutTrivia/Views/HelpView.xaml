<!-- Created on Aug 27, 2026 @ 15:08:05 -> HelpView split-pane layout for DJ rules, game mechanics, and settings guide -->
<UserControl x:Class="KnockoutTrivia.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:KnockoutTrivia.Models"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1050"
             Background="#0B0A0E">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- Top Header -->
            <RowDefinition Height="Auto" />
            <!-- Main Split-Pane Content -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#14121F" CornerRadius="10" Padding="15,12" Margin="0,0,0,12" BorderBrush="#252136" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="❓ KNOCKOUT TRIVIA — DJ &amp; HOST GUIDE" FontSize="18" FontWeight="Black" Foreground="#10B981" />
                    <TextBlock Text="Comprehensive game rules, shield token mechanics, Super Streak wheel guides, and settings references."
                               FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#1F1B2E" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Text="HOST REFERENCE" FontSize="10" FontWeight="Bold" Foreground="#A78BFA" />
                </Border>
            </Grid>
        </Border>

        <!-- Split-Pane: Topic Selector (Left) + Resizable Splitter + Detail Viewer (Right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left: Topic Index -->
                <ColumnDefinition Width="300" MinWidth="220" />
                <!-- Splitter -->
                <ColumnDefinition Width="6" />
                <!-- Right: Topic Details -->
                <ColumnDefinition Width="*" MinWidth="350" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Topic List -->
            <Border Grid.Column="0" Background="#14121F" CornerRadius="10" BorderBrush="#262238" BorderThickness="1" Padding="10">
                <ListBox ItemsSource="{Binding HelpTopics}"
                         SelectedItem="{Binding SelectedTopic, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="10,10" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#221C34" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#1A1528" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:HelpTopic}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="{Binding AccentColor}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" />

            <!-- RIGHT: Topic Details Panel -->
            <Border Grid.Column="2" Background="#14121F" CornerRadius="10" BorderBrush="#262238" BorderThickness="1" Padding="25">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Topic Header Banner -->
                        <Border Background="#1C182B" CornerRadius="8" Padding="15,12" Margin="0,0,0,15" BorderBrush="#352F4A" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedTopic.Title}" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" />
                                <TextBlock Text="{Binding SelectedTopic.DescriptionHeader}" FontSize="20" FontWeight="Black" Foreground="White" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Topic Content Body -->
                        <Border Background="#181524" CornerRadius="8" Padding="20" BorderBrush="#2C263D" BorderThickness="1">
                            <TextBlock Text="{Binding SelectedTopic.DescriptionContent}"
                                       FontSize="14"
                                       Foreground="#E5E7EB"
                                       TextWrapping="Wrap"
                                       LineHeight="24" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
