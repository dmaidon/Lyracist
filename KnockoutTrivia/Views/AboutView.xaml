<!-- Created on Aug 27, 2026 @ 14:38:05 -> AboutView presenting official Knockout Trivia branding, logo, company information, and shared DB note -->
<UserControl x:Class="KnockoutTrivia.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850"
             Background="#0B0A0E">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
        <Border Background="#14121F" CornerRadius="16" BorderBrush="#2F2942" BorderThickness="2" Padding="40" MaxWidth="680">
            <StackPanel HorizontalAlignment="Center">
                <!-- Official Knockout Trivia Logo -->
                <Image Source="{StaticResource KnockoutLogo}"
                       Height="160"
                       HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Margin="0,0,0,20">
                    <Image.Effect>
                        <DropShadowEffect Color="#10B981" BlurRadius="25" ShadowDepth="0" Opacity="0.6" />
                    </Image.Effect>
                </Image>

                <!-- Title & Company -->
                <TextBlock Text="{Binding AppName}" FontSize="28" FontWeight="Black" Foreground="#10B981" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Company}" FontSize="15" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,2,0,15" />

                <Separator Background="#2F2942" Margin="0,0,0,15" />

                <!-- Description -->
                <TextBlock Text="{Binding Description}"
                           FontSize="14"
                           Foreground="#E5E7EB"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           LineHeight="22"
                           Margin="0,0,0,15" />

                <!-- Database Compatibility Note -->
                <Border Background="#1A1528" CornerRadius="8" Padding="15,10" BorderBrush="#8B5CF6" BorderThickness="1" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="🔄 Database Compatibility" FontWeight="Bold" Foreground="#A78BFA" FontSize="12" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding DatabaseNotice}" FontSize="12" Foreground="#D1D5DB" TextWrapping="Wrap" LineHeight="18" />
                    </StackPanel>
                </Border>

                <!-- Copyright -->
                <TextBlock Text="{Binding Copyright}" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
