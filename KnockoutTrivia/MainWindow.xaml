<Window x:Class="KnockoutTrivia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Knockout Trivia"
        Height="820" Width="1200"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#0B0A0E"
        Foreground="White"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderBrush="#252136"
        BorderThickness="1">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Title Bar -->
            <RowDefinition Height="44" />
            <!-- Top Navigation Tab Bar -->
            <RowDefinition Height="52" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Custom Fluent Title Bar -->
        <Border Grid.Row="0" Background="#13111C" BorderBrush="#252136" BorderThickness="0,0,0,1" MouseDown="OnTitleBarMouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Branding: Small Knockout Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="{StaticResource KnockoutLogo}" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="KNOCKOUT TRIVIA" FontWeight="Black" FontSize="14" Foreground="#10B981" VerticalAlignment="Center" />
                    <Border Background="#1E192E" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="HOST EDITION" FontSize="10" FontWeight="Bold" Foreground="#A78BFA" />
                    </Border>
                </StackPanel>

                <!-- Center Active Tab Indicator -->
                <TextBlock Grid.Column="1" Text="{Binding ActiveTabTitle}" FontSize="13" Foreground="#9CA3AF" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- Right Window Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Height="28" Margin="0,0,12,0" Padding="10,0"
                            Command="{Binding ToggleAudienceDisplayCommand}"
                            Cursor="Hand"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#1E293B" />
                                <Setter Property="BorderBrush" Value="#334155" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="#38BDF8" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="Content" Value="📺 Audience Screen" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAudienceDisplayOpen}" Value="True">
                                        <Setter Property="Background" Value="#7F1D1D" />
                                        <Setter Property="BorderBrush" Value="#DC2626" />
                                        <Setter Property="Foreground" Value="#FCA5A5" />
                                        <Setter Property="Content" Value="🛑 Screen Active" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Width="46" Height="44" Background="Transparent" BorderThickness="0" Click="OnMinimizeClick" Cursor="Hand">
                        <ui:SymbolIcon Symbol="Subtract24" Foreground="#9CA3AF" />
                    </Button>
                    <Button Width="46" Height="44" Background="Transparent" BorderThickness="0" Click="OnMaximizeClick" Cursor="Hand">
                        <ui:SymbolIcon Symbol="Maximize24" Foreground="#9CA3AF" />
                    </Button>
                    <Button Width="46" Height="44" Background="Transparent" BorderThickness="0" Click="OnCloseClick" Cursor="Hand">
                        <ui:SymbolIcon Symbol="Dismiss24" Foreground="#EF4444" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

<!-- Edited on Aug 28, 2026 @ 09:24:00 -> Added Player Connect navigation tab to MainWindow.xaml -->
        <!-- ROW 1: Modern Navigation Tab Bar -->
        <Border Grid.Row="1" Background="#161421" BorderBrush="#252136" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <RadioButton Content="📱 Player Connect"
                             Style="{StaticResource {x:Type ToggleButton}}"
                             Command="{Binding NavigateToConnectCommand}"
                             IsChecked="True"
                             Margin="4,0" Padding="14,8"
                             FontWeight="SemiBold" FontSize="13"
                             Cursor="Hand" />

                <RadioButton Content="🎮 Game Host"
                             Style="{StaticResource {x:Type ToggleButton}}"
                             Command="{Binding NavigateToGameCommand}"
                             Margin="4,0" Padding="14,8"
                             FontWeight="SemiBold" FontSize="13"
                             Cursor="Hand" />

                <RadioButton Content="📊 Scoreboard"
                             Style="{StaticResource {x:Type ToggleButton}}"
                             Command="{Binding NavigateToScoreboardCommand}"
                             Margin="4,0" Padding="14,8"
                             FontWeight="SemiBold" FontSize="13"
                             Cursor="Hand" />

                <RadioButton Content="❓ Question Board"
                             Style="{StaticResource {x:Type ToggleButton}}"
                             Command="{Binding NavigateToQuestionCommand}"
                             Margin="4,0" Padding="14,8"
                             FontWeight="SemiBold" FontSize="13"
                             Cursor="Hand" />

                <RadioButton Content="⚡ Super Streak Wheel"
                             Style="{StaticResource {x:Type ToggleButton}}"
                             Command="{Binding NavigateToWheelCommand}"
                             Margin="4,0" Padding="14,8"
                             FontWeight="SemiBold" FontSize="13"
                             Cursor="Hand" />

                <RadioButton Content="📺 Banners &amp; Screens"
                             Style="{StaticResource {x:Type ToggleButton}}"
                             Command="{Binding NavigateToBannersCommand}"
                             Margin="4,0" Padding="14,8"
                             FontWeight="SemiBold" FontSize="13"
                             Cursor="Hand" />

                <RadioButton Content="⚙️ Settings"
                             Style="{StaticResource {x:Type ToggleButton}}"
                             Command="{Binding NavigateToSettingsCommand}"
                             Margin="4,0" Padding="14,8"
                             FontWeight="SemiBold" FontSize="13"
                             Cursor="Hand" />

                <RadioButton Content="❓ Help &amp; Rules"
                             Style="{StaticResource {x:Type ToggleButton}}"
                             Command="{Binding NavigateToHelpCommand}"
                             Margin="4,0" Padding="14,8"
                             FontWeight="SemiBold" FontSize="13"
                             Cursor="Hand" />

                <RadioButton Content="ℹ️ About"
                             Style="{StaticResource {x:Type ToggleButton}}"
                             Command="{Binding NavigateToAboutCommand}"
                             Margin="4,0" Padding="14,8"
                             FontWeight="SemiBold" FontSize="13"
                             Cursor="Hand" />
            </StackPanel>
        </Border>

        <!-- ROW 2: Main Dynamic Content Area -->
        <ContentControl Grid.Row="2" Content="{Binding CurrentView}" />

        <!-- ROW 3: Bottom Status Bar -->
        <Border Grid.Row="3" Background="#110F18" BorderBrush="#201C2E" BorderThickness="0,1,0,0" Padding="15,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="●" FontSize="10" Foreground="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusNotification}" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Knockout Trivia v26.8 • PAROLE Software" FontSize="11" Foreground="#6B7280" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
