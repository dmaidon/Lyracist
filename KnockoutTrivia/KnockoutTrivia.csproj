<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Company>PAROLE Software</Company>
    <Copyright>Copyright © 2026 PAROLE Software</Copyright>
    <Title>Knockout Trivia</Title>
    <NeutralLanguage>en-US</NeutralLanguage>
    <AssemblyVersion>26.8.28.2</AssemblyVersion>
    <FileVersion>26.8.28.2</FileVersion>
    <Authors>Dennis N. Maidon</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="KoTrivia\Assets\kotrv_logo.png" />
    <Resource Include="KoTrivia\Assets\kotrv_logo.webp" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\knockout.html" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="KoTrivia\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Globals.cs" Link="Shared\Globals.cs" />
    <Compile Include="..\Shared\MonitorInfo.cs" Link="Shared\MonitorInfo.cs" />
    <Compile Include="..\Shared\TextBoxSelectionHelper.cs" Link="Shared\TextBoxSelectionHelper.cs" />
    <Compile Include="..\Shared\NameFormatting.cs" Link="Shared\NameFormatting.cs" />
    <Compile Include="..\Shared\LocalNetworkHelper.cs" Link="Shared\LocalNetworkHelper.cs" />
    <Compile Include="..\Shared\WifiHelper.cs" Link="Shared\WifiHelper.cs" />
    <Compile Include="..\Shared\WifiPasswordStore.cs" Link="Shared\WifiPasswordStore.cs" />
    <Compile Include="..\Shared\AtomicJsonFile.cs" Link="Shared\AtomicJsonFile.cs" />
  </ItemGroup>

</Project>
