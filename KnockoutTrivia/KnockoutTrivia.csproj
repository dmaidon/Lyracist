<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Company>PAROLE Software</Company>
    <Copyright>Copyright © 2026 PAROLE Software</Copyright>
    <Title>Knockout Trivia</Title>
    <NeutralLanguage>en-US</NeutralLanguage>
    <AssemblyVersion>26.10.4.70</AssemblyVersion>
    <FileVersion>26.10.4.70</FileVersion>
    <Authors>Dennis N. Maidon</Authors>
    <ApplicationIcon>glove.ico</ApplicationIcon>
    <BaseOutputPath>C:\VB26\Release\Lyracist</BaseOutputPath>
    <PackageIcon>Glove-128.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\kotrv_logo.png" />
    <Resource Include="Assets\kotrv_logo.webp" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\knockout.html" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Packs\**\*">
      <Link>Packs\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Data\**\*">
      <Link>Data\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Globals.cs" Link="Shared\Globals.cs" />
    <Compile Include="..\Shared\MonitorInfo.cs" Link="Shared\MonitorInfo.cs" />
    <Compile Include="..\Shared\MonitorDpiHelper.cs" Link="Shared\MonitorDpiHelper.cs" />
    <Compile Include="..\Shared\MonitorEnumerator.cs" Link="Shared\MonitorEnumerator.cs" />
    <Compile Include="..\Shared\WindowPositioner.cs" Link="Shared\WindowPositioner.cs" />
    <Compile Include="..\Shared\TextBoxSelectionHelper.cs" Link="Shared\TextBoxSelectionHelper.cs" />
    <Compile Include="..\Shared\NameFormatting.cs" Link="Shared\NameFormatting.cs" />
    <Compile Include="..\Shared\LocalNetworkHelper.cs" Link="Shared\LocalNetworkHelper.cs" />
    <Compile Include="..\Shared\WifiHelper.cs" Link="Shared\WifiHelper.cs" />
    <Compile Include="..\Shared\WifiPasswordStore.cs" Link="Shared\WifiPasswordStore.cs" />
    <Compile Include="..\Shared\AtomicJsonFile.cs" Link="Shared\AtomicJsonFile.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="glove.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Glove-128.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>

