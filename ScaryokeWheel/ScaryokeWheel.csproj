<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <BaseOutputPath>C:\VB26\Release\Lyracist</BaseOutputPath>
    <AssemblyVersion>26.9.18.175</AssemblyVersion>
    <FileVersion>26.9.18.175</FileVersion>
    <Authors>Dennis N. Maidon</Authors>
    <Company>PAROLE Software</Company>
    <Copyright>Copyright © 2026 PAROLE Software</Copyright>
    <ApplicationIcon>..\Lyracist\Assets\scaryoke.ico</ApplicationIcon>
