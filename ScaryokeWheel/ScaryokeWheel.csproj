<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <BaseOutputPath>C:\VB26\Release\Lyracist</BaseOutputPath>
    <AssemblyVersion>26.8.13.114</AssemblyVersion>
    <FileVersion>26.8.13.114</FileVersion>
    <ApplicationIcon>..\Lyracist\Assets\scaryoke.ico</ApplicationIcon>
    <PackageIcon>scaryoke.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\*.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Globals.cs" Link="Globals.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Lyracist\Assets\scaryoke.ico" Link="scaryoke.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Lyracist\Assets\scaryoke.png" Link="scaryoke.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
