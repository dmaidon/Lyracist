<!-- Created on Oct 24, 2026 @ 15:35:00 -> Fullscreen audience projection window for secondary display/projector -->
<Window x:Class="ScaryokeWheel.ScaryokeProjectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Scaryoke Audience Display"
        Height="1080" Width="1920"
        WindowStyle="None"
        WindowState="Normal"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Background="#0A0810"
        Foreground="White"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid>
        <Grid.ContextMenu>
            <ContextMenu Background="#1E1A26" Foreground="#FFFFFF" BorderBrush="#332B45" BorderThickness="1">
                <MenuItem Header="✕ Close Audience Screen (Esc)" Click="CloseMenu_Click" FontWeight="Bold" Foreground="#FF5252" />
                <MenuItem Header="🗖 Toggle Fullscreen (F11 / Double-Click)" Click="ToggleFullscreen_Click" Foreground="#FFFFFF" />
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Dynamic Spooky Radial Gradient Background -->
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.85" RadiusY="0.85">
                    <GradientStop Color="#240A38" Offset="0.0" />
                    <GradientStop Color="#12061E" Offset="0.55" />
                    <GradientStop Color="#06040A" Offset="1.0" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Top-Right Floating Close Button -->
        <Button Width="36" Height="36" Margin="0,16,18,0"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="#66000000" BorderBrush="#33FFFFFF" BorderThickness="1"
                Click="CloseButton_Click" ToolTip="Close Audience Screen (Escape)"
                Cursor="Hand" Panel.ZIndex="100">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                        <TextBlock Text="✕" FontSize="16" FontWeight="Bold" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#FF5252" />
                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="#FF8A80" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Main Content Area with Uniform Viewbox Scaling for TV/DPI Resilience -->
        <Viewbox Stretch="Uniform" Margin="20">
            <Grid Width="1600" Height="900">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Giant Spin Wheel Graphic & Pointer -->
                <Viewbox Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                    <Grid Width="436" Height="436">
                        <!-- Outer Shadow / Glow Rim -->
                        <Ellipse Width="436" Height="436" Fill="#050406" Stroke="#3E1A60" StrokeThickness="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#6A0DAD" BlurRadius="30" ShadowDepth="0" Opacity="0.6" />
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- Canvas containing dynamically built segments -->
                        <Canvas x:Name="WheelCanvas" Width="420" Height="420" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Canvas.RenderTransform>
                                <RotateTransform x:Name="WheelRotate" Angle="0" />
                            </Canvas.RenderTransform>
                        </Canvas>

                        <!-- Indicator Pointer pointing at 12 o'clock -->
                        <Polygon Points="0,0 28,0 14,24" Fill="#FF3D00" Stroke="#FFD600" StrokeThickness="2" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-4,0,0">
                            <Polygon.Effect>
                                <DropShadowEffect Color="#FF3D00" BlurRadius="12" ShadowDepth="0" />
                            </Polygon.Effect>
                        </Polygon>

                        <!-- Central Spooky Rim Cap -->
                        <Ellipse Width="48" Height="48" Fill="#1E133A" Stroke="#FF6D00" StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="💀" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF6D00" />
                    </Grid>
                </Viewbox>

                <!-- Right: Header & Massive Result Banner -->
                <Grid Grid.Column="1" Margin="30,20,20,20" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Spooky Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,35" HorizontalAlignment="Center">
                        <TextBlock Text="🎃 SCARYOKE WHEEL 🎃" FontSize="42" FontWeight="Bold" Foreground="#FF6D00" HorizontalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FF6D00" BlurRadius="15" ShadowDepth="0" Opacity="0.5" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="The Ultimate Singing Challenge" FontSize="20" Foreground="#8F8B9B" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Large Result Banner -->
                    <Border Grid.Row="1" CornerRadius="20" Background="#16141C" BorderBrush="#332B45" BorderThickness="2" Padding="40,35" HorizontalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="CURRENT CHALLENGE" FontSize="18" FontWeight="Bold" Foreground="#8F8B9B" HorizontalAlignment="Center" Margin="0,0,0,20" />
                            <TextBlock x:Name="ResultTextBlock"
                                       Text="{Binding ResultText}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       FontSize="52"
                                       FontWeight="Bold"
                                       Foreground="#00E676"
                                       HorizontalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="ResultScale" />
                                        <TranslateTransform x:Name="ResultShake" />
                                    </TransformGroup>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Text="{Binding ResultDetail}" TextWrapping="Wrap" TextAlignment="Center" FontSize="24" Foreground="#C9C5D6" HorizontalAlignment="Center" Margin="0,20,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Viewbox>

        <!-- Full-window flash used for the DJ's Choice reveal -->
        <Border x:Name="FlashOverlay" Background="#FF3D00" Opacity="0" IsHitTestVisible="False" />
    </Grid>
</Window>
