<!-- Edited on Oct 27, 2026 @ 11:52:00 -> Set ComboBox foreground and background for monitor selection on Settings page -->
<Window x:Class="ScaryokeWheel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:ScaryokeWheel"
        mc:Ignorable="d"
        Title="Scaryoke Standalone Wheel"
        Height="700"
        Width="920"
        WindowStartupLocation="CenterScreen"
        Background="#0E0D12"
        Foreground="White"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderBrush="#332B45"
        BorderThickness="1"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="5" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Title Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar for Dark Spooky Theme -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="#16141C" Height="40" MouseDown="OnTitleBarMouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="🎃" FontSize="18" Margin="0,0,8,0" />
                    <TextBlock Text="Scaryoke Standalone Wheel" FontWeight="SemiBold" FontSize="14" Foreground="#FF6D00" />
                </StackPanel>

                <!-- Monitor Selection & Fullscreen in TitleBar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="🖥️" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding AvailableMonitors}"
                              SelectedItem="{Binding SelectedMonitor}"
                              Width="160" Height="35"
                              FontSize="12"
                              Background="#1E1A26" Foreground="#E0DDEC"
                              BorderBrush="#332B45"
                              VerticalContentAlignment="Center"
                              ToolTip="Display monitor for the wheel">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Index, StringFormat='{}Monitor {0}: '}" FontWeight="Bold" Foreground="#FF6D00" />
                                    <TextBlock Text="{Binding Width, StringFormat='{}{0}x'}" Foreground="#E0DDEC" />
                                    <TextBlock Text="{Binding Height}" Foreground="#E0DDEC" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Click="OnToggleAudienceScreenClick"
                            Height="35"
                            Padding="10,0"
                            Margin="8,0,0,0"
                            Background="#2A103D"
                            Foreground="#E0DDEC"
                            BorderBrush="#FF6D00"
                            FontSize="12"
                            FontWeight="SemiBold"
                            ToolTip="Open/close audience projection window on selected monitor"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="📺 Audience Screen" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProjectionActive}" Value="True">
                                        <Setter Property="Content" Value="📺 Close Audience" />
                                        <Setter Property="Background" Value="#6A0DAD" />
                                        <Setter Property="Foreground" Value="#00E676" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="⛶ Fullscreen"
                            Click="OnTogglePresentationClick"
                            Height="28"
                            Padding="10,0"
                            Margin="8,0,0,0"
                            Background="#291F26"
                            Foreground="#FF6D00"
                            BorderBrush="#332B45"
                            FontSize="12"
                            FontWeight="SemiBold"
                            ToolTip="Toggle fullscreen presentation mode on selected monitor (F11)"
                            Cursor="Hand" />
                </StackPanel>

                <!-- Window Control Buttons (Minimize, Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Width="46" Height="40" Background="Transparent" BorderThickness="0" Click="OnMinimizeClick" Cursor="Hand">
                        <ui:SymbolIcon Symbol="Subtract24" Foreground="Gray" />
                    </Button>
                    <Button Width="46" Height="40" Background="Transparent" BorderThickness="0" Click="OnCloseClick" Cursor="Hand">
                        <ui:SymbolIcon Symbol="Dismiss24" Foreground="DarkRed" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" TabStripPlacement="Top" Background="Transparent" BorderThickness="0" Margin="10">
            <TabControl.Resources>
                <!-- Custom TabItem Style to match WPF-UI and Scaryoke dark theme -->
                <Style TargetType="TabItem">
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding}" Margin="15,8" />
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#8F8B9B" />
                    <Setter Property="FontSize" Value="15" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="#FF6D00" />
                                        <Setter Property="BorderBrush" Value="#FF6D00" />
                                        <Setter Property="Background" Value="#1E1A26" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: SCARYOKE WHEEL -->
            <TabItem Header="Scaryoke Wheel">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="0.9*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Spin Wheel Graphic & Pointer -->
                    <Viewbox Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15">
                        <Grid Width="436" Height="436">
                            <!-- Outer Shadow / Glow Rim -->
                            <Ellipse Width="436" Height="436" Fill="#050406" Stroke="#3E1A60" StrokeThickness="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#6A0DAD" BlurRadius="25" ShadowDepth="0" Opacity="0.5" />
                                </Ellipse.Effect>
                            </Ellipse>

                            <!-- Canvas containing the dynamically built segments -->
                            <Canvas x:Name="WheelCanvas" Width="420" Height="420" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Canvas.RenderTransform>
                                    <RotateTransform x:Name="WheelRotate" Angle="0" />
                                </Canvas.RenderTransform>
                            </Canvas>

                            <!-- Indicator Pointer pointing at 12 o'clock (Adjust first Margin value to shift pointer left/right) -->
                            <Polygon Points="0,0 28,0 14,24" Fill="#FF3D00" Stroke="#FFD600" StrokeThickness="2" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-4,0,0">
                                <Polygon.Effect>
                                    <DropShadowEffect Color="#FF3D00" BlurRadius="10" ShadowDepth="0" />
                                </Polygon.Effect>
                            </Polygon>

                            <!-- Central Spooky Rim Cap -->
                            <Ellipse Width="48" Height="48" Fill="#1E133A" Stroke="#FF6D00" StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="💀" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF6D00" />
                        </Grid>
                    </Viewbox>

                    <!-- Right: Control Panel & Results -->
                    <Grid Grid.Column="1" Margin="20,10,10,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Spooky Header -->
                        <StackPanel Grid.Row="0" Margin="0,15,0,25" HorizontalAlignment="Center">
                            <TextBlock Text="🎃 SCARYOKE WHEEL 🎃" FontSize="24" FontWeight="Bold" Foreground="#FF6D00" HorizontalAlignment="Center" />
                            <TextBlock Text="Spin to select a category" FontSize="14" Foreground="#8F8B9B" Margin="0,5,0,0" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Spinning Result Banner -->
                        <Border Grid.Row="1" CornerRadius="12" Background="#16141C" BorderBrush="#332B45" BorderThickness="1" VerticalAlignment="Center" Padding="25" Margin="0,0,0,10">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="CURRENT CHALLENGE" FontSize="11" FontWeight="Bold" Foreground="#8F8B9B" HorizontalAlignment="Center" Margin="0,0,0,15" />
                                <TextBlock x:Name="ResultTextBlock"
                                           Text="{Binding ResultText}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="#00E676"
                                           HorizontalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="ResultScale" />
                                            <TranslateTransform x:Name="ResultShake" />
                                        </TransformGroup>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock Text="{Binding ResultDetail}" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Foreground="#C9C5D6" HorizontalAlignment="Center" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Options and recent spins -->
                        <StackPanel x:Name="OptionsPanel" Grid.Row="2" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox Content="Mute sounds" IsChecked="{Binding IsMuted}" Foreground="#E0DDEC" Margin="0,0,20,0" />
                                <CheckBox Content="Prevent 2 singers in a row getting the same result" IsChecked="{Binding AvoidRepeats}" Foreground="#E0DDEC" ToolTip="When enabled, prevents consecutive spins from landing on the same challenge category back-to-back." />
                            </StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Volume" FontSize="12" Foreground="#8F8B9B" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="1" LargeChange="0.1" SmallChange="0.05" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="RECENT SPINS" FontSize="11" FontWeight="Bold" Foreground="#8F8B9B" VerticalAlignment="Center" />
                                <Button Content="Clear" HorizontalAlignment="Right" Command="{Binding ClearHistoryCommand}" Background="Transparent" BorderThickness="0" Foreground="#8F8B9B" Cursor="Hand" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding History}" MaxHeight="110" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="13" Foreground="#E0DDEC" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Grid.Row="3" Margin="0,0,0,25">
                            <Button Click="OnToggleAudienceScreenClick"
                                    Height="40"
                                    Margin="0,0,0,10"
                                    HorizontalAlignment="Stretch"
                                    Background="#231730"
                                    Foreground="#E0DDEC"
                                    BorderBrush="#6A0DAD"
                                    BorderThickness="1"
                                    FontWeight="SemiBold"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Content" Value="📺 Project Wheel to 2nd Monitor (Audience Display)" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProjectionActive}" Value="True">
                                                <Setter Property="Content" Value="📺 Disconnect 2nd Monitor Audience Display" />
                                                <Setter Property="Foreground" Value="#00E676" />
                                                <Setter Property="BorderBrush" Value="#00E676" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <ui:Button x:Name="SpinButton"
                                       Content="SPIN THE WHEEL"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Height="60"
                                       HorizontalAlignment="Stretch"
                                       Appearance="Primary"
                                       Background="#FF6D00"
                                       Foreground="White"
                                       Click="OnSpinClick"
                                       Cursor="Hand">
                                <ui:Button.Effect>
                                    <DropShadowEffect Color="#FF6D00" BlurRadius="12" ShadowDepth="0" Opacity="0.4" />
                                </ui:Button.Effect>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: SETTINGS & ABOUT -->
            <TabItem x:Name="SettingsTab" Header="Settings &amp; About">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="0.9*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Category List Setup -->
                    <Grid Grid.Column="0" Margin="0,0,15,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Setup Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Configure Scaryoke Categories" FontSize="18" FontWeight="SemiBold" Foreground="#FF6D00" />
                            <TextBlock Text="Categories are placed on the wheel with Singer's Choice and black 'DJ's Choice' slivers" FontSize="13" Foreground="#8F8B9B" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Scrollable Category List -->
                        <Border Grid.Row="1" Background="#16141C" BorderBrush="#332B45" BorderThickness="1" CornerRadius="8" Padding="5">
                            <ListBox ItemsSource="{Binding CustomCategories}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        <Setter Property="BorderBrush" Value="#221E2C" />
                                        <Setter Property="Padding" Value="10,8" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsEnabled}" ToolTip="Include on the wheel" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <!-- Editable name: committed when the box loses focus; the view model reverts invalid names -->
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                     MaxLength="30"
                                                     FontSize="14"
                                                     FontWeight="SemiBold"
                                                     VerticalAlignment="Center"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="#E0DDEC"
                                                     CaretBrush="#FF6D00"
                                                     Margin="0,0,6,0" />
                                            <Button Grid.Column="2"
                                                    Content="▲"
                                                    Width="26"
                                                    Height="34"
                                                    Margin="0,0,2,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="#8F8B9B"
                                                    ToolTip="Move up"
                                                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand" />
                                            <Button Grid.Column="3"
                                                    Content="▼"
                                                    Width="26"
                                                    Height="34"
                                                    Margin="0,0,6,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="#8F8B9B"
                                                    ToolTip="Move down"
                                                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand" />
                                            <Button Grid.Column="4"
                                                    Width="34"
                                                    Height="34"
                                                    Margin="0,0,6,0"
                                                    Background="{Binding DisplayColor}"
                                                    BorderBrush="#332B45"
                                                    ToolTip="Change colour (Right-click for options)"
                                                    Command="{Binding DataContext.CycleColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Cycle Colour" Command="{Binding DataContext.CycleColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <MenuItem Header="Reset to Auto (by app)" Command="{Binding DataContext.ResetColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                            <Button Grid.Column="5"
                                                    Width="44"
                                                    Height="34"
                                                    Margin="0,0,6,0"
                                                    Background="#1E1A26"
                                                    BorderBrush="#332B45"
                                                    ToolTip="Wheel size (click to change)"
                                                    Command="{Binding DataContext.CycleWeightCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand">
                                                <TextBlock Text="{Binding Weight, StringFormat={}{0:0}×}" Foreground="#E0DDEC" FontWeight="SemiBold" />
                                            </Button>
                                            <Button Grid.Column="6"
                                                    Width="34"
                                                    Height="34"
                                                    Background="#291F26"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.RemoveCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand">
                                                <ui:SymbolIcon Symbol="Delete24" Foreground="DarkRed" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Add Category Controls -->
                        <StackPanel Grid.Row="2" Margin="0,15,0,0">
                            <!-- Helper Count -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock FontSize="12" Foreground="#8F8B9B" VerticalAlignment="Center">
                                    <Run Text="Limit: Max " /><Run Text="{Binding MaxCategories, Mode=OneWay}" /><Run Text=" categories" />
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding CustomCategories.Count}" FontWeight="Bold" Foreground="#FF6D00" />
                                    <TextBlock Text="{Binding MaxCategories, StringFormat=/{0}}" Foreground="#8F8B9B" />
                                </StackPanel>
                            </Grid>

                            <!-- Undo the last removal (shown only while there is one) -->
                            <Button Content="{Binding UndoLabel}" Command="{Binding UndoRemoveCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" Padding="10,4" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UndoLabel}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Validation message -->
                            <TextBlock Text="{Binding ValidationError}" Foreground="#FF5252" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ValidationError}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- TextBox and Add Button -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            PlaceholderText="Enter new category name..."
                                            Height="40"
                                            Margin="0,0,10,0"
                                            VerticalContentAlignment="Center"
                                            MaxLength="30"
                                            BorderBrush="#332B45"
                                            Background="#1C1A24">
                                    <ui:TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding AddCategoryCommand}" />
                                    </ui:TextBox.InputBindings>
                                </ui:TextBox>
                                <ui:Button Grid.Column="1"
                                           Content="Add Category"
                                           Height="40"
                                           Width="120"
                                           Appearance="Primary"
                                           Command="{Binding AddCategoryCommand}"
                                           Background="#FF6D00"
                                           Foreground="White"
                                           Cursor="Hand" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Right: About & App Info -->
                    <Border Grid.Column="1" Background="#16141C" BorderBrush="#332B45" BorderThickness="1" CornerRadius="12" Padding="25">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock Text="💀 ABOUT SCARYOKE WHEEL 💀" FontSize="18" FontWeight="Bold" Foreground="#FF6D00" HorizontalAlignment="Center" />
                                <Border Height="2" Background="#FF6D00" Margin="0,10,0,0" Width="100" HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Descriptions & Rules -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                                <StackPanel>
                                    <!-- Presets -->
                                    <TextBlock Text="PRESETS:" FontWeight="Bold" Foreground="#FF6D00" Margin="0,0,0,8" FontSize="13" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding Presets}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPreset}" Height="32" Margin="0,0,8,0" />
                                        <Button Grid.Column="1" Content="Load" Width="56" Margin="0,0,6,0" Command="{Binding LoadPresetCommand}" Cursor="Hand" />
                                        <Button Grid.Column="2" Content="Delete" Width="65" Command="{Binding DeletePresetCommand}" Cursor="Hand" />
                                    </Grid>
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                    PlaceholderText="Preset name (e.g. 80s Night)..."
                                                    Height="32"
                                                    Margin="0,0,8,0"
                                                    MaxLength="30"
                                                    BorderBrush="#332B45"
                                                    Background="#1C1A24">
                                            <ui:TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding SavePresetCommand}" />
                                            </ui:TextBox.InputBindings>
                                        </ui:TextBox>
                                        <Button Grid.Column="1" Content="Save Preset" Width="100" Command="{Binding SavePresetCommand}" Cursor="Hand" />
                                    </Grid>

                                    <!-- Wheel and Display options -->
                                    <TextBlock Text="DISPLAY &amp; WHEEL OPTIONS:" FontWeight="Bold" Foreground="#FF6D00" Margin="0,0,0,8" FontSize="13" />

                                    <!-- Monitor Selection -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Display Monitor" Foreground="#E0DDEC" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding AvailableMonitors}"
                                                  SelectedItem="{Binding SelectedMonitor}"
                                                  Height="35"
                                                  FontSize="12"
                                                  Background="#1E1A26" Foreground="#E0DDEC"
                                                  BorderBrush="#332B45"
                                                  VerticalContentAlignment="Center"
                                                  Margin="0,0,8,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Index, StringFormat='{}Monitor {0}: '}" FontWeight="Bold" Foreground="#FF6D00" />
                                                        <TextBlock Text="{Binding Width, StringFormat='{}{0}x'}" Foreground="#E0DDEC" />
                                                        <TextBlock Text="{Binding Height}" Foreground="#E0DDEC" />
                                                        <TextBlock Text=" (Primary)" Foreground="#8F8B9B">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="2"
                                                Click="OnToggleAudienceScreenClick"
                                                Height="30"
                                                Padding="12,0"
                                                Background="#2A103D"
                                                BorderBrush="#FF6D00"
                                                FontWeight="SemiBold"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Content" Value="📺 Project Wheel" />
                                                    <Setter Property="Foreground" Value="#E0DDEC" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProjectionActive}" Value="True">
                                                            <Setter Property="Content" Value="✕ Close Projection" />
                                                            <Setter Property="Foreground" Value="#FF5252" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>

                                    <CheckBox Content="Include Singer's Choice segment" IsChecked="{Binding ShowSingersChoice}" Foreground="#E0DDEC" Margin="0,0,0,8" />
                                    <CheckBox Content="Include DJ's Choice slivers" IsChecked="{Binding ShowDjsChoice}" Foreground="#E0DDEC" Margin="0,0,0,8" />
                                    <Grid Margin="0,0,0,18" IsEnabled="{Binding ShowDjsChoice}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="DJ's Choice slivers" Foreground="#E0DDEC" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding SliverSizeLabels}" SelectedIndex="{Binding SliverSizeIndex}" Height="35" />
                                    </Grid>

                                    <TextBlock Text="Scaryoke is the ultimate singing challenge! Performers are forced to step outside their comfort zones and sing a song randomly picked by the wheel."
                                               TextWrapping="Wrap"
                                               FontSize="13"
                                               LineHeight="20"
                                               Foreground="#E0DDEC"
                                               Margin="0,0,0,15" />

                                    <TextBlock Text="RULES OF SPINS:" FontWeight="Bold" Foreground="#FF6D00" Margin="0,5,0,8" FontSize="13" />

                                    <BulletDecorator Margin="0,0,0,8">
                                        <BulletDecorator.Bullet>
                                            <TextBlock Text="•" Foreground="#FF6D00" Margin="0,0,8,0" />
                                        </BulletDecorator.Bullet>
                                        <TextBlock Text="Add custom genre or artist categories in Settings. Rename, reorder, resize, recolour or switch them off there." TextWrapping="Wrap" Foreground="#E0DDEC" />
                                    </BulletDecorator>

                                    <BulletDecorator Margin="0,0,0,8">
                                        <BulletDecorator.Bullet>
                                            <TextBlock Text="•" Foreground="#FF6D00" Margin="0,0,8,0" />
                                        </BulletDecorator.Bullet>
                                        <TextBlock Text="The wheel can include Singer's Choice and thin black DJ's Choice slivers (configurable in Settings)." TextWrapping="Wrap" Foreground="#E0DDEC" />
                                    </BulletDecorator>

                                    <BulletDecorator Margin="0,0,0,8">
                                        <BulletDecorator.Bullet>
                                            <TextBlock Text="•" Foreground="#FF6D00" Margin="0,0,8,0" />
                                        </BulletDecorator.Bullet>
                                        <TextBlock Text="When spinning, the wheel ticks on each boundary transition." TextWrapping="Wrap" Foreground="#E0DDEC" />
                                    </BulletDecorator>

                                    <BulletDecorator Margin="0,0,0,8">
                                        <BulletDecorator.Bullet>
                                            <TextBlock Text="•" Foreground="#FF6D00" Margin="0,0,8,0" />
                                        </BulletDecorator.Bullet>
                                        <TextBlock Text="Land on 'DJ's Choice' for an evil laughter trigger!" TextWrapping="Wrap" Foreground="#E0DDEC" />
                                    </BulletDecorator>

                                    <TextBlock Text="Note: Configured categories are saved locally and load automatically each time you start the app."
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               FontStyle="Italic"
                                               Foreground="#8F8B9B"
                                               Margin="0,15,0,0" />
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Standalone Metadata Info -->
                            <StackPanel Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Company}" FontWeight="Bold" FontSize="13" Foreground="#FF6D00" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Version}" FontSize="12" Foreground="#8F8B9B" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Copyright}" FontSize="11" Foreground="#6C6975" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Full-window flash used for the DJ's Choice reveal -->
        <Border x:Name="FlashOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#FF3D00" Opacity="0" IsHitTestVisible="False" />
    </Grid>
</Window>