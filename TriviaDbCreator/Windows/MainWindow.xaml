<!-- Edited on Aug 19, 2026 @ 15:28:00 -> Added Help and About tabs with rich interactive topic viewer -->
<Window x:Class="TriviaDbCreator.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:TriviaDbCreator.ViewModels"
        mc:Ignorable="d"
        Title="Lyracist Trivia Database Creator &amp; Pack Editor"
        Height="880" Width="1540"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Icon="/LyracistTrivia.ico">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Tabs -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP HEADER APP BAR -->
        <Border Grid.Row="0" Background="#1E293B" Padding="20,12" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Title & Emblem -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/LyracistTrivia_128.png" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LYRACIST" FontWeight="Black" FontSize="18" Foreground="#A78BFA" Margin="0,0,6,0" />
                            <TextBlock Text="TRIVIA DB CREATOR" FontWeight="Black" FontSize="18" Foreground="#38BDF8" />
                        </StackPanel>
                        <TextBlock Text="Interactive Question Pack Authoring, Option Balancing &amp; Banner Studio" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>
                </StackPanel>

                <!-- Global Action Bar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SyncDatabaseCommand}" Margin="0,0,8,0" Padding="14,6" Background="#334155" BorderBrush="#475569" Foreground="#FFFFFF">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡ " FontSize="14" />
                            <TextBlock Text="Sync to SQLite (trivia.db)" FontWeight="Bold" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ImportPackCommand}" Margin="0,0,8,0" Padding="12,6" Background="#1E1B4B" BorderBrush="#6366F1" Foreground="#E0E7FF">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂 " FontSize="13" />
                            <TextBlock Text="Import JSON" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportPackCommand}" Margin="0,0,8,0" Padding="12,6" Background="#1E1B4B" BorderBrush="#6366F1" Foreground="#E0E7FF">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾 " FontSize="13" />
                            <TextBlock Text="Export JSON" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SavePackCommand}" Padding="16,6" Background="#10B981" BorderBrush="#059669" Foreground="#FFFFFF">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾 " FontSize="14" />
                            <TextBlock Text="Save Pack" FontWeight="ExtraBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN TAB CONTROL -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="14,10,14,6">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="#94A3B8" />
                    <Setter Property="Padding" Value="18,8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}" Margin="0,0,8,0" CornerRadius="4,4,0,0">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="#38BDF8" />
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#38BDF8" />
                                        <Setter TargetName="TabBorder" Property="Background" Value="#1E293B" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: 🗄️ DATABASE STUDIO -->
            <TabItem Header="🗄️ Database Studio">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <!-- 1. Left Sidebar: Category Packs List (280px) -->
                        <ColumnDefinition Width="280" MinWidth="220" />
                        <ColumnDefinition Width="12" />
                        <!-- 2. Center Column: Questions Table & Pack Info (5*) -->
                        <ColumnDefinition Width="5*" MinWidth="400" />
                        <ColumnDefinition Width="12" />
                        <!-- 3. Right Column: Question Editor Form (4*) -->
                        <ColumnDefinition Width="4*" MinWidth="380" />
                    </Grid.ColumnDefinitions>

                    <!-- 1. LEFT SIDEBAR: CATEGORY PACKS -->
                    <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Padding="14" BorderBrush="#14FFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Sidebar Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CATEGORY PACKS" FontWeight="Black" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding NewPackCommand}" Padding="10,4" Background="#8B5CF6" Foreground="#FFFFFF" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➕ " FontSize="11" />
                                        <TextBlock Text="New Pack" FontSize="12" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Pack Search Filter -->
                            <TextBox Grid.Row="1" Text="{Binding PackSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" Margin="0,0,0,10" Background="#0F172A" Foreground="#FFFFFF"
                                     BorderBrush="#334155" BorderThickness="1" />

                            <!-- Packs List -->
                            <ListBox Grid.Row="2" ItemsSource="{Binding FilteredPacks}" SelectedItem="{Binding SelectedPack}"
                                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#14FFFFFF" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#334155" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Questions.Count, StringFormat='{}{0} Qs'}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Pack Bottom Actions -->
                            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                                <Button Command="{Binding DeletePackCommand}" Background="#450A0A" BorderBrush="#991B1B" Foreground="#FCA5A5" HorizontalAlignment="Stretch" Padding="8,4">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="🗑️ " FontSize="12" />
                                        <TextBlock Text="Delete Selected Pack" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2. CENTER COLUMN: QUESTIONS TABLE & METADATA -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <!-- Pack Metadata Card -->
                            <RowDefinition Height="Auto" />
                            <!-- Questions List Table -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Pack Metadata Card -->
                        <Border Grid.Row="0" Background="#1E293B" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="#14FFFFFF" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>

                                <!-- Pack Fields -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,0">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Pack Title:" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding PackTitle, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#334155" Padding="8,5" FontWeight="Bold" FontSize="13" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Pack ID (Slug):" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding PackId, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#38BDF8" BorderBrush="#334155" Padding="8,5" FontSize="12" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Category Tag:" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding PackCategory, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#334155" Padding="8,5" FontSize="12" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel>
                                        <TextBlock Text="Description &amp; Themes:" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding PackDescription, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#CBD5E1" BorderBrush="#334155" Padding="8,4" FontSize="12" Height="36" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Banner Preview Card -->
                                <Border Grid.Row="0" Grid.Column="1" Background="#0F172A" CornerRadius="8" Padding="8" BorderBrush="#334155" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Image Source="{Binding BannerPath}" Stretch="Uniform" Height="68" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                        <Button Grid.Row="1" Command="{Binding GenerateBannerCommand}" Margin="0,6,0,0" Padding="8,3" Background="#334155" Foreground="#CBD5E1" HorizontalAlignment="Stretch" BorderThickness="0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="🎨 " FontSize="11" />
                                                <TextBlock Text="Generate 16:9 Banner" FontSize="11" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Questions Table Card -->
                        <Border Grid.Row="1" Background="#1E293B" CornerRadius="12" Padding="14" BorderBrush="#14FFFFFF" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- Questions Toolbar -->
                                    <RowDefinition Height="Auto" />
                                    <!-- Questions DataGrid -->
                                    <RowDefinition Height="*" />
                                    <!-- Distribution Bar -->
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Toolbar -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="QUESTIONS (" FontWeight="Black" FontSize="13" Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding PackQuestions.Count}" FontWeight="Black" FontSize="13" Foreground="#38BDF8" />
                                        <TextBlock Text=")" FontWeight="Black" FontSize="13" Foreground="#94A3B8" />
                                    </StackPanel>

                                    <!-- Question Filter Search -->
                                    <TextBox Grid.Column="1" Text="{Binding QuestionSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="6,4" Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#334155" FontSize="11" />

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <Button Command="{Binding BalanceOptionsCommand}" Margin="0,0,8,0" Padding="10,4" Background="#1E1B4B" BorderBrush="#6366F1" Foreground="#C7D2FE">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔀 " FontSize="11" />
                                                <TextBlock Text="Balance Options (25% each)" FontSize="11" FontWeight="Bold" />
                                            </StackPanel>
                                        </Button>

                                        <Button Command="{Binding NewQuestionCommand}" Padding="12,4" Background="#8B5CF6" Foreground="#FFFFFF" BorderThickness="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="➕ " FontSize="11" />
                                                <TextBlock Text="Add Question" FontSize="11" FontWeight="Bold" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Questions ListView -->
                                <ListView Grid.Row="1" ItemsSource="{Binding FilteredQuestions}" SelectedItem="{Binding SelectedQuestion}"
                                          Background="#0F172A" BorderBrush="#334155" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,6" Margin="0,2" Background="#14FFFFFF" CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="65" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="55" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Question ID -->
                                                    <Border Background="#334155" CornerRadius="4" Padding="4,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Id}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                                                    </Border>

                                                    <!-- Prompt -->
                                                    <TextBlock Grid.Column="1" Text="{Binding Prompt}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0" />

                                                    <!-- Difficulty Badge -->
                                                    <Border Grid.Column="2" Background="#1E293B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Difficulty}" FontSize="11" Foreground="#F59E0B" FontWeight="Bold" />
                                                    </Border>

                                                    <!-- Correct Option Badge -->
                                                    <Border Grid.Column="3" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#8B5CF6" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CorrectAnswerIndex}" Value="0">
                                                                        <Setter Property="Background" Value="#8B5CF6" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding CorrectAnswerIndex}" Value="1">
                                                                        <Setter Property="Background" Value="#06B6D4" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding CorrectAnswerIndex}" Value="2">
                                                                        <Setter Property="Background" Value="#F59E0B" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding CorrectAnswerIndex}" Value="3">
                                                                        <Setter Property="Background" Value="#F43F5E" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="11" FontWeight="Black" Foreground="#FFFFFF">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="▲ A" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CorrectAnswerIndex}" Value="0">
                                                                            <Setter Property="Text" Value="▲ A" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding CorrectAnswerIndex}" Value="1">
                                                                            <Setter Property="Text" Value="◆ B" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding CorrectAnswerIndex}" Value="2">
                                                                            <Setter Property="Text" Value="● C" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding CorrectAnswerIndex}" Value="3">
                                                                            <Setter Property="Text" Value="■ D" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <!-- Distribution & Warning Bar -->
                                <Border Grid.Row="2" Background="#0F172A" CornerRadius="8" Padding="12,6" Margin="0,8,0,0" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Option Distribution: " FontWeight="Bold" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding DistributionText}" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{Binding DistributionWarning}" FontSize="11" Foreground="#F59E0B" FontWeight="Bold" Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DistributionWarning}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DistributionWarning, Converter={x:Null}}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 3. RIGHT COLUMN: QUESTION EDITOR FORM -->
                    <Border Grid.Column="4" Background="#1E293B" CornerRadius="12" Padding="16" BorderBrush="#14FFFFFF" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Form Header -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="QUESTION EDITOR" FontWeight="Black" FontSize="13" Foreground="#94A3B8" />
                                        <TextBlock Text="Edit fields and select correct answer" FontSize="11" Foreground="#64748B" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Command="{Binding DuplicateQuestionCommand}" Margin="0,0,6,0" Padding="8,4" Background="#334155" Foreground="#FFFFFF" BorderThickness="0">
                                            <TextBlock Text="📋 Duplicate" FontSize="11" FontWeight="Bold" />
                                        </Button>
                                        <Button Command="{Binding DeleteQuestionCommand}" Padding="8,4" Background="#450A0A" Foreground="#FCA5A5" BorderBrush="#991B1B">
                                            <TextBlock Text="🗑️ Delete" FontSize="11" FontWeight="Bold" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Question ID & Difficulty Row -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Question ID:" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding EditorId, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#38BDF8" BorderBrush="#334155" Padding="8,5" FontWeight="Bold" FontSize="12" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Difficulty:" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                        <ComboBox ItemsSource="{Binding DifficultyOptions}" SelectedItem="{Binding EditorDifficulty}" Background="#0F172A" Foreground="#FFFFFF" Padding="8,5" />
                                    </StackPanel>
                                </Grid>

                                <!-- Question Prompt -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Question Prompt:" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding EditorPrompt, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#334155"
                                             Padding="8,6" FontSize="13" FontWeight="SemiBold" Height="70" TextWrapping="Wrap" AcceptsReturn="True" />
                                </StackPanel>

                                <!-- 4 Multiple Choice Options (A, B, C, D) -->
                                <TextBlock Text="4 MULTIPLE-CHOICE OPTIONS &amp; CORRECT ANSWER:" FontWeight="Black" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,6" />

                                <!-- Option A -->
                                <Border Background="#261A42" CornerRadius="8" Padding="10,8" Margin="0,0,0,8" BorderBrush="#8B5CF6" BorderThickness="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#8B5CF6" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="▲" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBox Grid.Column="1" Text="{Binding EditorOptionA, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#FFFFFF" BorderThickness="0" Padding="6,4" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <RadioButton Grid.Column="2" GroupName="CorrectAnswerGroup" IsChecked="{Binding EditorCorrectIndex, Converter={x:Null}, ConverterParameter=0}" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Set as Correct Answer">
                                            <RadioButton.Style>
                                                <Style TargetType="RadioButton">
                                                    <Setter Property="IsChecked" Value="False" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EditorCorrectIndex}" Value="0">
                                                            <Setter Property="IsChecked" Value="True" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </RadioButton.Style>
                                        </RadioButton>
                                    </Grid>
                                </Border>

                                <!-- Option B -->
                                <Border Background="#13313F" CornerRadius="8" Padding="10,8" Margin="0,0,0,8" BorderBrush="#06B6D4" BorderThickness="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#06B6D4" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="◆" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBox Grid.Column="1" Text="{Binding EditorOptionB, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#FFFFFF" BorderThickness="0" Padding="6,4" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <RadioButton Grid.Column="2" GroupName="CorrectAnswerGroup" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Set as Correct Answer">
                                            <RadioButton.Style>
                                                <Style TargetType="RadioButton">
                                                    <Setter Property="IsChecked" Value="False" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EditorCorrectIndex}" Value="1">
                                                            <Setter Property="IsChecked" Value="True" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </RadioButton.Style>
                                        </RadioButton>
                                    </Grid>
                                </Border>

                                <!-- Option C -->
                                <Border Background="#3D2912" CornerRadius="8" Padding="10,8" Margin="0,0,0,8" BorderBrush="#F59E0B" BorderThickness="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#F59E0B" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="●" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBox Grid.Column="1" Text="{Binding EditorOptionC, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#FFFFFF" BorderThickness="0" Padding="6,4" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <RadioButton Grid.Column="2" GroupName="CorrectAnswerGroup" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Set as Correct Answer">
                                            <RadioButton.Style>
                                                <Style TargetType="RadioButton">
                                                    <Setter Property="IsChecked" Value="False" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EditorCorrectIndex}" Value="2">
                                                            <Setter Property="IsChecked" Value="True" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </RadioButton.Style>
                                        </RadioButton>
                                    </Grid>
                                </Border>

                                <!-- Option D -->
                                <Border Background="#3E1524" CornerRadius="8" Padding="10,8" Margin="0,0,0,12" BorderBrush="#F43F5E" BorderThickness="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#F43F5E" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="■" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBox Grid.Column="1" Text="{Binding EditorOptionD, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#FFFFFF" BorderThickness="0" Padding="6,4" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <RadioButton Grid.Column="2" GroupName="CorrectAnswerGroup" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Set as Correct Answer">
                                            <RadioButton.Style>
                                                <Style TargetType="RadioButton">
                                                    <Setter Property="IsChecked" Value="False" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EditorCorrectIndex}" Value="3">
                                                            <Setter Property="IsChecked" Value="True" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </RadioButton.Style>
                                        </RadioButton>
                                    </Grid>
                                </Border>

                                <!-- Explanation Note -->
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Explanation / Fun Fact (Reveal Buffer):" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding EditorExplanation, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#0F172A" Foreground="#CBD5E1" BorderBrush="#334155"
                                             Padding="8,5" FontSize="12" Height="50" TextWrapping="Wrap" AcceptsReturn="True" />
                                </StackPanel>

                                <!-- Commit Question Button -->
                                <Button Command="{Binding SaveQuestionCommand}" Padding="16,10" Background="#10B981" BorderBrush="#059669" Foreground="#FFFFFF" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="💾 " FontSize="14" />
                                        <TextBlock Text="Apply / Save Question to Pack" FontWeight="ExtraBold" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: ❓ HELP & INSTRUCTIONS -->
            <TabItem Header="❓ Help &amp; Instructions">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <!-- Topic List Menu (320px) -->
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="14" />
                        <!-- Topic Content Card (*) -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Topics Menu -->
                    <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Padding="14" BorderBrush="#14FFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="DOCUMENTATION TOPICS" FontWeight="Black" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,12" />

                            <ListBox Grid.Row="1" ItemsSource="{Binding HelpTopics}" SelectedItem="{Binding SelectedHelpTopic}"
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,0,0,6" Background="#14FFFFFF" CornerRadius="8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Icon}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Right Topic Content Card -->
                    <Border Grid.Column="2" Background="#1E293B" CornerRadius="12" Padding="24" BorderBrush="#14FFFFFF" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedHelpTopic.DescriptionHeader}" FontSize="20" FontWeight="Black" Foreground="#38BDF8" Margin="0,0,0,14" />
                                <Border Height="1" Background="#334155" Margin="0,0,0,16" />
                                <TextBox Text="{Binding SelectedHelpTopic.DescriptionContent, Mode=OneWay}"
                                         Background="Transparent" Foreground="#E2E8F0" BorderThickness="0"
                                         FontSize="13" FontFamily="Segoe UI" TextWrapping="Wrap"
                                         IsReadOnly="True" IsReadOnlyCaretVisible="False" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: ℹ️ ABOUT -->
            <TabItem Header="ℹ️ About">
                <Border Background="#1E293B" CornerRadius="12" Padding="32" Margin="0,10,0,0" BorderBrush="#14FFFFFF" BorderThickness="1">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="700">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Official Logo -->
                            <Image Source="/LyracistTrivia_logo.png" Width="140" Height="140" HorizontalAlignment="Center" Margin="0,0,0,16" RenderOptions.BitmapScalingMode="HighQuality" />

                            <TextBlock Text="{Binding AppName}" FontSize="24" FontWeight="Black" Foreground="#A78BFA" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding AppVersion, StringFormat='{}Version {0}'}" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,4,0,12" />

                            <TextBlock Text="{Binding AppDescription}" FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20" Margin="0,0,0,20" />

                            <Border Background="#0F172A" CornerRadius="10" Padding="18,12" BorderBrush="#334155" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Company:" FontWeight="Bold" Foreground="#94A3B8" Margin="0,4" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Company}" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,4" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Author:" FontWeight="Bold" Foreground="#94A3B8" Margin="0,4" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Author}" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,4" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Copyright:" FontWeight="Bold" Foreground="#94A3B8" Margin="0,4" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Copyright}" Foreground="#CBD5E1" Margin="0,4" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="#1E293B" Padding="16,8" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#94A3B8" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="#EF4444" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="1" Text="Lyracist Trivia Pro © 2026 PAROLE Software" FontSize="11" Foreground="#64748B" FontWeight="Bold" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
