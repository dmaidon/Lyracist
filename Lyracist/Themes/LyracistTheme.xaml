<!-- Edited on Oct 30, 2026 @ 10:38:00 -> Restore Stretch HorizontalContentAlignment/VerticalContentAlignment on TabItem style so TabControl content fills width and height -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- Brand Colors -->
    <Color x:Key="LyricEmber">#C62828</Color>
    <Color x:Key="StageWood">#5D4037</Color>
    <Color x:Key="StudioSteel">#B0BEC5</Color>
    <Color x:Key="BackstageBlackout">#212121</Color>
    <Color x:Key="LyricGlow">#FF4081</Color>

    <!-- UI Colors -->
    <Color x:Key="UIBackground">#1E1E1E</Color>
    <Color x:Key="UISurface">#2C2C2C</Color>
    <Color x:Key="UIBorder">#3A3A3A</Color>
    <Color x:Key="UITextPrimary">#FFFFFF</Color>
    <Color x:Key="UITextSecondary">#CCCCCC</Color>
    <Color x:Key="UIAccent">#FF4081</Color>
    <Color x:Key="UIAccentHover">#FF79A8</Color>
    <Color x:Key="UIAccentPressed">#D81B60</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="UIBackgroundBrush" Color="{StaticResource UIBackground}" />
    <SolidColorBrush x:Key="UISurfaceBrush" Color="{StaticResource UISurface}" />
    <SolidColorBrush x:Key="UIBorderBrush" Color="{StaticResource UIBorder}" />
    <SolidColorBrush x:Key="UITextPrimaryBrush" Color="{StaticResource UITextPrimary}" />
    <SolidColorBrush x:Key="UITextSecondaryBrush" Color="{StaticResource UITextSecondary}" />
    <SolidColorBrush x:Key="UIAccentBrush" Color="{StaticResource UIAccent}" />
    <SolidColorBrush x:Key="UIAccentHoverBrush" Color="{StaticResource UIAccentHover}" />
    <SolidColorBrush x:Key="UIAccentPressedBrush" Color="{StaticResource UIAccentPressed}" />
    <SolidColorBrush x:Key="BackstageBlackoutBrush" Color="{StaticResource BackstageBlackout}" />
    <SolidColorBrush x:Key="LyricGlowBrush" Color="{StaticResource LyricGlow}" />
    <SolidColorBrush x:Key="StudioSteelBrush" Color="{StaticResource StudioSteel}" />

    <!-- App Chrome Colors: used by the control-panel window/pages only.
         Kept distinct from the UI* keys above, which are also used by the
         always-dark stage projector windows (RotationWindow/LyricsWindow)
         and must never change with the app's Dark/Light setting.
         Swapped at runtime by LyracistThemeManager. -->
    <Color x:Key="AppBackground">#1E1E1E</Color>
    <Color x:Key="AppSurface">#2C2C2C</Color>
    <Color x:Key="AppBorder">#3A3A3A</Color>
    <Color x:Key="AppTextPrimary">#FFFFFF</Color>
    <Color x:Key="AppTextSecondary">#CCCCCC</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackground}" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurface}" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorder}" />
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{StaticResource AppTextPrimary}" />
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{StaticResource AppTextSecondary}" />

    <!-- Overlay chrome buttons (maximize/close) for the borderless
         projector windows (RotationWindow/LyricsWindow). -->
    <Style x:Key="OverlayWindowButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource UITextPrimaryBrush}" />
        <Setter Property="Background" Value="#66000000" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#AA000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OverlayWindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource OverlayWindowButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#CCE81123" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Disable scrollbars on the Frame level to prevent page-level stretching -->
    <Style TargetType="Frame">
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- Make all ScrollBars wider and easier to see/click -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
    </Style>

    <!-- Ensure ScrollBar thumbs are locked to a fixed 45px size -->
    <Style TargetType="Thumb" BasedOn="{StaticResource {x:Type Thumb}}">
        <Setter Property="MinHeight" Value="45" />
        <Setter Property="MaxHeight" Value="45" />
        <Setter Property="MinWidth" Value="45" />
        <Setter Property="MaxWidth" Value="45" />
    </Style>

    <!-- Large DJ Button Style for Auto-Advance Controls -->
    <Style x:Key="BigDJButton" TargetType="Button">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource UIAccentBrush}" />
        <Setter Property="BorderBrush" Value="#60FFFFFF" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.4" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource UIAccentHoverBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource UIAccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- High-contrast colored TabItem style for dark venue readability -->
    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Background" Value="#CC3B4261" />
        <Setter Property="BorderBrush" Value="#FF6366F1" />
        <Setter Property="BorderThickness" Value="1.5,1.5,1.5,0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Margin" Value="0,0,3,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}"
                                Opacity="0.82">
                            <Border.Resources>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="White" />
                                </Style>
                            </Border.Resources>
                            <Grid>
                                <ContentPresenter x:Name="ContentSite"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="White" />
                                <Border x:Name="ActiveIndicator"
                                        Height="3"
                                        CornerRadius="1.5"
                                        Background="#FFFFFFFF"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,-4"
                                        Opacity="0" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Opacity" Value="0.95" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="#DDFFFFFF" />
                        </Trigger>
                        <Trigger Property="Selector.IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="100" />
                            <Setter TargetName="Border" Property="Opacity" Value="1.0" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="#FFFFFFFF" />
                            <Setter TargetName="Border" Property="BorderThickness" Value="2,2,2,0" />
                            <Setter TargetName="ContentSite" Property="TextElement.FontWeight" Value="Bold" />
                            <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1.0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Override WPF-UI TopCompactNavigationViewItemTemplate so top NavigationView tabs render their colored Background and BorderBrush -->
    <ControlTemplate x:Key="TopCompactNavigationViewItemTemplate" TargetType="{x:Type ui:NavigationViewItem}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="MainBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7,7,0,0"
                    Margin="2,4,2,0"
                    Opacity="0.84"
                    SnapsToDevicePixels="True">
                <Border.Resources>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Foreground" Value="White" />
                    </Style>
                </Border.Resources>
                <Grid>
                    <Grid Margin="7,6,7,6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="IconContentPresenter"
                                          Grid.Column="0"
                                          Content="{TemplateBinding ui:NavigationViewItem.Icon}"
                                          Margin="0,0,5,0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.FontSize="15"
                                          TextElement.Foreground="White" />
                        <ContentPresenter x:Name="ElementContentPresenter"
                                          Grid.Column="1"
                                          RecognizesAccessKey="True"
                                          Content="{TemplateBinding ContentControl.Content}"
                                          ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          TextElement.FontSize="13.5"
                                          TextElement.FontWeight="SemiBold"
                                          TextElement.Foreground="White" />
                        <Grid x:Name="PART_ChevronGrid" Grid.Column="2" Width="0" Visibility="Collapsed" />
                        <ContentPresenter x:Name="PART_InfoBadge"
                                          Grid.Column="2"
                                          Content="{TemplateBinding ui:NavigationViewItem.InfoBadge}"
                                          Margin="2"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <Rectangle x:Name="ActiveRectangle"
                               Grid.Column="0"
                               RadiusX="1.5"
                               RadiusY="1.5"
                               Fill="#FFFFFFFF"
                               Width="26"
                               Height="3"
                               Margin="0,0,0,1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Opacity="0" />
                </Grid>
            </Border>
            <Popup x:Name="SubMenuPopup"
                   Grid.Row="1"
                   IsOpen="False"
                   Placement="Bottom"
                   StaysOpen="False"
                   HorizontalOffset="-12"
                   VerticalOffset="1"
                   PopupAnimation="None"
                   AllowsTransparency="True"
                   Focusable="False">
                <Border x:Name="SubMenuBorder"
                        BorderThickness="1"
                        Padding="0,3"
                        CornerRadius="8"
                        BorderBrush="{DynamicResource FlyoutBorderBrush}"
                        Background="{DynamicResource FlyoutBackground}"
                        Margin="12,0,12,18"
                        SnapsToDevicePixels="True">
                    <ItemsControl x:Name="SubMenuItemsPresenter"
                                  Opacity="0"
                                  Focusable="False"
                                  KeyboardNavigation.DirectionalNavigation="Contained"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="MainBorder" Property="Opacity" Value="0.96" />
                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#DDFFFFFF" />
            </Trigger>
            <Trigger Property="ui:NavigationViewItem.IsActive" Value="True">
                <Setter TargetName="MainBorder" Property="Opacity" Value="1.0" />
                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FFFFFFFF" />
                <Setter TargetName="MainBorder" Property="BorderThickness" Value="2,2,2,0" />
                <Setter TargetName="ElementContentPresenter" Property="TextElement.FontWeight" Value="Bold" />
                <Setter TargetName="ActiveRectangle" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="ui:NavigationViewItem.Icon" Value="{x:Null}">
                <Setter TargetName="IconContentPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ContentControl.Content" Value="{x:Null}">
                <Setter TargetName="IconContentPresenter" Property="Margin" Value="0" />
                <Setter TargetName="ElementContentPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>