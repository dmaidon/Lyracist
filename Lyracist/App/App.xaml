<Application x:Class="Lyracist.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!-- WPF UI Theme and Controls -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />

                <!-- Lyracist Theme -->
                <ResourceDictionary Source="pack://application:,,,/Themes/LyracistTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Styles -->
            <!-- Buttons -->
            <Style TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="FontFamily" Value="Segoe UI Variable" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <!-- TextBlocks -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI Variable" />
            </Style>

            <Style TargetType="{x:Type Thumb}">
                <Setter Property="MinHeight" Value="80" />
                <Setter Property="MaxHeight" Value="80" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>