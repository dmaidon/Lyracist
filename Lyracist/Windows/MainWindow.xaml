<ui:FluentWindow x:Class="Lyracist.Windows.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:wpf="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:pages="clr-namespace:Lyracist.Views.Pages"
                 Title="Lyracist Pro" Height="700" Width="1000"
        WindowState="Maximized"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom TitleBar rendering Fluent Minimize, Maximize, and Close buttons -->
        <Grid Grid.Row="0" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Title Bar Logo -->
            <Image Grid.Column="0"
                   Source="/Assets/LyracistLogo.png"
                   Width="32" Height="32"
                   Margin="8,0,8,0"
                   VerticalAlignment="Center" />

            <ui:TitleBar Grid.Column="1"
                         Title="Lyracist Professional - Control Panel" />

            <!-- Drive Status Indicator -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,140,0" IsHitTestVisible="False">
                <Grid Margin="0,0,6,0" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{Binding DriveStatusBrush}">
                        <Ellipse.Effect>
                            <BlurEffect Radius="4" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <Ellipse Width="8" Height="8" Fill="{Binding DriveStatusBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <ui:SymbolIcon Symbol="Database24" Margin="4,0,4,0" VerticalAlignment="Center" Foreground="{Binding DriveStatusBrush}" />
                <TextBlock Text="{Binding DriveStatusText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding DriveStatusBrush}" />
            </StackPanel>
        </Grid>

        <!-- Fluent navigation panel at the top (Horizontal Tabs) -->
        <ui:NavigationView Grid.Row="1"
                            x:Name="RootNavigation"
                            PaneDisplayMode="Top"
                            IsBackButtonVisible="Collapsed"
                            Margin="0"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Karaoke" Icon="{ui:SymbolIcon MusicNote224}" TargetPageType="{x:Type pages:KaraokePage}" />
                <ui:NavigationViewItem Content="Rotation" Icon="{ui:SymbolIcon People24}" TargetPageType="{x:Type pages:RotationPage}" />
                <ui:NavigationViewItem Content="Lyrics" Icon="{ui:SymbolIcon DocumentText24}" TargetPageType="{x:Type pages:LyricsPage}" />
                <ui:NavigationViewItem Content="Playlists" Icon="{ui:SymbolIcon MusicNote2Play20}" TargetPageType="{x:Type pages:PlaylistsPage}" />
                <ui:NavigationViewItem Content="Requests" Icon="{ui:SymbolIcon MailInboxArrowDown20}" TargetPageType="{x:Type pages:RequestsPage}" />
                <ui:NavigationViewItem Content="Settings" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type pages:SettingsPage}" />
                <ui:NavigationViewItem Content="Casting" Icon="{ui:SymbolIcon Cast24}" TargetPageType="{x:Type pages:CastingPage}" />
                <ui:NavigationViewItem Content="Help" Icon="{ui:SymbolIcon QuestionCircle24}" TargetPageType="{x:Type pages:HelpPage}" />
                <ui:NavigationViewItem Content="About" Icon="{ui:SymbolIcon Info24}" TargetPageType="{x:Type pages:AboutPage}" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>

        <!-- Global Playback Control Bar at the bottom of the window -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Currently Playing Info -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Karaoke.NowSingingName, StringFormat='Performer: {0}'}"
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding Karaoke.CurrentSongName}"
                               FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Playback Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- Play Button -->
                    <ui:Button Icon="{ui:SymbolIcon Play24}"
                               Command="{Binding Karaoke.PlayCommand}"
                               Appearance="Primary"
                               Width="46" Height="36"
                               Margin="0,0,8,0"
                               ToolTip="Play" />
                    <!-- Pause Button -->
                    <ui:Button Icon="{ui:SymbolIcon Pause24}"
                               Command="{Binding Karaoke.PauseCommand}"
                               Width="46" Height="36"
                               Margin="0,0,8,0"
                               ToolTip="Pause" />
                    <!-- Stop Button -->
                    <ui:Button Icon="{ui:SymbolIcon Stop24}"
                               Command="{Binding Karaoke.StopCommand}"
                               Appearance="Danger"
                               Width="46" Height="36"
                               ToolTip="Stop / Reset" />
                </StackPanel>

                <!-- Display shortcut buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <wpf:ToggleButton IsChecked="{Binding Karaoke.IsLyricsActive, Mode=TwoWay}" Margin="0,0,8,0" Padding="8,4" Height="36">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Window24" Margin="0,0,6,0" />
                            <TextBlock Text="Lyrics Window" VerticalAlignment="Center" />
                        </StackPanel>
                    </wpf:ToggleButton>
                    <wpf:ToggleButton IsChecked="{Binding Karaoke.IsRotationActive, Mode=TwoWay}" Padding="8,4" Height="36">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="People24" Margin="0,0,6,0" />
                            <TextBlock Text="Rotation Window" VerticalAlignment="Center" />
                        </StackPanel>
                    </wpf:ToggleButton>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>