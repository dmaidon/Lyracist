<!-- Edited on Sep 6, 2026 @ 13:04:30 -> Add bottom-right NotificationHost toast overlay to BulkImportWindow -->
<Window x:Class="Lyracist.Windows.BulkImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Lyracist.Controls"
        Title="Bulk Import Wizard"
        Height="820" Width="1180"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <LinearGradientBrush x:Key="BulkHeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0072FF" Offset="0.0"/>
            <GradientStop Color="#00C6FF" Offset="0.5"/>
            <GradientStop Color="#7F00FF" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header Banner -->
            <RowDefinition Height="Auto"/> <!-- Folder Picker & Scan Bar -->
            <RowDefinition Height="Auto"/> <!-- Batch Options Toolbar -->
            <RowDefinition Height="*"/>    <!-- Preview DataGrid -->
            <RowDefinition Height="Auto"/> <!-- Progress & Execution Footer -->
        </Grid.RowDefinitions>

        <!-- 1. Header Banner -->
        <Border Grid.Row="0" CornerRadius="10" Padding="20,16" Margin="0,0,0,14" Background="{StaticResource BulkHeaderGradient}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="FolderZip24" FontSize="24" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Bulk Import Wizard" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Scan and batch import large collections of purchased tracks. Inspect metadata, preview Smart Import Rules, apply FFmpeg pipeline optimizations, and catalog all tracks in parallel."
                               FontSize="12" Foreground="#E0F2FE" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#33FFFFFF" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock Text="Parallel FFmpeg Pipeline (Max 3 Jobs)" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Folder Picker & Scan Bar -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0"
                            Text="{Binding SelectedFolder, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Select folder containing purchased karaoke files (.mp3, .cdg, .zip, .mp4)..."
                            Icon="{ui:SymbolIcon Folder24}"
                            Margin="0,0,10,0"/>

                <ui:Button Grid.Column="1"
                           Command="{Binding BrowseFolderCommand}"
                           Appearance="Secondary"
                           Content="Browse..."
                           Margin="0,0,8,0"/>

                <ui:Button Grid.Column="2"
                           Command="{Binding ScanFolderCommand}"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Search24}"
                           Content="Scan Folder"
                           IsEnabled="{Binding IsScanning, Converter={x:Null}}"/>
            </Grid>
        </Border>

        <!-- 3. Global Batch Options Toolbar -->
        <Border Grid.Row="2" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Batch Options:" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <CheckBox Content="Normalize All (-16 LUFS)"
                          IsChecked="{Binding NormalizeAll, Mode=TwoWay}"
                          FontWeight="SemiBold" FontSize="11"
                          VerticalAlignment="Center" Margin="0,0,20,0"/>

                <CheckBox Content="Trim Silence All (-50dB)"
                          IsChecked="{Binding TrimSilenceAll, Mode=TwoWay}"
                          FontWeight="SemiBold" FontSize="11"
                          VerticalAlignment="Center" Margin="0,0,20,0"/>

                <CheckBox Content="Generate Waveforms All"
                          IsChecked="{Binding GenerateWaveformAll, Mode=TwoWay}"
                          FontWeight="SemiBold" FontSize="11"
                          VerticalAlignment="Center" Margin="0,0,20,0"/>

                <CheckBox Content="Move to Destination Folders"
                          IsChecked="{Binding MoveFilesToTarget, Mode=TwoWay}"
                          FontWeight="SemiBold" FontSize="11"
                          VerticalAlignment="Center" Margin="0,0,10,0"/>
            </WrapPanel>
        </Border>

        <!-- 4. Preview Table & Track Preview Player -->
        <Border Grid.Row="3" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding PreviewItems}"
                          SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          Background="Transparent"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="36"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <!-- Filename -->
                        <DataGridTextColumn Header="Filename" Binding="{Binding Filename}" Width="2*" IsReadOnly="True" FontWeight="SemiBold"/>

                        <!-- Provider Badge -->
                        <DataGridTemplateColumn Header="Provider" Width="130" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <TextBlock Text="{Binding Provider}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- File Type -->
                        <DataGridTextColumn Header="Format" Binding="{Binding FileType}" Width="75" IsReadOnly="True"/>

                        <!-- Duration -->
                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="65" IsReadOnly="True"/>

                        <!-- Key -->
                        <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="45" IsReadOnly="True" FontWeight="SemiBold"/>

                        <!-- BPM -->
                        <DataGridTextColumn Header="BPM" Binding="{Binding BpmText}" Width="50" IsReadOnly="True"/>

                        <!-- Quality -->
                        <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="65" IsReadOnly="True"/>

                        <!-- Difficulty -->
                        <DataGridTextColumn Header="Difficulty" Binding="{Binding Difficulty}" Width="75" IsReadOnly="True"/>

                        <!-- Vocal Presence -->
                        <DataGridTextColumn Header="Vocals" Binding="{Binding VocalPresence}" Width="105" IsReadOnly="True"/>

                        <!-- Toggles -->
                        <DataGridCheckBoxColumn Header="Normalize" Binding="{Binding WillNormalize, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                        <DataGridCheckBoxColumn Header="Trim Silence" Binding="{Binding WillTrimSilence, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                        <DataGridCheckBoxColumn Header="Waveform" Binding="{Binding WillGenerateWaveform, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State Message -->
                <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding PreviewItems.Count, Converter={x:Null}}">
                    <TextBlock Text="No candidate tracks loaded yet." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Select a folder above and click 'Scan Folder' to populate the preview table." FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Embedded Track Preview Player for Candidates -->
                <controls:TrackPreviewControl Grid.Row="1"
                                              DataContext="{Binding TrackPreview}"
                                              Visibility="{Binding HasTrack, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Margin="8,4,8,8"/>
            </Grid>
        </Border>

        <!-- 5. Progress Bar & Execution Footer -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Status line & stats -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding CurrentProcessingFile}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Counters -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                        <TextBlock Text="{Binding TotalTracks, StringFormat='{}Tracks: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                    </Border>
                    <Border Background="#064E3B" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding SuccessCount, StringFormat='{}Success: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#34D399"/>
                    </Border>
                    <Border Background="#451A03" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding SkippedCount, StringFormat='{}Skipped: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#FB923C"/>
                    </Border>
                    <Border Background="#4C0519" CornerRadius="4" Padding="6,2" Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorCount, StringFormat='{}Errors: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#FB7185"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Progress Bar & Buttons -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="4" ClipToBounds="True" Height="12" Margin="0,0,16,0" VerticalAlignment="Center">
                    <ProgressBar Value="{Binding ProgressPercent}"
                                 Minimum="0" Maximum="100"
                                 Height="12"/>
                </Border>

                <ui:Button Grid.Column="1"
                           Command="{Binding StartImportCommand}"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Play24}"
                           Content="Start Bulk Import"
                           Margin="0,0,8,0"
                           IsEnabled="{Binding IsImporting, Converter={x:Null}}"/>

                <ui:Button Grid.Column="2"
                           Command="{Binding CancelCommand}"
                           Appearance="Secondary"
                           Content="Cancel"
                           Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Margin="0,0,8,0"/>

                <ui:Button Grid.Column="3"
                           Command="{Binding CloseCommand}"
                           Appearance="Secondary"
                           Content="Close"/>
            </Grid>
        </Grid>

        <!-- 6. Completion Summary Modal Dialog Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Background="#99000000"
                Visibility="{Binding IsComplete, Converter={StaticResource BooleanToVisibilityConverter}}"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Border Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="28,24"
                    Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="32" Foreground="#22C55E" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Bulk Import Complete!" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="All selected tracks have been processed, cataloged into the library, and indexed."
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center" Margin="0,0,0,20"/>

                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,4">
                                <TextBlock Text="Total Tracks Imported:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding SummaryReport.TotalImported}" FontSize="12" FontWeight="Bold" Foreground="#22C55E" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="Total Skipped:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding SummaryReport.TotalSkipped}" FontSize="12" FontWeight="Bold" Foreground="#EAB308" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="Total Errors:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding SummaryReport.TotalErrors}" FontSize="12" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Right"/>
                            </Grid>
                            <Separator Margin="0,8,0,8" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            <Grid Margin="0,4">
                                <TextBlock Text="Average Processing Time:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding SummaryReport.AverageProcessingTimeText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <ui:Button Command="{Binding CloseCommand}"
                               Appearance="Primary"
                               Content="Done"
                               HorizontalAlignment="Center"
                               Padding="32,8"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- NotificationHost Toast Overlay (Bottom-Right) -->
        <ItemsControl ItemsSource="{Binding Notifications}"
                      Grid.RowSpan="5"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,16,16"
                      Panel.ZIndex="2000"
                      IsHitTestVisible="True"
                      Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel VerticalAlignment="Bottom"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:ToastNotificationControl/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
