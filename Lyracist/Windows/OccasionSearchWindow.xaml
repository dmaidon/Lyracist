<Window x:Class="Lyracist.Windows.OccasionSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Search Occasion Music" Height="500" Width="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="#0E0E12"
        BorderBrush="#33333C"
        BorderThickness="1.5"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Search Bar -->
            <RowDefinition Height="*"/>    <!-- Tabs & Lists -->
            <RowDefinition Height="Auto"/> <!-- Footer / Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Search Special Occasion Music" FontSize="20" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Find local or streaming tracks to add to this occasion category." FontSize="12" Foreground="#888888" Margin="0,4,0,0"/>
            <Separator Margin="0,12,0,0" Background="#252528"/>
        </StackPanel>

        <!-- Search Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="SearchBox" PlaceholderText="Search title or artist..." Height="36" FontSize="13" KeyDown="SearchBox_KeyDown" />
            <ui:Button Grid.Column="2" Content="Search" Icon="{ui:SymbolIcon Search24}" Click="Search_Click" Appearance="Primary" Background="{StaticResource UIAccentBrush}" Height="36" Padding="16,0"/>
        </Grid>

        <!-- Tabs -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="0,0,0,16">
            <!-- Local Library Tab -->
            <TabItem Header="Local Library">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="LocalResultsList" Background="#13131A" BorderBrush="#252528" BorderThickness="1" SelectionMode="Single" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="#888888" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoLocalText" Grid.Row="0" Text="No local matches found." Foreground="#888888" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </TabItem>



            <!-- External Streams Tab -->
            <TabItem Header="External Streams (YouTube/Spotify)">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="ExternalResultsList" Background="#13131A" BorderBrush="#252528" BorderThickness="1" SelectionMode="Single" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="#888888" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#2B2B3A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Source}" FontSize="10" FontWeight="Bold" Foreground="#3B82F6"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoExternalText" Grid.Row="0" Text="No external streams found." Foreground="#888888" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <ui:ProgressRing x:Name="ExternalLoading" Grid.Row="0" IsIndeterminate="True" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Content="Add Selected" Icon="{ui:SymbolIcon Checkmark24}" Click="AddSelected_Click" Appearance="Primary" HorizontalAlignment="Stretch" Padding="10" Background="{StaticResource UIAccentBrush}"/>
            <ui:Button Grid.Column="2" Content="Cancel" Icon="{ui:SymbolIcon Dismiss24}" Click="Cancel_Click" Appearance="Secondary" HorizontalAlignment="Stretch" Padding="10"/>
        </Grid>
    </Grid>
</Window>
