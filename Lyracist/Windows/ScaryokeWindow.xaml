<!-- Edited on Oct 30, 2026 @ 06:23:30 -> Add manual Scaryoke category assignment controls to ScaryokeWindow -->
<Window x:Class="Lyracist.Windows.ScaryokeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scaryoke Wheel" Height="790" Width="560"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource BackstageBlackoutBrush}"
        Foreground="{StaticResource UITextPrimaryBrush}"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="OnDragMove">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title + close -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="🎃 SCARYOKE WHEEL 🎃"
                       FontSize="30" FontWeight="ExtraBold"
                       Foreground="{StaticResource LyricGlowBrush}"
                       HorizontalAlignment="Center"/>
            <Button Style="{StaticResource OverlayWindowCloseButtonStyle}"
                    Content="&#xE8BB;"
                    Click="OnHide"
                    ToolTip="Close"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"/>
        </Grid>

        <!-- Wheel -->
        <Viewbox Grid.Row="1" Stretch="Uniform">
            <Grid Width="460" Height="480">
                <Canvas x:Name="WheelCanvas"
                        Width="420" Height="420"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="WheelRotate" Angle="0"/>
                    </Canvas.RenderTransform>
                </Canvas>

                <!-- Hub -->
                <Ellipse Width="56" Height="56"
                         HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         Margin="0,0,0,182"
                         Fill="#1E133A" Stroke="{StaticResource LyricGlowBrush}" StrokeThickness="3"/>

                <!-- Pointer -->
                <Polygon Points="212,26 248,26 230,64"
                         Fill="{StaticResource LyricGlowBrush}"
                         Stroke="White" StrokeThickness="2"
                         HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </Grid>
        </Viewbox>

        <!-- Result -->
        <Border Grid.Row="2" Margin="0,14,0,14" Padding="16,10"
                Background="#1E133A" BorderBrush="#FF8E53" BorderThickness="1.5" CornerRadius="10">
            <TextBlock Text="{Binding ResultText}"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="White"
                       TextAlignment="Center" TextWrapping="Wrap"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="ResultShake"/>
                </TextBlock.RenderTransform>
            </TextBlock>
        </Border>

        <!-- Manual Category Assignment -->
        <Border Grid.Row="3" Margin="0,0,0,10" Padding="10,8"
                Background="#18102E" BorderBrush="#4C1D95" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Manual:" Foreground="#FFB74D" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Singers}"
                          SelectedItem="{Binding SelectedTargetSinger, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          Margin="0,0,6,0"
                          FontSize="12"
                          ToolTip="Select target singer (leave blank for current/selected singer)"/>
                <ComboBox Grid.Column="2"
                          IsEditable="True"
                          ItemsSource="{Binding AssignableCategories}"
                          Text="{Binding ManualCategoryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,6,0"
                          FontSize="12"
                          ToolTip="Select or type a Scaryoke category to assign manually"/>
                <Button Grid.Column="3"
                        Content="📌 Set Singer"
                        Command="{Binding AssignManualCategoryCommand}"
                        Padding="10,4" Margin="0,0,4,0"
                        FontSize="11" FontWeight="Bold"
                        Background="#7C3AED" Foreground="White" BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Manually assign this category to the singer without spinning"/>
                <Button Grid.Column="4"
                        Content="✕"
                        Command="{Binding ClearManualCategoryCommand}"
                        Padding="8,4"
                        FontSize="11" FontWeight="Bold"
                        Background="#DC2626" Foreground="White" BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Clear Scaryoke category from the singer"/>
            </Grid>
        </Border>

        <!-- Prevent 2 singers in a row getting the same result -->
        <CheckBox Grid.Row="4" Margin="0,0,0,12"
                  Content="Prevent 2 singers in a row getting the same result"
                  IsChecked="{Binding AvoidRepeats}"
                  ToolTip="When checked, avoids landing on the exact same challenge twice in a row"
                  Foreground="#CBD5E1" FontSize="13"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Spin -->
        <Button x:Name="SpinButton"
                Grid.Row="5"
                Content="🎲 SPIN!"
                FontSize="22" FontWeight="ExtraBold"
                Padding="0,12"
                Background="{StaticResource LyricGlowBrush}"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                Click="OnSpinClick"/>

        <!-- Full-window flash used for the DJ's Choice reveal -->
        <Border x:Name="FlashOverlay" Grid.RowSpan="6" Margin="-20"
                Background="#FF3D00" Opacity="0" IsHitTestVisible="False"/>
    </Grid>
</Window>
