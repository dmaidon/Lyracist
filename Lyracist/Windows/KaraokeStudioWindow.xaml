<!-- Created on Nov 27, 2026 @ 13:17:30 -> Custom Karaoke Track Studio window for vocal isolation, lyric synchronization, duet color assignment, and CDG/MP4 export -->
<Window x:Class="Lyracist.Windows.KaraokeStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="🎙️ Lyracist Karaoke Track Studio — Vocal Isolation, Lyric Sync &amp; CDG/MP4 Creator"
        Width="1120"
        Height="780"
        MinWidth="960"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        Foreground="White"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Banner -->
        <Border Grid.Row="0" CornerRadius="8" Padding="16,10" BorderBrush="#7C3AED" BorderThickness="1.5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2E1065" Offset="0.0" />
                    <GradientStop Color="#1E1B4B" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🎙️ Lyracist Custom Karaoke Track Studio" FontSize="19" FontWeight="Bold" Foreground="#FBBF24" />
                    <TextBlock Text="Turn any audio file into a custom MP3+G (.cdg) or MP4 karaoke track with vocal isolation, key/tempo shift, duet color assignments, translation subtitles, and live timestamp tapping."
                               FontSize="11.5" Foreground="#CBD5E1" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TxtPlaybackClock" Text="00:00.00" FontFamily="Consolas" FontSize="24" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
        </Border>

        <!-- Main Studio 2-Column Workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Audio Source, Vocal Isolation, Key/Tempo, & Raw Lyrics Input -->
            <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="1. Audio Source &amp; Vocal Isolation" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TbInputAudioPath" Grid.Column="0" IsReadOnly="True" Height="30" Padding="6,4" Background="#0F172A" Foreground="White" BorderBrush="#475569" VerticalContentAlignment="Center" />
                            <Button Grid.Column="2" Content="Browse Audio..." Click="OnBrowseAudioClicked" Height="30" Padding="10,2" Background="#7C3AED" Foreground="White" FontWeight="SemiBold" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Song Title" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                <TextBox x:Name="TbSongTitle" Height="28" Padding="6,3" Background="#0F172A" Foreground="White" BorderBrush="#475569" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Artist Name" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                <TextBox x:Name="TbArtistName" Height="28" Padding="6,3" Background="#0F172A" Foreground="White" BorderBrush="#475569" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Vocal Isolation Mode" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                        <ComboBox x:Name="CbVocalMode" SelectedIndex="0" Height="30" Margin="0,0,0,8">
                            <ComboBoxItem Content="Isolate Backing Track (Strip Lead Vocals)" />
                            <ComboBoxItem Content="Practice / Guide Vocal (set level below)" />
                            <ComboBoxItem Content="Keep Original Audio (Already Instrumental)" />
                        </ComboBox>

                        <TextBlock x:Name="LblGuideVocal" Text="Guide Vocal: 25% (used in Guide Vocal mode)" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                        <Slider x:Name="SliderGuideVocal" Minimum="0" Maximum="100" Value="25" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderGuideVocal_ValueChanged" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="LblKeyShift" Text="Key Shift: 0 semitones" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                <Slider x:Name="SliderKeyShift" Minimum="-6" Maximum="6" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderKeyShift_ValueChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="LblTempo" Text="Tempo: 100%" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                <Slider x:Name="SliderTempo" Minimum="50" Maximum="150" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderTempo_ValueChanged" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="2. Paste Raw Lyrics (1 line per phrase)" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,4" />
                    </StackPanel>

                    <TextBox x:Name="TbRawLyrics"
                             Grid.Row="2"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="#0F172A"
                             Foreground="White"
                             BorderBrush="#475569"
                             Padding="8"
                             FontSize="12.5" />

                    <Grid Grid.Row="4" ColumnDefinitions="*, 8, Auto">
                        <Button Grid.Column="0" Content="📋 Load Lyrics into Sync Grid →" Click="OnParseLyricsClicked" Height="32" Background="#0284C7" Foreground="White" FontWeight="Bold" />
                        <Button Grid.Column="2" Content="📂 Import LRC/TXT" Click="OnImportLyricsFileClicked" Height="32" Padding="10,2" Background="#334155" Foreground="White" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Right Column: Interactive Lyric Synchronization & Preview -->
            <Border Grid.Column="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Playback & Live Timestamp Tap Bar -->
                    <Border Grid.Row="0" Background="#0F172A" BorderBrush="#475569" BorderThickness="1" CornerRadius="6" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" x:Name="BtnPlayPause" Content="▶ Play Audio" Click="OnPlayPauseAudioClicked" Height="34" Padding="14,2" Background="#059669" Foreground="White" FontWeight="Bold" />
                            <Button Grid.Column="2" Content="⏹ Stop" Click="OnStopAudioClicked" Height="34" Padding="10,2" Background="#334155" Foreground="White" />

                            <Slider Grid.Column="4" x:Name="SliderAudioSeek" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="SliderAudioSeek_ValueChanged" />

                            <Button Grid.Column="6"
                                    Content="⏱ Stamp Selected Line (F8)"
                                    Click="OnStampNextLineClicked"
                                    Height="34"
                                    Padding="14,2"
                                    Background="#D97706"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    ToolTip="Stamps the current playback time as the Start Time for the selected lyric row and advances to the next line (Shortcut: F8)" />
                        </Grid>
                    </Border>

                    <!-- Synchronized Lyrics DataGrid -->
                    <DataGrid x:Name="GridLyrics"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              CanUserAddRows="True"
                              Background="#0F172A"
                              Foreground="White"
                              RowBackground="#1E293B"
                              AlternatingRowBackground="#152033"
                              BorderBrush="#475569"
                              BorderThickness="1"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Start (mm:ss.ff)" Binding="{Binding StartTimeFormatted, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="110" />
                            <DataGridTextColumn Header="End (mm:ss.ff)" Binding="{Binding EndTimeFormatted, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="110" />
                            <DataGridTextColumn Header="Lyric Line" Binding="{Binding LyricText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                            <DataGridTextColumn Header="Translation / Subtitle (Optional)" Binding="{Binding TranslationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="1.2*" />
                            <DataGridComboBoxColumn Header="Singer / Duet Color"
                                                    SelectedItemBinding="{Binding SingerAssignment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="135" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Export Configuration Card -->
                    <Border Grid.Row="4" Background="#0F172A" BorderBrush="#475569" BorderThickness="1" CornerRadius="6" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Export Format:" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Grid.Column="1" x:Name="CbExportFormat" SelectedIndex="0" Height="30">
                                <ComboBoxItem Content="MP3+G (.mp3 + .cdg)" />
                                <ComboBoxItem Content="MP4 Video (16:9 Stage Wide)" />
                                <ComboBoxItem Content="MP4 Video (9:16 Vertical Social)" />
                            </ComboBox>

                            <CheckBox Grid.Column="3" x:Name="ChkCountdowns" Content="Instrumental Break Countdowns" IsChecked="True" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <CheckBox Grid.Column="4" x:Name="ChkAutoImportToLibrary" Content="Auto-Import into Lyracist Karaoke Library" IsChecked="True" Foreground="#34D399" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Status & Export Actions -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="TxtStatus" Text="Ready. Load an audio track and lyrics to build a custom karaoke track." FontSize="12.5" FontWeight="SemiBold" Foreground="#FBBF24" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="Close" Click="OnCloseClicked" Width="100" Height="36" Background="#334155" Foreground="White" />
            <Button Grid.Column="3" x:Name="BtnExport" Content="🚀 Render &amp; Export Karaoke Track" Click="OnExportClicked" Width="260" Height="36" Background="#7C3AED" Foreground="White" FontWeight="Bold" />
        </Grid>
    </Grid>
</Window>
