<Window x:Class="Lyracist.Windows.EditSingerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:helpers="clr-namespace:Lyracist.Core.Helpers"
        Title="Edit Singer" Height="600" Width="440"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="#0E0E12"
        BorderBrush="#33333C"
        BorderThickness="1.5"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <helpers:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title/Header -->
            <RowDefinition Height="*"/>    <!-- Fields -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Edit Singer" FontSize="20" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Fix a typo'd name, or add/change the song, artist, key, or notes." FontSize="11" Foreground="#888888" Margin="0,4,0,0"/>
            <Separator Margin="0,10,0,0" Background="#252528"/>
        </StackPanel>

        <!-- Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Singer Name" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Singer Name" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding ValidationError}" FontSize="11" Foreground="#F87171" Margin="0,0,0,10"
                           Visibility="{Binding ValidationError, Converter={StaticResource NotEmptyToVisibilityConverter}}"/>

                <TextBlock Text="Duet Partner Name (Optional)" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding DuetPartnerName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. None" Margin="0,0,0,14"/>

                <Separator Margin="0,0,0,14" Background="#252528"/>

                <TextBlock Text="Song Title" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding SongTitle, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Song Title" Margin="0,0,0,14"/>

                <TextBlock Text="Artist" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Artist, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Artist" Margin="0,0,0,14"/>

                <TextBlock Text="Key Transposition (Semitones)" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. +2, -1, 0..." Margin="0,0,0,14"/>

                <TextBlock Text="Notes / Song Request" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Details..." MinLines="2" MaxLines="4" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                <Separator Margin="0,14,0,14" Background="#252528"/>

                <CheckBox IsChecked="{Binding HasSungInLastRound, Mode=TwoWay}"
                          Content="Completed in Last Round (uncheck to restore to rotation)"
                          Foreground="#F87171"
                          FontWeight="SemiBold"
                          Margin="0,0,0,6"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Content="Save" Icon="{ui:SymbolIcon Save24}" Click="Save_Click" Appearance="Primary" HorizontalAlignment="Stretch" Padding="10" Background="{StaticResource UIAccentBrush}"/>
            <ui:Button Grid.Column="2" Content="Cancel" Icon="{ui:SymbolIcon Dismiss24}" Click="Cancel_Click" Appearance="Secondary" HorizontalAlignment="Stretch" Padding="10"/>
        </Grid>
    </Grid>
</Window>
