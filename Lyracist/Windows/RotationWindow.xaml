<!-- Edited on Jul 30, 2026 @ 07:35:00 -> Increased QR Code overlay size and font sizes on public billboard screen -->
<Window x:Class="Lyracist.Windows.RotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Singer Rotation Screen" Height="600" Width="1000"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource BackstageBlackoutBrush}"
        Foreground="{StaticResource UITextPrimaryBrush}"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <!-- Window chrome overlay: fades in when the mouse is over the window. -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="12"
                    Panel.ZIndex="10">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <Button Click="OnToggleFullscreen" ToolTip="Maximize / Restore" Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource OverlayWindowButtonStyle}">
                        <Setter Property="Content" Value="&#xE922;" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                <Setter Property="Content" Value="&#xE923;" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Style="{StaticResource OverlayWindowCloseButtonStyle}"
                    Content="&#xE8BB;"
                    Click="OnHide"
                    ToolTip="Close Rotation Screen" />
        </StackPanel>

        <Grid Margin="60">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Scrolling Marquee Performer Banner -->
        <Border Grid.Row="0"
                x:Name="BannerBorder"
                Background="#1e183a"
                BorderBrush="#FF8E53"
                BorderThickness="1.5"
                Padding="8"
                Height="80"
                CornerRadius="12"
                ClipToBounds="True"
                Margin="0,0,0,32"
                Visibility="{Binding IsAnnouncementVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                SizeChanged="BannerBorder_SizeChanged">
            <Canvas x:Name="BannerCanvas" ClipToBounds="True">
                <TextBlock x:Name="BannerTextBlock"
                           FontSize="34"
                           FontFamily="Montserrat"
                           Foreground="White"
                           Canvas.Top="6"
                           TextOptions.TextFormattingMode="Display" />
            </Canvas>
        </Border>

        <!-- Public Auto-Advance Countdown Strip -->
        <Border Grid.Row="1" 
                Background="#2D1B4E" 
                BorderBrush="#FFD700" 
                BorderThickness="2" 
                CornerRadius="12" 
                Padding="24,16" 
                Margin="0,0,0,32"
                Visibility="{Binding IsAutoAdvanceActive, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Clock24" Foreground="#FFD700" Margin="0,0,12,0" FontSize="26" />
                    <TextBlock Text="Next Singer Up in" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AutoAdvanceRemainingSeconds, StringFormat='{} {0}s'}" FontSize="24" FontWeight="ExtraBold" Foreground="#FFD700" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
                
                <ProgressBar Grid.Column="1" 
                             Minimum="0" 
                             Maximum="{Binding AutoAdvanceMaxSeconds}" 
                             Value="{Binding AutoAdvanceRemainingSeconds}" 
                             Foreground="#FFD700" 
                             Background="#3A2E00" 
                             Height="10" 
                             Margin="24,0" 
                             VerticalAlignment="Center" 
                             IsIndeterminate="False" />
                             
                <TextBlock Grid.Column="2" Text="Prepare Yourselves!" FontSize="16" FontWeight="SemiBold" Foreground="#FF8E53" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2" x:Name="NormalPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Main Singer Display (Left Column) -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <!-- Now Singing -->
                <TextBlock Text="Now Singing"
                           FontSize="36"
                           FontWeight="SemiBold"
                           Foreground="#F5D042" />

                <TextBlock Text="{Binding CurrentSinger}"
                           FontSize="72"
                           FontWeight="ExtraBold"
                           Foreground="#F5D042"
                           Margin="0,16,0,0"
                           TextWrapping="Wrap" />

                <!-- Next Up -->
                <TextBlock Text="Next Up"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#3B82F6"
                           Margin="0,60,0,0" />

                <TextBlock Text="{Binding NextSinger}"
                           FontSize="48"
                           FontWeight="Bold"
                           Foreground="#3B82F6"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Full Queue Display (Right Column) -->
            <Border Grid.Column="1" BorderBrush="#2A2A2A" BorderThickness="1.5" CornerRadius="16" Background="#181818" Padding="32" VerticalAlignment="Center">
                <Grid>
                    <!-- Queue Panel -->
                    <StackPanel Visibility="{Binding ShowQueue, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Singer Rotation"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource StudioSteelBrush}"
                                   Margin="0,0,0,24" />

                        <!-- Display-only List of Rotation Queue -->
                        <ItemsControl ItemsSource="{Binding Rotation}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#252525" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                             <Grid.ColumnDefinitions>
                                                 <ColumnDefinition Width="*" />
                                                 <ColumnDefinition Width="Auto" />
                                                 <ColumnDefinition Width="8" />
                                                 <ColumnDefinition Width="Auto" />
                                             </Grid.ColumnDefinitions>
                                             <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                 <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center">
                                                     <TextBlock.Style>
                                                         <Style TargetType="TextBlock">
                                                             <Setter Property="Foreground" Value="{StaticResource UITextPrimaryBrush}" />
                                                             <Style.Triggers>
                                                                 <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                     <Setter Property="Foreground" Value="#F5D042" />
                                                                 </DataTrigger>
                                                                 <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                     <Setter Property="Foreground" Value="#3B82F6" />
                                                                 </DataTrigger>
                                                             </Style.Triggers>
                                                         </Style>
                                                     </TextBlock.Style>
                                                 </TextBlock>

                                                 <!-- Level Badge -->
                                                 <Border Background="#222222" BorderBrush="#FF8E53" BorderThickness="1" CornerRadius="4" Padding="4,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                     <TextBlock Text="{Binding Level, StringFormat='Lvl {0}'}" FontSize="11" FontWeight="Bold" Foreground="#FF8E53" />
                                                 </Border>

                                                 <!-- Badges List -->
                                                 <ItemsControl ItemsSource="{Binding Badges}" Margin="10,0,0,0" VerticalAlignment="Center">
                                                     <ItemsControl.ItemsPanel>
                                                         <ItemsPanelTemplate>
                                                             <StackPanel Orientation="Horizontal" />
                                                         </ItemsPanelTemplate>
                                                     </ItemsControl.ItemsPanel>
                                                     <ItemsControl.ItemTemplate>
                                                         <DataTemplate>
                                                             <Border Background="#2A1E35" CornerRadius="3" Padding="4,1.5" Margin="0,0,4,0">
                                                                 <TextBlock Text="{Binding}" FontSize="10" FontWeight="SemiBold" Foreground="Thistle" />
                                                             </Border>
                                                         </DataTemplate>
                                                     </ItemsControl.ItemTemplate>
                                                 </ItemsControl>
                                             </StackPanel>
                                             
                                             <!-- Ratings and Score info -->
                                             <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                                                         Visibility="{Binding DataContext.IsRatingSystemEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                 <TextBlock Text="{Binding DataContext.RatingIconSymbol, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#F5D042" FontSize="14" Margin="0,0,4,0"
                                                            Visibility="{Binding HasRatings, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                 <TextBlock Text="{Binding AverageRating, StringFormat='{}{0:F1}'}" FontSize="14" FontWeight="Bold" Foreground="#F5D042" 
                                                            Visibility="{Binding HasRatings, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                 <TextBlock Text="{Binding Score, StringFormat='({0} pts)'}" FontSize="14" FontWeight="Bold" Foreground="#FF8E53" Margin="6,0,0,0" />
                                             </StackPanel>
                                             
                                             <TextBlock Grid.Column="3" Text="{Binding Key, StringFormat='Key: {0}'}" FontSize="14" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center">
                                                 <TextBlock.Style>
                                                     <Style TargetType="TextBlock">
                                                         <Setter Property="Foreground" Value="{StaticResource UITextSecondaryBrush}" />
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                 <Setter Property="Foreground" Value="#F5D042" />
                                                             </DataTrigger>
                                                             <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                 <Setter Property="Foreground" Value="#3B82F6" />
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </TextBlock.Style>
                                             </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Leaderboard Panel -->
                    <StackPanel Visibility="{Binding ShowLeaderboard, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="🏆 Top Performers"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#F5D042"
                                   Margin="0,0,0,24" />

                        <!-- Display-only List of Top Performers -->
                        <ItemsControl ItemsSource="{Binding Leaderboard}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#252525" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Rank Badge -->
                                            <Border Grid.Column="0" CornerRadius="4" Width="28" Height="28" Background="#222222" BorderBrush="#3B82F6" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Rank}" FontSize="16" FontWeight="ExtraBold" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            
                                             <!-- Performer Name + Level details -->
                                             <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                 <StackPanel Orientation="Horizontal">
                                                     <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                                     <Border Background="#2A1A3C" BorderBrush="#F5D042" BorderThickness="1" CornerRadius="4" Padding="4,1.5" Margin="10,0,0,0" VerticalAlignment="Center">
                                                         <TextBlock Text="{Binding Level, StringFormat='Lvl {0}'}" FontSize="11" FontWeight="ExtraBold" Foreground="#F5D042" />
                                                     </Border>
                                                     <TextBlock Text="{Binding LevelName}" FontSize="12" FontStyle="Italic" Foreground="Thistle" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                 </StackPanel>
                                                 
                                                 <TextBlock Text="{Binding Badges}" FontSize="11" Foreground="#888888" Margin="0,2,0,0" />
                                             </StackPanel>
                                            
                                            <!-- Score / Rating details -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                 <TextBlock Text="{Binding DataContext.RatingIconSymbol, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#F5D042" FontSize="14" Margin="0,0,4,0" />
                                                 <TextBlock Text="{Binding AverageRating, StringFormat='{}{0:F1}'}" FontSize="14" FontWeight="Bold" Foreground="#F5D042" Margin="0,0,8,0" />
                                                 <TextBlock Text="{Binding Score, StringFormat='{}{0} pts'}" FontSize="15" FontWeight="ExtraBold" Foreground="#FF8E53" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Star Wars crawl panel (replaces list when SelectedProjectionView='Star Wars Crawl') -->
        <Grid Grid.Row="2" x:Name="CrawlPanel" Background="#FF04060B" Visibility="Collapsed">
            <Rectangle Fill="#FF04060B" />
            <Canvas x:Name="CrawlStarCanvas" SizeChanged="CrawlStarCanvas_SizeChanged" Panel.ZIndex="2" />
            <Viewport3D x:Name="CrawlViewport" Panel.ZIndex="3">
                <Viewport3D.Camera>
                    <PerspectiveCamera Position="0,3,-1" LookDirection="0,-1.2,4" UpDirection="0,1,0" FieldOfView="50" />
                </Viewport3D.Camera>
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <GeometryModel3D>
                            <GeometryModel3D.Geometry>
                                <MeshGeometry3D Positions="-2.2,0,0  2.2,0,0  2.2,0,24  -2.2,0,24"
                                                TriangleIndices="0,2,1  0,3,2"
                                                TextureCoordinates="1,1  0,1  0,0  1,0" />
                            </GeometryModel3D.Geometry>
                            <GeometryModel3D.Material>
                                <EmissiveMaterial x:Name="CrawlMaterial" Brush="Transparent" />
                            </GeometryModel3D.Material>
                            <GeometryModel3D.BackMaterial>
                                <EmissiveMaterial x:Name="CrawlBackMaterial" Brush="Transparent" />
                            </GeometryModel3D.BackMaterial>
                        </GeometryModel3D>
                    </ModelVisual3D.Content>
                </ModelVisual3D>
            </Viewport3D>
            <Canvas x:Name="CrawlOverlayCanvas" Panel.ZIndex="4" ClipToBounds="True" />
        </Grid>

        <!-- Vegas / Broadway Marquee panel -->
        <Grid Grid.Row="2" x:Name="MarqueePanel" Visibility="Collapsed">
            <!-- Deep theatrical backdrop -->
            <Grid.Background>
                <RadialGradientBrush GradientOrigin="0.5,0.42" Center="0.5,0.42" RadiusX="0.75" RadiusY="0.75">
                    <GradientStop Color="#FF3A0A12" Offset="0.0" />
                    <GradientStop Color="#FF1A040A" Offset="0.55" />
                    <GradientStop Color="#FF080205" Offset="1.0" />
                </RadialGradientBrush>
            </Grid.Background>

            <!-- Brass marquee frame -->
            <Border x:Name="MarqueeFrame" Margin="54" CornerRadius="20" BorderThickness="5">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFFE9A8" Offset="0.0" />
                        <GradientStop Color="#FFE0A93B" Offset="0.5" />
                        <GradientStop Color="#FFB9822A" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#CC15060A" Offset="0.0" />
                        <GradientStop Color="#CC0A0205" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid Margin="40,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <TextBlock Grid.Row="0"
                               Text="{Binding PerformerHeaderText}"
                               HorizontalAlignment="Center"
                               FontSize="45"
                               FontWeight="Bold"
                               Foreground="#FFFFD86B"
                               TextOptions.TextFormattingMode="Display">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FFB9822A" BlurRadius="14" ShadowDepth="0" Opacity="0.8" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Current singer name + song (vertically centered) -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding CurrentSinger}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="82"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFFFF"
                                   TextOptions.TextFormattingMode="Ideal">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FFFFD86B" BlurRadius="28" ShadowDepth="0" Opacity="0.85" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="{Binding CurrentSingerSong}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"
                                   FontSize="36"
                                   FontStyle="Italic"
                                   Foreground="#FFFFD86B" />
                        
                        <!-- Rating details -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"
                                    Visibility="{Binding IsRatingSystemEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding RatingIconSymbol}" FontSize="24" FontWeight="Bold" Foreground="#FFFFD86B" Margin="0,0,6,0"
                                       Visibility="{Binding CurrentSingerHasRatings, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding CurrentSingerAverageRating, StringFormat='{}{0:F1}'}" FontSize="24" FontWeight="Bold" Foreground="#FFFFD86B" Margin="0,0,12,0"
                                       Visibility="{Binding CurrentSingerHasRatings, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding CurrentSingerScore, StringFormat='({0} pts)'}" FontSize="24" FontWeight="Bold" Foreground="#FF8E53" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Divider -->
                    <Rectangle Grid.Row="2" Height="2" Margin="40,18" Fill="#55E0A93B" />

                    <!-- Up next strip -->
                    <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,0,0,4">
                        <TextBlock Text="UP NEXT"
                                   HorizontalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#FFE0A93B"
                                   Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding NextSingers}" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="6,4"
                                            Padding="14,6"
                                            CornerRadius="14"
                                            Background="#33E0A93B"
                                            BorderBrush="#66E0A93B"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding}"
                                                   FontSize="18"
                                                   Foreground="#FFF7E8C8" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Chasing light bulbs around the frame -->
            <Canvas x:Name="MarqueeBulbCanvas" Margin="54" SizeChanged="MarqueeBulbCanvas_SizeChanged" Panel.ZIndex="5" />
        </Grid>

        <!-- Vinyl "Now Spinning" turntable panel -->
        <Grid Grid.Row="2" x:Name="VinylPanel" Visibility="Collapsed">
            <!-- Warm dark DJ-booth backdrop -->
            <Grid.Background>
                <RadialGradientBrush GradientOrigin="0.35,0.45" Center="0.35,0.45" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#FF1E1814" Offset="0.0" />
                    <GradientStop Color="#FF120D0A" Offset="0.55" />
                    <GradientStop Color="#FF070504" Offset="1.0" />
                </RadialGradientBrush>
            </Grid.Background>

            <Grid Margin="48,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Turntable -->
                <Viewbox Grid.Column="0" Stretch="Uniform" Margin="0,0,24,0">
                    <Canvas Width="520" Height="520">
                        <!-- Spinning disc group -->
                        <Grid x:Name="VinylDisc" Width="440" Height="440" Canvas.Left="40" Canvas.Top="40"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="VinylRotate" />
                            </Grid.RenderTransform>

                            <!-- Disc body -->
                            <Ellipse Width="440" Height="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FF242424" Offset="0.0" />
                                        <GradientStop Color="#FF0E0E0E" Offset="0.75" />
                                        <GradientStop Color="#FF050505" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Stroke>
                                    <SolidColorBrush Color="#FF333333" />
                                </Ellipse.Stroke>
                            </Ellipse>

                            <!-- Rotating sheen so the spin is visible -->
                            <Ellipse Width="440" Height="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#30FFFFFF" Offset="0.0" />
                                        <GradientStop Color="#00FFFFFF" Offset="0.45" />
                                        <GradientStop Color="#00FFFFFF" Offset="0.55" />
                                        <GradientStop Color="#14FFFFFF" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- Center label -->
                            <Ellipse Width="220" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FFE8BC52" Offset="0.0" />
                                        <GradientStop Color="#FFCB9533" Offset="0.7" />
                                        <GradientStop Color="#FFB9822A" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Stroke>
                                    <SolidColorBrush Color="#FF8A5F1C" />
                                </Ellipse.Stroke>
                            </Ellipse>

                            <!-- Singer name on label -->
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,84"
                                       Width="184" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Text="{Binding CurrentSinger}"
                                       FontSize="22" FontWeight="Bold" Foreground="#FF2A1A05" />

                            <!-- Song title on label -->
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,86,0,0"
                                       Width="184" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Text="{Binding CurrentSongTitle}"
                                       FontSize="16" FontStyle="Italic" Foreground="#FF3A2608" />

                            <!-- Marker dot -->
                            <Ellipse Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,116,0,0" Fill="#FF2A1A05" />

                            <!-- Large 45 RPM center hole -->
                            <Ellipse Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#FF120D0A" Stroke="#66000000" StrokeThickness="1.5" />
                        </Grid>

                        <!-- Tonearm (static) -->
                        <Grid Width="60" Height="300" Canvas.Left="392" Canvas.Top="46"
                              RenderTransformOrigin="0.5,0.12">
                            <Grid.RenderTransform>
                                <RotateTransform Angle="-26" />
                            </Grid.RenderTransform>
                            <!-- Counterweight -->
                            <Ellipse Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FF6B6B6B" Offset="0.0" />
                                        <GradientStop Color="#FF2C2C2C" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <!-- Pivot collar -->
                            <Ellipse Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0" Fill="#FF4A4A4A" />
                            <!-- Arm tube -->
                            <Rectangle Width="10" Height="232" RadiusX="5" RadiusY="5" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF8A8A8A" Offset="0.0" />
                                        <GradientStop Color="#FFCFCFCF" Offset="0.5" />
                                        <GradientStop Color="#FF6E6E6E" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <!-- Headshell -->
                            <Border Width="34" Height="24" CornerRadius="3" Background="#FF1C1C1C" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                        </Grid>
                    </Canvas>
                </Viewbox>

                <!-- Now-playing text -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="♪  NOW SPINNING"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#FFE0A93B"
                               Margin="0,0,0,10"
                               TextOptions.TextFormattingMode="Display" />

                    <TextBlock Text="{Binding CurrentSinger}"
                               TextWrapping="Wrap"
                               FontSize="78"
                               FontWeight="Bold"
                               Foreground="#FFFFFFFF"
                               TextOptions.TextFormattingMode="Ideal">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FFE0A93B" BlurRadius="22" ShadowDepth="0" Opacity="0.6" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <TextBlock Text="{Binding CurrentSingerSong}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               FontSize="34"
                               FontStyle="Italic"
                               Foreground="#FFE8BC52" />
                    
                    <!-- Rating details -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding IsRatingSystemEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding RatingIconSymbol}" FontSize="22" FontWeight="Bold" Foreground="#FFE8BC52" Margin="0,0,6,0"
                                   Visibility="{Binding CurrentSingerHasRatings, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding CurrentSingerAverageRating, StringFormat='{}{0:F1}'}" FontSize="22" FontWeight="Bold" Foreground="#FFE8BC52" Margin="0,0,12,0"
                                   Visibility="{Binding CurrentSingerHasRatings, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding CurrentSingerScore, StringFormat='({0} pts)'}" FontSize="22" FontWeight="Bold" Foreground="#FF8E53" />
                    </StackPanel>

                    <Rectangle Height="2" Margin="0,20,40,16" Fill="#44E0A93B" HorizontalAlignment="Stretch" />

                    <TextBlock Text="ON DECK"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FFB98A3A"
                               Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding NextSingers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontSize="22"
                                           Margin="0,3"
                                           Foreground="#FFE6D6B8" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
            </Grid>
        </Grid>

        <!-- Floating QR Code Badge (Always on top, bottom-right) -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24"
                Background="#D916161E" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="12" Padding="14"
                Panel.ZIndex="100">
            <StackPanel Orientation="Horizontal">
                <Border Background="White" Padding="4" CornerRadius="6" Width="120" Height="120" VerticalAlignment="Center">
                    <Image Source="{Binding QrCodeImage}" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="SCAN TO JOIN" FontSize="15" FontWeight="ExtraBold" Foreground="#3B82F6" />
                    <TextBlock Text="Request Songs!" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding JoinUrl}" FontSize="15" Foreground="#FFF5D042" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Scaryoke Wheel Overlay on Rotation Billboard -->
        <Border x:Name="ScaryokeWheelOverlay" Background="#E504060B" Visibility="Collapsed" Panel.ZIndex="120">
            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="🎃 SCARYOKE WHEEL 🎃" FontSize="36" FontWeight="ExtraBold" Foreground="#FFFF5722" HorizontalAlignment="Center"/>
                
                <Viewbox Grid.Row="1" Stretch="Uniform">
                    <Grid Width="500" Height="520">
                        <Canvas x:Name="BillboardWheelCanvas" Width="460" Height="460" HorizontalAlignment="Center" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
                            <Canvas.RenderTransform>
                                <RotateTransform x:Name="BillboardWheelRotate" Angle="0"/>
                            </Canvas.RenderTransform>
                        </Canvas>
                        
                        <!-- Hub -->
                        <Ellipse Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,200" Fill="#1E133A" Stroke="#FFFF5722" StrokeThickness="4"/>
                        
                        <!-- Pointer -->
                        <Polygon Points="232,20 268,20 250,60" Fill="#FFFF5722" Stroke="White" StrokeThickness="2.5" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Grid>
                </Viewbox>
                
                <Border Grid.Row="2" Margin="0,20,0,0" Padding="24,14" Background="#1E133A" BorderBrush="#FF8E53" BorderThickness="2" CornerRadius="12">
                    <TextBlock x:Name="BillboardResultText" Text="Spin the wheel to seal a singer's fate!" FontSize="22" FontWeight="Bold" Foreground="White" TextAlignment="Center" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>

        <!-- Floating Emoji Reactions Overlay -->
        <Canvas x:Name="ReactionsCanvas" IsHitTestVisible="False" Background="Transparent" />
    </Grid>
</Window>
