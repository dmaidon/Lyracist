<Window x:Class="Lyracist.Windows.RotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Singer Rotation Screen" Height="600" Width="1000"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource BackstageBlackoutBrush}"
        Foreground="{StaticResource UITextPrimaryBrush}"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <!-- Window chrome overlay: fades in when the mouse is over the window. -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="12"
                    Panel.ZIndex="10">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <Button Click="OnToggleFullscreen" ToolTip="Maximize / Restore" Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource OverlayWindowButtonStyle}">
                        <Setter Property="Content" Value="&#xE922;" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                <Setter Property="Content" Value="&#xE923;" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Style="{StaticResource OverlayWindowCloseButtonStyle}"
                    Content="&#xE8BB;"
                    Click="OnHide"
                    ToolTip="Close Rotation Screen" />
        </StackPanel>

        <Grid Margin="60">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Optional Announcement / Special Occasion Banner -->
        <Border Grid.Row="0" 
                Background="#1e183a" 
                BorderBrush="#FF8E53" 
                BorderThickness="1.5"
                CornerRadius="12" 
                Padding="20,12" 
                Margin="0,0,0,32" 
                Visibility="{Binding IsAnnouncementVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="📢" FontSize="26" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" 
                           Text="{Binding AnnouncementBanner}" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="White" 
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Main Singer Display (Left Column) -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <!-- Now Singing -->
                <TextBlock Text="Now Singing"
                           FontSize="36"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource LyricGlowBrush}" />

                <TextBlock Text="{Binding CurrentSinger}"
                           FontSize="72"
                           FontWeight="ExtraBold"
                           Foreground="{StaticResource UITextPrimaryBrush}"
                           Margin="0,16,0,0"
                           TextWrapping="Wrap" />

                <!-- Next Up -->
                <TextBlock Text="Next Up"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource StudioSteelBrush}"
                           Margin="0,60,0,0" />

                <TextBlock Text="{Binding NextSinger}"
                           FontSize="48"
                           FontWeight="Bold"
                           Foreground="{StaticResource UITextSecondaryBrush}"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Full Queue Display (Right Column) -->
            <Border Grid.Column="1" BorderBrush="#2A2A2A" BorderThickness="1.5" CornerRadius="16" Background="#181818" Padding="32" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Singer Rotation"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource StudioSteelBrush}"
                               Margin="0,0,0,24" />

                    <!-- Display-only List of Rotation Queue -->
                    <ItemsControl ItemsSource="{Binding Rotation}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#252525" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource UITextPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Key, StringFormat='Key: {0}'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource LyricGlowBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
