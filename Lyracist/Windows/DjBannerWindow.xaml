<Window x:Class="Lyracist.Windows.DjBannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DJ Banner Screen" Height="600" Width="1000"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Black"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        xmlns:ctrl="clr-namespace:Lyracist.Controls"
        MouseDoubleClick="OnMouseDoubleClick">

    <Grid>
        <Image x:Name="BannerImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <MediaElement x:Name="BannerVideo" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" LoadedBehavior="Manual" UnloadedBehavior="Stop" Visibility="Collapsed" MediaEnded="BannerVideo_MediaEnded" />
        <ctrl:SpectrumBarsOverlay Screen="DjBanners" VerticalAlignment="Bottom" Height="260" />
    </Grid>
</Window>
