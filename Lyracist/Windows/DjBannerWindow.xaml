<!-- Edited on Aug 2, 2026 @ 10:06:00 -> Add MediaElement for looping MP4 video support and name Image element -->
<Window x:Class="Lyracist.Windows.DjBannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DJ Banner Screen" Height="600" Width="1000"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Black"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        MouseDoubleClick="OnMouseDoubleClick">

    <Grid>
        <Image x:Name="BannerImage" Source="{Binding BannerImage}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <MediaElement x:Name="BannerVideo" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" LoadedBehavior="Manual" UnloadedBehavior="Stop" Visibility="Collapsed" MediaEnded="BannerVideo_MediaEnded" />
    </Grid>
</Window>
