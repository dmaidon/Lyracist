<!-- Created on Aug 21, 2026 @ 17:52:00 -> Add enlarged Tablet Kiosk QR code popout window for Lyracist -->
<Window x:Class="Lyracist.Windows.KioskQrCodePopoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Tablet Kiosk Setup"
        Height="540"
        Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#0E0E12"
        BorderBrush="#8B5CF6"
        BorderThickness="1.5"
        ShowInTaskbar="False"
        MouseLeftButtonDown="OnDragMove">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/LyracistTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Large QR Container -->
            <RowDefinition Height="Auto" /> <!-- URL and Copy -->
            <RowDefinition Height="Auto" /> <!-- Tips Box -->
            <RowDefinition Height="Auto" /> <!-- Action Button -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" CornerRadius="10" Padding="14" Margin="0,0,0,16" Background="#1E1B4B" BorderBrush="#8B5CF6" BorderThickness="1">
            <Grid>
                <StackPanel>
                    <TextBlock Text="📟 TABLET KIOSK PORTAL" FontSize="16" FontWeight="Bold" Foreground="#C4B5FD"/>
                    <TextBlock Text="Scan code or visit URL on a venue tablet in landscape orientation" FontSize="11" Foreground="#A78BFA" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource OverlayWindowCloseButtonStyle}"
                        Content="&#xE8BB;"
                        Click="OnCloseClicked"
                        ToolTip="Close"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-6,-6,0"
                        Width="32" Height="26"/>
            </Grid>
        </Border>

        <!-- Large QR Container -->
        <Border Grid.Row="1"
                Width="240"
                Height="240"
                Background="White"
                CornerRadius="12"
                Padding="12"
                HorizontalAlignment="Center"
                BorderBrush="#8B5CF6"
                BorderThickness="2">
            <Image Source="{Binding KioskQrCodeImage}"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   Stretch="Uniform" />
        </Border>

        <!-- Direct URL & Copy -->
        <Border Grid.Row="2"
                Background="#131E32"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,6"
                Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding KioskUrl}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#A78BFA"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <ui:Button Grid.Column="1"
                           Content="Copy Link"
                           Icon="{ui:SymbolIcon Copy24}"
                           Click="OnCopyUrlClicked"
                           Margin="8,0,0,0"
                           Appearance="Secondary"
                           Padding="8,4" />
            </Grid>
        </Border>

        <!-- Setup Tips Box -->
        <Border Grid.Row="3"
                Background="rgba(139, 92, 246, 0.08)"
                BorderBrush="rgba(139, 92, 246, 0.25)"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,8"
                Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="💡 Tablet Kiosk Features:"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#C4B5FD"
                           Margin="0,0,0,4" />
                <TextBlock Text="• Mount tablet in landscape for side-by-side song entry &amp; live rotation queue."
                           FontSize="10"
                           Foreground="#94A3B8"
                           TextWrapping="Wrap" />
                <TextBlock Text="• Patrons can tap their name in the queue to auto-fill next requests."
                           FontSize="10"
                           Foreground="#94A3B8"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0" />
                <TextBlock Text="• Auto-resets 5s after request submission or 45s of idle time."
                           FontSize="10"
                           Foreground="#94A3B8"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Action / Close -->
        <ui:Button Grid.Row="4"
                   Content="Done"
                   Click="OnCloseClicked"
                   Appearance="Primary"
                   HorizontalAlignment="Stretch"
                   Margin="0,14,0,0"
                   Height="34" />
    </Grid>
</Window>
