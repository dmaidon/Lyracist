<!-- Edited on Aug 17, 2026 @ 16:08:30 -> Redesigned Trivia Settings page into 3-column no-scroll layout and pulled Venue/Host from AppSettings -->
<Page x:Class="Lyracist.Views.Pages.TriviaSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Trivia Settings"
      Background="{DynamicResource AppBackgroundBrush}"
      Foreground="{DynamicResource AppTextPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Purple GroupBox theme -->
        <LinearGradientBrush x:Key="PurpleHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#8B5CF6" Offset="0.0" />
            <GradientStop Color="#6366F1" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PurpleBodyBrush" Color="#188B5CF6" />
        <SolidColorBrush x:Key="PurpleBorderBrush" Color="#448B5CF6" />

        <Style x:Key="PurpleCardStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource PurpleBorderBrush}">
                            <StackPanel>
                                <Border Background="{StaticResource PurpleHeaderBrush}" CornerRadius="7,7,0,0" Padding="12,8">
                                    <TextBlock Text="{TemplateBinding Header}" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                                </Border>
                                <Border Background="{StaticResource PurpleBodyBrush}" Padding="12" CornerRadius="0,0,7,7">
                                    <ContentPresenter />
                                </Border>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Blue Card Style -->
        <LinearGradientBrush x:Key="BlueHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0284C7" Offset="0.0" />
            <GradientStop Color="#2563EB" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BlueBodyBrush" Color="#180284C7" />
        <SolidColorBrush x:Key="BlueBorderBrush" Color="#440284C7" />

        <Style x:Key="BlueCardStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BlueBorderBrush}">
                            <StackPanel>
                                <Border Background="{StaticResource BlueHeaderBrush}" CornerRadius="7,7,0,0" Padding="12,8">
                                    <TextBlock Text="{TemplateBinding Header}" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                                </Border>
                                <Border Background="{StaticResource BlueBodyBrush}" Padding="12" CornerRadius="0,0,7,7">
                                    <ContentPresenter />
                                </Border>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,12">
        <Grid HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header Row: Title & Status Message -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="🎯 Trivia Night Pro Settings" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    <TextBlock Text="Configure gameplay timers, scoring rules, speed multipliers, and local Wi-Fi patron access."
                               FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Status Toast -->
                <Border Grid.Column="1" Background="#10B981" CornerRadius="6" Padding="12,6"
                        Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                </Border>
            </Grid>

            <!-- 3-Column Dashboard Content Grid -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- COLUMN 0: Timers & Scoring -->
                <StackPanel Grid.Column="0">
                    <!-- ⏱️ Timers & Flow Card -->
                    <GroupBox Header="⏱️ Question Timers &amp; Flow" Style="{StaticResource BlueCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Time Limit (Sec)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding DefaultQuestionSeconds, UpdateSourceTrigger=PropertyChanged}" Height="28" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Warning (Sec)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding WarningCountdownSeconds, UpdateSourceTrigger=PropertyChanged}" Height="28" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Wrong Option Fade (Sec)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" />
                                <TextBox Text="{Binding AnswerEliminationIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Height="28" />
                            </StackPanel>
                            <CheckBox Content="Auto-advance questions"
                                      IsChecked="{Binding AutoAdvanceQuestions, UpdateSourceTrigger=PropertyChanged}"
                                      FontWeight="SemiBold" FontSize="11" />
                        </StackPanel>
                    </GroupBox>

                    <!-- 🏆 Scoring & Multipliers Card -->
                    <GroupBox Header="🏆 Scoring &amp; Bonus Multipliers" Style="{StaticResource PurpleCardStyle}">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Base Points Per Question" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" />
                                <TextBox Text="{Binding BaseQuestionPoints, UpdateSourceTrigger=PropertyChanged}" Height="28" />
                            </StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <CheckBox Content="Speed Bonus" IsChecked="{Binding SpeedBonusEnabled, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding MaxSpeedBonusPoints, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SpeedBonusEnabled}" Height="28" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <CheckBox Content="Streak Bonus" IsChecked="{Binding StreakBonusEnabled, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding StreakMultiplier, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding StreakBonusEnabled}" Height="28" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>

                <!-- COLUMN 1: Active Venue/Host & Intermission -->
                <StackPanel Grid.Column="2">
                    <!-- 🏢 Active Venue & Game Master (Inherited from App Settings) -->
                    <GroupBox Header="🏢 Active Venue &amp; Host" Style="{StaticResource PurpleCardStyle}">
                        <StackPanel>
                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource PurpleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="4" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="🏢 Venue:" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding VenueName}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource PrimaryHueMidBrush}" TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="🎧 Host/DJ:" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding GameMasterName}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource PrimaryHueMidBrush}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                            <TextBlock Text="ℹ️ Automatically synchronized from primary Venue and DJ settings in application Settings."
                                       FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </GroupBox>

                    <!-- 🔄 Intermission & Countdown Card -->
                    <GroupBox Header="🔄 Intermission &amp; Pre-Game" Style="{StaticResource BlueCardStyle}">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <CheckBox Content="Auto-start Next Round (Min)" IsChecked="{Binding AutoStartNextGameEnabled, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" />
                                <TextBox Text="{Binding NextGameDelayMinutes, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding AutoStartNextGameEnabled}" Height="28" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,2">
                                <CheckBox Content="Pre-Game Countdown (Min)" IsChecked="{Binding AutoStartAfterCountdown, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" />
                                <TextBox Text="{Binding PreGameCountdownMinutes, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding AutoStartAfterCountdown}" Height="28" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>

                <!-- COLUMN 2: Network, Wi-Fi & Save Actions -->
                <StackPanel Grid.Column="4">
                    <!-- 📶 Wi-Fi & Network Card -->
                    <GroupBox Header="📶 Local Network &amp; Wi-Fi Access" Style="{StaticResource PurpleCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Port" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding ServerPort, UpdateSourceTrigger=PropertyChanged}" Height="28" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Wi-Fi SSID" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding WifiSsid, UpdateSourceTrigger=PropertyChanged}" Height="28" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="Wi-Fi Password" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2" />
                                <TextBox Text="{Binding WifiPassword, UpdateSourceTrigger=PropertyChanged}" Height="28" />
                            </StackPanel>
                            <ui:Button Content="Auto-Detect Wi-Fi" Icon="{ui:SymbolIcon Wifi124}" Command="{Binding AutoDetectWifiCommand}"
                                       Appearance="Secondary" Height="30" HorizontalAlignment="Stretch" FontSize="11" />
                        </StackPanel>
                    </GroupBox>

                    <!-- 💾 Action Card -->
                    <Border Background="{StaticResource PurpleBodyBrush}" BorderBrush="{StaticResource PurpleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <StackPanel>
                            <ui:Button Content="Save Settings" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveSettingsCommand}"
                                       Appearance="Primary" Background="#8B5CF6" Foreground="#FFFFFF" Height="34" HorizontalAlignment="Stretch" Margin="0,0,0,6" FontWeight="Bold" FontSize="12" />
                            <ui:Button Content="Reset Defaults" Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding ResetDefaultsCommand}"
                                       Appearance="Secondary" Height="28" HorizontalAlignment="Stretch" FontSize="11" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
