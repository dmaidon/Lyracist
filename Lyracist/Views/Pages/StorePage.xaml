<Page x:Class="Lyracist.Views.Pages.StorePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Store"
      Background="{DynamicResource AppBackgroundBrush}"
      Foreground="{DynamicResource AppTextPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <LinearGradientBrush x:Key="StoreHeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8E2DE2" Offset="0.0"/>
            <GradientStop Color="#4A00E0" Offset="0.6"/>
            <GradientStop Color="#00C9FF" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="StoreSectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="KvButtonStyle" TargetType="ui:Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#FF6F00"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="PtButtonStyle" TargetType="ui:Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#00838F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="KcButtonStyle" TargetType="ui:Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#4A148C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="SfButtonStyle" TargetType="ui:Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Banner -->
            <Border Grid.Row="0" CornerRadius="12" Padding="24,20" Margin="0,0,0,20" Background="{StaticResource StoreHeaderGradient}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ShoppingBag24" FontSize="26" Foreground="White" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Karaoke Store &amp; Licensed Tracks" FontSize="26" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Search licensed karaoke stores online, purchase legal backing tracks, and automatically import them into your Lyracist library."
                                   FontSize="13" Foreground="#E0E7FF" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <Border Background="#33FFFFFF" CornerRadius="8" Padding="12,6" Margin="8,0,0,0">
                            <TextBlock Text="Deep Link &amp; Local Import Workflow" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Search & Deep-Link Section -->
            <Border Grid.Row="1" Style="{StaticResource StoreSectionCard}">
                <StackPanel>
                    <TextBlock Text="Search Licensed Music Stores" FontSize="17" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Enter a song title or artist to search official stores. When you click a store button, your default web browser opens to that store's search results where you can buy and download tracks."
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0"
                                    x:Name="SearchBox"
                                    PlaceholderText="Search song title, artist, or keywords (e.g. 'Sweet Caroline' or 'Queen')..."
                                    Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                    Icon="{ui:SymbolIcon Search24}"
                                    KeyDown="SearchBox_KeyDown"
                                    Margin="0,0,10,0"/>

                        <ui:Button Grid.Column="1"
                                   Command="{Binding SearchKaraokeVersionCommand}"
                                   Style="{StaticResource KvButtonStyle}"
                                   Icon="{ui:SymbolIcon Globe24}"
                                   Content="Search Karaoke Version"
                                   ToolTip="Search licensed tracks on Karaoke-Version.com"
                                   Margin="0,0,8,0"/>

                        <ui:Button Grid.Column="2"
                                   Command="{Binding SearchPartyTymeCommand}"
                                   Style="{StaticResource PtButtonStyle}"
                                   Icon="{ui:SymbolIcon MusicNote2Play20}"
                                   Content="Search Party Tyme"
                                   ToolTip="Search licensed tracks on PartyTyme.net"
                                   Margin="0,0,8,0"/>

                        <ui:Button Grid.Column="3"
                                   Command="{Binding ToggleAdditionalProvidersCommand}"
                                   Appearance="Secondary"
                                   Content="Additional Providers..."
                                   ToolTip="Show or hide additional search providers (Karaoke.com, Sunfly)"/>
                    </Grid>

                    <!-- Additional Providers Collapsible Section -->
                    <Border Visibility="{Binding ShowAdditionalProviders, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="14,10" Margin="0,4,0,10">
                        <StackPanel>
                            <TextBlock Text="Additional Licensed Search Providers:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Command="{Binding SearchKaraokeDotComCommand}"
                                           Style="{StaticResource KcButtonStyle}"
                                           Icon="{ui:SymbolIcon MicPulse24}"
                                           Content="Search Karaoke.com"
                                           ToolTip="Search backing tracks on Karaoke.com"
                                           Margin="0,0,8,0"/>

                                <ui:Button Command="{Binding SearchSunflyCommand}"
                                           Style="{StaticResource SfButtonStyle}"
                                           Icon="{ui:SymbolIcon MusicNote224}"
                                           Content="Search Sunfly Karaoke"
                                           ToolTip="Search Sunfly Karaoke catalog on sunflykaraoke.com"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Tip: Press Enter in the search box to search Karaoke Version instantly."
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- 3. Folder Configuration & Auto-Import Settings -->
            <Border Grid.Row="2" Style="{StaticResource StoreSectionCard}">
                <StackPanel>
                    <TextBlock Text="Folder Settings &amp; Processing Pipeline" FontSize="17" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Configure where downloaded files are detected, destination library folders, and FFmpeg audio enhancement steps."
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                    <!-- Purchased Tracks Folder (Watcher) -->
                    <Grid Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Purchased Tracks Folder (Download Watcher):" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" Text="{Binding PurchasedTracksFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                            <ui:Button Grid.Column="1" Command="{Binding BrowsePurchasedFolderCommand}" Content="Browse..." Margin="0,0,8,0"/>
                            <ui:Button Grid.Column="2" Command="{Binding OpenPurchasedFolderCommand}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Open in File Explorer"/>
                        </Grid>
                    </Grid>

                    <!-- Target Karaoke Folder -->
                    <Grid Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Target Karaoke Folder (.zip, .cdg, .mp4):" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" Text="{Binding TargetKaraokeFolder, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="(Optional) Select folder where karaoke tracks should be organized..." Margin="0,0,8,0"/>
                            <ui:Button Grid.Column="1" Command="{Binding BrowseTargetKaraokeFolderCommand}" Content="Browse..." Margin="0,0,8,0"/>
                            <ui:Button Grid.Column="2" Command="{Binding OpenTargetKaraokeFolderCommand}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Open in File Explorer"/>
                        </Grid>
                    </Grid>

                    <!-- Target Music Folder -->
                    <Grid Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Target Music / Audio Folder (standalone .mp3):" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" Text="{Binding TargetMusicFolder, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="(Optional) Select folder where background music tracks should be organized..." Margin="0,0,8,0"/>
                            <ui:Button Grid.Column="1" Command="{Binding BrowseTargetMusicFolderCommand}" Content="Browse..." Margin="0,0,8,0"/>
                            <ui:Button Grid.Column="2" Command="{Binding OpenTargetMusicFolderCommand}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Open in File Explorer"/>
                        </Grid>
                    </Grid>

                    <!-- Folder Toggles -->
                    <Separator Margin="0,0,0,14" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <ui:ToggleSwitch Content="Automatically import new files from Purchased Tracks folder"
                                             IsChecked="{Binding IsAutoImportEnabled, Mode=TwoWay}"
                                             Margin="0,0,0,4"/>
                            <TextBlock Text="Watches for new .mp3, .cdg, .zip, and .mp4 files and imports them immediately into your library."
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <ui:ToggleSwitch Content="Move imported files to destination folders (Karaoke / Music)"
                                             IsChecked="{Binding MoveFilesToTarget, Mode=TwoWay}"
                                             Margin="0,0,0,4"/>
                            <TextBlock Text="When enabled, newly imported files will be organized into the designated target folders above."
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <!-- FFmpeg Processing Pipeline Section -->
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="14,12" Margin="0,4,0,10">
                        <StackPanel>
                            <TextBlock Text="FFmpeg Import Enhancement Options:" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8"/>
                            <WrapPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,24,6">
                                    <ui:ToggleSwitch Content="Normalize Audio on Import"
                                                     IsChecked="{Binding NormalizeAudioOnImport, Mode=TwoWay}"/>
                                    <TextBlock Text="Loudness normalization to EBU R128 -16 LUFS" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,24,6">
                                    <ui:ToggleSwitch Content="Trim Silence on Import"
                                                     IsChecked="{Binding TrimSilenceOnImport, Mode=TwoWay}"/>
                                    <TextBlock Text="Removes leading and trailing silence below -50dB" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,24,6">
                                    <ui:ToggleSwitch Content="Generate Waveform Preview"
                                                     IsChecked="{Binding GenerateWaveformOnImport, Mode=TwoWay}"/>
                                    <TextBlock Text="Renders visual PNG waveform preview for track review" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="12,8" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Info24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Watcher Status: " FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding WatcherStatus}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 4. Manual Import & Recently Imported Tracks Section -->
            <Border Grid.Row="3" Style="{StaticResource StoreSectionCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Recently Imported Tracks" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ImportStatusMessage}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <ui:Button Grid.Column="1"
                                   Command="{Binding OpenBulkImportCommand}"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon FolderZip24}"
                                   Content="Bulk Import..."
                                   ToolTip="Batch scan, inspect metadata, and import large collections of purchased tracks"
                                   Margin="0,0,8,0"/>

                        <ui:Button Grid.Column="2"
                                   Command="{Binding ImportPurchasedTrackCommand}"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon ArrowUpload24}"
                                   Content="Import Purchased Track..."
                                   ToolTip="Select and import downloaded karaoke, audio, or lyric files manually"
                                   Margin="0,0,8,0"/>

                        <ui:Button Grid.Column="3"
                                   Command="{Binding ClearRecentImportsCommand}"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   Content="Clear Recent"
                                   ToolTip="Clear recent imports list"/>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding RecentImports}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MinHeight="200"
                              MaxHeight="400"
                              Background="Transparent"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Source" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <TextBlock Text="{Binding Source}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="1.5*"/>
                            <DataGridTextColumn Header="Format" Binding="{Binding KaraokeType}" Width="85"/>

                            <!-- Features / Badges Column -->
                            <DataGridTemplateColumn Header="Features &amp; Technical" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Lyrics Attached -->
                                            <Border Visibility="{Binding LyricsPath, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Background="#334155" CornerRadius="3" Padding="4,1" Margin="0,0,4,0" ToolTip="{Binding LyricsPath}">
                                                <TextBlock Text="📜 Lyrics" FontSize="10" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                            </Border>

                                            <!-- Dual Audio -->
                                            <Border Visibility="{Binding HasDualAudio, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Background="#581C87" CornerRadius="3" Padding="4,1" Margin="0,0,4,0" ToolTip="Dual Audio: Multiplexed Vocals &amp; Music">
                                                <TextBlock Text="🎧 Dual-Audio" FontSize="10" FontWeight="SemiBold" Foreground="#F3E8FF"/>
                                            </Border>

                                            <!-- Normalized -->
                                            <Border Visibility="{Binding Normalized, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Background="#065F46" CornerRadius="3" Padding="4,1" Margin="0,0,4,0" ToolTip="Loudness Normalized to -16 LUFS">
                                                <TextBlock Text="⚡ -16 LUFS" FontSize="10" FontWeight="SemiBold" Foreground="#D1FAE5"/>
                                            </Border>

                                            <!-- Trimmed -->
                                            <Border Visibility="{Binding SilenceTrimmed, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Background="#1E3A8A" CornerRadius="3" Padding="4,1" Margin="0,0,4,0" ToolTip="Silence Trimmed">
                                                <TextBlock Text="✂️ Trimmed" FontSize="10" FontWeight="SemiBold" Foreground="#DBEAFE"/>
                                            </Border>

                                            <!-- Waveform -->
                                            <Border Visibility="{Binding WaveformPath, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Background="#701A75" CornerRadius="3" Padding="4,1" Margin="0,0,4,0" ToolTip="{Binding WaveformPath}">
                                                <TextBlock Text="📊 Waveform" FontSize="10" FontWeight="SemiBold" Foreground="#FDF4FF"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="File Path" Binding="{Binding FilePath}" Width="2.5*"/>
                            <DataGridTextColumn Header="Added At" Binding="{Binding AddedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="125"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 5. Import Activity Log Panel (Last 20 Events) -->
            <Border Grid.Row="4" Style="{StaticResource StoreSectionCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Import Activity Log (Last 20 Events)" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="Real-time audit log of download watcher, FFmpeg processing, and metadata extraction events."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <ui:Button Grid.Column="1"
                                   Command="{Binding ToggleLogPanelCommand}"
                                   Appearance="Secondary"
                                   Content="{Binding ShowLogPanel, Converter={x:Null}}"
                                   ToolTip="Toggle Log Panel Visibility"
                                   Margin="0,0,8,0"/>

                        <ui:Button Grid.Column="2"
                                   Command="{Binding ClearImportLogsCommand}"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   Content="Clear Log"
                                   ToolTip="Clear activity log"/>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              Visibility="{Binding ShowLogPanel, Converter={StaticResource BooleanToVisibilityConverter}}"
                              ItemsSource="{Binding ImportLogs}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MinHeight="160"
                              MaxHeight="300"
                              Background="Transparent"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Width="85" FontFamily="Consolas"/>
                            <DataGridTemplateColumn Header="Status" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Track" Binding="{Binding TrackTitle}" Width="1.5*" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="1.2*"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="120"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*"/>
                            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 6. Store Analytics Section -->
            <Border Grid.Row="5" Style="{StaticResource StoreSectionCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ChartMultiple24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Store Analytics" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Statistical insights into imported tracks, provider distribution, file packaging, FFmpeg processing, and import activity."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <ui:Button Grid.Column="1"
                                   Command="{Binding Analytics.RefreshAnalyticsCommand}"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   Content="Refresh Analytics"
                                   ToolTip="Recalculate and update all store analytics"
                                   Margin="0,0,8,0"/>

                        <ui:Button Grid.Column="2"
                                   Command="{Binding Analytics.ToggleAnalyticsCommand}"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon ChevronUpDown24}"
                                   Content="Collapse / Expand"
                                   ToolTip="Toggle Analytics Panel Visibility"/>
                    </Grid>

                    <!-- Analytics Body (Collapsible) -->
                    <StackPanel Grid.Row="1"
                                Margin="0,16,0,0"
                                Visibility="{Binding Analytics.IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">

                        <!-- Row 1: Provider Stats | File Type Stats | FFmpeg Processing Stats -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- A) Provider Statistics Card -->
                            <Border Grid.Column="0" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,8,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="PeopleCommunity24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Provider Statistics" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" Background="#33FFFFFF" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding Analytics.TotalTracks, StringFormat='{}{0} Tracks'}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <!-- Top Provider Pill -->
                                    <Border Background="{DynamicResource AppSurfaceBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Top Provider: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Analytics.MostFrequentProvider}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- KV Row -->
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <Border Background="#FF6F00" CornerRadius="3" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Karaoke Version" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run Text="{Binding Analytics.KvCount, Mode=OneWay}"/>
                                            <Run Text=" ("/><Run Text="{Binding Analytics.KvPercent, StringFormat='{}{0:F1}%', Mode=OneWay}"/><Run Text=")"/>
                                        </TextBlock>
                                    </Grid>

                                    <!-- PT Row -->
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <Border Background="#00838F" CornerRadius="3" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Party Tyme" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run Text="{Binding Analytics.PtCount, Mode=OneWay}"/>
                                            <Run Text=" ("/><Run Text="{Binding Analytics.PtPercent, StringFormat='{}{0:F1}%', Mode=OneWay}"/><Run Text=")"/>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Sunfly Row -->
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <Border Background="#1565C0" CornerRadius="3" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Sunfly" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run Text="{Binding Analytics.SfCount, Mode=OneWay}"/>
                                            <Run Text=" ("/><Run Text="{Binding Analytics.SfPercent, StringFormat='{}{0:F1}%', Mode=OneWay}"/><Run Text=")"/>
                                        </TextBlock>
                                    </Grid>

                                    <!-- KC Row -->
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <Border Background="#4A148C" CornerRadius="3" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Karaoke.com" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run Text="{Binding Analytics.KcCount, Mode=OneWay}"/>
                                            <Run Text=" ("/><Run Text="{Binding Analytics.KcPercent, StringFormat='{}{0:F1}%', Mode=OneWay}"/><Run Text=")"/>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Local Row -->
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <Border Background="#475569" CornerRadius="3" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Local / Custom" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run Text="{Binding Analytics.LocalCount, Mode=OneWay}"/>
                                            <Run Text=" ("/><Run Text="{Binding Analytics.LocalPercent, StringFormat='{}{0:F1}%', Mode=OneWay}"/><Run Text=")"/>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- B) File Type Statistics Card -->
                            <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="14,12" Margin="4,0,4,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <ui:SymbolIcon Symbol="DocumentFolder24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="File Type Statistics" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- MP3+G -->
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" HorizontalAlignment="Left" Background="#1E293B" CornerRadius="3" Padding="6,2">
                                            <TextBlock Text="MP3+G Pairs" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Analytics.Mp3gCount}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- MP4 -->
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" HorizontalAlignment="Left" Background="#2E1065" CornerRadius="3" Padding="6,2">
                                            <TextBlock Text="MP4 Video" FontSize="10" FontWeight="SemiBold" Foreground="#C084FC"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Analytics.Mp4Count}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- ZIPCDG -->
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" HorizontalAlignment="Left" Background="#451A03" CornerRadius="3" Padding="6,2">
                                            <TextBlock Text="ZIPCDG Archive" FontSize="10" FontWeight="SemiBold" Foreground="#FB923C"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Analytics.ZipCdgCount}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Audio Only -->
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" HorizontalAlignment="Left" Background="#334155" CornerRadius="3" Padding="6,2">
                                            <TextBlock Text="Audio-Only (.mp3)" FontSize="10" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Analytics.AudioOnlyCount}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Lyrics File -->
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" HorizontalAlignment="Left" Background="#064E3B" CornerRadius="3" Padding="6,2">
                                            <TextBlock Text="Lyrics (.lrc / .txt)" FontSize="10" FontWeight="SemiBold" Foreground="#34D399"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Analytics.LyricsCount}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- C) FFmpeg Processing Statistics Card -->
                            <Border Grid.Column="2" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="14,12" Margin="8,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <ui:SymbolIcon Symbol="Flash24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="FFmpeg Processing Statistics" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Normalized -->
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" HorizontalAlignment="Left" Background="#065F46" CornerRadius="3" Padding="6,2">
                                            <TextBlock Text="⚡ EBU R128 Normalized" FontSize="10" FontWeight="SemiBold" Foreground="#D1FAE5"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Analytics.NormalizedCount}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Silence Trimmed -->
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" HorizontalAlignment="Left" Background="#1E3A8A" CornerRadius="3" Padding="6,2">
                                            <TextBlock Text="✂️ Silence-Trimmed (-50dB)" FontSize="10" FontWeight="SemiBold" Foreground="#DBEAFE"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Analytics.SilenceTrimmedCount}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Waveform Previews -->
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" HorizontalAlignment="Left" Background="#701A75" CornerRadius="3" Padding="6,2">
                                            <TextBlock Text="📊 Waveform Previews" FontSize="10" FontWeight="SemiBold" Foreground="#FDF4FF"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Analytics.WaveformCount}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Separator Margin="0,6,0,6" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>

                                    <!-- Timing Benchmarks -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Average Time:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Analytics.AvgProcessingTimeText}" FontSize="11" FontWeight="SemiBold"/>
                                    </Grid>

                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Longest (Max):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Analytics.MaxProcessingTimeText}" FontSize="11" FontWeight="SemiBold"/>
                                    </Grid>

                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Shortest (Min):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Analytics.MinProcessingTimeText}" FontSize="11" FontWeight="SemiBold"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Row 2: Quality & Difficulty | Key & BPM Distribution -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>

                            <!-- D) Quality & Difficulty Statistics Card -->
                            <Border Grid.Column="0" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,8,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <ui:SymbolIcon Symbol="StarSettings24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Quality &amp; Difficulty Statistics" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Quality Distribution -->
                                    <TextBlock Text="Quality Distribution" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="4" Padding="6,4" Margin="0,0,4,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Low" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Analytics.QualityLowCount}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="4" Padding="6,4" Margin="2,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Medium" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Analytics.QualityMediumCount}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="4" Padding="6,4" Margin="4,0,0,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="High" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Analytics.QualityHighCount}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Difficulty Distribution -->
                                    <TextBlock Text="Difficulty Distribution" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="4" Padding="6,4" Margin="0,0,4,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Easy" FontSize="10" Foreground="#22C55E" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Analytics.DifficultyEasyCount}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="4" Padding="6,4" Margin="2,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Medium" FontSize="10" Foreground="#EAB308" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Analytics.DifficultyMediumCount}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="4" Padding="6,4" Margin="4,0,0,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Hard" FontSize="10" Foreground="#EF4444" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Analytics.DifficultyHardCount}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Key & BPM Distribution Card -->
                            <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="14,12" Margin="8,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Key Distribution (Horizontal Bars) -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <ui:SymbolIcon Symbol="MusicNote224" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Top Musical Keys" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Analytics.KeyDistribution}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="38"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="50"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Key}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" HorizontalAlignment="Left" Width="{Binding BarWidth}" MaxWidth="100" Height="7" CornerRadius="3" Background="#8B5CF6" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat='{}{0} tracks'}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Separator Grid.Column="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="4,0"/>

                                    <!-- BPM Histogram (Vertical Bars) -->
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <ui:SymbolIcon Symbol="Timer24" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="BPM Distribution" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Analytics.BpmHistogram}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="2,0">
                                                        <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <Border Height="{Binding BarHeight}" Width="16" CornerRadius="3,3,0,0" Background="#0284C7" HorizontalAlignment="Center"/>
                                                        <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,2,0,2"/>
                                                        <TextBlock Text="{Binding RangeLabel}" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Row 3: E) Import Activity Summary (14-Day Timeline & 24-Hour Heatmap) -->
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="14,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="CalendarClock24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Import Activity Summary" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border Background="{DynamicResource AppSurfaceBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Busiest Day: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Analytics.BusiestDay}" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource AppSurfaceBrush}" CornerRadius="4" Padding="8,3">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Busiest Hour: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Analytics.BusiestHour}" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- 14-Day Activity Timeline -->
                                <TextBlock Text="Daily Imports (Last 14 Days):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding Analytics.DailyActivity}" Margin="0,0,0,14">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="1,0">
                                                <TextBlock Text="{Binding Count}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <Border Height="{Binding BarHeight}" Width="16" CornerRadius="2,2,0,0" Background="#6366F1" HorizontalAlignment="Center"/>
                                                <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,2,0,2"/>
                                                <TextBlock Text="{Binding DateLabel}" FontSize="8" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 24-Hour Activity Heatmap -->
                                <TextBlock Text="Imports by Hour (24-Hour Heatmap):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding Analytics.HourlyActivity}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="24"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding ColorHex}" Height="28" CornerRadius="3" Margin="1" ToolTip="{Binding Tooltip}">
                                                <TextBlock Text="{Binding HourLabel}" FontSize="8" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Heatmap Legend -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <TextBlock Text="Activity Level: " FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Border Background="#202538" Width="12" Height="12" CornerRadius="2" Margin="2,0" ToolTip="0 tracks"/>
                                    <Border Background="#0369A1" Width="12" Height="12" CornerRadius="2" Margin="2,0" ToolTip="1-2 tracks"/>
                                    <Border Background="#0284C7" Width="12" Height="12" CornerRadius="2" Margin="2,0" ToolTip="3-5 tracks"/>
                                    <Border Background="#38BDF8" Width="12" Height="12" CornerRadius="2" Margin="2,0" ToolTip="6-9 tracks"/>
                                    <Border Background="#34D399" Width="12" Height="12" CornerRadius="2" Margin="2,0" ToolTip="10+ tracks"/>
                                    <TextBlock Text=" (Low → High)" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
