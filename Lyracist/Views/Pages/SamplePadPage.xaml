<!-- Created on Oct 7, 2026 @ 19:46:00 -> 16-pad DJ sample / jingle pad page with drag-and-drop and context menu -->
<Page x:Class="Lyracist.Views.Pages.SamplePadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:Lyracist.ViewModels"
      mc:Ignorable="d"
      Title="Sample Pad"
      d:DataContext="{d:DesignInstance Type=vm:SamplePadViewModel}"
      Background="{DynamicResource AppBackgroundBrush}"
      Foreground="{DynamicResource AppTextPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Actions Bar -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="16,12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Grid24" FontSize="20" Margin="0,0,8,0" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                        <TextBlock Text="DJ Sample &amp; Jingle Pad" FontSize="18" FontWeight="Bold" />
                        <Border Margin="12,0,0,0" Padding="8,2" CornerRadius="4" Background="#DC2626" Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                            <TextBlock Text="ACTIVE" FontSize="11" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Trigger instant sound effects and jingles. Background music ducks automatically during playback." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="28,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Stop All (Panic)" Icon="{ui:SymbolIcon Stop24}" Command="{Binding StopAllCommand}" Appearance="Danger" Height="36" FontWeight="SemiBold" Padding="16,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4x4 Sample Pads Grid -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Slots}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" Rows="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SamplePadSlotItemViewModel}">
                    <Border Margin="6" CornerRadius="8" BorderThickness="2"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{Binding IsPlaying, Converter={x:Static vm:SamplePadVisualConverters.PlayingBorderBrushConverter}}"
                            AllowDrop="True"
                            Drop="Pad_Drop"
                            DragOver="Pad_DragOver"
                            ToolTip="{Binding DisplayToolTip}"
                            Tag="{Binding SlotIndex}">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Play Sound" Click="MenuPlay_Click" />
                                <MenuItem Header="Edit Pad Properties..." Click="MenuEdit_Click" />
                                <Separator />
                                <MenuItem Header="Clear Pad" Click="MenuClear_Click" />
                            </ContextMenu>
                        </Border.ContextMenu>

                        <Button Click="PadButton_Click" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="12" Cursor="Hand" IsEnabled="{Binding IsMissing, Converter={x:Static vm:SamplePadVisualConverters.InverseBoolConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top Row: Hotkey Badge and Status -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- HotKey Badge -->
                                    <Border Grid.Column="0" Background="{Binding BackgroundBrush}" CornerRadius="4" Padding="6,2" Visibility="{Binding HotKey, Converter={x:Static vm:SamplePadVisualConverters.StringNotEmptyToVisConverter}}">
                                        <TextBlock Text="{Binding HotKey}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                    </Border>

                                    <!-- Missing Indicator -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}">
                                        <ui:SymbolIcon Symbol="Warning20" Foreground="#F59E0B" Margin="0,0,4,0" />
                                        <TextBlock Text="Missing" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Playing Pulse Indicator -->
                                    <Ellipse Grid.Column="2" Width="10" Height="10" Fill="#10B981" Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Center Row: Sound Label -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,8">
                                    <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- Bottom Row: Volume Indicator -->
                                <Grid Grid.Row="2" Visibility="{Binding IsAssigned, Converter={StaticResource BoolToVis}}">
                                    <ProgressBar Value="{Binding Volume}" Minimum="0" Maximum="1" Height="3" Foreground="{Binding BackgroundBrush}" Background="#33FFFFFF" BorderThickness="0" />
                                </Grid>
                            </Grid>
                        </Button>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Page>
