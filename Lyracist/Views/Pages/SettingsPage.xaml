<Page x:Class="Lyracist.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Settings"
      Background="{DynamicResource AppBackgroundBrush}"
      Foreground="{DynamicResource AppTextPrimaryBrush}">

    <Page.Resources>

        <!-- Page header gradient -->
        <LinearGradientBrush x:Key="HeaderBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#614385" Offset="0.0" />
            <GradientStop Color="#516395" Offset="1.0" />
        </LinearGradientBrush>

        <!-- GroupBox header: horizontal purple→blue gradient -->
        <LinearGradientBrush x:Key="GroupBoxHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7B3FA8" Offset="0.0" />
            <GradientStop Color="#4A5AB8" Offset="1.0" />
        </LinearGradientBrush>

        <!-- GroupBox body: very subtle purple tint over the app background -->
        <SolidColorBrush x:Key="GroupBoxBodyBrush"   Color="#22614385" />
        <SolidColorBrush x:Key="GroupBoxBorderBrush" Color="#55614385" />

        <!-- Sub-heading color inside cards (channel names, section labels) -->
        <SolidColorBrush x:Key="SubHeaderBrush" Color="#B07FD4" />

        <!-- ControlTemplate that gives every GroupBox the purple-header card look -->
        <Style x:Key="SettingsGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource GroupBoxBorderBrush}">
                            <StackPanel>
                                <Border Background="{StaticResource GroupBoxHeaderBrush}"
                                        CornerRadius="7,7,0,0"
                                        Padding="14,9">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                </Border>
                                <Border Background="{StaticResource GroupBoxBodyBrush}"
                                        Padding="14"
                                        CornerRadius="0,0,7,7">
                                    <ContentPresenter />
                                </Border>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Page Header ── -->
        <Border Grid.Row="0" CornerRadius="12" Padding="20" Margin="0,0,0,24"
                Background="{StaticResource HeaderBackgroundBrush}">
            <StackPanel>
                <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="Configure audio outputs, visual themes, display assignments, and server options."
                           FontSize="14" Foreground="#F0F0F0" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- ── Settings Content: 4 Columns Grid ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- COLUMN 0: General settings (Theme, Displays, Splash) -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,16">
                    <!-- Theme & Appearance -->
                    <GroupBox Header="Theme &amp; Appearance"
                              Style="{StaticResource SettingsGroupBoxStyle}">
                        <StackPanel>
                            <CheckBox Content="Dark Application Theme Mode"
                                      IsChecked="{Binding IsDarkMode, Mode=TwoWay}"
                                      Margin="0,0,0,12" />

                            <CheckBox Content="Enable Hardware Rendering (Restart required)"
                                      IsChecked="{Binding EnableHardwareAcceleration, Mode=TwoWay}"
                                      Margin="0,0,0,12" />

                            <CheckBox Content="Show splash screen on startup"
                                      IsChecked="{Binding ShowSplashOnStartup, Mode=TwoWay}" />
                        </StackPanel>
                    </GroupBox>

                    <!-- Displays & Projection Monitors -->
                    <GroupBox Header="Displays &amp; Projection"
                              Style="{StaticResource SettingsGroupBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="Lyrics Projection Screen" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Screens}"
                                      SelectedItem="{Binding LyricsScreen, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,0,12" />

                            <TextBlock Text="Singer Rotation Billboard Screen" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Screens}"
                                      SelectedItem="{Binding RotationScreen, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,0,12" />

                            <CheckBox Content="Mirror Lyrics display on control view"
                                      IsChecked="{Binding IsLyricsMirrored, Mode=TwoWay}" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- COLUMN 1: Audio Configuration & Service Logins -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,16">
                    <!-- Audio Configuration -->
                    <GroupBox Header="Audio &amp; Equalizers"
                              Style="{StaticResource SettingsGroupBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="ASIO Output Device" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AsioDevices}"
                                      SelectedItem="{Binding SelectedAsioDevice, Mode=TwoWay}"
                                      Margin="0,0,0,12" />

                            <TextBlock Text="Audio Latency / Buffer" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding BufferSizes}"
                                      SelectedItem="{Binding SelectedBufferSize, Mode=TwoWay}"
                                      Margin="0,0,0,12" />

                            <CheckBox Content="Enable Vocal Noise Gate filter"
                                      IsChecked="{Binding EnableNoiseGate, Mode=TwoWay}"
                                      Margin="0,0,0,12" />

                            <CheckBox Content="Enable Reverb feedback on singer vocals"
                                      IsChecked="{Binding EnableReverb, Mode=TwoWay}" />
                        </StackPanel>
                    </GroupBox>

                    <!-- Service Logins & API Keys -->
                    <GroupBox Header="APIs &amp; Logins"
                              Style="{StaticResource SettingsGroupBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="YouTube API v3 Key" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding YouTubeApiKey, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="AIzaSy..." Margin="0,0,0,10" />

                            <TextBlock Text="Spotify Client ID" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding SpotifyClientId, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ID..." Margin="0,0,0,10" />

                            <TextBlock Text="Spotify Client Secret" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ui:PasswordBox PasswordChar="*" Password="{Binding SpotifyClientSecret, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" PlaceholderText="Secret..." Margin="0,0,0,10" />

                            <TextBlock Text="Amazon AWS Key ID" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding AmazonAccessKey, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="AKIA..." Margin="0,0,0,10" />

                            <TextBlock Text="Amazon AWS Secret" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <ui:PasswordBox PasswordChar="*" Password="{Binding AmazonSecretKey, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" PlaceholderText="AWS Secret..." Margin="0,0,0,10" />

                            <TextBlock Text="Party Tyme Client ID" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding PartyTymeClientId, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="PT-ID..." Margin="0,0,0,10" />

                            <TextBlock Text="Party Tyme Secret" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ui:PasswordBox PasswordChar="*" Password="{Binding PartyTymeClientSecret, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" PlaceholderText="PT-Secret..." />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- COLUMN 2: Tablet Server & Media Decoders -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,16">
                    <!-- Self-Hosted Tablet Server -->
                    <GroupBox Header="Tablet Server Settings"
                              Style="{StaticResource SettingsGroupBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="Listening Network Port" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding TabletPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                            <TextBlock Text="Server Status: " FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding TabletStatus}" FontSize="12" FontStyle="Italic" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Content="Start" Command="{Binding StartTabletServerCommand}" Appearance="Primary" HorizontalAlignment="Stretch" />
                                <ui:Button Grid.Column="2" Content="Stop" Command="{Binding StopTabletServerCommand}" Appearance="Secondary" HorizontalAlignment="Stretch" />
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- Media Engine & Decoders -->
                    <GroupBox Header="Decoders &amp; Layout"
                              Style="{StaticResource SettingsGroupBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="CDG Canvas Scaling Mode" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding CdgScalingModes}"
                                      SelectedItem="{Binding SelectedCdgScalingMode, Mode=TwoWay}"
                                      Margin="0,0,0,12" />

                            <TextBlock Text="MP4 Decoding Backend" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Mp4Backends}"
                                      SelectedItem="{Binding SelectedMp4Backend, Mode=TwoWay}"
                                      Margin="0,0,0,12" />

                            <TextBlock Text="Rendering Target FPS" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding FpsOptions}"
                                      SelectedItem="{Binding FrameRate, Mode=TwoWay}" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- COLUMN 3: Library, Maintenance & Scaryoke categories -->
            <ScrollViewer Grid.Column="6" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,16">
                    <!-- Music Library -->
                    <GroupBox Header="Music Library"
                              Style="{StaticResource SettingsGroupBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="Folders Scanned" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ListBox ItemsSource="{Binding LibraryDirectories}"
                                     SelectedItem="{Binding SelectedLibraryDirectory}"
                                     MaxHeight="120" Height="120" Margin="0,0,0,8"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Icon="{ui:SymbolIcon FolderAdd24}"
                                           Command="{Binding AddLibraryDirectoryCommand}"
                                           Appearance="Primary" ToolTip="Add directory..."/>
                                <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Delete24}"
                                           Command="{Binding RemoveLibraryDirectoryCommand}"
                                           Appearance="Danger" ToolTip="Remove selected directory"/>
                                <ui:Button Grid.Column="6" Icon="{ui:SymbolIcon Play24}"
                                           Command="{Binding ScanSelectedDirectoryCommand}"
                                           Appearance="Secondary" ToolTip="Scan selected folder"/>
                                <ui:Button Grid.Column="8" Icon="{ui:SymbolIcon ArrowSync24}"
                                           Command="{Binding RescanSelectedDirectoryCommand}"
                                           Appearance="Secondary" ToolTip="Rescan selected folder"/>
                            </Grid>

                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:ProgressRing Grid.Column="0" IsIndeterminate="True"
                                                 Width="16" Height="16" Margin="0,0,8,0"
                                                 Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding LibraryStatus}"
                                           FontSize="11" FontStyle="Italic"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>

                            <ui:Button Content="Rescan All Directories"
                                       Icon="{ui:SymbolIcon ArrowSync24}"
                                       Command="{Binding RescanLibraryCommand}"
                                       Appearance="Secondary" HorizontalAlignment="Stretch"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Database Maintenance" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,4" />
                            
                            <CheckBox Content="Seed 15 Test Performers"
                                      IsChecked="{Binding IsTestMode, Mode=TwoWay}"
                                      Margin="0,4,0,10"/>

                            <ui:Button Content="Clear Database"
                                       Command="{Binding ClearDatabaseCommand}"
                                       Appearance="Secondary"
                                       HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </GroupBox>

                    <!-- Scaryoke Settings -->
                    <GroupBox Header="Scaryoke Categories"
                              Style="{StaticResource SettingsGroupBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="Wheel Categories (Max 12)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ListBox ItemsSource="{Binding ScaryokeCategories}"
                                     SelectedItem="{Binding SelectedScaryokeCategory}"
                                     MaxHeight="140" Height="140" Margin="0,0,0,8"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="Add Category" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubHeaderBrush}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0"
                                            Text="{Binding NewScaryokeCategoryName, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Category Name..." Height="26" FontSize="11" />
                                <ui:Button Grid.Column="2" Content="Add"
                                           Command="{Binding AddScaryokeCategoryCommand}"
                                           Appearance="Primary"
                                           Height="26" FontSize="11" />
                            </Grid>

                            <ui:Button Content="Remove Selected"
                                       Icon="{ui:SymbolIcon Delete24}"
                                       Command="{Binding RemoveScaryokeCategoryCommand}"
                                       Appearance="Danger" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>