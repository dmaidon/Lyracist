<Page x:Class="Lyracist.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Settings"
      Background="{DynamicResource AppBackgroundBrush}"
      Foreground="{DynamicResource AppTextPrimaryBrush}">

    <Page.Resources>
        <LinearGradientBrush x:Key="HeaderBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#614385" Offset="0.0"/>
            <GradientStop Color="#516395" Offset="1.0"/>
        </LinearGradientBrush>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" CornerRadius="12" Padding="20" Margin="0,0,0,24" Background="{StaticResource HeaderBackgroundBrush}">
            <StackPanel>
                <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Configure audio outputs, visual themes, display assignments, and server options." FontSize="14" Foreground="#F0F0F0" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Expanders List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="700" HorizontalAlignment="Left">

                <!-- 1. Theme Expander -->
                <Expander Header="Theme &amp; Appearance" Margin="0,0,0,16" Padding="16">
                    <StackPanel>
                        <CheckBox Content="Dark Application Theme Mode"
                                  IsChecked="{Binding IsDarkMode, Mode=TwoWay}"
                                  Margin="0,0,0,16" />
                        
                        <ui:Card Padding="16" Background="{DynamicResource AppSurfaceBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Accent Color Preset" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="The application brand color applied to active controls." FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Rectangle Grid.Column="1" Width="40" Height="40" RadiusX="6" RadiusY="6" Fill="{StaticResource UIAccentBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </ui:Card>
                    </StackPanel>
                </Expander>

                <!-- 2. Audio Expander -->
                <Expander Header="Audio Configuration" Margin="0,0,0,16" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Playback Device Selection" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding AudioDevices}"
                                  SelectedItem="{Binding SelectedAudioDevice}"
                                  Margin="0,0,0,16"
                                  HorizontalAlignment="Stretch" />

                        <TextBlock Text="Master Volume" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="0" Maximum="100" Value="{Binding Volume}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Volume, StringFormat='{}{0}%'}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Output Latency Delay (ms)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="0" Maximum="200" Value="{Binding Latency}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Latency, StringFormat='{}{0}ms'}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- 3. Display Monitor Placement -->
                <Expander Header="Display &amp; Projection Monitors" Margin="0,0,0,16" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Rotation Queue Projector Display Screen" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding Screens}"
                                  SelectedItem="{Binding RotationScreen}"
                                  Margin="0,0,0,16"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DeviceName, StringFormat='Screen {0}'}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Lyrics Player Projector Display Screen" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding Screens}"
                                  SelectedItem="{Binding LyricsScreen}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DeviceName, StringFormat='Screen {0}'}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Expander>

                <!-- 4. Tablet Server Settings -->
                <Expander Header="Self-Hosted Tablet Server" Margin="0,0,0,16" Padding="16">
                    <StackPanel>
                        <TextBlock Text="SignalR Server Port" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ui:TextBox Text="{Binding TabletPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" Width="120" HorizontalAlignment="Left" />

                        <!-- Status Alert Card -->
                        <ui:Card Padding="16" Margin="0,0,0,16" Background="{DynamicResource AppSurfaceBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Kestrel Socket Server Status" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TabletStatus, StringFormat='The lyrics broadcast is currently {0}.'}" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource UIAccentBrush}" CornerRadius="4" Padding="12,6" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TabletStatus}" FontSize="12" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </Grid>
                        </ui:Card>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0" Content="Start Broadcast" Icon="{ui:SymbolIcon Play24}" Command="{Binding StartTabletServerCommand}" Appearance="Primary" Background="{StaticResource UIAccentBrush}" Margin="0,0,8,0" HorizontalAlignment="Stretch" />
                            <ui:Button Grid.Column="1" Content="Stop Broadcast" Icon="{ui:SymbolIcon Stop24}" Command="{Binding StopTabletServerCommand}" Appearance="Secondary" Margin="8,0,0,0" HorizontalAlignment="Stretch" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- 5. MediaEngine Configuration -->
                <Expander Header="Media Engine &amp; Decoders" Margin="0,0,0,16" Padding="16">
                    <StackPanel>
                        <TextBlock Text="CDG Vector Canvas Scaling Mode" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding CdgScalingModes}"
                                  SelectedItem="{Binding SelectedCdgScalingMode}"
                                  Margin="0,0,0,16"
                                  HorizontalAlignment="Stretch" />

                        <TextBlock Text="MP4 Video Decoder Backend Core" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding Mp4Backends}"
                                  SelectedItem="{Binding SelectedMp4Backend}"
                                  Margin="0,0,0,16"
                                  HorizontalAlignment="Stretch" />

                        <TextBlock Text="Decoder Target Frame Rate" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="15" Maximum="60" Value="{Binding FrameRate}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding FrameRate, StringFormat='{}{0} FPS'}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
