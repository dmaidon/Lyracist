<!-- Edited on Oct 3, 2026 @ 12:36:00 -> Provide checkable RadioButtons for Visualizer Mode in SettingsPage -->
<Page x:Class="Lyracist.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Settings"
      Background="{DynamicResource AppBackgroundBrush}"
      Foreground="{DynamicResource AppTextPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Page header gradient -->
        <LinearGradientBrush x:Key="HeaderBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#614385" Offset="0.0" />
            <GradientStop Color="#516395" Offset="1.0" />
        </LinearGradientBrush>

        <!-- GroupBox header: horizontal purple→blue gradient -->
        <LinearGradientBrush x:Key="GroupBoxHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7B3FA8" Offset="0.0" />
            <GradientStop Color="#4A5AB8" Offset="1.0" />
        </LinearGradientBrush>

        <!-- GroupBox body: very subtle purple tint over the app background -->
        <SolidColorBrush x:Key="GroupBoxBodyBrush"   Color="#22614385" />
        <SolidColorBrush x:Key="GroupBoxBorderBrush" Color="#55614385" />

        <!-- Sub-heading color inside cards (channel names, section labels) -->
        <SolidColorBrush x:Key="SubHeaderBrush" Color="#B07FD4" />

        <!-- ControlTemplate that gives every GroupBox the purple-header card look -->
        <Style x:Key="SettingsGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource GroupBoxBorderBrush}">
                            <StackPanel>
                                <Border Background="{StaticResource GroupBoxHeaderBrush}"
                                        CornerRadius="7,7,0,0"
                                        Padding="14,9">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                </Border>
                                <Border Background="{StaticResource GroupBoxBodyBrush}"
                                        Padding="14"
                                        CornerRadius="0,0,7,7">
                                    <ContentPresenter />
                                </Border>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Blue GroupBox theme (Theme, Displays, Presentation) -->
        <LinearGradientBrush x:Key="BlueGroupBoxHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00A6E0" Offset="0.0" />
            <GradientStop Color="#0072ff" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BlueGroupBoxBodyBrush"   Color="#1200c6ff" />
        <SolidColorBrush x:Key="BlueGroupBoxBorderBrush" Color="#550072ff" />

        <Style x:Key="BlueSettingsGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BlueGroupBoxBorderBrush}">
                            <StackPanel>
                                <Border Background="{StaticResource BlueGroupBoxHeaderBrush}"
                                        CornerRadius="7,7,0,0"
                                        Padding="14,9">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                </Border>
                                <Border Background="{StaticResource BlueGroupBoxBodyBrush}"
                                        Padding="14"
                                        CornerRadius="0,0,7,7">
                                    <ContentPresenter />
                                </Border>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Teal GroupBox theme (Audio, Engine, Equalizer, Decoders) -->
        <LinearGradientBrush x:Key="TealGroupBoxHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#13b194" Offset="0.0" />
            <GradientStop Color="#187e85" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="TealGroupBoxBodyBrush"   Color="#1213b194" />
        <SolidColorBrush x:Key="TealGroupBoxBorderBrush" Color="#5513b194" />

        <Style x:Key="TealSettingsGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource TealGroupBoxBorderBrush}">
                            <StackPanel>
                                <Border Background="{StaticResource TealGroupBoxHeaderBrush}"
                                        CornerRadius="7,7,0,0"
                                        Padding="14,9">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                </Border>
                                <Border Background="{StaticResource TealGroupBoxBodyBrush}"
                                        Padding="14"
                                        CornerRadius="0,0,7,7">
                                    <ContentPresenter />
                                </Border>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Green GroupBox theme (Connect & Request Instructions) -->
        <LinearGradientBrush x:Key="GreenGroupBoxHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#059669" Offset="0.0" />
            <GradientStop Color="#047857" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="GreenGroupBoxBodyBrush"   Color="#12059669" />
        <SolidColorBrush x:Key="GreenGroupBoxBorderBrush" Color="#5510B981" />

        <Style x:Key="GreenSettingsGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource GreenGroupBoxBorderBrush}">
                            <StackPanel>
                                <Border Background="{StaticResource GreenGroupBoxHeaderBrush}"
                                        CornerRadius="7,7,0,0"
                                        Padding="14,9">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                </Border>
                                <Border Background="{StaticResource GreenGroupBoxBodyBrush}"
                                        Padding="14"
                                        CornerRadius="0,0,7,7">
                                    <ContentPresenter />
                                </Border>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Orange GroupBox theme (Scaryoke, Simulation Auto-pilot) -->
        <LinearGradientBrush x:Key="OrangeGroupBoxHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#e65c00" Offset="0.0" />
            <GradientStop Color="#f5af19" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="OrangeGroupBoxBodyBrush"   Color="#12e65c00" />
        <SolidColorBrush x:Key="OrangeGroupBoxBorderBrush" Color="#55e65c00" />

        <Style x:Key="OrangeSettingsGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource OrangeGroupBoxBorderBrush}">
                            <StackPanel>
                                <Border Background="{StaticResource OrangeGroupBoxHeaderBrush}"
                                        CornerRadius="7,7,0,0"
                                        Padding="14,9">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                </Border>
                                <Border Background="{StaticResource OrangeGroupBoxBodyBrush}"
                                        Padding="14"
                                        CornerRadius="0,0,7,7">
                                    <ContentPresenter />
                                </Border>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slate GroupBox theme (APIs, Logins, Security keys) -->
        <LinearGradientBrush x:Key="SlateGroupBoxHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#708090" Offset="0.0" />
            <GradientStop Color="#4f5d73" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="SlateGroupBoxBodyBrush"   Color="#12708090" />
        <SolidColorBrush x:Key="SlateGroupBoxBorderBrush" Color="#55708090" />

        <Style x:Key="SlateSettingsGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource SlateGroupBoxBorderBrush}">
                            <StackPanel>
                                <Border Background="{StaticResource SlateGroupBoxHeaderBrush}"
                                        CornerRadius="7,7,0,0"
                                        Padding="14,9">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                </Border>
                                <Border Background="{StaticResource SlateGroupBoxBodyBrush}"
                                        Padding="14"
                                        CornerRadius="0,0,7,7">
                                    <ContentPresenter />
                                </Border>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navy GroupBox theme (Library, Tablet server, KSRotation sync) -->
        <LinearGradientBrush x:Key="NavyGroupBoxHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#3a7bd5" Offset="0.0" />
            <GradientStop Color="#3a6073" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="NavyGroupBoxBodyBrush"   Color="#123a7bd5" />
        <SolidColorBrush x:Key="NavyGroupBoxBorderBrush" Color="#553a7bd5" />

        <Style x:Key="NavySettingsGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource NavyGroupBoxBorderBrush}">
                            <StackPanel>
                                <Border Background="{StaticResource NavyGroupBoxHeaderBrush}"
                                        CornerRadius="7,7,0,0"
                                        Padding="14,9">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                </Border>
                                <Border Background="{StaticResource NavyGroupBoxBodyBrush}"
                                        Padding="14"
                                        CornerRadius="0,0,7,7">
                                    <ContentPresenter />
                                </Border>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gold GroupBox theme (Performer ratings, stars) -->
        <LinearGradientBrush x:Key="GoldGroupBoxHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#f9d423" Offset="0.0" />
            <GradientStop Color="#d4af37" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="GoldGroupBoxBodyBrush"   Color="#12f9d423" />
        <SolidColorBrush x:Key="GoldGroupBoxBorderBrush" Color="#55f9d423" />

        <Style x:Key="GoldSettingsGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource GoldGroupBoxBorderBrush}">
                            <StackPanel>
                                <Border Background="{StaticResource GoldGroupBoxHeaderBrush}"
                                        CornerRadius="7,7,0,0"
                                        Padding="14,9">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                </Border>
                                <Border Background="{StaticResource GoldGroupBoxBodyBrush}"
                                        Padding="14"
                                        CornerRadius="0,0,7,7">
                                    <ContentPresenter />
                                </Border>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Page Header ── -->
        <Border Grid.Row="0" CornerRadius="12" Padding="20" Margin="0,0,0,24"
                Background="{StaticResource HeaderBackgroundBrush}">
            <StackPanel>
                <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="Configure audio outputs, visual themes, display assignments, and server options."
                           FontSize="14" Foreground="#F0F0F0" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- ── Settings Content: Unified Top TabControl ── -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- ── TAB 1: Presentation & DJ ── -->
            <TabItem Header="Presentation &amp; DJ" FontSize="12">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Column 0 -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,16">
                            <!-- Theme & Appearance -->
                            <GroupBox Header="Theme &amp; Appearance" Style="{StaticResource BlueSettingsGroupBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="Application Theme Mode" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox SelectedItem="{Binding ThemeMode, Mode=TwoWay}" ItemsSource="{Binding ThemeModes}" Margin="0,0,0,12" Width="125" HorizontalAlignment="Left" />
                                    <CheckBox Content="Enable Hardware Rendering (Restart required)" IsChecked="{Binding EnableHardwareAcceleration, Mode=TwoWay}" Margin="0,0,0,12" />
                                    <CheckBox Content="Show splash screen on startup" IsChecked="{Binding ShowSplashOnStartup, Mode=TwoWay}" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Column 2 -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,16">
                            <!-- DJ & Venue Settings -->
                            <GroupBox Header="DJ &amp; Venue Management" Style="{StaticResource SettingsGroupBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="DJ / Host Name" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding DjName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="DJ Name..." Margin="0,0,0,12" />
                                    <TextBlock Text="Venues List" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ListBox ItemsSource="{Binding Venues}" SelectedItem="{Binding SelectedVenue, Mode=TwoWay}" MaxHeight="120" Height="120" Margin="0,0,0,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="Add Venue" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubHeaderBrush}" Margin="0,0,0,4" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0" Text="{Binding NewVenueName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Venue Name..." Height="35" FontSize="11" />
                                        <ui:Button Grid.Column="2" Content="Add" Command="{Binding AddVenueCommand}" Appearance="Primary" Height="26" FontSize="11" />
                                    </Grid>
                                    <ui:Button Content="Remove Selected Venue" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveVenueCommand}" Appearance="Danger" HorizontalAlignment="Stretch" Margin="0,0,0,8" />

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:Button Grid.Column="0" Content="📍 Tag GPS" Command="{Binding TagCurrentVenueLocationCommand}" Appearance="Secondary" HorizontalAlignment="Stretch" ToolTip="Tag current GPS coordinates to selected venue" Height="30" FontSize="11" />
                                        <ui:Button Grid.Column="2" Content="Auto-Detect" Command="{Binding AutoDetectVenueCommand}" Appearance="Secondary" HorizontalAlignment="Stretch" ToolTip="Detect nearest venue via GPS or Wi-Fi" Height="30" FontSize="11" />
                                    </Grid>
                                    <TextBlock Text="{Binding SelectedVenueLocationStatus}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

                                    <Separator Margin="0,12,0,12" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                                    <TextBlock Text="Venue Graphics (Slideshow)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ListBox ItemsSource="{Binding SelectedVenueGraphics}" MaxHeight="100" Height="100" Margin="0,0,0,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding}" />
                                                    <ui:Button Grid.Column="1" Content="✕"
                                                               Command="{Binding DataContext.RemoveVenueGraphicCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                               CommandParameter="{Binding}"
                                                               Appearance="Transparent"
                                                               Padding="4,2"
                                                               FontSize="10" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <ui:Button Content="Add Graphic..." Icon="{ui:SymbolIcon Add24}" Command="{Binding AddVenueGraphicCommand}" Appearance="Secondary" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </GroupBox>

                            <!-- Auto-Advance Countdown Settings -->
                            <GroupBox Header="Auto-Advance Countdown" Style="{StaticResource SettingsGroupBoxStyle}">
                                <StackPanel>
                                    <CheckBox Content="Enable Auto-Advance Countdown" IsChecked="{Binding EnableAutoAdvance, Mode=TwoWay}" Margin="0,0,0,12" />

                                    <TextBlock Text="Countdown Duration" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="5" Maximum="30" Value="{Binding AutoAdvanceCountdownSeconds, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding AutoAdvanceCountdownSeconds, StringFormat='{}{0}s'}" FontSize="12" FontWeight="Bold" Width="30" TextAlignment="Right" VerticalAlignment="Center" Foreground="White" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ── TAB 2: Display (4 Equal Columns) ── -->
            <TabItem Header="Display" FontSize="12" Background="#FFF1B2B2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" Background="#FFDA7171">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Column 0: Monitors & Screen Assignments -->
                        <StackPanel Grid.Column="0" Margin="0,0,0,16">
                            <GroupBox Header="Monitors &amp; Screen Assignments" Style="{StaticResource BlueSettingsGroupBoxStyle}">
                                <StackPanel>
                                    <CheckBox Content="Enable Lyrics Projection Screen" IsChecked="{Binding IsLyricsActive, Mode=TwoWay}" Margin="0,0,0,4" />
                                    <TextBlock Text="Lyrics Projection Screen" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Screens}" SelectedItem="{Binding LyricsScreen, Mode=TwoWay}" DisplayMemberPath="DisplayName" Margin="0,0,0,4" />
                                    <CheckBox Content="Show QR Code on Lyrics Screen" IsChecked="{Binding ShowQrCodeOnLyricsScreen, Mode=TwoWay}" Margin="0,0,0,12" ToolTip="Displays the song-request QR code badge in the corner of the Lyrics Projection Screen." />

                                    <CheckBox Content="Enable Singer Rotation Billboard Screen" IsChecked="{Binding IsRotationActive, Mode=TwoWay}" Margin="0,0,0,4" />
                                    <TextBlock Text="Singer Rotation Billboard Screen" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Screens}" SelectedItem="{Binding RotationScreen, Mode=TwoWay}" DisplayMemberPath="DisplayName" IsEnabled="{Binding IsRotationScreenSelectorEnabled}" Margin="0,0,0,4" />
                                    <CheckBox Content="Show QR Code on Rotation Screen" IsChecked="{Binding ShowQrCodeOnRotationScreen, Mode=TwoWay}" Margin="0,0,0,12" ToolTip="Displays the song-request QR code badge in the corner of the Singer Rotation Billboard Screen." />

                                    <CheckBox Content="Enable DJ Banner Screen" IsChecked="{Binding IsDjBannerActive, Mode=TwoWay}" Margin="0,0,0,4" ToolTip="Toggle the DJ Banner projection screen on/off." />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="DJ Banner Screen" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" Cursor="Help"
                                                   ToolTip="If broadcasting to an older TV, check its picture settings for 'Overscan', 'Just Scan', 'Screen Fit', or '1:1 Pixel Mapping' and disable overscan - otherwise the TV may crop and zoom into the banner, cutting off its edges." />
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding Screens}" SelectedItem="{Binding DjBannerScreen, Mode=TwoWay}" DisplayMemberPath="DisplayName" Margin="0,0,0,12" />

                                    <TextBlock Text="Billboard View Mode" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding ProjectionViews}" SelectedItem="{Binding SelectedProjectionView, Mode=TwoWay}" Margin="0,0,0,6" />
                                    <CheckBox Content="Reduced projection effects (slower PCs)" IsChecked="{Binding ReducedProjectionEffects, Mode=TwoWay}" Margin="0,0,0,6"
                                              ToolTip="Use fewer particles and skip glow/blur effects on the themed rotation screens. Turn this on if the rotation display stutters on an older laptop or a busy venue PC." />
                                    <Expander Header="View Mode Descriptions &amp; Themes" Margin="0,0,0,12" IsExpanded="False">
                                        <StackPanel Margin="4,6">
                                            <TextBlock Text="• Normal List: Displays active singers in clean, high-contrast, self-wrapping columns. The active singer is highlighted in crimson." Margin="0,2" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                            <TextBlock Text="• Star Wars Crawl: Animates the rotation queue in a 3D perspective scroll, moving up over a gorgeous twinkling starfield with distant galaxies." Margin="0,2" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                            <TextBlock Text="• Vegas Marquee: A Vegas/Broadway theater marquee: the current singer's name in giant glowing letters inside a brass frame ringed by chasing light bulbs." Margin="0,2" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                            <TextBlock Text="• Vinyl Turntable: A 'Now Spinning' turntable: a continuously spinning 45 single with singer's name on the gold label, resting tonearm, and On Deck strip." Margin="0,2" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                            <TextBlock Text="• Disco Ball: A mirror-ball dance club spectacle: rotating facets cast drifting light spots and sweeping colored stage beams across the venue floor." Margin="0,2" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                            <TextBlock Text="• Synthwave Grid: Retro 80s outrun aesthetic: animated perspective horizon grid in neon cyan/magenta with a glowing retro sun backdrop." Margin="0,2" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                            <TextBlock Text="• Concert Festival Lineup: Main-stage music festival poster vibe: towering stage trusses, drifting golden concert sparkles, and sweeping spotlights." Margin="0,2" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                            <TextBlock Text="• Casino Slot Reels: High-roller casino excitement: singer names spin rapidly on slot-machine reels that clunk to a stop with a jackpot coin flourish." Margin="0,2" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                            <TextBlock Text="• Jukebox: Classic 1950s rock-and-roll diner cabinet: glowing chrome arches, animated rising bubble-tube light columns, and illuminated pushbuttons." Margin="0,2" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                            <TextBlock Text="• Stadium Jumbotron: Massive arena LED scoreboard: sweeping stadium floodlights crisscross the arena as the singer is announced like a stadium superstar." Margin="0,2" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                            <TextBlock Text="• Movie Theater 'Now Showing': Vintage Hollywood premiere aesthetic: vintage 35mm film leader countdown sweep, flickering projector beam, and marquee lobby poster cards." Margin="0,2" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                            <TextBlock Text="• Purple Velvet Curtain: Opulent royal purple velvet stage with undulating drapery folds, overhead stage wash, and warm champagne-gold chasing marquee bulbs." Margin="0,2" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                        </StackPanel>
                                    </Expander>

                                    <CheckBox Content="Float Current Singer to Top of Rotation" IsChecked="{Binding FloatCurrentSingerToTop, Mode=TwoWay}" Margin="0,0,0,4" ToolTip="When enabled, the current active performer automatically floats to index 0 of the rotation queue." />
                                    <CheckBox Content="Block Duplicate Songs in Session" IsChecked="{Binding BlockDuplicateSongsInSession, Mode=TwoWay}" Margin="0,0,0,4" ToolTip="When enabled, patrons cannot request a song via the patron portal that has already been performed or queued in the current session." />
                                    <CheckBox Content="Mirror Lyrics display on control view" IsChecked="{Binding IsLyricsMirrored, Mode=TwoWay}" Margin="0,4,0,12" />

                                    <CheckBox Content="Show Estimated Wait Time on Rotation Screens" IsChecked="{Binding ShowEstimatedWaitTime, Mode=TwoWay}" Margin="0,0,0,4" ToolTip="Shows/hides the {N} minute wait-time badge next to each waiting singer's name on the audience-facing rotation displays." />

                                    <TextBlock Text="Default Song Length (Estimated Wait Time)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" ToolTip="Used to estimate how long a queued singer's wait is on the rotation screen, whenever that singer's actual song length isn't known." />
                                    <Grid Margin="0,0,0,4" IsEnabled="{Binding ShowEstimatedWaitTime}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="2" Maximum="8" TickFrequency="0.25" Value="{Binding DefaultSongLengthMinutes, Mode=TwoWay}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding DefaultSongLengthMinutes, StringFormat='{}{0:0.00} min'}" FontSize="12" FontWeight="Bold" Width="60" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!-- Lyrics Screen Audio Visualizer -->
                            <GroupBox Header="Lyrics Screen Audio Visualizer" Style="{StaticResource BlueSettingsGroupBoxStyle}">
                                <StackPanel>
                                    <CheckBox Content="Enable Audio Visualizer" IsChecked="{Binding EnableLyricsVisualizer, Mode=TwoWay}" Margin="0,0,0,8" ToolTip="Renders an animated audio spectrum visualizer along the bottom of the active Lyrics projection screen." />

                                    <TextBlock Text="Visualizer Mode" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <RadioButton Content="Audio Spectrum (Live FFT)" IsChecked="{Binding IsVisualizerModeFft, Mode=TwoWay}" Margin="0,0,16,0" GroupName="VisualizerModeGroup" />
                                        <RadioButton Content="Simulated / Ambient" IsChecked="{Binding IsVisualizerModeSimulated, Mode=TwoWay}" GroupName="VisualizerModeGroup" />
                                    </StackPanel>

                                    <TextBlock Text="Visualizer Color Style" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding VisualizerStyles}" SelectedItem="{Binding LyricsVisualizerStyle, Mode=TwoWay}" Margin="0,0,0,10" />

                                    <TextBlock Text="Bar Width" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding VisualizerBarWidths}" SelectedItem="{Binding LyricsVisualizerBarWidth, Mode=TwoWay}" Margin="0,0,0,10" />

                                    <TextBlock Text="Visualizer Opacity" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0.1" Maximum="1.0" TickFrequency="0.05" Value="{Binding LyricsVisualizerOpacity, Mode=TwoWay}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding LyricsVisualizerOpacity, StringFormat='{}{0:P0}'}" FontSize="12" FontWeight="Bold" Width="45" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <!-- Column 1: DJ & Special Event Banners, Session Schedule -->
                        <StackPanel Grid.Column="2" Margin="0,0,0,16">
                            <GroupBox Header="DJ &amp; Event Banners" Style="{StaticResource BlueSettingsGroupBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="DJ Banner Image" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding DjBanners}" SelectedItem="{Binding SelectedDjBanner, Mode=TwoWay}" DisplayMemberPath="FileName" HorizontalAlignment="Stretch" />
                                        <ui:Button Grid.Column="2" Content="Upload" Icon="{ui:SymbolIcon ArrowUpload24}" Command="{Binding UploadDjBannerCommand}" />
                                        <ui:Button Grid.Column="4" Content="Delete" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteDjBannerCommand}" Appearance="Danger" />
                                    </Grid>

                                    <!-- Banner Preview -->
                                    <Border Height="80" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}" Background="#11000000" Margin="0,0,0,8" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding SelectedDjBanner.FullPath}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedDjBanner.IsVideo}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedDjBanner}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedDjBanner.IsVideo}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <ui:SymbolIcon Symbol="Video24" FontSize="26" HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="Animated Video Banner (MP4)" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="No DJ Banner Selected" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedDjBanner}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <CheckBox Content="Show request QR Code overlay on DJ Banner" IsChecked="{Binding IsDjBannerQrCodeEnabled, Mode=TwoWay}" Margin="0,4,0,12" ToolTip="Displays the patron request portal QR code overlay directly on the active DJ Banner." />

                                    <TextBlock Text="Stadium Jumbotron Sponsor Banner" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding JumbotronBanners}" SelectedItem="{Binding SelectedJumbotronBanner, Mode=TwoWay}" DisplayMemberPath="FileName" HorizontalAlignment="Stretch" Margin="0,0,0,12"
                                              ToolTip="Optional banner shown in the bottom sponsor box of the Stadium Jumbotron projection view. When 'None' is selected, a tip-your-bartenders-and-DJ reminder shows instead." />

                                    <Separator Margin="0,4,0,12" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                                    <!-- Special Event Banners Configuration -->
                                    <TextBlock Text="Special Event Banners Mapping" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding SpecialEventsList}" Margin="0,0,0,12">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:TextBox Grid.Column="0" Text="{Binding EventName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" FontSize="11" />
                                                    <ComboBox Grid.Column="2"
                                                              ItemsSource="{Binding DataContext.AvailableEventBannerFiles, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              SelectedItem="{Binding BannerFileName, Mode=TwoWay}"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Center" FontSize="11" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ui:Button Content="Save Special Events Mapping" Command="{Binding SaveSpecialEventsCommand}" Icon="{ui:SymbolIcon Save24}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="New Performer Welcome Screen" Style="{StaticResource BlueSettingsGroupBoxStyle}" Margin="0,12,0,0">
                                <StackPanel>
                                    <CheckBox Content="Show 'Welcome to our new performer' screen when a new singer joins"
                                              IsChecked="{Binding WelcomeScreenEnabled, Mode=TwoWay}"
                                              Margin="0,0,0,6"
                                              ToolTip="Covers the rotation and DJ Banner screens with a randomly designed welcome for each singer who is new to tonight's rotation." />
                                    <TextBlock Text="Welcome Screen Display" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                    <ComboBox ItemsSource="{Binding WelcomeScreenChoices}" SelectedValue="{Binding WelcomeScreenMonitor, Mode=TwoWay}"
                                              SelectedValuePath="DeviceName" DisplayMemberPath="Label" Margin="0,0,0,8"
                                              ToolTip="Default overlays the rotation and DJ Banner screens where they already are. Pick a monitor to show the welcome there instead; the rotation and DJ Banner are not changed and come back when it ends." />
                                    <TextBlock Text="Welcome Screen Style" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                    <ComboBox ItemsSource="{Binding WelcomeDesignChoices}" SelectedValue="{Binding WelcomeScreenDesign, Mode=TwoWay}"
                                              SelectedValuePath="Id" DisplayMemberPath="Name" Margin="0,0,0,8"
                                              ToolTip="Choose a specific welcome screen design to always display, or select 'All (Random)' to rotate through all models." />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                        <TextBlock Text="Show welcome for:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                        <TextBox Text="{Binding WelcomeScreenSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Width="50" Height="26" Padding="4,1" TextAlignment="Center" VerticalAlignment="Center"
                                                 ToolTip="3 to 120 seconds." />
                                        <TextBlock Text="sec" VerticalAlignment="Center" Margin="6,0,12,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                        <Button Content="Preview" Command="{Binding PreviewWelcomeScreenCommand}" Padding="10,3" FontSize="11"
                                                ToolTip="Shows a sample welcome on the rotation and DJ Banner screens." />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Session Schedule &amp; Request Cutoff" Style="{StaticResource BlueSettingsGroupBoxStyle}" Margin="0,12,0,0">
                                <StackPanel>
                                    <CheckBox Content="Enable Session Schedule" IsChecked="{Binding EnableSessionSchedule, Mode=TwoWay}" Margin="0,0,0,8" ToolTip="Restrict patron portal and kiosk requests to the scheduled session timeframe." />
                                    <Grid Margin="0,0,0,10" IsEnabled="{Binding EnableSessionSchedule}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Start Time" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding TimeOptions}" SelectedItem="{Binding SessionStartTime, Mode=TwoWay}" IsEditable="True" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Stop Time" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding TimeOptions}" SelectedItem="{Binding SessionStopTime, Mode=TwoWay}" IsEditable="True" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Content="Enable Last Request Cutoff" IsChecked="{Binding EnableLastRequestTime, Mode=TwoWay}" Margin="0,0,0,8" ToolTip="Set a cutoff time after which patrons and kiosk users can no longer submit song requests." />
                                    <StackPanel IsEnabled="{Binding EnableLastRequestTime}" Margin="0,0,0,4">
                                        <TextBlock Text="Last Request Time" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding TimeOptions}" SelectedItem="{Binding LastRequestTime, Mode=TwoWay}" IsEditable="True" />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <!-- Column 2: Star Wars Crawl & Spaceship Overlay -->
                        <StackPanel Grid.Column="4" Margin="0,0,0,16">
                            <GroupBox Header="Star Wars Crawl &amp; Spaceship" Style="{StaticResource BlueSettingsGroupBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="Crawl Intro Text Template" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding CrawlBannerTypes}" SelectedItem="{Binding SelectedCrawlBannerType, Mode=TwoWay}" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding CrawlBannerPreviewText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="4,0,4,12" FontStyle="Italic" />

                                    <StackPanel Visibility="{Binding IsCustomCrawlBannerSelected, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Custom Crawl Text" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubHeaderBrush}" Margin="0,0,0,4" />
                                        <ui:TextBox Text="{Binding CrawlBannerCustomText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Enter custom Star Wars crawl text..." AcceptsReturn="True" TextWrapping="Wrap" Height="70" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />
                                    </StackPanel>

                                    <!-- Spaceship Overlay Settings -->
                                    <Separator Margin="0,4,0,12" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                    <TextBlock Text="Spaceship Overlay Settings" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Font Size" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                            <ui:TextBox Text="{Binding CrawlSpaceshipFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="26" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Duration (s)" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" ToolTip="Flight duration in seconds" />
                                            <ui:TextBox Text="{Binding CrawlSpaceshipDuration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="13" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Interval (s)" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" ToolTip="Interval in seconds between spawns" />
                                            <ui:TextBox Text="{Binding CrawlSpaceshipFrequency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="60" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Custom Text Snippets (Max 10)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                                    <ListBox ItemsSource="{Binding CrawlSpaceshipSnippets}" SelectedItem="{Binding SelectedSpaceshipSnippet, Mode=TwoWay}" Height="100" Margin="0,0,0,8">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Text}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Command="{Binding DataContext.SaveSpaceshipSnippetsCommand, RelativeSource={RelativeSource AncestorType=Page}}" VerticalAlignment="Center" FontSize="11" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0" Text="{Binding NewSpaceshipSnippetText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="New snippet..." FontSize="11" />
                                        <ui:Button Grid.Column="2" Content="Add" Command="{Binding AddSpaceshipSnippetCommand}" Appearance="Primary" Padding="8,4" FontSize="11" />
                                        <ui:Button Grid.Column="4" Content="Remove" Command="{Binding RemoveSpaceshipSnippetCommand}" Appearance="Secondary" Padding="8,4" FontSize="11" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <!-- Column 3: Screen Rotation & Connect Instructions -->
                        <StackPanel Grid.Column="6" Margin="0,0,0,16">
                            <GroupBox Header="🔀 Screen Rotation" Style="{StaticResource NavySettingsGroupBoxStyle}">
                                <StackPanel>
                                    <CheckBox Content="Automatically rotate through screens"
                                              IsChecked="{Binding AutoRotateProjectionViews, Mode=TwoWay}"
                                              Margin="0,0,0,8"
                                              ToolTip="When enabled, the rotation display automatically and randomly cycles through the checked screens below every configured interval, instead of staying on one fixed screen." />

                                    <!-- Unified Rotation Duration -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                                        <TextBlock Text="Change screen every:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
                                        <TextBox Text="{Binding AutoRotateDurationSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Width="50" Height="26" Padding="4,1" TextAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Text="sec" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                    </StackPanel>

                                    <!-- Select All / Clear All buttons -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="✓ Select All"
                                                Command="{Binding SelectAllProjectionScreensCommand}"
                                                Padding="10,3" Margin="0,0,8,0" FontSize="11" />
                                        <Button Content="✗ Clear All"
                                                Command="{Binding ClearAllProjectionScreensCommand}"
                                                Padding="10,3" FontSize="11" />
                                    </StackPanel>

                                    <TextBlock Text="Check which screens to randomly cycle through:"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Margin="0,0,0,6"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                    <ItemsControl ItemsSource="{Binding ProjectionRotationSchedule}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ViewName}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Connect &amp; Request Instructions" Style="{StaticResource GreenSettingsGroupBoxStyle}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Connect Instructions &amp; QR Code Screen" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding ConnectInstructionScreens}" SelectedItem="{Binding ConnectInstructionsScreen, Mode=TwoWay}" Margin="0,0,0,12" ToolTip="Select display screen/monitor for projected Wi-Fi and Song Request QR code banner." />

                                    <TextBlock Text="Wi-Fi Password (Optional)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" ToolTip="Enter password for travel router or venue Wi-Fi to generate scan-to-connect Wi-Fi QR code" />
                                    <ui:TextBox Text="{Binding WifiPassword, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" PlaceholderText="Wi-Fi Password for QR code" Margin="0,0,0,12" />

                                    <TextBlock Text="Dynamic Banner &amp; Dual QR Code Status" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="Automatically detects connected Wi-Fi SSID and song request portal URL to generate high-resolution ConnectInstructions.png with dual scan-to-connect Wi-Fi and portal QR codes." Foreground="{DynamicResource AppInfoTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />
                                    
                                    <ui:Button Content="👁️ Preview Connect Screen" Command="{Binding PreviewConnectInstructionsCommand}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ── TAB 3: Special Events ── -->
            <TabItem Header="Special Events" FontSize="12">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Column 0 -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,16">
                            <!-- Scaryoke Settings -->
                            <GroupBox Header="Scaryoke Categories" Style="{StaticResource OrangeSettingsGroupBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="Wheel Categories (Max 12)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ListBox ItemsSource="{Binding ScaryokeCategories}" SelectedItem="{Binding SelectedScaryokeCategory}" MaxHeight="140" Height="140" Margin="0,0,0,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="Add Category" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubHeaderBrush}" Margin="0,0,0,4" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0" Text="{Binding NewScaryokeCategoryName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Category Name..." Height="26" FontSize="11" />
                                        <ui:Button Grid.Column="2" Content="Add" Command="{Binding AddScaryokeCategoryCommand}" Appearance="Primary" Height="26" FontSize="11" />
                                    </Grid>
                                    <ui:Button Content="Remove Selected" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveScaryokeCategoryCommand}" Appearance="Danger" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Column 2 -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,16">
                            <!-- System Simulator -->
                            <GroupBox Header="System Simulator Auto-Pilot" Style="{StaticResource OrangeSettingsGroupBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="System Stress-Test Simulator" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="Simulates rapid user actions: adds/removes singers, triggers requests, adjusts volumes/EQ, and plays/pauses tracks to stress-test database, network, and audio engine stability." FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />

                                    <!-- Duration Selection Slider -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Simulation Duration" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Slider Grid.Column="1" Minimum="1" Maximum="30" Value="{Binding SimulationDurationMinutes, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding SimulationDurationMinutes, StringFormat='{}{0} Min'}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Grid>

                                    <!-- Start / Stop Button & Status -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:Button Grid.Column="0" Content="{Binding SimulationButtonText}" Icon="{ui:SymbolIcon Play24}" Command="{Binding StartSimulationCommand}" Appearance="Primary" Height="30" />
                                        <TextBlock Grid.Column="1" Text="{Binding SimulationStatusText}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Grid>

                                    <!-- Console log box -->
                                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="#CC111115" Padding="8" Height="140">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding SimulationLogText}" FontSize="10" FontFamily="Consolas" Foreground="#FF00FF00" TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ── TAB 4: Audio & Engine ── -->
            <TabItem Header="Audio &amp; Engine" FontSize="12">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Column 0 -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,16">
                            <!-- Audio & Equalizers -->
                            <GroupBox Header="Audio &amp; Equalizers" Style="{StaticResource TealSettingsGroupBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="Karaoke Output Device" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AudioDevices}" SelectedValue="{Binding SelectedKaraokeAudioDevice, Mode=TwoWay}" SelectedValuePath="DeviceIdentifier" DisplayMemberPath="Description" Margin="0,0,0,12" />

                                    <TextBlock Text="Background Music (BGM) Output Device" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AudioDevices}" SelectedValue="{Binding SelectedBgmAudioDevice, Mode=TwoWay}" SelectedValuePath="DeviceIdentifier" DisplayMemberPath="Description" Margin="0,0,0,12" />

                                    <CheckBox Content="Enable Hardware Mixer Mode (Bypass Software EQ)" IsChecked="{Binding IsHardwareMixerMode, Mode=TwoWay}" Margin="0,0,0,12" />

                                    <TextBlock Text="Master Output Boost / Preamp (USB Mixer Mode)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0" Maximum="12" Value="{Binding MasterOutputBoostDb, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ToolTip="Digital preamplification applied to audio output. 0 dB is standard; +6 dB to +12 dB is recommended for external USB mixers like the Yamaha MG10XU." />
                                        <TextBlock Grid.Column="1" Text="{Binding MasterOutputBoostDb, StringFormat='{}{0:0} dB'}" FontSize="12" FontWeight="Bold" Width="70" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Content="0 dB (Standard)" Command="{Binding SetMasterOutputBoostCommand}" CommandParameter="0" Height="24" Padding="8,1" FontSize="11" Margin="0,0,6,0" />
                                        <Button Content="+6 dB (USB Mixer)" Command="{Binding SetMasterOutputBoostCommand}" CommandParameter="6" Height="24" Padding="8,1" FontSize="11" Margin="0,0,6,0" />
                                        <Button Content="+12 dB (Maximum)" Command="{Binding SetMasterOutputBoostCommand}" CommandParameter="12" Height="24" Padding="8,1" FontSize="11" />
                                    </StackPanel>

                                    <CheckBox Content="Enable Anti-Clipping Peak Limiter" IsChecked="{Binding EnableAudioLimiter, Mode=TwoWay}" Margin="0,0,0,12" ToolTip="Transparent soft-knee peak limiter protects against digital clipping or distortion when output gain is boosted." />

                                    <CheckBox Content="Normalize Volume Across Tracks" IsChecked="{Binding NormalizeVolumeEnabled, Mode=TwoWay}" Margin="0,0,0,4" ToolTip="Automatically level perceived loudness track-to-track using each song's measured loudness. Tracks are measured once in the background the first time they play." />
                                    <Grid Margin="0,0,0,12" IsEnabled="{Binding NormalizeVolumeEnabled}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="-23" Maximum="-9" Value="{Binding TargetLoudnessLufs, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ToolTip="Target loudness (LUFS). -16 is a typical streaming-style target; lower is quieter, higher is louder." />
                                        <TextBlock Grid.Column="1" Text="{Binding TargetLoudnessLufs, StringFormat='{}{0:0} LUFS'}" FontSize="12" FontWeight="Bold" Width="70" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>

                                    <TextBlock Text="Audio Latency / Buffer" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding BufferSizes}" SelectedItem="{Binding SelectedBufferSize, Mode=TwoWay}" Margin="0,0,0,12" />
                                    <CheckBox Content="Enable Vocal Noise Gate filter" IsChecked="{Binding EnableNoiseGate, Mode=TwoWay}" Margin="0,0,0,12" />
                                    <CheckBox Content="Enable Reverb feedback on singer vocals" IsChecked="{Binding EnableReverb, Mode=TwoWay}" Margin="0,0,0,12" />

                                    <TextBlock Text="Fill-In Music Delay (Seconds)" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,4" />
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0" Maximum="30" Value="{Binding FillInDelaySeconds, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding FillInDelaySeconds, StringFormat='{}{0} Sec'}" FontSize="12" FontWeight="Bold" Width="45" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!-- Media Engine & Decoders -->
                            <GroupBox Header="Decoders &amp; Layout" Style="{StaticResource TealSettingsGroupBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="CDG Canvas Scaling Mode" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding CdgScalingModes}" SelectedItem="{Binding SelectedCdgScalingMode, Mode=TwoWay}" Margin="0,0,0,12" />
                                    <TextBlock Text="MP4 Decoding Backend" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Mp4Backends}" SelectedItem="{Binding SelectedMp4Backend, Mode=TwoWay}" Margin="0,0,0,12" />
                                    <TextBlock Text="CDG Backdrop Mode" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding BackdropModes}" SelectedItem="{Binding CdgBackdropMode, Mode=TwoWay}" Margin="0,0,0,12" />
                                    <TextBlock Text="Rendering Target FPS" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding FrameRate, Mode=TwoWay}" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Column 2 -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,16">
                            <!-- Service Logins & API Keys -->
                            <GroupBox Header="APIs &amp; Logins" Style="{StaticResource SlateSettingsGroupBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="YouTube API v3 Key" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding YouTubeApiKey, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="AIzaSy..." Margin="0,0,0,10" />
                                    <TextBlock Text="Spotify Client ID" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding SpotifyClientId, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ID..." Margin="0,0,0,10" />
                                    <TextBlock Text="Spotify Client Secret" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ui:PasswordBox PasswordChar="*" Password="{Binding SpotifyClientSecret, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" PlaceholderText="Secret..." Margin="0,0,0,10" />
                                    <TextBlock Text="Amazon AWS Key ID" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding AmazonAccessKey, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="AKIA..." Margin="0,0,0,10" />
                                    <TextBlock Text="Amazon AWS Secret" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <ui:PasswordBox PasswordChar="*" Password="{Binding AmazonSecretKey, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" PlaceholderText="AWS Secret..." />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ── TAB 5: Library & Ratings ── -->
            <TabItem Header="Library &amp; Ratings" FontSize="12">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Column 0 -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,16">
                            <!-- Music Library -->
                            <GroupBox Header="Music Library" Style="{StaticResource NavySettingsGroupBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="Folders Scanned" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ListBox ItemsSource="{Binding LibraryDirectories}" SelectedItem="{Binding SelectedLibraryDirectory}" MaxHeight="120" Height="120" Margin="0,0,0,8" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:Button Grid.Column="0" Icon="{ui:SymbolIcon FolderAdd24}" Command="{Binding AddLibraryDirectoryCommand}" Appearance="Primary" ToolTip="Add directory..." />
                                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveLibraryDirectoryCommand}" Appearance="Danger" ToolTip="Remove selected directory" />
                                        <ui:Button Grid.Column="6" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding ScanSelectedDirectoryCommand}" Appearance="Secondary" ToolTip="Scan/rescan selected folder" />
                                    </Grid>
                                    <Grid Margin="0,4,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding LibraryStatus}" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:Button Grid.Column="0" Content="Rescan All" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RescanLibraryCommand}" Appearance="Secondary" HorizontalAlignment="Stretch" ToolTip="Rescan all directories in the library" />
                                        <ui:Button Grid.Column="2" Content="LyracistDbEditor" Icon="{ui:SymbolIcon Database24}" Command="{Binding LoadDbEditorCommand}" Appearance="Primary" HorizontalAlignment="Stretch" ToolTip="Launch the Lyracist Database Editor" />
                                    </Grid>

                                    <TextBlock Text="Database Maintenance" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,4" />
                                    <CheckBox Content="Seed 15 Test Performers" IsChecked="{Binding IsTestMode, Mode=TwoWay}" Margin="0,4,0,10" />
                                    <ui:Button Content="Clear Database" Command="{Binding ClearDatabaseCommand}" Appearance="Secondary" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </GroupBox>

                            <!-- Self-Hosted Tablet Server -->
                            <GroupBox Header="Tablet Server Settings" Style="{StaticResource NavySettingsGroupBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="Listening Network Port" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding TabletPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                                    <TextBlock Text="Static/Override IP Address (Optional)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" ToolTip="Override automatically detected IP address for QR codes (e.g. for travel routers)." />
                                    <ui:TextBox Text="{Binding StaticIPAddress, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. 192.168.1.100" Margin="0,0,0,10" />
                                    <TextBlock Text="Server Status: " FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding TabletStatus}" FontSize="12" FontStyle="Italic" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,12" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:Button Grid.Column="0" Content="Start" Command="{Binding StartTabletServerCommand}" Appearance="Primary" HorizontalAlignment="Stretch" />
                                        <ui:Button Grid.Column="2" Content="Stop" Command="{Binding StopTabletServerCommand}" Appearance="Secondary" HorizontalAlignment="Stretch" />
                                    </Grid>
                                    <ui:Button Content="Open Tablet Kiosk QR &amp; Link" Command="{Binding OpenKioskQrWindowCommand}" Icon="{ui:SymbolIcon Tablet24}" Appearance="Secondary" HorizontalAlignment="Stretch" ToolTip="Open enlarged QR code and link for tablet kiosk request station." />
                                </StackPanel>
                            </GroupBox>

                            <!-- KSRotation Sync Settings -->
                            <GroupBox Header="KSRotation Sync Settings" Style="{StaticResource NavySettingsGroupBoxStyle}">
                                <StackPanel>
                                    <CheckBox Content="Enable KSRotation Synchronization" IsChecked="{Binding KSRotationSyncEnabled, Mode=TwoWay}" Margin="0,0,0,12" />

                                    <TextBlock Text="KSRotation IP Address" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding KSRotationIpAddress, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. 127.0.0.1" Margin="0,0,0,10" />

                                    <TextBlock Text="KSRotation Port" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding KSRotationPort, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. 5000" Margin="0,0,0,10" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Column 2 -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,16">
                            <!-- Performer Ratings Settings -->
                            <GroupBox Header="Performer Ratings Settings" Style="{StaticResource GoldSettingsGroupBoxStyle}">
                                <StackPanel>
                                    <CheckBox Content="Enable Performer Ratings System" IsChecked="{Binding IsRatingSystemEnabled, Mode=TwoWay}" Margin="0,0,0,12" />
                                    <TextBlock Text="Active Rating Icon / Symbol" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AvailableRatingIcons}" SelectedItem="{Binding SelectedRatingIcon, Mode=TwoWay}" Margin="0,0,0,12" />
                                    <TextBlock Text="Manage Available Symbols" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ListBox ItemsSource="{Binding AvailableRatingIcons}" SelectedItem="{Binding SelectedRatingIcon, Mode=TwoWay}" MaxHeight="220" Height="185" Margin="0,0,0,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="Add Custom Symbol" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubHeaderBrush}" Margin="0,0,0,4" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0" Text="{Binding NewRatingIconName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. 💎 Diamond" Height="26" FontSize="11" />
                                        <ui:Button Grid.Column="2" Content="Add" Command="{Binding AddRatingIconCommand}" Appearance="Primary" Height="26" FontSize="11" />
                                    </Grid>

                                    <TextBlock Text="Quick Add Presets" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubHeaderBrush}" Margin="0,0,0,4" />
                                    <WrapPanel Margin="0,0,0,12">
                                        <ui:Button Content="💋 Kiss" Command="{Binding AddPresetIconCommand}" CommandParameter="💋 Kiss" Margin="0,0,4,4" Padding="6,4" FontSize="10" />
                                        <ui:Button Content="👋 Wave" Command="{Binding AddPresetIconCommand}" CommandParameter="👋 Wave" Margin="0,0,4,4" Padding="6,4" FontSize="10" />
                                        <ui:Button Content="✨ Sparkle" Command="{Binding AddPresetIconCommand}" CommandParameter="✨ Sparkle" Margin="0,0,4,4" Padding="6,4" FontSize="10" />
                                        <ui:Button Content="🎸 Rock" Command="{Binding AddPresetIconCommand}" CommandParameter="🎸 Rock" Margin="0,0,4,4" Padding="6,4" FontSize="10" />
                                        <ui:Button Content="🌈 Rainbow" Command="{Binding AddPresetIconCommand}" CommandParameter="🌈 Rainbow" Margin="0,0,4,4" Padding="6,4" FontSize="10" />
                                        <ui:Button Content="🎈 Balloon" Command="{Binding AddPresetIconCommand}" CommandParameter="🎈 Balloon" Margin="0,0,4,4" Padding="6,4" FontSize="10" />
                                        <ui:Button Content="⭐ Star" Command="{Binding AddPresetIconCommand}" CommandParameter="⭐ Star" Margin="0,0,4,4" Padding="6,4" FontSize="10" />
                                        <ui:Button Content="❤️ Heart" Command="{Binding AddPresetIconCommand}" CommandParameter="❤️ Heart" Margin="0,0,4,4" Padding="6,4" FontSize="10" />
                                        <ui:Button Content="🔥 Fire" Command="{Binding AddPresetIconCommand}" CommandParameter="🔥 Fire" Margin="0,0,4,4" Padding="6,4" FontSize="10" />
                                        <ui:Button Content="🎵 Note" Command="{Binding AddPresetIconCommand}" CommandParameter="🎵 Note" Margin="0,0,4,4" Padding="6,4" FontSize="10" />
                                    </WrapPanel>

                                    <ui:Button Content="Remove Selected Symbol" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveRatingIconCommand}" Appearance="Danger" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ── TAB 6: Registration ── -->
            <TabItem Header="Registration" FontSize="12">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Form Inputs -->
                    <Border Grid.Column="0" Background="#FF13131F" BorderBrush="#FF212135" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="Product Registration" FontSize="16" FontWeight="Bold" Foreground="#FF8E53" Margin="0,0,0,16" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="First Name" FontSize="12" FontWeight="SemiBold" Foreground="#FFAAAAAA" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding RegFirstName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="First Name" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Last Name" FontSize="12" FontWeight="SemiBold" Foreground="#FFAAAAAA" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding RegLastName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Last Name" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Stage Name (or 'None')" FontSize="12" FontWeight="SemiBold" Foreground="#FFAAAAAA" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding RegStageName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Stage Name" Margin="0,0,0,12" />

                            <TextBlock Text="Email Address" FontSize="12" FontWeight="SemiBold" Foreground="#FFAAAAAA" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding RegEmail, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Email Address" Margin="0,0,0,12" />

                            <TextBlock Text="Registration Serial Key" FontSize="12" FontWeight="SemiBold" Foreground="#FFAAAAAA" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding RegLicenseKey, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="XXXXX-XXXXX-XXXXX" Margin="0,0,0,16" />
                        </StackPanel>
                    </Border>

                    <!-- Activation Status Box -->
                    <Border Grid.Column="1" Background="#FF13131F" BorderBrush="#FF212135" BorderThickness="1" CornerRadius="12" Padding="24" Height="260" VerticalAlignment="Top">
                        <Grid>
                            <!-- Default / Empty State -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RegistrationStatus}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ui:SymbolIcon Symbol="Key24" FontSize="48" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <TextBlock Text="Awaiting Registration Key" FontSize="14" FontWeight="SemiBold" Foreground="Gray" HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Valid Activation State -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RegistrationStatus}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="64" Foreground="LimeGreen" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <TextBlock Text="Lyracist Pro Activated!" FontSize="16" FontWeight="Bold" Foreground="LimeGreen" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="Thank you for registering Lyracist." FontSize="12" Foreground="#FFAAAAAA" HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Invalid Activation State -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RegistrationStatus}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ui:SymbolIcon Symbol="DismissCircle24" FontSize="64" Foreground="Crimson" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <TextBlock Text="Invalid Registration Code" FontSize="16" FontWeight="Bold" Foreground="Crimson" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="Please double check your details." FontSize="12" Foreground="#FFAAAAAA" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ── TAB 7: Keyboard Hotkeys ── -->
            <TabItem Header="Keyboard Hotkeys" FontSize="12">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Hotkeys List -->
                    <Border Grid.Column="0" Background="#FF13131F" BorderBrush="#FF212135" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="Hotkey Mappings (Learn Mode)" FontSize="16" FontWeight="Bold" Foreground="#FF8E53" Margin="0,0,0,8" />
                            <TextBlock Text="Click in any input box and press a key on your keyboard to map it." FontSize="12" Foreground="#FFAAAAAA" Margin="0,0,0,20" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Play / Pause" FontSize="12" FontWeight="SemiBold" Foreground="#FFAAAAAA" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding HkPlayPause, Mode=TwoWay}" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" IsReadOnly="True" Margin="0,0,0,12" />

                                    <TextBlock Text="Stop Playback" FontSize="12" FontWeight="SemiBold" Foreground="#FFAAAAAA" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding HkStop, Mode=TwoWay}" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" IsReadOnly="True" Margin="0,0,0,12" />

                                    <TextBlock Text="Done Singer (Advance)" FontSize="12" FontWeight="SemiBold" Foreground="#FFAAAAAA" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding HkDoneSinger, Mode=TwoWay}" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" IsReadOnly="True" Margin="0,0,0,12" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Toggle Marquee Banner" FontSize="12" FontWeight="SemiBold" Foreground="#FFAAAAAA" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding HkToggleBanner, Mode=TwoWay}" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" IsReadOnly="True" Margin="0,0,0,12" />

                                    <TextBlock Text="Toggle Lyrics Window" FontSize="12" FontWeight="SemiBold" Foreground="#FFAAAAAA" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding HkToggleLyricsWindow, Mode=TwoWay}" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" IsReadOnly="True" Margin="0,0,0,12" />

                                    <TextBlock Text="Toggle Rotation Window" FontSize="12" FontWeight="SemiBold" Foreground="#FFAAAAAA" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding HkToggleRotationWindow, Mode=TwoWay}" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" IsReadOnly="True" Margin="0,0,0,12" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Help / Notes Panel -->
                    <Border Grid.Column="1" Background="#FF13131F" BorderBrush="#FF212135" BorderThickness="1" CornerRadius="12" Padding="20" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="ℹ️ Hotkey Usage Notes" FontSize="14" FontWeight="Bold" Foreground="#FF8E53" Margin="0,0,0,10" />
                            <TextBlock Text="• Global Intercept: Hotkeys are checked globally across the main window." TextWrapping="Wrap" FontSize="12" Foreground="#FFAAAAAA" Margin="0,0,0,6" />
                            <TextBlock Text="• Text Input Safety: Hotkeys are automatically disabled when you are typing inside search boxes or text fields, preventing accidental triggers." TextWrapping="Wrap" FontSize="12" Foreground="#FFAAAAAA" Margin="0,0,0,6" />
                            <TextBlock Text="• To clear a hotkey mapping, select the textbox and press Backspace or Delete to set it to 'None'." TextWrapping="Wrap" FontSize="12" Foreground="#FFAAAAAA" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>