<Page x:Class="Lyracist.Views.Pages.HelpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Help"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Page.Resources>
        <LinearGradientBrush x:Key="HeaderBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#11998e" Offset="0.0"/>
            <GradientStop Color="#38ef7d" Offset="1.0"/>
        </LinearGradientBrush>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" CornerRadius="12" Padding="20" Margin="0,0,0,24" Background="{StaticResource HeaderBackgroundBrush}">
            <StackPanel>
                <TextBlock Text="Help &amp; Support" FontSize="28" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Learn how to configure displays, scan media folders, and manage singers." FontSize="14" Foreground="#F0F0F0" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Split-Screen Help Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left side: Topics List -->
            <Border Grid.Column="0" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="12" Padding="12" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ListBox ItemsSource="{Binding HelpTopics}"
                         SelectedItem="{Binding SelectedTopic}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Icon}" FontSize="18" Margin="4,0,12,0" Foreground="{Binding AccentColor}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Right side: Detail Panel -->
            <Border Grid.Column="2" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="12" Padding="24" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedTopic}">
                        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>
                        <ui:CardControl Margin="0,0,0,20" Padding="20">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{Binding DescriptionHeader}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding DescriptionContent}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="36" Foreground="{Binding AccentColor}"/>
                        </ui:CardControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
