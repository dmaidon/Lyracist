<!-- Edited on Aug 2, 2026 @ 08:41:00 -> Correct height and spacing of casting controls in columns 0 and 1 -->
<Page x:Class="Lyracist.Views.Pages.CastingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:views="clr-namespace:Lyracist.Views"
      Title="Casting"
      Background="{DynamicResource AppBackgroundBrush}"
      Foreground="{DynamicResource AppTextPrimaryBrush}">

    <Page.Resources>
        <!-- Page header gradient -->
        <LinearGradientBrush x:Key="HeaderBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00c6ff" Offset="0.0" />
            <GradientStop Color="#0072ff" Offset="1.0" />
        </LinearGradientBrush>

        <!-- GroupBox header: horizontal cyan→blue gradient, matching this page's header banner -->
        <LinearGradientBrush x:Key="CastGroupBoxHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00A6E0" Offset="0.0" />
            <GradientStop Color="#0072ff" Offset="1.0" />
        </LinearGradientBrush>

        <!-- GroupBox body: very subtle blue tint over the app background -->
        <SolidColorBrush x:Key="CastGroupBoxBodyBrush"   Color="#1200c6ff" />
        <SolidColorBrush x:Key="CastGroupBoxBorderBrush" Color="#550072ff" />

        <!-- ControlTemplate that gives every GroupBox the cyan-header card look -->
        <Style x:Key="CastGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource CastGroupBoxBorderBrush}">
                            <StackPanel>
                                <Border Background="{StaticResource CastGroupBoxHeaderBrush}"
                                        CornerRadius="7,7,0,0"
                                        Padding="14,9">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                </Border>
                                <Border Background="{StaticResource CastGroupBoxBodyBrush}"
                                        Padding="14"
                                        CornerRadius="0,0,7,7">
                                    <ContentPresenter />
                                </Border>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" CornerRadius="12" Padding="20" Margin="0,0,0,24" Background="{StaticResource HeaderBackgroundBrush}">
            <StackPanel>
                <TextBlock Text="Casting Controls" FontSize="28" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="Configure remote projections and cast your singer rotation dynamically." FontSize="14" Foreground="#F0F0F0" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Column 0: Cast Status & Cast Rotation -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
            <StackPanel>
                <!-- Cast Status -->
                <GroupBox Header="Cast Status" Style="{StaticResource CastGroupBoxStyle}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Cast24" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </GroupBox>

                <!-- Cast Rotation -->
                <GroupBox Header="Cast Rotation" Style="{StaticResource CastGroupBoxStyle}">
                    <StackPanel>
                        <TextBlock Text="Display Target" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding Targets}"
                                  SelectedItem="{Binding SelectedTarget}"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0"
                                       Content="Cast Rotation"
                                       Icon="{ui:SymbolIcon Cast24}"
                                       Command="{Binding CastCommand}"
                                       Appearance="Primary"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Center" />
                            <ui:Button Grid.Column="2"
                                       Content="Stop Casting"
                                       Icon="{ui:SymbolIcon Stop24}"
                                       Command="{Binding StopCommand}"
                                       Appearance="Secondary"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Column 1: Chromecast TVs & BrowserCast Clients -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
            <StackPanel>
                <!-- Chromecast TVs -->
                <GroupBox Header="Chromecast TVs" Style="{StaticResource CastGroupBoxStyle}">
                    <StackPanel>
                        <ui:Button Content="Scan for TVs"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   Command="{Binding RefreshCommand}"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center"
                                   Margin="0,0,0,12" />

                        <TextBlock Text="Available Devices" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding SelectedDevice}"
                                  DisplayMemberPath="Name"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,12" />

                        <ui:Button Content="Cast to Selected TV"
                                   Icon="{ui:SymbolIcon Cast24}"
                                   Command="{Binding CastToDeviceCommand}"
                                   Appearance="Primary"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center" />
                    </StackPanel>
                </GroupBox>

                <!-- BrowserCast Clients -->
                <GroupBox Header="BrowserCast Clients" Style="{StaticResource CastGroupBoxStyle}">
                    <StackPanel>
                        <TextBlock Text="Connected Browser Clients" Style="{StaticResource FieldLabelStyle}" />
                        <Border BorderBrush="{StaticResource CastGroupBoxBorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ListBox ItemsSource="{Binding BrowserClients}"
                                     DisplayMemberPath="Device"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     MaxHeight="160" />
                        </Border>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>