<Page x:Class="Lyracist.Views.Pages.PlaylistsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Playlists"
      Background="{DynamicResource AppBackgroundBrush}"
      Foreground="{DynamicResource AppTextPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <LinearGradientBrush x:Key="HeaderBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#11998e" Offset="0.0" />
            <GradientStop Color="#38ef7d" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="SubHeaderBrush" Color="#B07FD4" />
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" CornerRadius="12" Padding="20" Margin="0,0,0,24" Background="{StaticResource HeaderBackgroundBrush}">
            <StackPanel>
                <TextBlock Text="Background Music Playlists" FontSize="28" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="Opening music before the show, fill-in music between singers, and a send-off playlist once the queue empties." FontSize="14" Foreground="#F0F0F0" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="PlaylistsScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <Grid MinWidth="1680" Height="{Binding ViewportHeight, ElementName=PlaylistsScrollViewer}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <!-- Music Library (Left Column) -->
                <Border Grid.Column="0" Margin="0,0,12,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource AppSurfaceBrush}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Music Library" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshLibraryCommand}" Appearance="Secondary" Margin="12,0,0,0" ToolTip="Refresh" />
                        </StackPanel>

                        <ui:TextBox Grid.Row="1"
                                    PlaceholderText="Search library..."
                                    Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                    Icon="{ui:SymbolIcon Search24}"
                                    Margin="0,0,0,12" />

                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding LibrarySongs}"
                                 SelectedItem="{Binding SelectedLibrarySong}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Opening Playlist (Middle Column) -->
                <Border Grid.Column="1" Margin="0,0,12,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource AppSurfaceBrush}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Opening Playlist" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:Button Icon="{ui:SymbolIcon Add24}" Content="Add" Command="{Binding AddToOpeningCommand}" Appearance="Primary" Background="{StaticResource UIAccentBrush}" Margin="0,0,4,0" />
                            <ui:Button Icon="{ui:SymbolIcon ArrowUp24}" Command="{Binding MoveOpeningUpCommand}" Margin="0,0,4,0" ToolTip="Move Up" />
                            <ui:Button Icon="{ui:SymbolIcon ArrowDown24}" Command="{Binding MoveOpeningDownCommand}" Margin="0,0,4,0" ToolTip="Move Down" />
                            <ui:Button Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveOpeningItemCommand}" Appearance="Danger" ToolTip="Remove" />
                        </StackPanel>

                        <ListBox Grid.Row="2" ItemsSource="{Binding OpeningTracks}" SelectedItem="{Binding SelectedOpeningTrack}" Background="Transparent" BorderThickness="0" Margin="0,0,0,12">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="3">
                            <TextBlock Text="Volume" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="0" Maximum="100" Value="{Binding OpeningVolume}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding OpeningVolume, StringFormat='{}{0:0}%'}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Expander Header="Tone (EQ)" Margin="0,0,0,12" FontSize="12">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="Bass" FontSize="11" Margin="0,0,0,4" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="46" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="-20" Maximum="20" Value="{Binding OpeningBass}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding OpeningBass, StringFormat='{}{0:0}dB'}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Treble" FontSize="11" Margin="0,0,0,4" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="46" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="-20" Maximum="20" Value="{Binding OpeningTreble}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding OpeningTreble, StringFormat='{}{0:0}dB'}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Gain (Preamp)" FontSize="11" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="46" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="-20" Maximum="20" Value="{Binding OpeningGain}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding OpeningGain, StringFormat='{}{0:0}dB'}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Content="Start Show" Icon="{ui:SymbolIcon Play24}" Command="{Binding StartOpeningMusicCommand}" Appearance="Primary" Background="{StaticResource UIAccentBrush}" Margin="0,0,4,0" HorizontalAlignment="Stretch" />
                                <ui:Button Grid.Column="1" Content="Stop" Icon="{ui:SymbolIcon Stop24}" Command="{Binding StopOpeningMusicCommand}" Appearance="Secondary" Margin="4,0,0,0" HorizontalAlignment="Stretch" />
                            </Grid>

                            <TextBlock Margin="0,8,0,0"
                                   Text="{Binding IsOpeningPlaying, StringFormat='Status: {0}'}"
                                   FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Fill-In Playlist (Third Column) -->
                <Border Grid.Column="2" Margin="0,0,12,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource AppSurfaceBrush}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Fill-In Playlist" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:Button Icon="{ui:SymbolIcon Add24}" Content="Add" Command="{Binding AddToFillInCommand}" Appearance="Primary" Background="{StaticResource UIAccentBrush}" Margin="0,0,4,0" />
                            <ui:Button Icon="{ui:SymbolIcon ArrowUp24}" Command="{Binding MoveFillInUpCommand}" Margin="0,0,4,0" ToolTip="Move Up" />
                            <ui:Button Icon="{ui:SymbolIcon ArrowDown24}" Command="{Binding MoveFillInDownCommand}" Margin="0,0,4,0" ToolTip="Move Down" />
                            <ui:Button Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveFillInItemCommand}" Appearance="Danger" ToolTip="Remove" />
                        </StackPanel>

                        <ListBox Grid.Row="2" ItemsSource="{Binding FillInTracks}" SelectedItem="{Binding SelectedFillInTrack}" Background="Transparent" BorderThickness="0" Margin="0,0,0,12">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="3">
                            <TextBlock Text="Volume" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="0" Maximum="100" Value="{Binding FillInVolume}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding FillInVolume, StringFormat='{}{0:0}%'}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Expander Header="Tone (EQ)" Margin="0,0,0,12" FontSize="12">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="Bass" FontSize="11" Margin="0,0,0,4" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="46" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="-20" Maximum="20" Value="{Binding FillInBass}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding FillInBass, StringFormat='{}{0:0}dB'}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Treble" FontSize="11" Margin="0,0,0,4" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="46" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="-20" Maximum="20" Value="{Binding FillInTreble}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding FillInTreble, StringFormat='{}{0:0}dB'}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Gain (Preamp)" FontSize="11" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="46" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="-20" Maximum="20" Value="{Binding FillInGain}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding FillInGain, StringFormat='{}{0:0}dB'}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Content="Play" Icon="{ui:SymbolIcon Play24}" Command="{Binding PlayFillInCommand}" Appearance="Primary" Background="{StaticResource UIAccentBrush}" Margin="0,0,4,0" HorizontalAlignment="Stretch" />
                                <ui:Button Grid.Column="1" Content="Stop" Icon="{ui:SymbolIcon Stop24}" Command="{Binding StopFillInCommand}" Appearance="Secondary" Margin="4,0,0,0" HorizontalAlignment="Stretch" />
                            </Grid>

                            <ui:Button Content="Duck for Announcement" Icon="{ui:SymbolIcon SpeakerMute24}" Command="{Binding ToggleDuckFillInCommand}" Appearance="Secondary" HorizontalAlignment="Stretch" />

                            <TextBlock Margin="0,8,0,0"
                                   Text="{Binding IsFillInPlaying, StringFormat='Status: {0}'}"
                                   FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Text="{Binding IsFillInDucked, StringFormat='Ducked: {0}'}"
                                   FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- End-of-Rotation Playlist (Fourth Column) -->
                <Border Grid.Column="3" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource AppSurfaceBrush}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="End-of-Rotation Playlist" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:Button Icon="{ui:SymbolIcon Add24}" Content="Add" Command="{Binding AddToEndRotationCommand}" Appearance="Primary" Background="{StaticResource UIAccentBrush}" Margin="0,0,4,0" />
                            <ui:Button Icon="{ui:SymbolIcon ArrowUp24}" Command="{Binding MoveEndRotationUpCommand}" Margin="0,0,4,0" ToolTip="Move Up" />
                            <ui:Button Icon="{ui:SymbolIcon ArrowDown24}" Command="{Binding MoveEndRotationDownCommand}" Margin="0,0,4,0" ToolTip="Move Down" />
                            <ui:Button Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveEndRotationItemCommand}" Appearance="Danger" ToolTip="Remove" />
                        </StackPanel>

                        <ListBox Grid.Row="2" ItemsSource="{Binding EndRotationTracks}" SelectedItem="{Binding SelectedEndRotationTrack}" Background="Transparent" BorderThickness="0" Margin="0,0,0,12">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="3">
                            <TextBlock Text="Volume" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="0" Maximum="100" Value="{Binding EndRotationVolume}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding EndRotationVolume, StringFormat='{}{0:0}%'}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Expander Header="Tone (EQ)" Margin="0,0,0,12" FontSize="12">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="Bass" FontSize="11" Margin="0,0,0,4" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="46" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="-20" Maximum="20" Value="{Binding EndRotationBass}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding EndRotationBass, StringFormat='{}{0:0}dB'}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Treble" FontSize="11" Margin="0,0,0,4" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="46" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="-20" Maximum="20" Value="{Binding EndRotationTreble}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding EndRotationTreble, StringFormat='{}{0:0}dB'}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Gain (Preamp)" FontSize="11" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="46" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="-20" Maximum="20" Value="{Binding EndRotationGain}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding EndRotationGain, StringFormat='{}{0:0}dB'}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Content="Play" Icon="{ui:SymbolIcon Play24}" Command="{Binding StartEndRotationMusicCommand}" Appearance="Primary" Background="{StaticResource UIAccentBrush}" Margin="0,0,4,0" HorizontalAlignment="Stretch" />
                                <ui:Button Grid.Column="1" Content="Stop" Icon="{ui:SymbolIcon Stop24}" Command="{Binding StopEndRotationMusicCommand}" Appearance="Secondary" Margin="4,0,0,0" HorizontalAlignment="Stretch" />
                            </Grid>

                            <TextBlock Margin="0,8,0,0"
                                   Text="{Binding IsEndRotationPlaying, StringFormat='Status: {0}'}"
                                   FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Text="Plays automatically when the singer queue empties."
                                   FontSize="11" FontStyle="Italic" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Special Occasion Music (Fifth Column) -->
                <Border Grid.Column="4" Margin="12,0,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource AppSurfaceBrush}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Special Occasion Music" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- Categories -->
                                <TextBlock Text="Categories" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource SubHeaderBrush}" Margin="0,0,0,6" />
                                <ListBox ItemsSource="{Binding OccasionCategories}"
                                         SelectedItem="{Binding SelectedOccasionCategory}"
                                         DisplayMemberPath="Label"
                                         MaxHeight="120" Height="120" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Grid.Column="0"
                                                Text="{Binding NewOccasionCategoryName, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="New category..." Height="26" FontSize="11" />
                                    <ui:Button Grid.Column="2" Content="Add" Icon="{ui:SymbolIcon Add24}"
                                               Command="{Binding AddOccasionCategoryCommand}"
                                               Appearance="Primary" Height="26" FontSize="11" />
                                    <ui:Button Grid.Column="4" Icon="{ui:SymbolIcon Delete24}"
                                               Command="{Binding RemoveOccasionCategoryCommand}"
                                               Appearance="Danger" Height="26" FontSize="11"
                                               ToolTip="Remove selected category" />
                                </Grid>
                                <CheckBox Content="Add as subcategory of selected"
                                          IsChecked="{Binding AddAsSubcategory}" Margin="0,0,0,12" />

                                <Separator Margin="0,4,0,12" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                                <!-- Items -->
                                <TextBlock Text="Music Items in Category" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource SubHeaderBrush}" Margin="0,0,0,6" />
                                <ListBox ItemsSource="{Binding OccasionItems}"
                                         SelectedItem="{Binding SelectedOccasionItem}"
                                         DisplayMemberPath="Name"
                                         MaxHeight="100" Height="100" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Grid.Column="0"
                                                Text="{Binding NewOccasionItemName, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="Item name..." Height="26" FontSize="11" />
                                    <ui:Button Grid.Column="2" Content="File..." Icon="{ui:SymbolIcon MusicNote224}"
                                               Command="{Binding AddOccasionItemCommand}"
                                               Appearance="Secondary" Height="26" FontSize="11" />
                                    <ui:Button Grid.Column="4" Content="Search..." Icon="{ui:SymbolIcon Search24}"
                                               Command="{Binding SearchOccasionItemCommand}"
                                               Appearance="Primary" Background="{StaticResource UIAccentBrush}" Height="26" FontSize="11" />
                                    <ui:Button Grid.Column="6" Icon="{ui:SymbolIcon Delete24}"
                                               Command="{Binding RemoveOccasionItemCommand}"
                                               Appearance="Danger" Height="26" FontSize="11"
                                               ToolTip="Remove selected item" />
                                </Grid>

                                <Separator Margin="0,4,0,12" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                                <!-- per-item EQ -->
                                <TextBlock Text="Per-Occasion Audio (selected item)"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="46" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Bass"   FontSize="12" VerticalAlignment="Center" />
                                    <Slider    Grid.Row="0" Grid.Column="1" Minimum="-20" Maximum="20" Value="{Binding OccasionItemBass}"   VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding OccasionItemBass,   StringFormat='{}{0:0}dB'}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Treble" FontSize="12" VerticalAlignment="Center" />
                                    <Slider    Grid.Row="1" Grid.Column="1" Minimum="-20" Maximum="20" Value="{Binding OccasionItemTreble}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding OccasionItemTreble, StringFormat='{}{0:0}dB'}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Gain"   FontSize="12" VerticalAlignment="Center" />
                                    <Slider    Grid.Row="2" Grid.Column="1" Minimum="-20" Maximum="20" Value="{Binding OccasionItemGain}"   VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding OccasionItemGain,   StringFormat='{}{0:0}dB'}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <ui:Button Content="Save Audio Settings" Icon="{ui:SymbolIcon Save24}"
                                           Command="{Binding SaveOccasionItemAudioCommand}"
                                           Appearance="Secondary" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>