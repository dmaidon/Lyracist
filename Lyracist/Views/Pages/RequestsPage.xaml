<Page x:Class="Lyracist.Views.Pages.RequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Music Requests"
      Background="{DynamicResource AppBackgroundBrush}"
      Foreground="{DynamicResource AppTextPrimaryBrush}">

    <Page.Resources>
        <LinearGradientBrush x:Key="HeaderBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8E2DE2" Offset="0.0"/>
            <GradientStop Color="#4A00E0" Offset="1.0"/>
        </LinearGradientBrush>
        <DataTemplate x:Key="RequestItemTemplate">
            <StackPanel Margin="0,4">
                <StackPanel Orientation="Horizontal">
                    <Border Background="{DynamicResource UIAccentBrush}" CornerRadius="4" Padding="6,1" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RequestType}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <TextBlock FontSize="14" FontWeight="SemiBold">
                        <Run Text="{Binding Title}"/><Run Text=" — "/><Run Text="{Binding Artist}"/>
                    </TextBlock>
                </StackPanel>
                <TextBlock FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}">
                    <Run Text="{Binding SingerName}"/><Run Text=" · "/><Run Text="{Binding Source}"/><Run Text=" · "/><Run Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"/>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="HistoryItemTemplate">
            <StackPanel Margin="0,4">
                <TextBlock FontSize="13" FontWeight="SemiBold">
                    <Run Text="{Binding Title}"/><Run Text=" — "/><Run Text="{Binding Artist}"/>
                </TextBlock>
                <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}">
                    <Run Text="{Binding SingerName}"/><Run Text=" · "/><Run Text="{Binding RequestType}"/><Run Text=" · "/><Run Text="{Binding Status}"/><Run Text=" · "/><Run Text="{Binding Timestamp, StringFormat='{}{0:MMM d HH:mm}'}"/>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" CornerRadius="12" Padding="20" Margin="0,0,0,16" Background="{StaticResource HeaderBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Music Requests" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Review incoming requests from singers, approve them, and cue them up. Singers can submit from their phones at http://&lt;this-pc&gt;:5005/request" FontSize="14" Foreground="#F0F0F0" Margin="0,4,0,0"/>
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1"
                                  Content="Auto-accept requests"
                                  IsChecked="{Binding AutoAcceptRequests, Mode=TwoWay}"
                                  Foreground="White"
                                  VerticalAlignment="Center"
                                  Margin="16,0,0,0"
                                  ToolTip="When on, incoming requests skip the Pending queue and are accepted automatically instead of waiting for DJ approval."/>
            </Grid>
        </Border>

        <!-- Manual Add Row -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource AppSurfaceBrush}" Padding="12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" Text="{Binding NewRequestSinger, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Singer name" Margin="0,0,8,0"/>
                <ui:TextBox Grid.Column="1" Text="{Binding NewRequestTitle, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Song title" Margin="0,0,8,0"/>
                <ui:TextBox Grid.Column="2" Text="{Binding NewRequestArtist, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Artist" Margin="0,0,8,0"/>
                <ui:Button Grid.Column="3" Content="Add Request" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddRequestCommand}" Appearance="Primary" Background="{StaticResource UIAccentBrush}"/>
                <TextBlock Grid.Column="4" Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- Queues -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Pending -->
            <Border Grid.Column="0" Margin="0,0,12,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource AppSurfaceBrush}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Pending" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Pending}" SelectedItem="{Binding SelectedPending}" ItemTemplate="{StaticResource RequestItemTemplate}" Background="Transparent" BorderThickness="0"/>
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="Approve" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding ApproveCommand}" Appearance="Primary" Background="{StaticResource UIAccentBrush}" Margin="0,0,4,0" HorizontalAlignment="Stretch"/>
                        <ui:Button Grid.Column="1" Content="Reject" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding RejectCommand}" Appearance="Danger" Margin="4,0,0,0" HorizontalAlignment="Stretch"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Approved -->
            <Border Grid.Column="1" Margin="0,0,12,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource AppSurfaceBrush}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Approved — Ready to Play" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Approved}" SelectedItem="{Binding SelectedApproved}" ItemTemplate="{StaticResource RequestItemTemplate}" Background="Transparent" BorderThickness="0"/>
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="Play Now" Icon="{ui:SymbolIcon Play24}" Command="{Binding PlayApprovedCommand}" Appearance="Primary" Background="{StaticResource UIAccentBrush}" Margin="0,0,4,0" HorizontalAlignment="Stretch"/>
                        <ui:Button Grid.Column="1" Content="Mark Played" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding MarkPlayedWithoutPlayingCommand}" Appearance="Secondary" Margin="4,0,0,0" HorizontalAlignment="Stretch"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- History -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource AppSurfaceBrush}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="History" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}" Appearance="Secondary" Margin="12,0,0,0" ToolTip="Refresh"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding History}" ItemTemplate="{StaticResource HistoryItemTemplate}" Background="Transparent" BorderThickness="0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
