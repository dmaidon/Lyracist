<!-- Edited on Oct 2, 2026 @ 13:08:00 -> Add Center Face and Rotate buttons to Users avatar actions -->
<Page x:Class="Lyracist.Views.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Users &amp; Singers"
      Background="{DynamicResource AppBackgroundBrush}"
      Foreground="{DynamicResource AppTextPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <LinearGradientBrush x:Key="UsersHeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0072ff" Offset="0.0" />
            <GradientStop Color="#00c6ff" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AvatarGlowBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFE8BC52" Offset="0.0" />
            <GradientStop Color="#FFB9822A" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Styled GroupBox for Tone Controls -->
        <LinearGradientBrush x:Key="UsersGroupBoxHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0072ff" Offset="0.0" />
            <GradientStop Color="#00c6ff" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="UsersGroupBoxBodyBrush"   Color="#140072ff" />
        <SolidColorBrush x:Key="UsersGroupBoxBorderBrush" Color="#440072ff" />

        <Style x:Key="UsersSettingsGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource UsersGroupBoxBorderBrush}">
                            <StackPanel>
                                <Border Background="{StaticResource UsersGroupBoxHeaderBrush}"
                                        CornerRadius="7,7,0,0"
                                        Padding="14,9">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                </Border>
                                <Border Background="{StaticResource UsersGroupBoxBodyBrush}"
                                        Padding="14"
                                        CornerRadius="0,0,7,7">
                                    <ContentPresenter />
                                </Border>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="24" TextElement.Foreground="{DynamicResource AppTextPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Card -->
        <Border Grid.Row="0" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" Background="{StaticResource UsersHeaderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Users &amp; Singer Accounts" FontSize="26" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Manage singer accounts, set default vocal &amp; audio profiles, merge duplicate accounts, and inspect past performance logs."
                               FontSize="13" Foreground="#F0F8FF" Margin="0,4,0,0" />
                </StackPanel>
                <ui:Button Grid.Column="1"
                           Content="New Singer"
                           Icon="{ui:SymbolIcon PersonAdd24}"
                           Appearance="Secondary"
                           Command="{Binding AddNewSingerCommand}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Singer Account List -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Search Box -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <ui:TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Search singers by name or email..."
                                    Icon="{ui:SymbolIcon Search24}" />
                    </Grid>

                    <!-- Singers List -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FilteredSingers}"
                             SelectedItem="{Binding SelectedSinger, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,2" CornerRadius="6" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar Circle Thumbnail -->
                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                                                BorderBrush="{StaticResource AvatarGlowBrush}" BorderThickness="1.5"
                                                Margin="0,0,10,0" Background="#222" ClipToBounds="True">
                                            <Grid>
                                                <ui:SymbolIcon Symbol="Person24" Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Source="{Binding AvatarImage}" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>

                                        <!-- Name & Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"
                                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding SongsText, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding VocalRange, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Level Badge -->
                                        <Border Grid.Column="2" Background="#1E3A5F" BorderBrush="#0EA5E9" BorderThickness="1"
                                                CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LevelText}" FontSize="11" FontWeight="Bold" Foreground="#0EA5E9" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Bottom Actions -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <ui:Button Content="Delete"
                                   Appearance="Danger"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   Command="{Binding DeleteSingerCommand}"
                                   IsEnabled="{Binding HasSelectedSinger}"
                                   ToolTip="Permanently delete the selected singer account" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Pane: Singer Profile & Settings Editor -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">
                <Grid>
                    <!-- Empty State Placeholder -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasNoSelectedSinger, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon Symbol="People24" FontSize="64" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,12" />
                        <TextBlock Text="No Singer Selected" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Choose a performer from the list on the left or create a new one."
                                   FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Active Editor View -->
                    <Grid Visibility="{Binding HasSelectedSinger, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Performer Profile Header Card -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Large Avatar Preview & Upload Action -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <Border Width="72" Height="72" CornerRadius="36"
                                            BorderBrush="{StaticResource AvatarGlowBrush}" BorderThickness="2"
                                            Background="#181818" ClipToBounds="True">
                                        <Grid>
                                            <ui:SymbolIcon Symbol="Person48" Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding EditAvatarImage}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                        <ui:Button Content="Take Photo" Icon="{ui:SymbolIcon Camera24}"
                                                   Appearance="Primary"
                                                   Command="{Binding OpenWebcamCaptureCommand}" Margin="0,0,0,4"
                                                   ToolTip="Capture a live photo of the performer using a connected webcam" />
                                        <ui:Button Content="Upload Photo" Icon="{ui:SymbolIcon Image24}"
                                                   Appearance="Secondary"
                                                   Command="{Binding UploadAvatarCommand}" Margin="0,0,0,4"
                                                   ToolTip="Select a custom selfie or photo from your computer" />
                                        <ui:Button Content="Center Face" Icon="{ui:SymbolIcon Crop24}"
                                                   Appearance="Secondary"
                                                   Command="{Binding AdjustAvatarCommand}" Margin="0,0,0,4"
                                                   ToolTip="Reposition and zoom the photo to center the performer's face" />
                                        <ui:Button Content="Rotate ↻" Appearance="Secondary"
                                                   Command="{Binding RotateAvatarCommand}" Margin="0,0,0,4"
                                                   ToolTip="Rotate photo 90 degrees clockwise" />
                                        <ui:Button Content="Clear" Appearance="Secondary"
                                                   Command="{Binding ClearAvatarCommand}"
                                                   ToolTip="Remove custom avatar photo" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Performer Name & Badges -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedSinger.Name}" FontSize="24" FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border Background="#2A1E35" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding SelectedSinger.LevelText}" FontSize="12" FontWeight="Bold" Foreground="#FF8E53" />
                                        </Border>
                                        <Border Background="#1E3A5F" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding SelectedSinger.Score, StringFormat='{}{0} XP'}" FontSize="12" FontWeight="SemiBold" Foreground="#0EA5E9" />
                                        </Border>
                                        <Border Background="#1B382B" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding SelectedSinger.SongsText}" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Merge Duplicate Button -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <ui:Button Content="Merge Duplicate..."
                                               Icon="{ui:SymbolIcon People24}"
                                               Appearance="Primary"
                                               Command="{Binding OpenMergePopupCommand}"
                                               ToolTip="Consolidate duplicate accounts for this performer" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Status Toast Alert -->
                        <Border Grid.Row="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#1E3A5F" />
                                    <Setter Property="BorderBrush" Value="#0EA5E9" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatusSuccess}" Value="False">
                                            <Setter Property="Background" Value="#3D1A1A" />
                                            <Setter Property="BorderBrush" Value="#EF4444" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" FontSize="13" Foreground="White" />
                        </Border>

                        <!-- Editor Tabs -->
                        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
                            <!-- TAB 1: Profile & Credentials -->
                            <TabItem Header="Profile &amp; Credentials">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
                                    <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                                        <!-- Performer Name -->
                                        <TextBlock Text="Singer Name" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,4" />
                                        <ui:TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                                        <!-- PIN Code & Email -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Portal PIN Code" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,4" />
                                                <ui:TextBox Text="{Binding EditPinCode, UpdateSourceTrigger=PropertyChanged}"
                                                            PlaceholderText="4-digit PIN for portal login" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Email Address" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,4" />
                                                <ui:TextBox Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}"
                                                            PlaceholderText="Optional patron email" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Vocal Range & Custom Title -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Vocal Range" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,4" />
                                                <ComboBox ItemsSource="{Binding VocalRanges}"
                                                          SelectedItem="{Binding EditVocalRange, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Custom Title / Nickname" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,4" />
                                                <ui:TextBox Text="{Binding EditCustomTitle, UpdateSourceTrigger=PropertyChanged}"
                                                            PlaceholderText="e.g. VIP Performer" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- XP & Songs Counts -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Experience Score (XP)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,4" />
                                                <ui:TextBox Text="{Binding EditScore, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Total Songs Sung" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,4" />
                                                <ui:TextBox Text="{Binding EditTotalSongsSung, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- DJ Notes -->
                                        <TextBlock Text="Performer Notes" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,4" />
                                        <ui:TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                                                    AcceptsReturn="True" Height="70" TextWrapping="Wrap" Margin="0,0,0,14" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- TAB 2: Audio & Voice Defaults -->
                            <TabItem Header="Vocal &amp; Audio Defaults">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
                                    <StackPanel MaxWidth="650" HorizontalAlignment="Left">
                                        <TextBlock Text="These defaults automatically preload whenever this singer performs:"
                                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" />

                                        <!-- Mic Gain (Volume) -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="50" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Microphone Gain" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding EditGain, Mode=TwoWay}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding EditGain, StringFormat='{}{0:0}%'}" TextAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                        </Grid>

                                        <!-- Key Transposition -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="50" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Key Transposition" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="-12" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    Value="{Binding EditKey, Mode=TwoWay}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding EditKey, StringFormat='{}{0:+0;-0;0}'}" TextAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                        </Grid>

                                        <!-- Tempo -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="50" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Playback Speed" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="0.8" Maximum="1.2" TickFrequency="0.05"
                                                    Value="{Binding EditTempo, Mode=TwoWay}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding EditTempo, StringFormat='{}{0:0.0}x'}" TextAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                        </Grid>

                                        <!-- 3-Band EQ -->
                                        <GroupBox Header="3-Band EQ (Tone Controls)" Style="{StaticResource UsersSettingsGroupBoxStyle}" Margin="0,10,0,12" Padding="10">
                                            <StackPanel>
                                                <Grid Margin="0,4,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="60" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Treble" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                                                    <Slider Grid.Column="1" Minimum="-15" Maximum="15" Value="{Binding EditTreble, Mode=TwoWay}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding EditTreble, StringFormat='{}{0:0.0} dB'}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                                </Grid>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="60" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Mid" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                                                    <Slider Grid.Column="1" Minimum="-15" Maximum="15" Value="{Binding EditMid, Mode=TwoWay}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding EditMid, StringFormat='{}{0:0.0} dB'}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                                </Grid>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="60" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Bass" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                                                    <Slider Grid.Column="1" Minimum="-15" Maximum="15" Value="{Binding EditBass, Mode=TwoWay}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding EditBass, StringFormat='{}{0:0.0} dB'}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                                </Grid>
                                            </StackPanel>
                                        </GroupBox>

                                        <!-- Dynamics -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Compressor Amount" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,4" />
                                                <Slider Minimum="0" Maximum="100" Value="{Binding EditCompressor, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Limiter Threshold" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,4" />
                                                <Slider Minimum="0" Maximum="100" Value="{Binding EditLimiter, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Audio Notes / Sound Check Remarks" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,4" />
                                        <ui:TextBox Text="{Binding EditAudioNotes, UpdateSourceTrigger=PropertyChanged}"
                                                    AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- TAB 3: Song Performance History -->
                            <TabItem Header="Performance History">
                                <Grid Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="Record of all songs performed by this singer, with recalled key and tempo settings:"
                                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding PerformanceHistory}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="True"
                                              SelectionMode="Single"
                                              GridLinesVisibility="Horizontal"
                                              Background="Transparent"
                                              Foreground="{DynamicResource AppTextPrimaryBrush}"
                                              BorderThickness="1"
                                              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                              RowHeight="36">
                                        <DataGrid.Resources>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Style>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
                                            </Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Song Title" Binding="{Binding SongTitle}" Width="*" />
                                            <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="150" />
                                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="60" />
                                            <DataGridTextColumn Header="Speed" Binding="{Binding Tempo, StringFormat='{}{0:0.0}x'}" Width="70" />
                                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="80" />
                                            <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding FormattedDate}" Width="160" />
                                            <DataGridTemplateColumn Header="Actions" Width="170">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <ui:Button Content="Queue"
                                                                       Icon="{ui:SymbolIcon Play20}"
                                                                       Appearance="Primary"
                                                                       Padding="6,2"
                                                                       Margin="0,0,6,0"
                                                                       Command="{Binding DataContext.QueueHistoricalSongCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                       CommandParameter="{Binding}"
                                                                       ToolTip="Queue this song into the active rotation" />
                                                            <ui:Button Content="Remove"
                                                                       Appearance="Danger"
                                                                       Icon="{ui:SymbolIcon Delete20}"
                                                                       Padding="6,2"
                                                                       Command="{Binding DataContext.DeleteHistoricalSongCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                       CommandParameter="{Binding}"
                                                                       ToolTip="Remove this record from history" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                        </TabControl>

                        <!-- Bottom Action Bar -->
                        <Border Grid.Row="3" Margin="0,14,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Content="Save Changes"
                                           Icon="{ui:SymbolIcon Save24}"
                                           Appearance="Primary"
                                           Command="{Binding SaveSingerCommand}"
                                           FontWeight="SemiBold"
                                           Padding="20,8" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Merge Duplicate Accounts Modal / Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#B0000000"
                Panel.ZIndex="1000"
                Visibility="{Binding IsMergePopupOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="28"
                    Width="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextElement.Foreground="{DynamicResource AppTextPrimaryBrush}">
                <StackPanel>
                    <TextBlock Text="Merge Duplicate Singer Account" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,10" />
                    <TextBlock Text="Consolidate another singer profile into the currently selected account:" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

                    <!-- Target Account -->
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Target (Keep): " FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding SelectedSinger.Name}" FontWeight="Bold" Foreground="#0EA5E9" />
                        </StackPanel>
                    </Border>

                    <!-- Duplicate Account Selector -->
                    <TextBlock Text="Select Duplicate Account to Merge &amp; Remove:" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding MergeCandidates}"
                              SelectedItem="{Binding SelectedDuplicateSinger, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Margin="0,0,0,16" />

                    <TextBlock Text="All historical song performances, requests, and XP points from the duplicate account will be transferred to the target account. The duplicate account will then be permanently deleted."
                               TextWrapping="Wrap" FontSize="12" Foreground="#F59E0B" Margin="0,0,0,20" />

                    <!-- Dialog Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Cancel" Appearance="Secondary"
                                   Command="{Binding CloseMergePopupCommand}" Margin="0,0,10,0" />
                        <ui:Button Content="Confirm Merge" Appearance="Primary"
                                   Command="{Binding ExecuteMergeAccountsCommand}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Webcam Photo Capture Modal / Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#B0000000"
                Panel.ZIndex="1000"
                Visibility="{Binding IsWebcamOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="24"
                    Width="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextElement.Foreground="{DynamicResource AppTextPrimaryBrush}">
                <StackPanel>
                    <!-- Title & Close -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Webcam Performer Snapshot" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Take a live photo of the performer for their avatar profile and billboard display."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent"
                                   Command="{Binding CloseWebcamCaptureCommand}" VerticalAlignment="Top" />
                    </Grid>

                    <!-- Camera Selector (when cameras exist) -->
                    <Grid Margin="0,0,0,12" Visibility="{Binding HasWebcamDevice, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Select Camera:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,10,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableCameras}"
                                  SelectedItem="{Binding SelectedCamera, Mode=TwoWay}"
                                  DisplayMemberPath="Name" />
                    </Grid>

                    <!-- Live / Captured Viewport -->
                    <Border Width="480" Height="360" Background="#111" CornerRadius="8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" ClipToBounds="True" Margin="0,0,0,14">
                        <Grid>
                            <!-- No Camera Detected View -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding HasNoWebcamDevice, Converter={StaticResource BoolToVis}}">
                                <ui:SymbolIcon Symbol="VideoOff24" FontSize="48" Foreground="#888" Margin="0,0,0,8" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding WebcamStatusMessage}" Foreground="#AAA" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
                            </StackPanel>

                            <!-- Live Stream Image -->
                            <Image Source="{Binding WebcamLiveFrame}" Stretch="Uniform"
                                   Visibility="{Binding IsWebcamStreaming, Converter={StaticResource BoolToVis}}" />

                            <!-- Captured Snapshot Image (Frozen) -->
                            <Image Source="{Binding WebcamCapturedFrame}" Stretch="Uniform"
                                   Visibility="{Binding IsWebcamFrozen, Converter={StaticResource BoolToVis}}" />

                            <!-- Framing Guideline Circle for Performer Headshot -->
                            <Ellipse Width="260" Height="260" Stroke="#40FFFFFF" StrokeThickness="2" StrokeDashArray="3 3"
                                     IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Visibility="{Binding HasWebcamDevice, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid>
                        <!-- When No Camera Detected -->
                        <ui:Button Content="Close" Appearance="Secondary" HorizontalAlignment="Right"
                                   Command="{Binding CloseWebcamCaptureCommand}"
                                   Visibility="{Binding HasNoWebcamDevice, Converter={StaticResource BoolToVis}}" />

                        <!-- When Streaming Live: Capture Button -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Visibility="{Binding IsWebcamStreaming, Converter={StaticResource BoolToVis}}">
                            <ui:Button Content="Cancel" Appearance="Secondary" Command="{Binding CloseWebcamCaptureCommand}" Margin="0,0,10,0" />
                            <ui:Button Content="Capture Snapshot" Appearance="Primary" Icon="{ui:SymbolIcon Camera24}"
                                       Command="{Binding CaptureWebcamSnapshotCommand}" FontWeight="SemiBold" Padding="16,8" />
                        </StackPanel>

                        <!-- When Frozen (Snapshot Taken): Retake / Save & Apply -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Visibility="{Binding IsWebcamFrozen, Converter={StaticResource BoolToVis}}">
                            <ui:Button Content="Retake" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowReset24}"
                                       Command="{Binding RetakeWebcamSnapshotCommand}" Margin="0,0,10,0" />
                            <ui:Button Content="Save &amp; Apply Photo" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}"
                                       Command="{Binding ApplyWebcamSnapshotCommand}" FontWeight="SemiBold" Padding="16,8" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Page>
