<Page x:Class="Lyracist.Views.Pages.RotationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Singer Rotation"
      Background="{DynamicResource AppBackgroundBrush}"
      Foreground="{DynamicResource AppTextPrimaryBrush}">

    <Page.Resources>
        <LinearGradientBrush x:Key="HeaderBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00B4DB" Offset="0.0"/>
            <GradientStop Color="#0083B0" Offset="1.0"/>
        </LinearGradientBrush>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" CornerRadius="12" Padding="20" Margin="0,0,0,24" Background="{StaticResource HeaderBackgroundBrush}">
            <StackPanel>
                <TextBlock Text="Singer Rotation" FontSize="28" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Manage active performers, pitch key adjustments, and notes." FontSize="14" Foreground="#F0F0F0" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Add Singer Form (Left Column) -->
            <Border Grid.Column="0" Margin="0,0,12,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource AppSurfaceBrush}" Padding="20" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Add Performer" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <TextBlock Text="Singer Name" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox IsEditable="True"
                              Text="{Binding NewSingerName, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding SingerNames}"
                              Margin="0,0,0,12" />

                    <TextBlock Text="Key Transposition (Semitones)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ui:TextBox Text="{Binding NewSingerKey, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. +2, -1, 0..." Margin="0,0,0,12"/>

                    <TextBlock Text="Notes / Song Request" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ui:TextBox Text="{Binding NewSingerNotes, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Details..." MinLines="3" MaxLines="5" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"/>

                    <ui:Button Content="Add to Rotation" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddSingerCommand}" Appearance="Primary" Background="{StaticResource UIAccentBrush}" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <!-- Queue Management (Right Column) -->
            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Current Queue" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Icon="{ui:SymbolIcon ArrowUp24}" Command="{Binding MoveUpCommand}" Margin="0,0,4,0" ToolTip="Move Up"/>
                        <ui:Button Icon="{ui:SymbolIcon ArrowDown24}" Command="{Binding MoveDownCommand}" Margin="0,0,4,0" ToolTip="Move Down"/>
                        <ui:Button Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveSingerCommand}" Appearance="Danger" Margin="0,0,8,0" ToolTip="Remove Singer"/>
                        
                        <Separator Width="1" Margin="0,0,8,0" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        
                        <ui:Button Icon="{ui:SymbolIcon Play24}" Content="Sing" Command="{Binding MarkAsSingingCommand}" Appearance="Primary" Background="{StaticResource UIAccentBrush}" Margin="0,0,4,0" ToolTip="Mark As Singing"/>
                        <ui:Button Icon="{ui:SymbolIcon Dismiss24}" Content="Clear" Command="{Binding ClearRotationCommand}" Appearance="Secondary" ToolTip="Clear Rotation"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource AppSurfaceBrush}" Padding="8">
                    <ListBox ItemsSource="{Binding Rotation}" SelectedItem="{Binding SelectedSinger}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Notes}" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" CornerRadius="4" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" Padding="8,4" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Key, StringFormat='Key: {0}'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
