<!-- Edited on Sep 5, 2026 @ 08:45:00 -> Increase question packs ListBox height and patron portal TextBox sizing for enhanced legibility -->
<Page x:Class="Lyracist.Views.Pages.TriviaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Trivia Master Console"
      Background="{DynamicResource AppBackgroundBrush}"
      Foreground="{DynamicResource AppTextPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="StandardActionBtn" TargetType="ui:Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="AnswerBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="4" />
        </Style>
    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar: Venue, Connected Players & Monitor Projection Selector -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎯" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="LYRACIST LIVE TRIVIA MASTER" FontSize="16" FontWeight="ExtraBold" Foreground="#8B5CF6" />
                        <TextBlock Text="{Binding VenueName, StringFormat='Active Venue: {0}'}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Connected Players Badge -->
                    <Border Background="#243347" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                        <TextBlock Text="{Binding ConnectedPlayerCount, StringFormat='👥 {0} Players Connected'}" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" />
                    </Border>

                    <!-- Target Monitor Dropdown -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="🖥️" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding AvailableMonitors}"
                                  SelectedItem="{Binding SelectedMonitor}"
                                  Width="180" Height="32"
                                  Padding="6,2" VerticalContentAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Index, StringFormat='{}Monitor {0}: '}" FontWeight="Bold" Foreground="#8B5CF6" />
                                        <TextBlock Text="{Binding Width, StringFormat='{}{0}x'}" />
                                        <TextBlock Text="{Binding Height}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Open/Activate TV Projection Button -->
                    <ui:Button Content="📺 Open TV Display" Appearance="Primary" Background="#8B5CF6" Foreground="White"
                               Command="{Binding ToggleTriviaDisplayCommand}" FontWeight="Bold" Height="32" Padding="12,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main 3-Column Deck -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Column 1: Game Master Controls -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="GAME MASTER CONTROLS" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,6" />

                        <!-- Category Pack Checklist -->
                        <TextBlock Text="Select Category Pack(s) — check 2+ to mix:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,3" TextWrapping="Wrap" />
                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
                            <Grid>
                                <ListBox ItemsSource="{Binding SelectablePacks}" MinHeight="160" MaxHeight="200" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Height="160">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Padding" Value="4,2" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                                <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- Questions Per Game -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Questions Per Game:" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding QuestionsPerGamePresets}" SelectedItem="{Binding QuestionsPerGame}" Height="28" Padding="6,2" />
                        </Grid>

                        <!-- Auto-Run Gameplay Switch -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="⚡ Auto-Run Game" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                                    <TextBlock Text="{Binding AutoRunTimingSummary}" FontSize="9" Foreground="#94A3B8" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding AutoAdvanceQuestions}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Primary 1-Click Launch Action -->
                        <ui:Button Content="🎯 Launch Pre-Game Countdown" Command="{Binding LaunchPreGameLobbyCommand}"
                                   Appearance="Primary" Background="#6366F1" Foreground="White" Style="{StaticResource StandardActionBtn}"
                                   ToolTip="Opens big screen with category banner, countdown timer, and scan-to-join instructions." />

                        <ui:Button Content="▶ Start Game Now (Skip Countdown)" Command="{Binding StartGameCommand}"
                                   Appearance="Primary" Background="#10B981" Foreground="White" Style="{StaticResource StandardActionBtn}" Margin="0,0,0,12" />

                        <!-- Live Question Controls -->
                        <TextBlock Text="LIVE QUESTION CONTROLS" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,6" />
                        <ui:Button Content="▶ Start Question &amp; Timer" Command="{Binding StartQuestionCommand}"
                                   Appearance="Primary" Background="#3B82F6" Foreground="White" Style="{StaticResource StandardActionBtn}" />

                        <ui:Button Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}"
                                   Appearance="Secondary" Style="{StaticResource StandardActionBtn}" />

                        <ui:Button Content="🔓 Lock &amp; Reveal Answer" Command="{Binding LockAndRevealCommand}"
                                   Appearance="Secondary" Background="#F59E0B" Foreground="White" Style="{StaticResource StandardActionBtn}" />

                        <ui:Button Content="⏭ Next Question" Command="{Binding NextQuestionCommand}"
                                   Appearance="Secondary" Style="{StaticResource StandardActionBtn}" />

                        <ui:Button Content="🔄 Reset Game Session" Command="{Binding ResetGameCommand}"
                                   Appearance="Danger" Style="{StaticResource StandardActionBtn}" Margin="0,0,0,12" />

                        <!-- Patron Join URL & Server Info -->
                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                            <StackPanel>
                                <TextBlock Text="📱 Patron Mobile Portal" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,2" Height="20" />
                                <TextBox Text="{Binding PatronUrl}" IsReadOnly="True" FontSize="11" Foreground="#38BDF8" Height="35" Margin="0,0,0,3" />
                                <TextBlock Text="{Binding ServerStatusText}" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                <TextBlock Text="{Binding PauseReason, StringFormat='⏸ PAUSED: {0}'}" Foreground="#EF4444" FontWeight="Bold" FontSize="10" Margin="0,2,0,0"
                                           Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Column 2: Active Question, Answer Distribution Visualizer & 2x2 Options -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Active Question Prompt Header -->
                <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ActiveRoundTitle}" FontSize="13" FontWeight="Bold" Foreground="#8B5CF6" />
                            <TextBlock Grid.Column="1" Text="{Binding RemainingSeconds, StringFormat='⏱ {0}s left'}" FontWeight="Bold" FontSize="14" Foreground="#F59E0B" />
                        </Grid>
                        <TextBlock Text="{Binding CurrentQuestionPrompt}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" LineHeight="24" MinHeight="48" />
                    </StackPanel>
                </Border>

                <!-- Live Answer Distribution Graph -->
                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📊 LIVE PATRON RESPONSE VISUALIZER" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding AnswerDistribution}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="55" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Value="{Binding Count}" Maximum="25" Height="10" Foreground="#8B5CF6" Background="#334155" Margin="6,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat='{}{0} votes'}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 2x2 Option Cards -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Option A -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource AnswerBoxStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="▲ OPTION A" FontWeight="Black" Foreground="#EF4444" FontSize="11" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding OptionA}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Option B -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource AnswerBoxStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="◆ OPTION B" FontWeight="Black" Foreground="#3B82F6" FontSize="11" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding OptionB}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Option C -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource AnswerBoxStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="● OPTION C" FontWeight="Black" Foreground="#F59E0B" FontSize="11" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding OptionC}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Option D -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource AnswerBoxStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="■ OPTION D" FontWeight="Black" Foreground="#10B981" FontSize="11" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding OptionD}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Column 3: Live Player Roster & Leaderboard -->
            <Border Grid.Column="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🏆 Live Player Leaderboard" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Players.Count, StringFormat='{}{0} Players'}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{Binding Players}" BorderThickness="0" Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                            <TextBlock Text="{Binding TeamName, StringFormat='Team: {0}'}" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalScore, StringFormat='{}{0:N0} pts'}" FontWeight="Bold" Foreground="#38BDF8" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ui:Button Grid.Column="2" Content="✕" Height="22" Width="22" Padding="0" Appearance="Danger"
                                                   Command="{Binding DataContext.RemovePlayerCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                   CommandParameter="{Binding}" ToolTip="Kick Player" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
