<!-- Created on Aug 17, 2026 @ 15:47:00 -> Live Game Master interactive console page for Lyracist Pro -->
<Page x:Class="Lyracist.Views.Pages.TriviaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Trivia Master Console"
      Background="{DynamicResource AppBackgroundBrush}"
      Foreground="{DynamicResource AppTextPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="AnswerBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A1E2E" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="4" />
        </Style>
    </Page.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- Left Column: Pack & Game Controls -->
        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
            <StackPanel>
                <TextBlock Text="🎮 Game Master Deck" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,12" />

                <!-- Pack Selection: check 2+ packs to shuffle them together into one mixed game -->
                <TextBlock Text="Question Pack(s) — check 2+ to mix categories" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                        <ListBox ItemsSource="{Binding SelectablePacks}" MaxHeight="150" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Padding" Value="6,3" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding Title}" FontSize="12" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshPacksCommand}" Margin="4,0,0,0" ToolTip="Refresh Packs" VerticalAlignment="Top" />
                </Grid>

                <!-- Game State Pill -->
                <Border Background="#2563EB" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding GameStateText, StringFormat='State: {0}'}" Foreground="White" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding RemainingSeconds, StringFormat='⏱ {0}s'}" Foreground="#FDE047" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Paused Alert Pill -->
                <Border Background="#DC2626" CornerRadius="6" Padding="10,6" Margin="0,0,0,12" Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding PauseReason, StringFormat='⏸ PAUSED: {0}'}" Foreground="White" FontWeight="Bold" FontSize="11" TextWrapping="Wrap" />
                </Border>

                <!-- Control Buttons -->
                <ui:Button Content="🚀 Start Game" Icon="{ui:SymbolIcon Play24}" Command="{Binding StartGameCommand}"
                           Appearance="Primary" Background="#8B5CF6" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" Margin="0,0,0,8" />

                <ui:Button Content="{Binding PauseButtonText}" Icon="{ui:SymbolIcon Pause24}" Command="{Binding TogglePauseCommand}"
                           Appearance="Secondary" HorizontalAlignment="Stretch" Margin="0,0,0,8" />

                <ui:Button Content="🔍 Lock &amp; Reveal" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding LockAndRevealCommand}"
                           Appearance="Secondary" HorizontalAlignment="Stretch" Margin="0,0,0,8" />

                <ui:Button Content="⏭ Next Question" Icon="{ui:SymbolIcon ArrowRight24}" Command="{Binding NextQuestionCommand}"
                           Appearance="Secondary" HorizontalAlignment="Stretch" Margin="0,0,0,8" />

                <ui:Button Content="🔄 Reset Session" Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding ResetGameCommand}"
                           Appearance="Danger" HorizontalAlignment="Stretch" Margin="0,0,0,16" />

                <!-- Server Info -->
                <TextBlock Text="Patron Join URL" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2" />
                <TextBox Text="{Binding PatronUrl}" IsReadOnly="True" FontSize="11" Foreground="#38BDF8" Margin="0,0,0,4" />
                <TextBlock Text="{Binding ServerStatusText}" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Center Column: Active Question & Live Answers -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Round & Prompt Header -->
            <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding ActiveRoundTitle}" FontSize="13" FontWeight="SemiBold" Foreground="#8B5CF6" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding CurrentQuestionPrompt}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" LineHeight="24" />
                </StackPanel>
            </Border>

            <!-- 2x2 Answer Cards -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Option A -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource AnswerBoxStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="▲ Option A" FontWeight="Bold" Foreground="#EF4444" FontSize="12" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding OptionA}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Option B -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource AnswerBoxStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="◆ Option B" FontWeight="Bold" Foreground="#3B82F6" FontSize="12" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding OptionB}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Option C -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource AnswerBoxStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="● Option C" FontWeight="Bold" Foreground="#F59E0B" FontSize="12" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding OptionC}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Option D -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource AnswerBoxStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="■ Option D" FontWeight="Bold" Foreground="#10B981" FontSize="12" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding OptionD}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Right Column: Live Players & Leaderboard -->
        <Border Grid.Column="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🏆 Live Leaderboard" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Players.Count, StringFormat='{}{0} Players'}" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{Binding Players}" BorderThickness="0" Background="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding TeamName, StringFormat='Team: {0}'}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding TotalScore, StringFormat='{}{0} pts'}" FontWeight="Bold" Foreground="#38BDF8" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
