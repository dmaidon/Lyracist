<!-- Edited on Sep 9, 2026 @ 14:25:00 -> Fix tablet DataGrid action button vertical line collapse, add search clear button, and bind SelectedSearchTabIndex -->
<Page x:Class="Lyracist.Views.Pages.KaraokePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:wpf="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:helpers="clr-namespace:Lyracist.Core.Helpers"
      Title="Karaoke"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <Page.Resources>
        <helpers:SingerAvatarConverter x:Key="SingerAvatarConverter" />
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <helpers:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <LinearGradientBrush x:Key="HeaderBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF8E53" Offset="0.0" />
            <GradientStop Color="#FF4E50" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Keyed + self-referencing so it cascades down every
             nested level of the data-bound menu tree without
             applying to the top-level dropdown header itself. -->
        <Style x:Key="OccasionMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding Name}" />
            <Setter Property="ItemsSource" Value="{Binding Children}" />
            <Setter Property="ItemContainerStyle" Value="{DynamicResource OccasionMenuItemStyle}" />
            <Setter Property="Command" Value="{Binding DataContext.PlayOccasionCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
        </Style>

        <!-- Search-result row tint so karaoke vs. music results are distinguishable at a glance -
             green for karaoke (IsKaraoke=True), gold for music (the default, since the Music
             Library tab's rows all have IsKaraoke=False). -->
        <Style x:Key="SongTypeRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Background" Value="#15F59E0B" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKaraoke}" Value="True">
                    <Setter Property="Background" Value="#1522C55E" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" CornerRadius="12" Padding="10" Margin="0,0,0,10" Background="{StaticResource HeaderBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Lyracist Karaoke Control" FontSize="28" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Control your audio, CDG decoding, and singer queues here." FontSize="14" Foreground="#F0F0F0" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Venue & DJ Names (Venue on top, DJ on bottom) -->
                    <Border BorderBrush="#60FFFFFF"
                            BorderThickness="1,0,0,0"
                            Padding="12,2,12,2"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding VenueTitleText}" FontSize="12" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="{Binding DjTitleText}" FontSize="12" FontWeight="SemiBold" Foreground="#F0F0F0" />
                        </StackPanel>
                    </Border>

                    <!-- Pending Request Indicator Bulbs -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="18" Margin="0,0,8,0" BorderBrush="#40000000" BorderThickness="1"
                                Cursor="Hand" ToolTip="Pending karaoke request — click to review">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToRequestsCommand}" />
                            </Border.InputBindings>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#33000000" />
                                    <Setter Property="Effect" Value="{x:Null}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPendingKaraokeRequest}" Value="True">
                                            <Setter Property="Background" Value="#FFD700" />
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#FFD700" BlurRadius="18" ShadowDepth="0" Opacity="0.95" />
                                                </Setter.Value>
                                            </Setter>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="KaraokeBulbPulse">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.5" Duration="0:0:0.8" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="KaraokeBulbPulse" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ui:SymbolIcon Symbol="Mic24" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="#66FFFFFF" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPendingKaraokeRequest}" Value="True">
                                                <Setter Property="Foreground" Value="#3A2E00" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Border>

                        <Border Width="36" Height="36" CornerRadius="18" BorderBrush="#40000000" BorderThickness="1"
                                Cursor="Hand" ToolTip="Pending music request — click to review">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToRequestsCommand}" />
                            </Border.InputBindings>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#33000000" />
                                    <Setter Property="Effect" Value="{x:Null}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPendingMusicRequest}" Value="True">
                                            <Setter Property="Background" Value="#39FF14" />
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#39FF14" BlurRadius="18" ShadowDepth="0" Opacity="0.95" />
                                                </Setter.Value>
                                            </Setter>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="MusicBulbPulse">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.5" Duration="0:0:0.8" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="MusicBulbPulse" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ui:SymbolIcon Symbol="MusicNote224" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="#66FFFFFF" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPendingMusicRequest}" Value="True">
                                                <Setter Property="Foreground" Value="#0A3300" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Border>
                    </StackPanel>

                    <!-- QR Code Badge -->
                    <Border Background="#20000000" BorderBrush="White" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="White" Padding="2" CornerRadius="4" Width="70" Height="70" VerticalAlignment="Center">
                                <Image Source="{Binding QrCodeImage}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="SCAN TO JOIN" FontSize="9" FontWeight="ExtraBold" Foreground="White" />
                                <TextBlock Text="{Binding JoinUrl}" FontSize="10" Foreground="#FFF5D042" FontWeight="SemiBold" Margin="0,1,0,0" />
                                <ui:Button Content="📟 Kiosk QR" Command="{Binding OpenKioskQrWindowCommand}" Appearance="Secondary" Padding="4,1" Height="18" FontSize="9" Margin="0,2,0,0" ToolTip="Open Tablet Kiosk QR Code Popout" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    <ComboBox SelectedItem="{Binding ThemeMode, Mode=TwoWay}" ItemsSource="{Binding ThemeModes}" Width="110" Height="38" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Auto-Advance & DJ Control Strip -->
        <Border Grid.Row="1"
                Background="#1E1E2A"
                BorderBrush="#FFD700"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,4"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Countdown & Progress Bar -->
                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Clock24" Foreground="#FFD700" Margin="0,0,6,0" FontSize="16" />
                        <TextBlock Text="Auto-Advance:" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AutoAdvanceRemainingSeconds, StringFormat='{} {0}s'}" FontSize="12" FontWeight="Bold" Foreground="#FFD700" VerticalAlignment="Center" Margin="4,0,0,0"
                                   Visibility="{Binding IsAutoAdvanceActive, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                        <TextBlock Text=" Ready" FontSize="11" FontWeight="SemiBold" Foreground="#888888" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAutoAdvanceActive}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <ProgressBar Grid.Column="1"
                                 Minimum="0"
                                 Maximum="{Binding AutoAdvanceMaxSeconds}"
                                 Value="{Binding AutoAdvanceRemainingSeconds}"
                                 Foreground="#FFD700"
                                 Background="#333344"
                                 Height="4"
                                 Margin="12,0"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsAutoAdvanceActive, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                </Grid>

                <!-- Right: Compact DJ Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="StartSongButton"
                               Content="▶ Start Song"
                               Command="{Binding StartSongNowCommand}"
                               Appearance="Primary"
                               Background="{StaticResource UIAccentBrush}"
                               Height="28"
                               Padding="10,2"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="0,0,8,0"
                               ToolTip="Immediately start the next song" />

                    <ui:Button x:Name="SkipSingerButton"
                               Content="⏭ Skip Singer"
                               Command="{Binding SkipSingerCommand}"
                               Appearance="Secondary"
                               Height="28"
                               Padding="10,2"
                               FontSize="11"
                               FontWeight="Bold"
                               ToolTip="Skip current singer in rotation" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.8*" MinWidth="360" />
                <ColumnDefinition Width="3.2*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Search & Assignment -->
            <ScrollViewer Grid.Column="0" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPreviewExpanded}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="300" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search Input Row -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,6,0">
                        <ui:TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Search song or artist..."
                                    Icon="{ui:SymbolIcon Search24}"
                                    KeyDown="SearchBox_KeyDown" />
                        <ui:Button Command="{Binding ClearSearchQueryCommand}"
                                   Icon="{ui:SymbolIcon Dismiss16}"
                                   Appearance="Transparent"
                                   Padding="4"
                                   Width="28"
                                   Height="28"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"
                                   ToolTip="Clear search text"
                                   Visibility="{Binding HasSearchQuery, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                    </Grid>
                    <ui:Button Grid.Column="1"
                               Content="Scan"
                               Icon="{ui:SymbolIcon Search24}"
                               Command="{Binding SearchDatabaseCommand}"
                               Appearance="Primary"
                               ToolTip="Scan database for matching songs"
                               Margin="0,0,4,0" />
                    <ui:Button Grid.Column="2"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Command="{Binding ScanFolderCommand}"
                               Appearance="Secondary"
                               ToolTip="Scan music folder from disk into library..." />
                </Grid>

                <!-- Search Results list -->
                <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedSearchTabIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Margin="0,0,0,12">
                    <TabItem FontSize="12">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Karaoke Library" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FilteredSongs.Count, StringFormat=' ({0})'}" VerticalAlignment="Center" Opacity="0.75" Margin="2,0,0,0" />
                            </StackPanel>
                        </TabItem.Header>
                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="4" Margin="0,8,0,0">
                            <DataGrid ItemsSource="{Binding FilteredSongs}"
                                      SelectedItem="{Binding SelectedSong, Mode=TwoWay}"
                                      MouseDoubleClick="OnSongDoubleClicked"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      RowStyle="{StaticResource SongTypeRowStyle}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Item"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Song" Binding="{Binding Title}" Width="*" />
                                    <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*" />
                                    <DataGridTemplateColumn Width="52" MinWidth="52" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ui:Button Icon="{ui:SymbolIcon Add24}"
                                                           Command="{Binding DataContext.AddSongToRotationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}"
                                                           ToolTip="Add to Rotation"
                                                           Appearance="Primary"
                                                           Width="36"
                                                           Height="32"
                                                           Padding="4"
                                                           Margin="2"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>

                    <TabItem FontSize="12">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Music Library" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FilteredMusic.Count, StringFormat=' ({0})'}" VerticalAlignment="Center" Opacity="0.75" Margin="2,0,0,0" />
                            </StackPanel>
                        </TabItem.Header>
                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="4" Margin="0,8,0,0">
                            <DataGrid ItemsSource="{Binding FilteredMusic}"
                                      SelectedItem="{Binding SelectedSong, Mode=TwoWay}"
                                      MouseDoubleClick="OnSongDoubleClicked"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      RowStyle="{StaticResource SongTypeRowStyle}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Item"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Song" Binding="{Binding Title}" Width="*" />
                                    <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*" />
                                    <DataGridTemplateColumn Width="52" MinWidth="52" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ui:Button Icon="{ui:SymbolIcon Add24}"
                                                           Command="{Binding DataContext.AddSongToRotationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}"
                                                           ToolTip="Add to Rotation"
                                                           Appearance="Primary"
                                                           Width="36"
                                                           Height="32"
                                                           Padding="4"
                                                           Margin="2"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>

                    <TabItem Header="Streaming Links" FontSize="12">
                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="12" Margin="0,8,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Service Selector -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Service:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" FontWeight="SemiBold" />
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding SelectedExternalService, Mode=TwoWay}" SelectedValuePath="Content" FontSize="11" Height="35">
                                        <ComboBoxItem Content="All" />
                                        <ComboBoxItem Content="Spotify" />
                                        <ComboBoxItem Content="YouTube" />
                                        <ComboBoxItem Content="Amazon" />
                                    </ComboBox>
                                </Grid>

                                <!-- Direct URL input for Custom Links -->
                                <Border Grid.Row="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <StackPanel>
                                        <TextBlock Text="Paste Custom Music Link" FontSize="11" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" />
                                        <ui:TextBox Text="{Binding CustomExternalUrl, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Paste Spotify, YouTube, or Amazon URL..." Margin="0,0,0,6" FontSize="11" Height="35" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox Grid.Column="0" Text="{Binding CustomExternalTitle, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Song Title (Optional)..." Margin="0,0,4,0" FontSize="11" Height="35" />
                                            <ui:TextBox Grid.Column="1" Text="{Binding CustomExternalArtist, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Artist Name (Optional)..." Margin="4,0,0,0" FontSize="11" Height="35" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Search Results list of cloud backing tracks -->
                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="3" Visibility="{Binding IsExternalLoading, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" Margin="0,0,0,4" />

                                    <ListBox Grid.Row="1" ItemsSource="{Binding ExternalResults}" SelectedItem="{Binding SelectedExternalTrack, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" CornerRadius="6" Padding="8,6" Margin="2" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <!-- Source Provider Badge -->
                                                        <Border Grid.Column="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="6,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Source}" Value="Spotify">
                                                                            <Setter Property="Background" Value="#331DB954" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Source}" Value="YouTube">
                                                                            <Setter Property="Background" Value="#33FF0000" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Source}" Value="Amazon">
                                                                            <Setter Property="Background" Value="#3300A8E1" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="9" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Source}" Value="Spotify">
                                                                                <Setter Property="Text" Value="SPOTIFY" />
                                                                                <Setter Property="Foreground" Value="#1DB954" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Source}" Value="YouTube">
                                                                                <Setter Property="Text" Value="YOUTUBE" />
                                                                                <Setter Property="Foreground" Value="#FF0000" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Source}" Value="Amazon">
                                                                                <Setter Property="Text" Value="AMAZON" />
                                                                                <Setter Property="Foreground" Value="#00A8E1" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:Button Icon="{ui:SymbolIcon Add24}"
                                                                   Command="{Binding DataContext.AddExternalSongToRotationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                   CommandParameter="{Binding}"
                                                                   ToolTip="Add Song to Singer"
                                                                   Appearance="Secondary"
                                                                   Padding="6" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="Singer History" FontSize="12">
                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="4" Margin="0,8,0,0">
                            <DataGrid ItemsSource="{Binding SingerHistoryResults}"
                                       SelectedItem="{Binding SelectedHistoryEntry, Mode=TwoWay}"
                                       MouseDoubleClick="OnHistoryDoubleClicked"
                                       AutoGenerateColumns="False"
                                       IsReadOnly="True"
                                       HeadersVisibility="Column"
                                       GridLinesVisibility="Horizontal"
                                       Background="Transparent"
                                       BorderThickness="0"
                                       VirtualizingPanel.IsVirtualizing="True"
                                       VirtualizingPanel.VirtualizationMode="Recycling"
                                       VirtualizingPanel.ScrollUnit="Item"
                                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Song" Binding="{Binding SongTitle}" Width="*" />
                                    <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*" />
                                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="45" />
                                    <DataGridTextColumn Header="Speed" Binding="{Binding Tempo, StringFormat='{}{0:0.0}x'}" Width="50" />
                                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="75" />
                                    <DataGridTemplateColumn Width="52" MinWidth="52" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ui:Button Icon="{ui:SymbolIcon Add24}"
                                                           Command="{Binding DataContext.AddHistorySongToRotationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}"
                                                           ToolTip="Add Song to Rotation"
                                                           Width="36"
                                                           Height="32"
                                                           Padding="4"
                                                           Margin="2"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>
                </TabControl>

                <!-- Singer Assignment Card -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Singer Assignment" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                        <TextBlock Text="Singer Name" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox IsEditable="True"
                                  Text="{Binding NewSingerName, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding SingerNames}"
                                  Margin="0,0,0,8" />

                        <TextBlock Text="Duet Partner Name (Optional)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox IsEditable="True"
                                  Text="{Binding NewDuetPartnerName, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding SingerNames}"
                                  Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Key Transposition" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding NewSingerKey, StringFormat='{}{0:+0;-0;0}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorAttentionBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Slider Minimum="-6" Maximum="6" Value="{Binding NewSingerKey, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,8" />

                        <TextBlock Text="Notes / Song Request" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding NewSingerNotes, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Details..." MinLines="2" MaxLines="3" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

                        <ui:Button Content="Add Performer To Rotation" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddToRotationCommand}" Appearance="Primary" Background="{StaticResource UIAccentBrush}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <!-- Selected Performer's Pending Songs Card -->
                <Border Grid.Row="3" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="16" Margin="0,12,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rotation.SelectedSinger}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="Songs Queue for: {0}">
                                    <Binding Path="Rotation.SelectedSinger.Name" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Rotation.SelectedSingerQueue}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  MaxHeight="180"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Song" Binding="{Binding Title, Mode=TwoWay}" IsReadOnly="False" Width="1.2*" />
                                <DataGridTextColumn Header="Artist" Binding="{Binding Artist, Mode=TwoWay}" IsReadOnly="False" Width="*" />
                                <DataGridTextColumn Header="Key" Binding="{Binding Key, Mode=TwoWay}" IsReadOnly="False" Width="40" />
                                <DataGridTextColumn Header="Notes" Binding="{Binding Notes, Mode=TwoWay}" IsReadOnly="False" Width="1.2*" />
                                <DataGridTemplateColumn Width="98" MinWidth="98" CanUserResize="False" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ui:Button Icon="{ui:SymbolIcon ArrowUp16}"
                                                           Command="{Binding DataContext.Rotation.MovePendingSongUpCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}"
                                                           ToolTip="Move Up"
                                                           Width="28"
                                                           Height="28"
                                                           Padding="2" Margin="0,0,2,0" />
                                                <ui:Button Icon="{ui:SymbolIcon ArrowDown16}"
                                                           Command="{Binding DataContext.Rotation.MovePendingSongDownCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}"
                                                           ToolTip="Move Down"
                                                           Width="28"
                                                           Height="28"
                                                           Padding="2" Margin="0,0,2,0" />
                                                <ui:Button Icon="{ui:SymbolIcon Delete16}"
                                                           Command="{Binding DataContext.Rotation.RemovePendingSongCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}"
                                                           ToolTip="Remove"
                                                           Appearance="Danger"
                                                           Width="28"
                                                           Height="28"
                                                           Padding="2" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
            </ScrollViewer>

            <!-- Middle Column: Queue & Media Controls -->
            <Grid Grid.Column="1" Margin="0,0,12,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPreviewExpanded}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Singer Queue" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Icon="{ui:SymbolIcon ArrowUp24}" Command="{Binding Rotation.MoveUpCommand}" Margin="0,0,4,0" ToolTip="Move Up" />
                            <ui:Button Icon="{ui:SymbolIcon ArrowDown24}" Command="{Binding Rotation.MoveDownCommand}" Margin="0,0,4,0" ToolTip="Move Down" />
                            <ui:Button Icon="{ui:SymbolIcon Delete24}" Command="{Binding Rotation.RemoveSingerCommand}" Appearance="Danger" Margin="0,0,8,0" ToolTip="Remove Selected Singer" />

                            <Separator Width="1" Margin="0,0,4,0" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                            <ui:Button Icon="{ui:SymbolIcon Play24}" Content="Current" Command="{Binding Rotation.MarkAsSingingCommand}" Appearance="Primary" Background="{StaticResource UIAccentBrush}" Margin="0,0,4,0" ToolTip="Mark As Singing" />
                            <ui:Button Icon="{ui:SymbolIcon Dismiss24}" Content="Clear" Command="{Binding Rotation.ClearRotationCommand}" Appearance="Secondary" ToolTip="Clear Rotation" />
                        </StackPanel>
                    </Grid>
                    <!-- Queue Service Filters -->
                    <WrapPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <CheckBox Content="Local" IsChecked="{Binding ShowLocalFilter, Mode=TwoWay}" Margin="0,0,10,0" FontSize="11" />
                        <CheckBox Content="Spotify" IsChecked="{Binding ShowSpotifyFilter, Mode=TwoWay}" IsEnabled="{Binding IsSpotifyAvailable}" Margin="0,0,10,0" FontSize="11" />
                        <CheckBox Content="YouTube" IsChecked="{Binding ShowYouTubeFilter, Mode=TwoWay}" IsEnabled="{Binding IsYouTubeAvailable}" Margin="0,0,10,0" FontSize="11" />
                        <CheckBox Content="Amazon" IsChecked="{Binding ShowAmazonFilter, Mode=TwoWay}" IsEnabled="{Binding IsAmazonAvailable}" Margin="0,0,0,0" FontSize="11" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="Float to Top" IsChecked="{Binding Rotation.FloatCurrentSingerToTop, Mode=TwoWay}" Margin="0,0,12,0" FontSize="11" ToolTip="When checked, the current performer always floats to the top of the rotation list." />
                        <CheckBox Content="Auto-Play Rotation Music" IsChecked="{Binding AutoPlayRotationMusic, Mode=TwoWay}" Margin="0,0,12,0" FontSize="11" />
                        <TextBlock Text="Delay:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ComboBox SelectedItem="{Binding RotationMusicDelaySeconds, Mode=TwoWay}" ItemsSource="{Binding MusicDelayOptions}" Width="65" Height="24" FontSize="11" Padding="6,1" VerticalContentAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="sec" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </WrapPanel>
                </StackPanel>

                <!-- Queue List Box -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="6">
                    <ListBox ItemsSource="{Binding Rotation.Rotation}" SelectedItem="{Binding Rotation.SelectedSinger}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,2" />
                                <Setter Property="Visibility" Value="Visible" />
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_PreviewMouseLeftButtonDown" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Source}" Value="Local" />
                                            <Condition Binding="{Binding DataContext.ShowLocalFilter, RelativeSource={RelativeSource AncestorType=Page}}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Source}" Value="Spotify" />
                                            <Condition Binding="{Binding DataContext.ShowSpotifyFilter, RelativeSource={RelativeSource AncestorType=Page}}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Source}" Value="YouTube" />
                                            <Condition Binding="{Binding DataContext.ShowYouTubeFilter, RelativeSource={RelativeSource AncestorType=Page}}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Source}" Value="Amazon" />
                                            <Condition Binding="{Binding DataContext.ShowAmazonFilter, RelativeSource={RelativeSource AncestorType=Page}}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}" BorderThickness="1.5" CornerRadius="6" Padding="6,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                            <Style.Triggers>
                                                <!-- Lowest priority: Rotation Anchor red tint, overridden below by Current (yellow) / Next (blue) -->
                                                <DataTrigger Binding="{Binding IsRotationStart}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#DC2626" />
                                                    <Setter Property="Background" Value="#15DC2626" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#F5D042" />
                                                    <Setter Property="Background" Value="#15F5D042" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#3B82F6" />
                                                    <Setter Property="Background" Value="#153B82F6" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Command="{Binding Path=PlacementTarget.Tag.Rotation.SetRotationStartSingerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Header" Value="Set as Rotation Anchor" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRotationStart}" Value="True">
                                                                <Setter Property="Header" Value="Clear Rotation Anchor" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <MenuItem Header="Edit Singer Audio Defaults..." Command="{Binding Path=PlacementTarget.Tag.EditSingerSettingsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                            <MenuItem Header="Play Performer's Request" Command="{Binding Path=PlacementTarget.Tag.PlayPerformerRequestCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                            <MenuItem Header="Open External Link in Browser" Command="{Binding Path=PlacementTarget.Tag.OpenExternalLinkInBrowserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Source}" Value="Local">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Current Performer Selector Star Box -->
                                        <Border Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Button Padding="2" Background="Transparent" BorderThickness="1" BorderBrush="#33888888" Width="26" Height="26"
                                                    Command="{Binding DataContext.Rotation.SetCurrentSingerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Set as Current Performer">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Foreground" Value="#888888" />
                                                        <Setter Property="Content" Value="☆" />
                                                        <Setter Property="FontSize" Value="12" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Foreground" Value="#F5D042" />
                                                                <Setter Property="Content" Value="★" />
                                                                <Setter Property="BorderBrush" Value="#F5D042" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Border>

                                        <!-- Singer Avatar image -->
                                        <Border Grid.Column="1" Width="28" Height="28" CornerRadius="14" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" ClipToBounds="True" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Image Source="{Binding Converter={StaticResource SingerAvatarConverter}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Visibility="{Binding IsRotationStart, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#DC2626" CornerRadius="4" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Rotation Anchor (marks where a round begins)">
                                                    <TextBlock Text="⚓ ANCHOR" FontSize="9" FontWeight="ExtraBold" Foreground="White" />
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <Border Visibility="{Binding IsPaused, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" Background="#CC3300" CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="PAUSED" FontSize="9" FontWeight="ExtraBold" Foreground="White" />
                                                </Border>

                                                <!-- Separator and song info only if there is a song loaded -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding SongTitle, Converter={StaticResource NotEmptyToVisibilityConverter}}">
                                                    <TextBlock Text="  ➔  " FontSize="10" Foreground="#888888" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding SongTitle}" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                                    <TextBlock Text=" by " FontSize="9.5" Foreground="#888888" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Artist}" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="130" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Notes}" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,1,0,0" Visibility="{Binding Notes, Converter={StaticResource NotEmptyToVisibilityConverter}}" />
                                        </StackPanel>

                                        <!-- Badge for Service Provider (Local, Party Tyme, Spotify, YouTube, Amazon) -->
                                        <Border Grid.Column="3" CornerRadius="4" Padding="5,1" VerticalAlignment="Center" Margin="4,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Source}" Value="Local">
                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Source}" Value="Spotify">
                                                            <Setter Property="Background" Value="#331DB954" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Source}" Value="YouTube">
                                                            <Setter Property="Background" Value="#33FF0000" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Source}" Value="Amazon">
                                                            <Setter Property="Background" Value="#3300A8E1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="8.5" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Source}" Value="Local">
                                                                <Setter Property="Text" Value="LOCAL" />
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Source}" Value="Spotify">
                                                                <Setter Property="Text" Value="SPOTIFY" />
                                                                <Setter Property="Foreground" Value="#1DB954" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Source}" Value="YouTube">
                                                                <Setter Property="Text" Value="YOUTUBE" />
                                                                <Setter Property="Foreground" Value="#FF0000" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Source}" Value="Amazon">
                                                                <Setter Property="Text" Value="AMAZON" />
                                                                <Setter Property="Foreground" Value="#00A8E1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Key & Actions -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                            <Border CornerRadius="4" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" Padding="5,1" VerticalAlignment="Center" Margin="0,0,4,0">
                                                <TextBlock Text="{Binding Key, StringFormat='Key: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                            </Border>

                                            <!-- Edit Button -->
                                            <ui:Button Icon="{ui:SymbolIcon Edit20}"
                                                       Command="{Binding DataContext.Rotation.EditSingerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                       CommandParameter="{Binding}"
                                                       Appearance="Secondary"
                                                       Margin="0,0,2,0"
                                                       Padding="3"
                                                       ToolTip="Edit singer name, song, artist, key, or notes" />

                                            <!-- Done Button -->
                                            <ui:Button Icon="{ui:SymbolIcon Checkmark20}"
                                                       Command="{Binding DataContext.Rotation.DoneSingerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                       CommandParameter="{Binding}"
                                                       Appearance="Success"
                                                       Margin="0,0,2,0"
                                                       Padding="3"
                                                       ToolTip="Mark current song as completed (updates song request and advances active indicator)" />

                                            <!-- Pause/Resume Button -->
                                            <ui:Button Command="{Binding DataContext.Rotation.TogglePauseSingerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                       CommandParameter="{Binding}"
                                                       Margin="0,0,2,0"
                                                       Padding="3">
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Icon" Value="{ui:SymbolIcon Pause20}" />
                                                        <Setter Property="ToolTip" Value="Pause performer (temporary skip)" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                                <Setter Property="Icon" Value="{ui:SymbolIcon Play20}" />
                                                                <Setter Property="ToolTip" Value="Resume performer" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>

                                            <!-- Inactive Button -->
                                            <ui:Button Icon="{ui:SymbolIcon Dismiss20}"
                                                       Command="{Binding DataContext.Rotation.ToggleInactiveSingerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                       CommandParameter="{Binding}"
                                                       Appearance="Secondary"
                                                       Padding="3"
                                                       ToolTip="Set performer inactive (removes from active rotation)" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Queue Sing Button -->
                <ui:Button Grid.Row="2" Content="Load &amp; Play Selected Performer" Icon="{ui:SymbolIcon Play24}" Command="{Binding LoadAndPlaySelectedPerformerCommand}" Appearance="Primary" HorizontalAlignment="Stretch" Padding="12" Margin="0,12,0,0" Background="{StaticResource UIAccentBrush}" />
            </Grid>

            <!-- Right Column: Live Lyrics Preview, Audio Controls & Displays -->
            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="#0A0A0A" Padding="16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Grid.Column" Value="2" />
                        <Setter Property="Grid.ColumnSpan" Value="1" />
                        <Setter Property="Margin" Value="12,0,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPreviewExpanded}" Value="True">
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="3" />
                                <Setter Property="Margin" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <ScrollViewer>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPreviewExpanded}" Value="True">
                                    <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Clickable Preview Screen -->
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Lyrics Preview Monitor (Click to Toggle Theater Mode)" FontSize="14" FontWeight="SemiBold" Foreground="#888888" HorizontalAlignment="Center" Margin="0,0,0,10" />

                            <Border Grid.Row="1" MinHeight="220" CornerRadius="6" Background="Black" ClipToBounds="True" BorderBrush="#333" BorderThickness="1">
                                <ui:Button Command="{Binding TogglePreviewExpandCommand}"
                                       Padding="0"
                                       BorderThickness="0"
                                       Background="Transparent"
                                       Cursor="Hand"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       HorizontalContentAlignment="Stretch"
                                       VerticalContentAlignment="Stretch">
                                    <Grid>
                                        <Image Source="{Binding CurrentFrame}" Stretch="Uniform" />

                                        <!-- No active media feed default message -->
                                        <TextBlock Text="No active media feed" Foreground="#444444" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding CurrentFrame}" Value="{x:Null}" />
                                                                <Condition Binding="{Binding IsExternalPerformanceActive}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- External Performance active message -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExternalPerformanceActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <ui:SymbolIcon Symbol="VideoClip24" FontSize="32" Foreground="{StaticResource UIAccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />

                                            <TextBlock Text="{Binding ExternalPerformanceSource, StringFormat='{}{0} Performance Active'}"
                                                   FontSize="15" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />

                                            <TextBlock Text="Lyrics are displaying on your browser window."
                                                   FontSize="11" Foreground="#888888" HorizontalAlignment="Center" Margin="0,2,0,12" />

                                            <ui:Button Content="Re-open Performance Link"
                                                   Icon="{ui:SymbolIcon Open24}"
                                                   Command="{Binding ReopenExternalPerformanceLinkCommand}"
                                                   Appearance="Secondary"
                                                   HorizontalAlignment="Center"
                                                   Padding="10,6"
                                                   FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </ui:Button>
                            </Border>
                        </Grid>

                        <!-- Collapsible Control Center -->
                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPreviewExpanded}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Audio Adjustments Panel -->
                            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Audio Controls" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ui:ToggleSwitch Grid.Column="1" Content="Kill Vocal (AI)" IsChecked="{Binding EnableKillVocal, Mode=TwoWay}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <ui:Button Grid.Column="2" Content="Save to Singer" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveSingerAudioDefaultsCommand}" Appearance="Primary" Margin="0,0,6,0" ToolTip="Save current EQ, mic level, key, and tempo as defaults for this singer" />
                                        <ui:Button Grid.Column="3" Content="Recall Singer" Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding RecallSingerAudioDefaultsCommand}" Appearance="Secondary" Margin="0,0,6,0" ToolTip="Recall saved audio defaults and key/tempo for this singer" />
                                        <ui:Button Grid.Column="4" Content="Reset Audio" Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding ResetAudioCommand}" Appearance="Secondary" />
                                    </Grid>

                                    <!-- First Slider Row (Volume, Speed, Pitch) -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Volume -->
                                        <StackPanel Grid.Column="0">
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Volume" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding Volume, StringFormat='{}{0:0}%'}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" />
                                        </StackPanel>

                                        <!-- Speed -->
                                        <StackPanel Grid.Column="2">
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Speed" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding Speed, StringFormat='{}{0:0.0}x'}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider Minimum="0.5" Maximum="2.0" Value="{Binding Speed, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" />
                                        </StackPanel>

                                        <!-- Pitch -->
                                        <StackPanel Grid.Column="4">
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Pitch Transpose" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding Pitch, StringFormat='{}{0:+0;-0;0}'}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider Minimum="-6" Maximum="6" Value="{Binding Pitch, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Separator -->
                                    <Separator Margin="0,12,0,12" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                                    <!-- Tone sliders (Treble, Mid, Bass) -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Treble -->
                                        <StackPanel Grid.Column="0">
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Treble (Highs)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding Treble, StringFormat='{}{0:+0;-0;0} dB'}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider Minimum="-10" Maximum="10" Value="{Binding Treble, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" />
                                        </StackPanel>

                                        <!-- Mid -->
                                        <StackPanel Grid.Column="2">
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Midrange" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding Mid, StringFormat='{}{0:+0;-0;0} dB'}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider Minimum="-10" Maximum="10" Value="{Binding Mid, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" />
                                        </StackPanel>

                                        <!-- Bass -->
                                        <StackPanel Grid.Column="4">
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Bass (Lows)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding Bass, StringFormat='{}{0:+0;-0;0} dB'}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider Minimum="-10" Maximum="10" Value="{Binding Bass, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Dynamics controllers (Compressor, Limiter) -->
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Compressor -->
                                        <StackPanel Grid.Column="0">
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Compressor Threshold" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding Compressor, StringFormat='{}{0:0}%'}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider Minimum="0" Maximum="100" Value="{Binding Compressor, Mode=TwoWay}" />
                                        </StackPanel>

                                        <!-- Limiter -->
                                        <StackPanel Grid.Column="2">
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Limiter Threshold" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding Limiter, StringFormat='{}{0:0} dB'}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider Minimum="-20" Maximum="0" Value="{Binding Limiter, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Display Projection & Multi-Monitor Controls -->
                            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Display Projection &amp; Multi-Monitor Controls" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Lyrics Monitor -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Lyrics Projection Screen" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding AvailableScreens}" SelectedIndex="{Binding SelectedLyricsScreenIndex, Mode=TwoWay}" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                                            <wpf:ToggleButton IsChecked="{Binding IsLyricsActive, Mode=TwoWay}" HorizontalAlignment="Stretch" Height="36">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Window24" Margin="0,0,6,0" />
                                                    <TextBlock Text="Lyrics Projection" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </wpf:ToggleButton>
                                        </StackPanel>

                                        <!-- Rotation Monitor -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Rotation Queue Screen" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding AvailableScreens}" SelectedIndex="{Binding SelectedRotationScreenIndex, Mode=TwoWay}" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                                            <wpf:ToggleButton IsChecked="{Binding IsRotationActive, Mode=TwoWay}" HorizontalAlignment="Stretch" Height="36">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="People24" Margin="0,0,6,0" />
                                                    <TextBlock Text="Rotation Queue" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </wpf:ToggleButton>
                                        </StackPanel>

                                        <!-- DJ Banner Monitor -->
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="DJ Banner Screen" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding AvailableScreens}" SelectedIndex="{Binding SelectedDjBannerScreenIndex, Mode=TwoWay}" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                                            <wpf:ToggleButton IsChecked="{Binding IsDjBannerActive, Mode=TwoWay}" HorizontalAlignment="Stretch" Height="36">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Flag24" Margin="0,0,6,0" />
                                                    <TextBlock Text="DJ Banner" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </wpf:ToggleButton>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Rotation Banner controls -->
                                    <Separator Margin="0,6,0,6" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                    <TextBlock Text="Rotation Screen Billboard Banner" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0" Text="{Binding RotationBannerText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Enter scroll announcement text..." Margin="0,0,0,0" />
                                        <CheckBox Grid.Column="2" Content="Show Banner" IsChecked="{Binding ShowRotationBanner, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- DJ Banner controls -->
                                    <Separator Margin="0,6,0,6" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                    <TextBlock Text="DJ Banner Selection" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding DjBanners}" SelectedItem="{Binding SelectedDjBanner, Mode=TwoWay}" DisplayMemberPath="FileName" HorizontalAlignment="Stretch" />
                                        <ui:Button Grid.Column="2" Content="Upload" Icon="{ui:SymbolIcon ArrowUpload24}" Command="{Binding UploadDjBannerCommand}" />
                                        <ui:Button Grid.Column="4" Content="Delete" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteDjBannerCommand}" Appearance="Danger" />
                                    </Grid>

                                    <!-- Special Event Banner Selection -->
                                    <TextBlock Text="Special Event Banner Selection" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,4" />
                                    <ItemsControl ItemsSource="{Binding SpecialEventOptions}" Margin="0,0,0,8">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,16,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Show Extras: Special Occasions + Scaryoke Party Mode -->
                                    <Separator Margin="0,6,0,6" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Headers Row -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Show Extras" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Billboard Display Type" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="12,0,0,4" />

                                        <Menu Grid.Row="1" Grid.Column="0" Background="Transparent" VerticalAlignment="Center">
                                            <MenuItem Padding="10,6"
                                                  ItemsSource="{Binding OccasionMenu}"
                                                  ItemContainerStyle="{DynamicResource OccasionMenuItemStyle}">
                                                <MenuItem.Header>
                                                    <TextBlock Text="🎉 Special Occasion ▼" FontWeight="SemiBold" />
                                                </MenuItem.Header>
                                            </MenuItem>
                                        </Menu>

                                        <ui:Button Grid.Row="1" Grid.Column="1" Icon="{ui:SymbolIcon Stop24}" Command="{Binding StopOccasionCommand}" Appearance="Secondary" ToolTip="Stop Occasion Music" Margin="6,0,0,0" />

                                        <ComboBox x:Name="CmbBannerType" Grid.Row="1" Grid.Column="2"
                                              ItemsSource="{Binding ProjectionViews}"
                                              SelectedItem="{Binding SelectedProjectionView, Mode=TwoWay}"
                                              Height="35"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" Width="200"
                                              Margin="12,0" />

                                        <ui:ToggleSwitch Grid.Row="1" Grid.Column="3" Content="Scaryoke" IsChecked="{Binding IsScaryokeMode, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <ui:Button Grid.Row="1" Grid.Column="4" Content="Spin!" Icon="{ui:SymbolIcon PlayingCards20}" Command="{Binding OpenScaryokeWheelCommand}" IsEnabled="{Binding IsScaryokeMode}" Appearance="Primary" Background="{StaticResource UIAccentBrush}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>