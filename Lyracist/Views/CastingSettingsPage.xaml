<!-- Created on Aug 1, 2026 @ 15:10:00 -> Add CastingSettingsPage UserControl -->
<!-- Redesigned on Aug 1, 2026 -> Match the SettingsPage card layout: two columns, full-width inputs, labeled fields -->
<UserControl x:Class="Lyracist.Views.CastingSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <!-- GroupBox header: horizontal cyan→blue gradient, matching this page's header banner -->
        <LinearGradientBrush x:Key="CastGroupBoxHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00A6E0" Offset="0.0" />
            <GradientStop Color="#0072ff" Offset="1.0" />
        </LinearGradientBrush>

        <!-- GroupBox body: very subtle blue tint over the app background -->
        <SolidColorBrush x:Key="CastGroupBoxBodyBrush"   Color="#1200c6ff" />
        <SolidColorBrush x:Key="CastGroupBoxBorderBrush" Color="#550072ff" />

        <!-- ControlTemplate that gives every GroupBox the cyan-header card look -->
        <Style x:Key="CastGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource CastGroupBoxBorderBrush}">
                            <StackPanel>
                                <Border Background="{StaticResource CastGroupBoxHeaderBrush}"
                                        CornerRadius="7,7,0,0"
                                        Padding="14,9">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                </Border>
                                <Border Background="{StaticResource CastGroupBoxBodyBrush}"
                                        Padding="14"
                                        CornerRadius="0,0,7,7">
                                    <ContentPresenter />
                                </Border>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN: status + primary cast controls -->
        <StackPanel Grid.Column="0">

            <!-- Cast Status -->
            <GroupBox Header="Cast Status" Style="{StaticResource CastGroupBoxStyle}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Cast24" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </GroupBox>

            <!-- Cast Rotation -->
            <GroupBox Header="Cast Rotation" Style="{StaticResource CastGroupBoxStyle}">
                <StackPanel>
                    <TextBlock Text="Display Target" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding Targets}"
                              SelectedItem="{Binding SelectedTarget}"
                              HorizontalAlignment="Stretch"
                              Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0"
                                   Content="Cast Rotation"
                                   Icon="{ui:SymbolIcon Cast24}"
                                   Command="{Binding CastCommand}"
                                   Appearance="Primary"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center" />
                        <ui:Button Grid.Column="2"
                                   Content="Stop Casting"
                                   Icon="{ui:SymbolIcon Stop24}"
                                   Command="{Binding StopCommand}"
                                   Appearance="Secondary"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center" />
                    </Grid>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- RIGHT COLUMN: device discovery -->
        <StackPanel Grid.Column="2">

            <!-- Multi-TV Selector -->
            <GroupBox Header="Chromecast TVs" Style="{StaticResource CastGroupBoxStyle}">
                <StackPanel>
                    <ui:Button Content="Scan for TVs"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"
                               Command="{Binding RefreshCommand}"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center"
                               Margin="0,0,0,12" />

                    <TextBlock Text="Available Devices" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="Name"
                              HorizontalAlignment="Stretch"
                              Margin="0,0,0,12" />

                    <ui:Button Content="Cast to Selected TV"
                               Icon="{ui:SymbolIcon Cast24}"
                               Command="{Binding CastToDeviceCommand}"
                               Appearance="Primary"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center" />
                </StackPanel>
            </GroupBox>

            <!-- BrowserCast Clients -->
            <GroupBox Header="BrowserCast Clients" Style="{StaticResource CastGroupBoxStyle}">
                <StackPanel>
                    <TextBlock Text="Connected Browser Clients" Style="{StaticResource FieldLabelStyle}" />
                    <Border BorderBrush="{StaticResource CastGroupBoxBorderBrush}" BorderThickness="1" CornerRadius="4">
                        <ListBox ItemsSource="{Binding BrowserClients}"
                                 DisplayMemberPath="Device"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 MaxHeight="160" />
                    </Border>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>
</UserControl>
