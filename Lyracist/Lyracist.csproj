<!-- Edited on Aug 30, 2026 @ 08:26:00 -> Update Content links for consolidated Packs, Banners, and Data directories -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyVersion>26.9.1.466</AssemblyVersion>
    <FileVersion>26.9.1.466</FileVersion>
    <ApplicationIcon>Assets\LyracistIcon.ico</ApplicationIcon>
    <PackageIcon>mic_128.png</PackageIcon>
    <!-- Report each monitor's true physical resolution/DPI on mixed-DPI multi-monitor setups. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NeutralLanguage>en-US</NeutralLanguage>
    <BaseOutputPath>C:\VB26\Release\Lyracist</BaseOutputPath>
    <Title>Lyracist Pro</Title>
    <Product>Lyracist Pro</Product>
    <AssemblyTitle>Lyracist Pro</AssemblyTitle>
    <Authors>Dennis N. Maidon</Authors>
    <Company>PAROLE Software</Company>
    <Copyright>Copyright © 2026 PAROLE Software</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\lyracist_mic.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="C:\VB26\Lyracist\README.md" Link="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="Assets\mic_128.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\mic_128.png" />
    <Resource Include="Assets\lyracist_modern.png" />
    <Resource Include="Assets\LyracistLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
    <PackageReference Include="FFME.Windows" Version="4.4.350" />
    <PackageReference Include="LibVLCSharp" Version="3.10.1" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <PackageReference Include="WriteableBitmapEx" Version="1.6.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lyracist.Data\Lyracist.Data.csproj" />
    <ProjectReference Include="..\Lyracist.Trivia.Core\Lyracist.Trivia.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="C:\ffmpeg\bin\ffmpeg.exe">
      <Link>ffmpeg.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="C:\ffmpeg\bin\ffprobe.exe">
      <Link>ffprobe.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\IRotationSinger.cs" Link="IRotationSinger.cs" />
    <Compile Include="..\Shared\RotationHelpers.cs" Link="RotationHelpers.cs" />
    <Compile Include="..\Shared\ChromecastDiscoveryService.cs" Link="ChromecastDiscoveryService.cs" />
    <Compile Include="..\Shared\ChromecastSender.cs" Link="ChromecastSender.cs" />
    <Compile Include="..\Shared\BrowserCastDiscoveryService.cs" Link="BrowserCastDiscoveryService.cs" />
    <Compile Include="..\Shared\LocalNetworkHelper.cs" Link="LocalNetworkHelper.cs" />
    <Compile Include="..\Shared\DisplayTarget.cs" Link="DisplayTarget.cs" />
    <Compile Include="..\Shared\ICaptureSource.cs" Link="ICaptureSource.cs" />
    <Compile Include="..\Shared\IRotationRenderer.cs" Link="IRotationRenderer.cs" />
    <Compile Include="..\Shared\RotationRenderer.cs" Link="RotationRenderer.cs" />
    <Compile Include="..\Shared\MiracastController.cs" Link="MiracastController.cs" />
    <Compile Include="..\Shared\BrowserCastServer.cs" Link="BrowserCastServer.cs" />
    <Compile Include="..\Shared\ICastingService.cs" Link="ICastingService.cs" />
    <Compile Include="..\Shared\CastingService.cs" Link="CastingService.cs" />
    <Compile Include="..\Shared\MonitorDpiHelper.cs" Link="MonitorDpiHelper.cs" />
    <Compile Include="..\Shared\DjBannerItem.cs" Link="DjBannerItem.cs" />
    <Compile Include="..\Shared\SpecialEventConfig.cs" Link="SpecialEventConfig.cs" />
    <Compile Include="..\Shared\DjBannerFileManager.cs" Link="DjBannerFileManager.cs" />
    <Compile Include="..\Shared\WindowPositioner.cs" Link="WindowPositioner.cs" />
    <Compile Include="..\Shared\MonitorInfo.cs" Link="MonitorInfo.cs" />
    <Compile Include="..\Shared\MonitorEnumerator.cs" Link="MonitorEnumerator.cs" />
    <Compile Include="..\Shared\AtomicJsonFile.cs" Link="AtomicJsonFile.cs" />
    <Compile Include="..\Shared\WifiHelper.cs" Link="WifiHelper.cs" />
    <Compile Include="..\Shared\WifiPasswordStore.cs" Link="WifiPasswordStore.cs" />
    <Compile Include="..\Shared\TriviaDisplayViewModel.cs" Link="TriviaDisplayViewModel.cs" />
    <Compile Include="..\Shared\TextBoxSelectionHelper.cs" Link="TextBoxSelectionHelper.cs" />
    <Compile Include="..\Shared\NameFormatting.cs" Link="NameFormatting.cs" />
    <Compile Include="..\Lyracist.Trivia\Services\TriviaBannerGenerator.cs" Link="Services\TriviaBannerGenerator.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="TabletClient\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- kiosk.html has one canonical copy (KSRotation/Resources/kiosk.html); link it in
         here instead of maintaining a second physical copy that can drift out of sync. -->
    <None Include="..\KSRotation\Resources\kiosk.html" Link="TabletClient\kiosk.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Packs\**\*">
      <Link>Packs\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- EventBanners is shared with KSRotation (see Globals.EventBannersDir /
         Shared/DjBannerFileManager.cs) - one folder, not a per-app copy. DJBanners and
         Announcements are per-venue, user-supplied content, not source content. -->
    <Content Include="..\Banners\KSRotation\EventBanners\*">
      <Link>Banners\KSRotation\EventBanners\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Data\**\*">
      <Link>Data\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
