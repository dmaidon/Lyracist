<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyVersion>26.7.7.149</AssemblyVersion>
    <FileVersion>26.7.7.149</FileVersion>
    <ApplicationIcon>Assets\LyracistIcon.ico</ApplicationIcon>
    <PackageIcon>mic_128.png</PackageIcon>
    <Authors>Dennis Maidon</Authors>
    <Company>PAROLE Software</Company>
    <NeutralLanguage>en-US</NeutralLanguage>
    <BaseOutputPath>C:\VB26\Release\Lyracist</BaseOutputPath>
    <Title>Lyracist</Title>
    <Copyright>© 2026 PAROLE Software - All rights reserved.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Sonya-Swarm-Microphone.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\Users\dmaid\Downloads\mic_128.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\lyracist_modern.png" />
    <Resource Include="Assets\LyracistLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="FFME.Windows" Version="4.4.350" />
    <PackageReference Include="LibVLCSharp" Version="3.10.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="SkiaSharp" Version="4.148.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <PackageReference Include="WriteableBitmapEx" Version="1.6.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lyracist.Data\Lyracist.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="C:\ffmpeg\bin\ffmpeg.exe">
      <Link>ffmpeg.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="C:\ffmpeg\bin\ffprobe.exe">
      <Link>ffprobe.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
