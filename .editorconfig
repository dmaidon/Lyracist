root = true

[*.cs]
# Disable specific noisy code quality, MVVM Toolkit, and design rules that clutter the Error List
dotnet_diagnostic.MVVMTK0042.severity = none
dotnet_diagnostic.CA1805.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.SYSLIB1045.severity = none
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.CA1311.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1862.severity = none
dotnet_diagnostic.CA1869.severity = none
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.CA1050.severity = none
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.SYSLIB1054.severity = none
dotnet_diagnostic.CA1866.severity = none

# Disable all IDE style and refactoring messages (IDE0000 - IDE9999)
dotnet_analyzer_diagnostic.category-Style.severity = none
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.IDE0044.severity = none
dotnet_diagnostic.IDE0051.severity = none
dotnet_diagnostic.IDE0052.severity = none
dotnet_diagnostic.IDE0060.severity = none
dotnet_diagnostic.IDE0090.severity = none
dotnet_diagnostic.IDE0290.severity = none
dotnet_diagnostic.IDE0300.severity = none

