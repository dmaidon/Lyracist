<!-- Edited on Oct 1, 2026 @ 09:05:00 -> Set Version and PackageVersion to 1.0.1 across all solution projects -->
<Project>
  <PropertyGroup>
    <Version>1.0.1</Version>
    <PackageVersion>1.0.1</PackageVersion>
    <Company>PAROLE Software</Company>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Copyright>© $([System.DateTime]::UtcNow.ToString('yyyy')) PAROLE Software</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);0436;CA1416;CA1422</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(OutputType)' == 'WinExe' And '$(MSBuildProjectName)' != 'LyracistKeyGen'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)Licenses\*.txt" Link="Licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
